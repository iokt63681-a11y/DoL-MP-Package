	<br>
<</if>>
<<socialiseicon>><<link [[继续|MP Companion Hub]]>><</link>>
<br>
<<getouticon>><<link [[离开|($mpReturnPassage or "Orphanage")]]>><<set $eventskip to 1>><<endevent>><</link>>


