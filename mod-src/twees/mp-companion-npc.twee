:: MP Companion Hub [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<run window.dolmp && window.dolmp.syncCompanionToVariables && window.dolmp.syncCompanionToVariables()>>
<<if $mpCompanion and $mpCompanion.isPartnerOnline and window.dolmp and window.dolmp.findOnlineCompanionPeer and window.dolmp.findOnlineCompanionPeer()>>
	<<set _livePeer to window.dolmp.findOnlineCompanionPeer()>>
	<<set $mpInteractTargetId to _livePeer.id>><<set $mpInteractTargetName to _livePeer.name>>
	<<run window.dolmp && window.dolmp.openNativeInteract && window.dolmp.openNativeInteract(_livePeer)>>
<<else>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", attitude: "meek", persona: "meek", love: 0, trust: 0, lust: 0, jealousy: 0, corruption: 0, stage: "stranger" })>>
<<set _exitPas to ($mpReturnPassage or "Orphanage")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas is "Orphanage Intro" or _exitPas.startsWith("MP ")>><<set _exitPas to "Orphanage">><</if>>
<<endevent>><<generateNPC 1 "a" _comp.pronoun _comp.gender>><<person1>>
<<if _comp.stage is "soulmate">>
	听到脚步声，<<print _comp.name>>立刻迎上来握住你的手，胸前银挂坠贴着锁骨轻晃：「欢迎回来，看到你平安我就安心了。」
<<elseif _comp.stage is "lover">>
	<<print _comp.name>>眼神柔和下来，主动替你拂去肩头微尘，十指紧扣地拉你在身旁坐下：「累不累？刚好我这儿有空陪你。」
<<elseif _comp.stage is "crush">>
	<<print _comp.name>>抬头撞见你的视线，耳尖微红地挪出半个位置：「你、你来啦，快过来坐吧。」
<<else>>
	你走近<<print _comp.name>>身旁，<<he>>放下手头活计，朝你点头打了声招呼。
<</if>>
<<if $exposed gte 1>><span class="lewd">见你衣衫不整，<<print _comp.name>>急忙用外套替你挡住视线。</span><</if>>
<br><br>
<<getouticon>><<link [[返回原处 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<bedicon>><<link [[去<<his>>房间 (0:03)|MP Companion Room]]>><<pass 3>><</link>>
<br>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("companion_talk")>>
	<<link [[促膝交谈 (0:07)|MP Companion Talk]]>><<pass 7>><<stress -6>><<trauma -3>><</link>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("companion_study")>>
	<<schoolicon "library">><<link [[温习功课 (0:20)|MP Companion Study]]>><<pass 20>><<stress -4>><<tiredness 2>><</link>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("companion_cuddle")>>
	<<loveicon "hug">><<link [[靠<<him>>小憩 (0:16)|MP Companion Cuddle]]>><<pass 16>><<stress -8>><<tiredness -5>><<trauma -3>><</link>><<lstress>><<ltiredness>><<ltrauma>><<glove>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("companion_walk")>>
	<<link [[约<<him>>散步 (0:25)|MP Companion Walk]]>><<pass 25>><<stress -10>><<trauma -4>><</link>><<lstress>><<ltrauma>><<glove>>
	<br>
<</if>>
<<if (_comp.love gte 10 or _comp.stage is "crush" or _comp.stage is "lover" or _comp.stage is "soulmate" or $promiscuity gte 15) and (!window.dolmp || window.dolmp.canDoDailyInteract("companion_kiss"))>>
	<<link [[捧<<his>>脸亲吻 (0:04)|MP Companion Kiss]]>><<pass 4>><<stress -6>><<arousal 800>><</link>><<promiscuous1>><<lstress>><<glove>><<garousal>>
	<br>
<</if>>
<<if (_comp.love gte 18 or _comp.lust gte 15 or _comp.stage is "lover" or _comp.stage is "soulmate" or $promiscuity gte 35) and (!window.dolmp || window.dolmp.canDoDailyInteract("companion_lewd"))>>
	<<link [[拉进背光处 (0:12)|MP Companion Lewd]]>><<pass 12>><<stress -8>><<arousal 1600>><</link>><<promiscuous2>><<lstress>><<glove>><<ggarousal>>
	<br>
<</if>>
<<if ($mpCompanionQuest or 0) lt 8 and (!$daily or !$daily.mpCompanionQuest)>>
	<<link [[追查八音盒 (0:15)|MP Companion Quest Step]]>><<if !$daily>><<set $daily to {}>><</if>><<set $daily.mpCompanionQuest to 1>><<pass 15>><</link>>
<</if>>
<</if>>

:: MP Companion Room [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<run window.dolmp && window.dolmp.syncCompanionToVariables && window.dolmp.syncCompanionToVariables()>>
<<if $mpCompanion and $mpCompanion.isPartnerOnline and window.dolmp and window.dolmp.findOnlineCompanionPeer and window.dolmp.findOnlineCompanionPeer()>>
	<<set _livePeer to window.dolmp.findOnlineCompanionPeer()>>
	<<set $mpInteractTargetId to _livePeer.id>><<set $mpInteractTargetName to _livePeer.name>>
	<<run window.dolmp && window.dolmp.openNativeInteract && window.dolmp.openNativeInteract(_livePeer)>>
<<else>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", attitude: "meek", persona: "meek", love: 0, trust: 0, lust: 0, jealousy: 0, corruption: 0, stage: "stranger" })>>
<<endevent>><<generateNPC 1 "a" _comp.pronoun _comp.gender>><<person1>>
你推开走廊斜对面<<print _comp.name>>的房门。靠窗木桌上亮着暖黄旧台灯，床头叠着散发阳光气息的棉被。
<<if _comp.stage is "soulmate" or _comp.stage is "lover">>
	<<print _comp.name>>反手将房门落锁，眼底盛满笑意：「门锁好了，没人会来打扰我们。」
<<else>>
	<<print _comp.name>>拉过木椅示意你坐下：「走廊人多眼杂，有什么事进屋说吧。」
<</if>>
<br><br>
<<getouticon>><<link [[返回走廊 (0:02)|Orphanage]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<link [[与<<him>>互动 (0:04)|MP Companion Hub]]>><<pass 4>><</link>>
<br>
<<tvicon>><<link [[打游戏 (0:25)|MP Companion Room Game]]>><<pass 25>><<stress -10>><<trauma -4>><</link>>
<br>
<<bedicon "zzz">><<link [[躺<<his>>床小憩 (0:30)|MP Companion Room Sleep]]>><<pass 30>><<tiredness -10>><<stress -8>><</link>>
<br>
<<if _comp.stage is "lover" or _comp.stage is "soulmate" or _comp.lust gte 15>>
	<<brothelicon>><<link [[锁门与<<him>>温存 (0:30)|MP Companion Combat Consensual]]>><<pass 30>><</link>>
<</if>>
<</if>>

:: MP Companion Room Sleep [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", stage: "stranger" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>><<person1>>
你脱下外鞋躺进<<print _comp.name>>带着皂角清香的被窝里。<<He>>替你掖好被角，守在床沿安静翻书，直到你呼吸变得绵长平稳。<span class="green">这一觉让你恢复了不少精神。</span>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_cuddle", 30, -8, -3, -10, 100, "让你在床铺上安心小憩", { love: 1, trust: 1 })>>
<br><br>
<<getouticon>><<link [[整装起身 (0:03)|MP Companion Room]]>><<pass 3>><</link>>
<br>
<<link [[拉<<his>>腕赖床 (0:10)|MP Companion Cuddle]]>><<pass 10>><<stress -4>><</link>>

:: MP Companion Combat Consensual [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
你向同伴伸出了手，对方呼吸微促地迎了上来……
<<run window.dolmp && window.dolmp.startOfflineCompanionCombat && window.dolmp.startOfflineCompanionCombat(true)>>
<br><br>
<<getouticon>><<link [[返回同伴 (0:02)|MP Companion Hub]]>><<pass 2>><</link>>

:: MP Companion Talk [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", stage: "stranger" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>><<person1>>
你与<<print _comp.name>>并肩坐下，低声聊起这几天的见闻。
<<if _comp.stage is "soulmate" or _comp.stage is "lover">>
	<<He>>握着你的手放在掌心摩挲，把你随口提过的小事都牢牢记在心上，胸口满溢着踏实的暖意。
<<else>>
	<<He>>认真听完你的讲述，还把自己打听到的省钱窍门与夜晚需绕开的小巷仔细告诉了你。
<</if>>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_talk", 7, -6, -2, 0, 200, "与你促膝长谈", { love: 1, trust: 1, jealousy: -1 })>>
<br><br>
<<getouticon>><<link [[返回同伴 (0:02)|MP Companion Hub]]>><<pass 2>><</link>>
<br>
<<walkicon>><<link [[约<<him>>散步 (0:20)|MP Companion Walk]]>><<pass 20>><<stress -8>><</link>>
<br>
<<link [[靠<<him>>小憩 (0:15)|MP Companion Cuddle]]>><<pass 15>><<stress -6>><<tiredness -4>><</link>>

:: MP Companion Study [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", stage: "stranger" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>><<person1>>
你翻开笔记与课本，和<<print _comp.name>>凑在一处温习功课。
<<if _comp.stage is "soulmate" or _comp.stage is "lover">>
	<<He>>一手揽着你的腰，一手握着你的笔尖在草稿纸上推导重点，时不时偷亲一下你的脸颊。
<<else>>
	你们头挨着头核对历史与数学笔记，<<he>>把整理好的提纲推到你手边，配合得十分默契。
<</if>>
<<schoolskill 3>><span class="green">温习让你的课业熟练了不少。</span>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_study", 20, -4, -2, 2, 200, "与你一同温习功课", { love: 1, trust: 1 })>>
<br><br>
<<getouticon>><<link [[收起课本 (0:02)|MP Companion Hub]]>><<pass 2>><</link>>

:: MP Companion Cuddle [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", stage: "stranger" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>><<person1>>
你卸下防备靠在<<print _comp.name>>肩头闭目小憩。<<He>>放轻呼吸揽住你的肩膀，有节奏地轻拍你的后背，驱散了你积累的寒意与疲惫。
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_cuddle", 16, -8, -3, -5, 300, "将你拥在怀中小憩", { love: 1, trust: 1 })>>
<br><br>
<<getouticon>><<link [[起身返回 (0:02)|MP Companion Hub]]>><<pass 2>><</link>>
<br>
<<if _comp.love gte 10 or _comp.stage is "crush" or _comp.stage is "lover" or _comp.stage is "soulmate">>
	<<link [[仰头亲吻<<his>> (0:04)|MP Companion Kiss]]>><<pass 4>><<arousal 600>><</link>>
<</if>>

:: MP Companion Walk [nobr]
<<set $outside to 1>><<set $location to "town">><<effects>><<mpAmbient>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", stage: "stranger" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>><<person1>>
你与<<print _comp.name>>沿着僻静的石板路并肩漫步。<<He>>始终走在靠马路的外侧，遇到积水时自然地扶住你的手肘。<span class="green">清凉微风吹散了心头郁结。</span>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_walk", 25, -10, -4, 0, 200, "与你在街巷并肩漫步", { love: 1, trust: 1 })>>
<br><br>
<<getouticon>><<link [[返回同伴 (0:08)|MP Companion Hub]]>><<pass 8>><</link>>

:: MP Companion Kiss [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", stage: "stranger" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>><<person1>>
你捧住<<print _comp.name>>的脸颊，踮起脚尖吻上<<his>>温软的双唇。<<He>>怔了一瞬，随即收紧手臂将你按向胸膛，唇齿交缠间呼吸渐渐滚烫。
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("kiss", 4, -6, -2, 0, 800, "与你交换了深吻", { love: 1, lust: 1 })>>
<br><br>
<<getouticon>><<link [[平复呼吸 (0:02)|MP Companion Hub]]>><<pass 2>><</link>>
<br>
<<brothelicon>><<link [[耳鬓厮磨 (0:12)|MP Companion Lewd]]>><<pass 12>><<arousal 1200>><</link>>

:: MP Companion Lewd [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", stage: "stranger" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>><<person1>>
你将<<print _comp.name>>拉进背光的隐秘角落，滚烫的身体紧密贴合。<<He>>一手掩住你的唇防止声音外泄，另一只手探入衣摆轻拢慢捻，直到你们在急促喘息中一同战栗着攀上高峰。
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_lewd", 12, -8, -2, 0, 1500, "与你在暗处耳鬓厮磨", { love: 1, lust: 2, corruption: 1 })>>
<br><br>
<<getouticon>><<link [[整装返回 (0:02)|MP Companion Hub]]>><<pass 2>><</link>>

:: MP Companion Quest Step [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", stage: "stranger" })>>
<<set _q to ($mpCompanionQuest or 0)>>
<<if _q gte 4>>
	<<include "MP Companion Quest Step Late">>
<<else>>
	<<if _q is 0>>你在<<print _comp.name>>床底旧木匣里发现一只缺了音筒的银边八音盒，盒底刻着孤儿院早期编号。<<print _comp.name>>握住你的手，约你夜里去旧储物室查底册。<<set $mpCompanionQuest to 1>>
	<<elseif _q is 1>>你们潜入旧储物室翻出十年前存根，查出八音盒音筒曾被前任管理员典当给高街钟表铺。<<set $mpCompanionQuest to 2>>
	<<elseif _q is 2>>高街钟表铺的<<if $mpNpcs and $mpNpcs.sera and $mpNpcs.sera.hasMet>>塞拉<<else>>修表师<</if>>用放大镜端详刻痕，认出这枚定制音筒早年流落到了学园图书馆旧档案架。<<set $mpCompanionQuest to 3>>
	<<else>>你们在图书馆旧档架翻出半张铜曲谱，躲过<<if $NPCNameList and $NPCNameList.includes("Leighton")>>礼顿<<else>>值班校官<</if>>巡查后看清背面标着公园旧玻璃花房石坛。<<set $mpCompanionQuest to 4>><</if>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("companion_quest_stage_" + $mpCompanionQuest)>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><</if>>
	<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_quest", 15, -8, -4, 0, 300, "与你追查八音盒线索", { love: 2, trust: 2 })>>
	<br><br>
	<<getouticon>><<link [[返回同伴 (0:03)|MP Companion Hub]]>><<pass 3>><</link>>
	<br>
	<<if $mpCompanionQuest gte 4>><<link [[核对暗记 (0:03)|MP Companion Quest Step Late]]>><<pass 3>><</link>><</if>>
<</if>>

:: MP Companion Quest Step Late [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", stage: "stranger" })>>
<<set _q to ($mpCompanionQuest or 4)>>
<<if _q is 4>>你们在公园旧花房石坛下挖出带天鹅纹章锁的密封铅盒，决定去寻匹配的黄铜小匙。<<set $mpCompanionQuest to 5>>
<<elseif _q is 5>>在台灯下用天鹅铜匙打开铅盒，里面躺着失落多年的纯银音筒与证明<<print _comp.name>>身世的家书。<<set $mpCompanionQuest to 6>>
<<elseif _q is 6>>将纯银音筒装回八音盒拧紧发条，清脆摇篮曲响起，<<print _comp.name>>红着眼眶将你紧紧拥入怀中。<<set $mpCompanionQuest to 7>>
<<else>><<print _comp.name>>从盒底取出一枚成套的纯银同心指环戴在你手上，与你十指紧扣许下相守心愿。<<set $mpCompanionQuest to 8>><</if>>
<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("companion_quest_stage_" + $mpCompanionQuest + "_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><</if>>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_quest", 15, -10, -5, 0, 400, "与你解开八音盒身世之谜", { love: 2, trust: 2 })>>
<br><br>
<<getouticon>><<link [[返回同伴 (0:03)|MP Companion Hub]]>><<pass 3>><</link>>

:: MP Companion Room Game [nobr]
<<set $outside to 0>><<set $location to "bedroom">><<effects>><<mpAmbient>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", stage: "stranger" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>><<person1>>
你与<<print _comp.name>>并肩窝在床沿地毯上，打开老旧小彩电与双人手柄玩起像素闯关游戏。通关瞬间<<he>>欢呼着扑进你怀里，满屋阴霾一扫而空。<span class="green">你们配合默契地打通了关卡。</span>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_talk", 25, -10, -4, 0, 200, "与你窝在床边打双人游戏", { love: 1, trust: 1 })>>
<br><br>
<<getouticon>><<link [[放下手柄 (0:02)|MP Companion Room]]>><<pass 2>><</link>>
