/* =========================================================================
   离线伴侣可恋爱 NPC 系统 — 常驻孤儿院与全镇日程、五重性格差分与八章多结局个人长支线
   ========================================================================= */

:: MP Companion Hub [nobr]
<<effects>>
<<run window.dolmp && window.dolmp.syncCompanionToVariables && window.dolmp.syncCompanionToVariables()>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", attitude: "meek", persona: "meek", love: 0, trust: 0, lust: 0, jealousy: 0, corruption: 0, stage: "stranger" })>>
<<set $mpInteractTargetName to _comp.name>>
<<set _exitPas to ($mpReturnPassage or "Orphanage")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Orphanage">>
<</if>>
<<endevent>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>>
<<person1>>
<<run window.dolmp && window.dolmp.prepareInteractVars && window.dolmp.prepareInteractVars()>>
<div id="mp-rel-header" class="mp-rel-banner"><<print window.dolmp && window.dolmp.renderRelationshipBannerHtml ? window.dolmp.renderRelationshipBannerHtml() : "">></div>
<<if _comp.persona is "possessive">>
	你刚走近，<<print _comp.name>>便停下了手里的动作，目光沉沉地锁在你身上。<<He>>上前一步替你理了理衣领，指尖在你的颈侧停留了片刻："你今天在外面待了好久……没有别人欺负你，或者乱碰你吧？只要待在我身边就安全了。"
<<elseif _comp.persona is "corrupt">>
	<<print _comp.name>>一看见你，嘴角便勾起一抹意味深长的笑意。<<He>>自然而然地贴近你的身侧，温热的指尖隔着布料在你的腰际轻轻画了个圈："我刚才还在想你什么时候会来找我呢，结果你就自己送上门了。"
<<elseif _comp.attitude is "bratty">>
	看到你走过来，<<print _comp.name>>故作矜持地扬了扬下巴，耳尖却微微泛红，顺手把自己怀里刚温好的热饮塞进你手里："怎么才过来？我可不是特意在这儿等你的，只是刚好顺路而已。"
<<elseif _comp.attitude is "meek">>
	听到你的脚步声，<<print _comp.name>>立刻抬起头，眼睛亮晶晶地迎了上来，小心翼翼地拉住你的衣袖："你来啦……我刚刚还在担心你在外面会不会遇到麻烦，看到你平安无事真是太好了。"
<<else>>
	<<print _comp.name>>合上手里的笔记本，温和地朝你笑了笑，往旁边让出半个位置示意你坐下："你来了。累的话，先在我身边歇一会儿吧。"
<</if>>
<br><br>
<<if $pain gte 25 or $stress gte 3000 or $trauma gte 1000>>
	注意到你略显疲惫与狼狈的神色，<<his>>的眉头立刻蹙了起来，从口袋里掏出干净的手帕替你擦去额角的汗水，掌心传来令人安心的温度。
	<br><br>
<</if>>
<<if _exitPas is "Orphanage" or _exitPas is "Bedroom">>
	<<bedicon>><<link [[去<<his>>的孤儿院房间坐坐 (0:05)|MP Companion Room]]>><<pass 5>><</link>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("companion_talk")>>
	<<socialiseicon>><<link [[和<<him>>聊聊孤儿院与镇上的日常 (0:15)|MP Companion Talk]]>><<pass 15>><<stress -6>><<trauma -2>><</link>><<lstress>><<ltrauma>><<glove>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("companion_study")>>
	<<schoolicon "library">><<link [[和<<him>>一起温习功课 (0:25)|MP Companion Study]]>><<pass 25>><<stress -4>><<school 2>><</link>><<gschool>><<glove>><<gtrust>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("companion_cuddle")>>
	<<loveicon "hug">><<link [[靠在<<him>>怀里拥抱温存 (0:15)|MP Companion Cuddle]]>><<pass 15>><<stress -8>><<trauma -4>><<tiredness -3>><</link>><<lstress>><<ltrauma>><<ltiredness>><<glove>>
	<br>
<</if>>
<<if Time.hour gte 7 and Time.hour lte 9 and Time.weekDay gte 2 and Time.weekDay lte 6 and (_exitPas is "Orphanage" or _exitPas is "Bedroom" or _exitPas is "Domus Street") and (!$daily or !$daily.mpCompanionWalkSchool)>>
	<<walkicon>><<link [[和<<him>>牵手一起去学校 (0:15)|MP Companion Walk School]]>><<set $daily.mpCompanionWalkSchool to 1>><<pass 15>><<stress -6>><</link>><<lstress>><<glove>>
	<br>
<</if>>
<<if (Time.weekDay is 1 or Time.weekDay is 7) and Time.hour gte 9 and Time.hour lte 17 and (!$daily or !$daily.mpCompanionStall)>>
	<<Highicon>><<link [[帮<<him>>一起照看周末小摊 (0:45)|MP Companion Weekend Stall]]>><<set $daily.mpCompanionStall to 1>><<pass 45>><<money 1800>><<stress -6>><</link>><<lstress>><<glove>>
	<br>
<</if>>
<<if (_comp.love gte 10 or hasSexStat("promiscuity", 2) or $promiscuity gte 15) and (!window.dolmp || window.dolmp.canDoDailyInteract("companion_kiss"))>>
	<<loveicon "kiss">><<link [[凑近亲吻<<him>> (0:10)|MP Companion Kiss]]>><<pass 10>><<stress -6>><<arousal 700>><</link>><<promiscuous1>><<lstress>><<glove>><<garousal>>
	<br>
<</if>>
<<if (_comp.love gte 15 or _comp.lust gte 12 or hasSexStat("promiscuity", 3) or $promiscuity gte 35) and (!window.dolmp || window.dolmp.canDoDailyInteract("companion_lewd"))>>
	<<brothelicon>><<link [[在暗处拉住<<his>>的手探入衣内 (0:15)|MP Companion Lewd Touch]]>><<pass 15>><<arousal 1400>><<stress -6>><</link>><<promiscuous2>><<lstress>><<ggarousal>>
	<br>
<</if>>
<<if ($mpCompanionQuest or 0) lt 8 and (!$daily or !$daily.mpCompanionQuest)>>
	<<investigateicon>><<link [[询问<<him>>最近藏在心里的事 (0:20)|MP Companion Storyline Hub]]>><<set $daily.mpCompanionQuest to 1>><<pass 20>><</link>>
	<br>
<</if>>
<<brothelicon "stage">><<link [[与<<him>>深入温存|MP Player Interact]]>><</link>>
<br>
<<socialiseicon "ask">><<link [[调整伴侣印象设定|MP Companion Customize]]>><</link>>
<br>
<<getouticon>><<link [[返回|_exitPas]]>><<set $eventskip to 1>><<endevent>><</link>>


:: MP Companion Room [nobr]
<<effects>>
<<run window.dolmp && window.dolmp.syncCompanionToVariables && window.dolmp.syncCompanionToVariables()>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", attitude: "meek", persona: "meek", love: 0, trust: 0, lust: 0, jealousy: 0, corruption: 0, stage: "stranger" })>>
<<set $mpInteractTargetName to _comp.name>>
<<endevent>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>>
<<person1>>
<<run window.dolmp && window.dolmp.prepareInteractVars && window.dolmp.prepareInteractVars()>>
你轻轻敲了敲房门，推门走进<<print _comp.name>>在孤儿院的房间。房间虽然不大，却被收拾得格外温馨整洁。窗台上摆着一只装着干花与海螺的玻璃瓶，书桌上叠着几本做满笔记的课本，床铺边还放着一只旧游戏机与双人手柄。
<br><br>
<<if _comp.persona is "possessive">>
	<<print _comp.name>>反手替你关上房门，顺手落下了门锁。<<He>>从背后抱住你的腰，把下巴抵在你的肩膀上深吸了一口气："只要进了这个房间，外面那些讨厌的家伙就再也看不到你了……今晚留在这里陪我，好不好？"
<<elseif _comp.persona is "corrupt">>
	<<print _comp.name>>懒洋洋地半倚在床头，领口微敞，拍了拍自己身旁松软的床垫："门已经关好了，就算叫出声来，走廊外面也听不见的。"
<<elseif _comp.attitude is "bratty">>
	<<print _comp.name>>连忙把桌上一张画着你侧脸的草稿纸压到书本底下，装作若无其事地咳了一声："随便坐吧，床铺我刚整理过，你要是累了躺会儿也不是不行。"
<<else>>
	<<print _comp.name>>欣喜地迎上来替你挂好外套，又从保温壶里倒了一杯热可可递给你："快坐下暖和一会儿吧，我正想着去敲你的门呢。"
<</if>>
<br><br>
<<if !$daily or !$daily.mpCompGame>>
	<<tvicon>><<link [[和<<him>>一起窝在床边打游戏 (0:30)|MP Companion Play Game]]>><<set $daily.mpCompGame to 1>><<pass 30>><<stress -10>><<trauma -4>><</link>><<lstress>><<ltrauma>><<glove>>
	<br>
<</if>>
<<if !$daily or !$daily.mpCompTea>>
	<<foodicon "cocoa">><<link [[和<<him>>分享热可可与点心 (0:20)|MP Companion Room Cocoa]]>><<set $daily.mpCompTea to 1>><<pass 20>><<stress -8>><<tiredness -4>><</link>><<lstress>><<ltiredness>><<glove>>
	<br>
<</if>>
<<if !$daily or !$daily.mpCompTraumaCare>>
	<<loveicon "hug">><<link [[伏在<<him>>膝头倾诉委屈 (0:25)|MP Companion Trauma Care]]>><<set $daily.mpCompTraumaCare to 1>><<pass 25>><<stress -14>><<trauma -10>><</link>><<lstress>><<ltrauma>><<glove>><<gtrust>>
	<br>
<</if>>
<<if (_comp.love gte 12 or hasSexStat("promiscuity", 2) or $promiscuity gte 15) and (!$daily or !$daily.mpCompRoomBed)>>
	<<bedicon "double">><<link [[把<<him>>按倒在床铺上亲热 (0:25)|MP Companion Room Bed]]>><<set $daily.mpCompRoomBed to 1>><<pass 25>><<arousal 1600>><<stress -8>><</link>><<promiscuous2>><<lstress>><<ggarousal>>
	<br>
<</if>>
<<if Time.hour gte 20 or Time.hour lte 5>>
	<<bedicon "zzz">><<link [[钻进<<his>>的被窝相拥过夜 (1:00)|MP Companion Room Sleep]]>><<pass 60>><<tiredness -15>><<stress -12>><<trauma -6>><</link>><<ltiredness>><<lstress>><<ltrauma>><<glove>>
	<br>
<</if>>
<<if ($mpCompanionQuest or 0) lt 8 and (!$daily or !$daily.mpCompanionQuest)>>
	<<investigateicon>><<link [[聊起<<he>>锁在抽屉里的旧木盒 (0:20)|MP Companion Storyline Hub]]>><<set $daily.mpCompanionQuest to 1>><<pass 20>><</link>>
	<br>
<</if>>
<<socialiseicon>><<link [[返回伴侣互动|MP Companion Hub]]>><</link>>
<br>
<<getouticon>><<link [[回孤儿院大厅|Orphanage]]>><<set $eventskip to 1>><<endevent>><</link>>

:: MP Companion Customize [nobr]
<<effects>>
<<run window.dolmp && window.dolmp.syncCompanionToVariables && window.dolmp.syncCompanionToVariables()>>
你可以在此调整离线伴侣的性格倾向与称呼。当你的联机队友在线进入房间时，该角色会自动同步并记住队友的昵称、外貌与性格数据。
<br><br>
当前伴侣称呼：<<print ($mpCompanion ? $mpCompanion.name : "艾琳")>>
<br>
当前性格倾向：<<print ($mpCompanion ? ($mpCompanion.attitude is "bratty" ? "傲娇护短" : $mpCompanion.attitude is "meek" ? "温柔依恋" : "沉稳冷静") : "温柔依恋")>>
<br><br>
<<socialiseicon>><<link [[性格设为：温柔依恋|MP Companion Hub]]>><<set $mpCompanion.attitude to "meek">><<if window.dolmp && window.dolmp.companion>><<set window.dolmp.companion.attitude to "meek">><</if>><</link>>
<br>
<<socialiseicon "angry">><<link [[性格设为：傲娇护短|MP Companion Hub]]>><<set $mpCompanion.attitude to "bratty">><<if window.dolmp && window.dolmp.companion>><<set window.dolmp.companion.attitude to "bratty">><</if>><</link>>
<br>
<<socialiseicon "ask">><<link [[性格设为：沉稳冷静|MP Companion Hub]]>><<set $mpCompanion.attitude to "neutral">><<if window.dolmp && window.dolmp.companion>><<set window.dolmp.companion.attitude to "neutral">><</if>><</link>>
<br>
<<tficon>><<link [[性别设为：女性|MP Companion Hub]]>><<set $mpCompanion.pronoun to "f">><<set $mpCompanion.gender to "f">><<if window.dolmp && window.dolmp.companion>><<set window.dolmp.companion.pronoun to "f">><<set window.dolmp.companion.gender to "f">><</if>><</link>>
<br>
<<tficon>><<link [[性别设为：男性|MP Companion Hub]]>><<set $mpCompanion.pronoun to "m">><<set $mpCompanion.gender to "m">><<if window.dolmp && window.dolmp.companion>><<set window.dolmp.companion.pronoun to "m">><<set window.dolmp.companion.gender to "m">><</if>><</link>>
<br><br>
<<getouticon>><<link [[返回|MP Companion Hub]]>><</link>>


:: MP Companion Talk [nobr]
<<effects>>
<<run window.dolmp && window.dolmp.syncCompanionToVariables && window.dolmp.syncCompanionToVariables()>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", attitude: "meek" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>>
<<person1>>
你与<<print $mpInteractTargetName>>并肩坐在窗边，聊起了孤儿院里的点点滴滴。从孩子们偷偷藏起来的糖果、走廊地板哪一块踩上去会响，一直聊到各自对未来的打算。
<br><br>
<<if _comp.attitude is "meek">>
	"只要能和你待在一起，哪怕这间孤儿院再破旧，我也觉得像真正的家一样，"<<he>>垂下眼帘，手指轻轻勾住你的小指，声音轻柔而真挚。
<<elseif _comp.attitude is "bratty">>
	"哼，贝利要是敢对你动粗，我第一个跟那家伙拼命，"<<he>>抱起手臂偏过头，眼神却始终没有离开你的脸，"你只管照顾好自己就行了，听见没有？"
<<else>>
	"镇上最近不太平，要是出门去远的地方，记得提前告诉我一声，"<<he>>神色认真地替你整理了一下衣领，"无论什么时候，我都会在家里给你留着灯。"
<</if>>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_talk", 15, -6, -3, 0, 300, "与你在孤儿院共度了一段亲密时光", { love: 1, trust: 1 })>>
<br><br>
<<if "MP Companion Talk" is "MP Companion Room Bed" or "MP Companion Talk" is "MP Companion Lewd Touch">>
	<<brothelicon>><<link [[彻底褪去衣物与<<him>>深入交合|MP Companion Start Combat]]>><</link>><<promiscuous3>>
	<br>
<</if>>
<<socialiseicon>><<link [[继续|MP Companion Hub]]>><</link>>
<br>
<<getouticon>><<link [[离开|($mpReturnPassage or "Orphanage")]]>><<set $eventskip to 1>><<endevent>><</link>>


:: MP Companion Study [nobr]
<<effects>>
<<run window.dolmp && window.dolmp.syncCompanionToVariables && window.dolmp.syncCompanionToVariables()>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", attitude: "meek" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>>
<<person1>>
你们把课本与笔记摊开在桌面上，头挨着头一起梳理最近落下功课的难点。微风吹动书页，发出沙沙的轻响，你们的肩膀不时轻轻碰触在一起。
<br><br>
<<if _comp.attitude is "meek">>
	每当你遇到卡壳的题目时，<<he>>总会耐心地用铅笔在草稿纸上一步步写下推导过程，温热的呼吸拂过你的耳垂，让你连枯燥的课业都觉得甜丝丝的。
<<elseif _comp.attitude is "bratty">>
	"笨死了，这道题我上次不是给你划过重点吗？"<<he>>嘴上数落着，手底下却把自己工工整整写好的笔记推到你面前，指尖还在你手背上轻轻点了两下。
<<else>>
	<<He>>条理清晰地帮你归纳好各科的重点，又贴心地替你削好了铅笔。在<<his>>的陪伴下，原本繁杂的课业很快便迎刃而解。
<</if>>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_study", 15, -6, -3, 0, 300, "与你在孤儿院共度了一段亲密时光", { love: 1, trust: 1 })>>
<br><br>
<<if "MP Companion Study" is "MP Companion Room Bed" or "MP Companion Study" is "MP Companion Lewd Touch">>
	<<brothelicon>><<link [[彻底褪去衣物与<<him>>深入交合|MP Companion Start Combat]]>><</link>><<promiscuous3>>
	<br>
<</if>>
<<socialiseicon>><<link [[继续|MP Companion Hub]]>><</link>>
<br>
<<getouticon>><<link [[离开|($mpReturnPassage or "Orphanage")]]>><<set $eventskip to 1>><<endevent>><</link>>


:: MP Companion Cuddle [nobr]
<<effects>>
<<run window.dolmp && window.dolmp.syncCompanionToVariables && window.dolmp.syncCompanionToVariables()>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", attitude: "meek" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>>
<<person1>>
你主动张开双臂靠进<<print $mpInteractTargetName>>怀里。<<He>>愣了一瞬，随即顺势收拢双臂将你紧紧圈住，下巴轻轻搁在你的发顶上。
<br><br>
<<if _comp.attitude is "meek">>
	<<He>>温热的胸膛随着呼吸轻轻起伏，手掌顺着你的后背一下下轻抚着，仿佛要把你所有的疲惫与不安都揉进怀抱里融化掉。
<<elseif _comp.attitude is "bratty">>
	"突然撒什么娇啊……"<<he>>的身体先是僵了一下，随后耳根通红地把你抱得更紧了些，连声音都放轻了不少，"算了，想靠多久都随你。"
<<else>>
	你们安静地依偎在一起，听着窗外隐约传来的风声与彼此平稳的心跳，内心深处的焦躁在无声的温存中缓缓平息。
<</if>>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_cuddle", 15, -6, -3, 0, 300, "与你在孤儿院共度了一段亲密时光", { love: 1, trust: 1, jealousy: -1 })>>
<br><br>
<<if "MP Companion Cuddle" is "MP Companion Room Bed" or "MP Companion Cuddle" is "MP Companion Lewd Touch">>
	<<brothelicon>><<link [[彻底褪去衣物与<<him>>深入交合|MP Companion Start Combat]]>><</link>><<promiscuous3>>
	<br>
<</if>>
<<socialiseicon>><<link [[继续|MP Companion Hub]]>><</link>>
<br>
<<getouticon>><<link [[离开|($mpReturnPassage or "Orphanage")]]>><<set $eventskip to 1>><<endevent>><</link>>


:: MP Companion Walk School [nobr]
<<effects>>
<<run window.dolmp && window.dolmp.syncCompanionToVariables && window.dolmp.syncCompanionToVariables()>>
<<set _comp to ($mpCompanion or { name: "艾琳", pronoun: "f", gender: "f", attitude: "meek" })>>
<<generateNPC 1 "a" _comp.pronoun _comp.gender>>
<<person1>>
清晨的阳光洒在宅邸街的石板路上，你与<<print $mpInteractTargetName>>并肩走出孤儿院大门，顺着街道一路朝牛津街的学校走去。
<br><br>
<<if _comp.attitude is "meek">>
	路上遇到湿滑的水洼或来往的车辆时，<<he>>总会第一时间握住你的手把你拉到安全的内侧，一直把你送到学校前院才恋恋不舍地松开手。
<<elseif _comp.attitude is "bratty">>
	<<He>>单肩背着书包走在靠马路的一侧，顺手替你拎过了沉重的书袋："走快点，要是迟到了被礼顿留堂，我可不陪你罚站。"
<<else>>
	你们一路聊着天穿过街区，清爽的晨风拂面而来。抵达学校前院时，<<he>>朝你挥了挥手，约好放学后一起回孤儿院。<<set $mpReturnPassage to "School Front Courtyard">>
<</if>>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("companion_walk", 15, -6, -3, 0, 300, "与你在孤儿院共度了一段亲密时光", { love: 1, trust: 1 })>>
<br><br>
<<if "MP Companion Walk School" is "MP Companion Room Bed" or "MP Companion Walk School" is "MP Companion Lewd Touch">>
	<<brothelicon>><<link [[彻底褪去衣物与<<him>>深入交合|MP Companion Start Combat]]>><</link>><<promiscuous3>>
	<br>
<</if>>
<<socialiseicon>><<link [[继续|MP Companion Hub]]>><</link>>
<br>
