<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("comp_quest_0_b", 20, -8, -4, 0, 800, "在调查途中与你亲密拥吻", { love: 2, lust: 1, trust: 1 })>>
