<</if>>
<<run window.dolmp && window.dolmp.notifyInteractEffect && window.dolmp.notifyInteractEffect("comp_quest_0_a", 20, -6, -4, 0, 200, "与你并肩推进了旧怀表的秘密调查", { love: 1, trust: 2 })>>
