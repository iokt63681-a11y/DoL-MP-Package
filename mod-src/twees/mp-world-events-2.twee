	<br>
	<<link [[转身步回多瑙河街 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">垫帕子取出 (0:06)（能力不足）</span><</if>>
</div>

