:: MP Job Extra PubKitchen 2 [nobr]
<<set $outside to 0>><<set $location to "pub">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "night" or Time.dayState is "dusk">>晚市喧嚣的丰收街酒馆后厨炉火正旺，<<else>>酒馆后厨备餐忙碌的时段里，<</if>>烤肉架上的蜂蜜烤肋排火苗窜高，排烟罩铁网突然卡住，浓烟眼看要倒灌进前厅。

<br><br>
<<getouticon>><<link [[返回后厨 (0:03)|MP Job PubKitchen]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_extra_pubkitchen_2 is 1>>
酒馆后厨的排烟罩铁网今日已疏通归位，蜂蜜烤肋排焦香扑鼻。
<<else>>
<div id="act-mp-job-extra-pubkitchen-2">
<<if ($physique or 10000) gte 11400 or ($athletics or 0) gte 240>><<mpclockworkicon>><<link "拉动联杆 (0:07)">><<pass 7>><<replace "#act-mp-job-extra-pubkitchen-2">>
<<if ($physique or 10000) gte 11400 or ($athletics or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_pubkitchen_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_pubkitchen_2")>><<money 1520>>排烟百叶轰然敞开，油烟瞬间抽净，厨师长切下一大块烤肋排并塞给你奖金。<<else>>排烟百叶轰然敞开，积聚的油烟瞬间被抽离后厨。<</if>><span class="green">你及时拉开排烟罩保住了整炉烤肉。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[继续备菜 (0:04)|MP Job PubKitchen]]>><<pass 4>><</link>>
<<else>>
	热油烟呛得你连咳两声，铁叉柄有些烫手。<span class="red">你裹上湿抹布准备再拉拉杆。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Job Extra PubKitchen 2]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|MP Job PubKitchen]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<<else>><<mpclockworkicon>><<link [[拉动联杆 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "拉动联杆">><<set $mpInsuffReq to "体魄：11400 或 运动等级：<span class='purple'>D</span>">><<pass 7>><</link>><</if>>
<br>
<<if ($science or 0) gte 240 or ($housekeeping or 0) gte 250>><<link "压火通叶 (0:08)">><<pass 8>><<replace "#act-mp-job-extra-pubkitchen-2">>
<<if ($science or 0) gte 240 or ($housekeeping or 0) gte 250>>
	<<set $daily.mpJob3_mp_job_extra_pubkitchen_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_pubkitchen_2_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span>粗盐瞬间压灭窜高的油火，烤肋排色泽金黄诱人，前厅酒客吃得赞不绝口。<<else>>粗盐撒下后窜高的油火当即平息，烤架上的肋排色泽金黄诱人。<</if>><<skulduggery 1>><span class="green">你用粗盐控火之法完美稳住了烤炉。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[查看备料单 (0:04)|MP Job PubKitchen Progress]]>><<pass 4>><</link>>
<<else>>
	炭火热浪扑面，熏得你额角冒出一层细汗。<span class="red">你侧身避开火苗准备重撒粗盐。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Job Extra PubKitchen 2]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|MP Job PubKitchen]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<<else>><<link [[压火通叶 (0:08)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "压火通叶">><<set $mpInsuffReq to "科学等级：<span class='purple'>D</span> 或 家政等级：<span class='purple'>D</span>">><<pass 8>><</link>><</if>>
</div>
<</if>>

:: MP Job Extra Stable 2 [nobr]
<<set $outside to 1>><<set $location to "farm">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "night">>夜风灌进马厩外棚，<<elseif Weather.precipitation is "rain">>风雨交加的马厩外棚雷声隐隐，<<else>>马厩洗刷区的石板槽旁，<</if>>一匹刚钉好蹄铁的银灰母马被飞进来的野蜂惊扰，前蹄不安地刨着木栏。

<br><br>
<<getouticon>><<link [[返回马厩 (0:03)|MP Job Stable]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_extra_stable_2 is 1>>
那匹银灰母马今日已安然卧在干草垫上嚼着燕麦，马厩一片安宁。
<<else>>
<div id="act-mp-job-extra-stable-2">
<<if ($tending or 0) gte 250 or ($willpower or 0) gte 420>><<mpanimalicon>><<link "喂糖安抚 (0:07)">><<pass 7>><<replace "#act-mp-job-extra-stable-2">>
<<if ($tending or 0) gte 250 or ($willpower or 0) gte 420>>
	<<set $daily.mpJob3_mp_job_extra_stable_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_stable_2")>><<money 1520>>母马嚼着方糖温顺地喷了个响鼻，马夫欣慰地把今日的驯马奖金交给你。<<else>>母马嚼着甜方糖温顺地喷了个响鼻，任由你替它理顺鬃毛。<</if>><span class="green">你温柔安抚住了受惊的银灰母马。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[继续照料 (0:04)|MP Job Stable]]>><<pass 4>><</link>>
<<else>>
	母马甩头时鬃毛扫在你的脸颊上，有些发痒。<span class="red">你退开半步放柔声音再靠近。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Job Extra Stable 2]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|MP Job Stable]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<<else>><<mpanimalicon>><<link [[喂糖安抚 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "喂糖安抚">><<set $mpInsuffReq to "照料等级：<span class='purple'>D</span> 或 意志等级：<span class='blue'>C</span>">><<pass 7>><</link>><</if>>
<br>
<<if ($athletics or 0) gte 240 or ($housekeeping or 0) gte 240>><<link "赶蜂栓木 (0:08)">><<pass 8>><<replace "#act-mp-job-extra-stable-2">>
<<if ($athletics or 0) gte 240 or ($housekeeping or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_stable_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_stable_2_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span>野蜂被驱出棚外，横木稳稳落槽，母马很快安静下来低头饮水。<<else>>受惊的野蜂被驱出马棚，隔栏横木稳稳落槽，母马低头安静饮水。<</if>><<skulduggery 1>><span class="green">你果断驱蜂落栓平息了马厩骚动。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[登记草料账 (0:04)|MP Job Stable Progress]]>><<pass 4>><</link>>
<<else>>
	横木插销略涩，推入时磨红了手腕。<span class="red">你抬高横木前端准备重新推栓。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Job Extra Stable 2]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|MP Job Stable]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<<else>><<link [[赶蜂栓木 (0:08)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "赶蜂栓木">><<set $mpInsuffReq to "运动等级：<span class='purple'>D</span> 或 家政等级：<span class='purple'>D</span>">><<pass 8>><</link>><</if>>
</div>
<</if>>

:: MP Job Extra Trawler 2 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "dawn" or Weather.precipitation is "rain">>海雾弥漫的近海拖网船甲板上，<<else>>起网作业中的拖网船后甲板上，<</if>>主吊杆滑轮组被一团墨绿海带缠死，装满鲜鱼的网兜悬在半空摇晃。

<br><br>
<<getouticon>><<link [[返回甲板 (0:03)|MP Job Trawler]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_extra_trawler_2 is 1>>
拖网船主吊杆的滑轮组今日已清理干净，满舱渔获顺利卸入冰舱。
<<else>>
<div id="act-mp-job-extra-trawler-2">
<<if ($athletics or 0) gte 250 or ($swimmingskill or 0) gte 240>><<mpclimbicon>><<link "攀杆割海带 (0:07)">><<pass 7>><<replace "#act-mp-job-extra-trawler-2">>
<<if ($athletics or 0) gte 250 or ($swimmingskill or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_trawler_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_trawler_2")>><<money 1520>>缠死的海带应声脱落，网兜平稳降落甲板，老船长重重拍着你的肩发了奖金。<<else>>缠死的巨藻应声切断脱落，沉重的网兜平稳降落在甲板上。<</if>><span class="green">你攀上吊杆干净利落地解除了险情。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[继续值班 (0:04)|MP Job Trawler]]>><<pass 4>><</link>>
<<else>>
	船身随海浪晃动，安全绳勒得腰侧微酸。<span class="red">你扣紧铁环稳住重心准备再割。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Job Extra Trawler 2]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|MP Job Trawler]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<<else>><<mpclimbicon>><<link [[攀杆割海带 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "攀杆割海带">><<set $mpInsuffReq to "运动等级：<span class='purple'>D</span> 或 游泳等级：<span class='purple'>D</span>">><<pass 7>><</link>><</if>>
<br>
<<if ($science or 0) gte 250 or ($skulduggery or 0) gte 240>><<link "反拉绞盘 (0:08)">><<pass 8>><<replace "#act-mp-job-extra-trawler-2">>
<<if ($science or 0) gte 250 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_trawler_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_trawler_2_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span>滑轮倒转半圈便将海带整团吐出，你站在甲板上便安全降下了渔网。<<else>>滑轮倒转半圈便将海带整团吐出，渔网顺畅地收回了船舷内。<</if>><<skulduggery 1>><span class="green">你巧控副绞盘兵不血刃地排除了故障。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[核对今日网获 (0:04)|MP Job Trawler Progress]]>><<pass 4>><</link>>
<<else>>
	副绞盘钢索沾着鱼腥水，摇柄滑了一下。<span class="red">你撒把防滑木糠准备再摇绞盘。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Job Extra Trawler 2]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|MP Job Trawler]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<<else>><<link [[反拉绞盘 (0:08)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "反拉绞盘">><<set $mpInsuffReq to "科学等级：<span class='purple'>D</span> 或 诡术等级：<span class='purple'>D</span>">><<pass 8>><</link>><</if>>
</div>
<</if>>

:: MP Job Partner Cafe 3 [nobr]
<<set $outside to 0>><<set $location to "cafe">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "dusk" or Time.dayState is "night">>海风咖啡馆晚间打烊前，<<else>>午后茶歇收尾的海风咖啡馆里，<</if>>同班侍应生正忙着将新到的锡兰红茶饼掰开分装进防潮锡罐，请你搭手一起挑出整叶茶尖。

<br><br>
<<getouticon>><<link [[返回咖啡馆 (0:03)|MP Job Cafe]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_partner_cafe_3 is 1>>
新到的锡兰红茶今日已全部挑拣入罐，茶香在吧台后久久不散。
<<else>>
<div id="act-mp-job-partner-cafe-3">
<<if ($tending or 0) gte 240 or ($skulduggery or 0) gte 240>><<mpdrinkicon>><<link "竹针撬茶 (0:07)">><<pass 7>><<replace "#act-mp-job-partner-cafe-3">>
<<if ($tending or 0) gte 240 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_partner_cafe_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_partner_cafe_3")>><<money 1520>>茶饼整片剥离而毫无碎末，侍应生开心地与你平分了格威岚发下的分装奖金。<<else>>整片茶饼顺着纹理完整剥离，半点碎末都未落进锡罐。<</if>><span class="green">你与搭档默契配合分装好了上等红茶。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[继续当班 (0:04)|MP Job Cafe]]>><<pass 4>><</link>>
<<else>>
	茶饼压得颇紧，竹茶针尖滑了一下。<span class="red">你换个切入点准备重新下针。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Job Partner Cafe 3]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|MP Job Cafe]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<<else>><<mpdrinkicon>><<link [[竹针撬茶 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "竹针撬茶">><<set $mpInsuffReq to "照料等级：<span class='purple'>D</span> 或 诡术等级：<span class='purple'>D</span>">><<pass 7>><</link>><</if>>
<br>
<<if ($housekeeping or 0) gte 240 or ($science or 0) gte 240>><<link "筛茶封纸 (0:08)">><<pass 8>><<replace "#act-mp-job-partner-cafe-3">>
<<if ($housekeeping or 0) gte 240 or ($science or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_partner_cafe_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_partner_cafe_3_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span>筛出的金毫茶尖匀称透亮，每一罐都封得严严实实，赢来额外工钱。<<else>>筛出的金毫茶尖匀称透亮，每一只小锡罐都封得严丝合缝。<</if>><<skulduggery 1>><span class="green">细致筛茶与封罐让整批茶叶品相极佳。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[请教冲泡诀窍 (0:04)|MP Job Cafe Upgrade]]>><<pass 4>><</link>>
<<else>>
	细茶末飘起，惹得你鼻尖微微发痒。<span class="red">你放轻筛动幅度准备再试。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Job Partner Cafe 3]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|MP Job Cafe]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<<else>><<link [[筛茶封纸 (0:08)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "筛茶封纸">><<set $mpInsuffReq to "家政等级：<span class='purple'>D</span> 或 科学等级：<span class='purple'>D</span>">><<pass 8>><</link>><</if>>
</div>
<</if>>

:: MP Job Partner Fish 3 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "morning" or Time.dayState is "dawn">>清晨早市最热闹的鱼档前，<<else>>栈桥鱼档装车发货的间隙里，<</if>>邻摊老渔工推来一桶刚捕上的活海鳗，请你帮忙一起按斤两称重装入充氧木桶。

<br><br>
<<getouticon>><<link [[返回鱼档 (0:03)|MP Job Fish]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_partner_fish_3 is 1>>
那桶活海鳗今日已全部称重装车完毕，酒楼采买满意地签了单。
<<else>>
<div id="act-mp-job-partner-fish-3">
<<if ($athletics or 0) gte 250 or ($physique or 10000) gte 11300>><<mpfishicon>><<link "抓活海鳗 (0:07)">><<pass 7>><<replace "#act-mp-job-partner-fish-3">>
<<if ($athletics or 0) gte 250 or ($physique or 10000) gte 11300>>
	<<set $daily.mpJob3_mp_job_partner_fish_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_partner_fish_3")>><<money 1520>>滑溜的海鳗在你手中服服帖帖地入桶过秤，老渔工爽快地分了你一份辛苦钱。<<else>>滑溜的海鳗在你手中服服帖帖地入桶过秤，水花都未溅出半分。<</if>><span class="green">你眼疾手快帮老渔工完成了活鳗过秤。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[继续过秤 (0:04)|MP Job Fish]]>><<pass 4>><</link>>
<<else>>
	海鳗猛地甩尾，溅了你一脸咸腥水花。<span class="red">你擦去脸上水珠捏稳鳗鱼七寸。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[垫上干布重起卡扣 (0:04)|MP Job Partner Fish 3]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|MP Job Fish]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
