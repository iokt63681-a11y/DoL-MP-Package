/* DoL-MP v1.2.0-dev9: mp-job-seasonal-and-failures-3.twee (20 passages: 12 Job Extra 2 + 8 Job Partner 3) */

:: MP Job Extra Cafe 2 [nobr]
<<set $outside to 0>><<set $location to "cafe">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Weather.precipitation is "rain">>窗外冷雨淅沥，海风咖啡馆里挤满避雨客人，<<else>>午后茶点高峰期的海风咖啡馆内，<</if>>一只装满热焦糖浆的玻璃壶底座突然出现裂纹，甜腻糖浆正往木吧台边缘渗流。

<br><br>
<<getouticon>><<link [[返回咖啡馆吧台 (0:03)|MP Job Cafe]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_extra_cafe_2 is 1>>
咖啡馆吧台上的焦糖浆已换入新瓷罐，台面擦拭得清爽光洁。
<<else>>
<div id="act-mp-job-extra-cafe-2">
<<tendingicon>><<link "端起温水盆接住渗漏糖浆 (0:07)">><<pass 7>><<replace "#act-mp-job-extra-cafe-2">>
<<if ($housekeeping or 0) gte 250 or ($tending or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_cafe_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_cafe_2")>><<money 1520>>你迅速用温水盆托住裂壶并将糖浆转入备用瓷罐，格威岚在吧台后冲你赞许颔首。<<else>>你用温水盆稳稳托住裂壶并将残余焦糖浆转入备用瓷罐，吧台擦得一尘不染。<</if>><span class="green">你及时保住了整罐焦糖浆与吧台整洁。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[擦净吧台继续当班 (0:04)|MP Job Cafe]]>><<pass 4>><</link>>
<<else>>
	温热糖浆粘在手指上，烫得你指尖微红。<span class="red">你先用冷水冲净手指糖渍。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[擦干指尖糖渍再试 (0:04)|MP Job Extra Cafe 2]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回咖啡馆吧台歇息 (0:03)|MP Job Cafe]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "用厚餐巾裹壶分装热糖浆 (0:08)">><<pass 8>><<replace "#act-mp-job-extra-cafe-2">>
<<if ($athletics or 0) gte 250 or ($science or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_cafe_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_cafe_2_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>几只小奶盅刚好盛满焦糖，还顺手送上了客人的松饼桌，赢来一笔熟客赞许信物。<<else>>几只小奶盅分装得匀净利落，端上松饼桌时焦糖甜香四溢。<</if>><<skulduggery 1>><span class="green">急中生智的分装赢得了满堂称赞。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[核对今日咖啡馆账目 (0:04)|MP Job Cafe Upgrade]]>><<pass 4>><</link>>
<<else>>
	餐巾边角沾了糖浆，拉扯时差点带翻汤匙。<span class="red">你扶稳汤匙准备换块干布再分装。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[折厚餐巾重新分装 (0:04)|MP Job Extra Cafe 2]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回咖啡馆吧台定神 (0:03)|MP Job Cafe]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Job Extra Fish 2 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.season is "winter" or Weather.isFreezing>>寒潮来袭的鱼档结了一层薄霜，<<else>>早市卸货高峰期的栈桥鱼档上，<</if>>碎冰机齿轮被一块硬冰卡死，刚上岸的一批鲜银鲳急需铺冰保鲜。

<br><br>
<<getouticon>><<link [[返回栈桥鱼档 (0:03)|MP Job Fish]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_extra_fish_2 is 1>>
鱼档碎冰机的齿轮今日已疏通完毕，细碎冰花均匀覆在银鲳上。
<<else>>
<div id="act-mp-job-extra-fish-2">
<<tendingicon>><<link "用铁冰锥凿碎卡齿的硬冰块 (0:07)">><<pass 7>><<replace "#act-mp-job-extra-fish-2">>
<<if ($physique or 10000) gte 11400 or ($athletics or 0) gte 250>>
	<<set $daily.mpJob3_mp_job_extra_fish_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_fish_2")>><<money 1520>>硬冰应声碎裂，碎冰机轰鸣着吐出雪白冰花，老渔工分给你几枚鲜鱼提成。<<else>>碎冰机轰鸣着吐出雪白冰花，你将新到的鲜鱼一层层铺得匀称整齐。<</if>><span class="green">你利落凿通碎冰机保住了整批银鲳。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好冰铲继续忙活 (0:04)|MP Job Fish]]>><<pass 4>><</link>>
<<else>>
	飞溅的冰碴擦过手背，冻得皮肤生疼。<span class="red">你戴好厚棉手套准备再凿。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[握紧铁冰锥再凿一次 (0:04)|MP Job Extra Fish 2]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回栈桥鱼档歇息 (0:03)|MP Job Fish]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "淋上温盐水化冰再摇手柄 (0:08)">><<pass 8>><<replace "#act-mp-job-extra-fish-2">>
<<if ($science or 0) gte 240 or ($housekeeping or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_fish_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_fish_2_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>盐水迅速融开卡死处，齿轮顺滑转动起来，银鲳及时铺满了碎冰。<<else>>温盐水迅速化开滚筒余霜，齿轮顺滑转动，碎冰很快铺满木槽。<</if>><<skulduggery 1>><span class="green">你用温盐水巧解了碎冰机卡阻。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[查看鱼档今日进账 (0:04)|MP Job Fish Upgrade]]>><<pass 4>><</link>>
<<else>>
	盐水浇偏了半寸，手柄依然沉重难摇。<span class="red">你对准主齿缝隙准备再淋一次。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[添一勺温盐水再摇 (0:04)|MP Job Extra Fish 2]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回栈桥鱼档定神 (0:03)|MP Job Fish]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Job Extra Spa 2 [nobr]
<<set $outside to 0>><<set $location to "spa">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "dusk" or Time.dayState is "night">>晚间客流高峰的温泉馆里水雾缭绕，<<else>>午后满客的温泉理疗馆内，<</if>>二号药浴池的进水铜滤网被草药碎叶堵住，水位眼看降了一截。

<br><br>
<<getouticon>><<link [[返回温泉前厅 (0:03)|MP Job Spa]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_extra_spa_2 is 1>>
温泉馆二号药浴池的铜滤网今日已清理通畅，温热泉水汩汩注入。
<<else>>
<div id="act-mp-job-extra-spa-2">
<<tendingicon>><<link "用长柄竹夹掏净滤网草药渣 (0:07)">><<pass 7>><<replace "#act-mp-job-extra-spa-2">>
<<if ($housekeeping or 0) gte 250 or ($tending or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_spa_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_spa_2")>><<money 1520>>草药渣清理一空，温热泉水重新欢快涌入，乔丹温和地向你道谢并记下奖金。<<else>>铜滤网里的药渣被清理一空，温热泉水重新欢快涌入浴池。<</if>><span class="green">你在不惊扰客人的情况下疏通了药浴池。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[理好毛巾继续值守 (0:04)|MP Job Spa]]>><<pass 4>><</link>>
<<else>>
	滚烫泉水溅上手腕，熏得你皮肤泛红。<span class="red">你浸入冷水盆凉了凉手腕。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[挽高袖口重新清理 (0:04)|MP Job Extra Spa 2]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回温泉前厅歇息 (0:03)|MP Job Spa]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "旋开旁路水阀再拆洗滤网 (0:08)">><<pass 8>><<replace "#act-mp-job-extra-spa-2">>
<<if ($science or 0) gte 250 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_spa_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_spa_2_alt")>><<set $mpHerbsCollected to ($mpHerbsCollected or 0) + 1>>备用进水阀稳住了池水温度，你从容拆下主滤网刷得干干净净。<<else>>备用进水阀稳住了池水温度，主滤网被你刷洗得透亮干净。<</if>><<skulduggery 1>><span class="green">双路切换让药浴池水温分毫未降。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[登记温泉池巡检表 (0:04)|MP Job Spa Upgrade]]>><<pass 4>><</link>>
<<else>>
	备用铜阀旋钮滑腻，拧动时脱了一下手。<span class="red">你裹上干毛巾准备重新旋阀。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[拧松旁路阀重新拆洗 (0:04)|MP Job Extra Spa 2]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回温泉前厅定神 (0:03)|MP Job Spa]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Job Extra Farm 2 [nobr]
<<set $outside to 1>><<set $location to "farm">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Weather.precipitation is "rain">>冷雨把农场果园的泥路泡得泥泞不堪，<<else>>丰收季忙碌的农场果园小径上，<</if>>一辆装满红苹果的独轮车陷进泥坑，木轮眼看要压断果园灌溉竹管。

<br><br>
<<getouticon>><<link [[返回农场打谷场 (0:03)|MP Job Farm]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_extra_farm_2 is 1>>
果园小径上的苹果独轮车今日已推入谷仓，灌溉竹管完好无损。
<<else>>
<div id="act-mp-job-extra-farm-2">
<<tendingicon>><<link "托住车尾抬出木轮 (0:07)">><<pass 7>><<replace "#act-mp-job-extra-farm-2">>
<<if ($physique or 10000) gte 11500 or ($athletics or 0) gte 250>>
	<<set $daily.mpJob3_mp_job_extra_farm_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_farm_2")>><<money 1520>>你一鼓作气将独轮车抬上干路，亚历克斯递给你一条干毛巾与额外工钱。<<else>>你双手发力将独轮车稳稳抬上干爽路面，车斗里的红苹果纹丝未乱。<</if>><span class="green">你凭扎实力气保住了果车与灌溉管。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[拍净草屑继续干活 (0:04)|MP Job Farm]]>><<pass 4>><</link>>
<<else>>
	泥水飞溅到裤腿上，车把震得掌心发麻。<span class="red">你站稳脚跟准备再使一把劲。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[垫稳脚下泥土再抬 (0:04)|MP Job Extra Farm 2]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回农场打谷场歇息 (0:03)|MP Job Farm]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "在轮下垫入宽木板推过渠 (0:08)">><<pass 8>><<replace "#act-mp-job-extra-farm-2">>
<<if ($tending or 0) gte 250 or ($science or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_farm_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_farm_2_alt")>><<set $mpHerbsCollected to ($mpHerbsCollected or 0) + 1>>独轮车顺着木板桥稳稳碾过竹管上方，连一颗苹果都没滚落。<<else>>独轮车顺着厚木板桥平稳碾过竹管上方，顺利抵达果库廊檐。<</if>><<skulduggery 1>><span class="green">你搭设木板斜坡巧妙护住了灌溉竹管。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[清点谷仓今日交接单 (0:04)|MP Job Farm Upgrade]]>><<pass 4>><</link>>
<<else>>
	木板底面沾泥滑了一下，没能一下垫正。<span class="red">你在木板下撒把干草准备重垫。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[把宽木板塞实再推 (0:04)|MP Job Extra Farm 2]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回农场打谷场定神 (0:03)|MP Job Farm]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Job Extra Clock 2 [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "dusk">>傍晚湿冷的空气渗入钟表铺，<<elseif Weather.precipitation is "rain">>冷雨裹着湿气渗入钟表铺，<<else>>钟表铺安静的修缮工作台前，<</if>>一位老船长送修的航海秒表游丝粘在了一起，急等半小时后带回港务局校验。

<br><br>
<<getouticon>><<link [[返回钟表铺前厅 (0:03)|MP Job Clock]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_extra_clock_2 is 1>>
那只航海秒表的游丝今日已彻底分离校准，已被老船长满意取走。
<<else>>
<div id="act-mp-job-extra-clock-2">
<<investigateicon>><<link "用脱脂棉签蘸酒精洗去油膜 (0:07)">><<pass 7>><<replace "#act-mp-job-extra-clock-2">>
<<if ($science or 0) gte 250 or ($tending or 0) gte 250>>
	<<set $daily.mpJob3_mp_job_extra_clock_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_clock_2")>><<money 1520>>粘连的蓝钢游丝立刻恢复轻盈弹跳，塞拉笑着将老船长留下的加急费交给你。<<else>>脱脂棉签吸净残油后，蓝钢游丝立刻恢复了轻盈均匀的弹跳。<</if>><span class="green">你精准去除了游丝油膜恢复走时。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收妥镊子继续修表 (0:04)|MP Job Clock]]>><<pass 4>><</link>>
<<else>>
	棉签纤维挂住了游丝外圈，吓得你忙屏住呼吸。<span class="red">你用细镊轻轻取下棉丝。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[稳住手腕重新擦洗 (0:04)|MP Job Extra Clock 2]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回钟表铺前厅歇息 (0:03)|MP Job Clock]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "用消磁铜镊顺着弧度拨开 (0:08)">><<pass 8>><<replace "#act-mp-job-extra-clock-2">>
<<if ($skulduggery or 0) gte 260 or ($housekeeping or 0) gte 240>>
	<<set $daily.mpJob3_mp_job_extra_clock_2 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job3_rew_mp_job_extra_clock_2_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>游丝圈距重归均匀，秒表发出清脆悦耳的滴答声，老船长连声道谢。<<else>>游丝圈距拨得匀称分明，航海秒表发出清脆稳定的滴答声。<</if>><<skulduggery 1>><span class="green">你凭极稳的指尖功夫理顺了游丝。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[翻看钟表铺修缮簿 (0:04)|MP Job Clock Upgrade]]>><<pass 4>><</link>>
<<else>>
	高倍放大镜看久了眼眶发酸，手腕微微一晃。<span class="red">你闭眼歇了三秒准备重新下镊。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[对准游丝弧度再拨 (0:04)|MP Job Extra Clock 2]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回钟表铺前厅定神 (0:03)|MP Job Clock]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Job Extra Laundry 2 [nobr]
<<set $outside to 0>><<set $location to "orphanage">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.season is "winter" or Weather.precipitation is "rain">>阴冷潮湿的孤儿院洗衣房里，<<else>>热气腾腾的孤儿院洗衣房内，<</if>>烘干炉的排湿风道被绒毛团堵住，满屋水汽排不出去，新洗的毛毯眼看要闷出霉味。

<br><br>
<<getouticon>><<link [[返回洗衣房工位 (0:03)|MP Job Laundry]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpJob3_mp_job_extra_laundry_2 is 1>>
孤儿院洗衣房的排湿风道今日已清理通畅，烘干的毛毯蓬松温暖。
<<else>>
<div id="act-mp-job-extra-laundry-2">
<<tendingicon>><<link "用长柄藤刷卷出绒毛 (0:07)">><<pass 7>><<replace "#act-mp-job-extra-laundry-2">>
<<if ($housekeeping or 0) gte 250 or ($athletics or 0) gte 240>>
