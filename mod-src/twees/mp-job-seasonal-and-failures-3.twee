	<<walkicon>><<link [[擦净手心重新上手 (0:04)|MP Job Extra Spa 2]]>><<pass 4>><</link>>
	<br>
	<<link [[先回岗位歇口气 (0:03)|MP Job Spa]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "旋开旁路水阀再拆洗滤网 (0:08)">><<pass 8>><<replace "#act-mp-job-extra-spa-2">>
<<if ($science or 0) gte 250 or ($skulduggery or 0) gte 240>>
