<<investigateicon>><<link "稳住心神 (0:05)">><<pass 5>><<replace "#act-mp-festival-tide-5">>
<<set _first to true>>
<<if window.dolmp && window.dolmp.claimUniqueReward>><<set _first to window.dolmp.claimUniqueReward("festival_tide_5")>><</if>>
<<if ($willpower or 0) gte 260>>
	你迎着咸湿的夜风把自己的木牌放入水中，看着烛火顺流远去，胸中的郁结与疲惫随之消散，连老船工塞给你的压船红包都沉甸甸的。<<if _first>><<money 400>><</if>><<stress -4>>
	<br><br>
	<<walkicon>><<link [[返回水牌 (0:02)|MP Town Festivals 2 Hub]]>><<pass 2>><</link>>
<<else>>
	夜里的海风吹得你打了个寒噤，你裹紧外套喝光了杯里的热姜茶，听着潮声缓了半晌才找回力气。<<stress -1>><<tiredness 2>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Festival Tide 5]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
</div>
/* ==================== 4. 学园开学祭 (Term) ==================== */

:: MP Festival Term 1 [nobr]
<<set $outside to 0>><<set $location to "school">><<effects>><<mpAmbient>>
<<set $mpFestivalClues to ($mpFestivalClues or {})>>
新学期开学祭的清晨，学校主走廊两侧摆满了各社团的招新木架与历年校史画框。
走廊尽头的储物柜后散落着印错门牌的传单与一叠裁纸边角，悉尼正守在转角的文具摊旁焦急核对。
<br><br>
<<getouticon>><<link [[返回学校 (0:02)|Hallways]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
