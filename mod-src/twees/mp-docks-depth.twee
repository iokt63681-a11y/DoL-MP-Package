		<<set $mpDocksEvOk to 1>>
		<<set $mpDockTimber to ($mpDockTimber or 0) + 1>>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("docks_ev6_orphan_seabox_v39")>>
			<<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>
			<<money 500>>
		<</if>>
		<<stress -5>><<tiredness 2>>
	<<else>>
		<<set $mpDocksEvOk to 0>><<stress 4>><<tiredness 3>>
	<</if>>
<</link>>
<br>
<<sneakicon>><<link [[制造响动引工 (0:16)|MP Deep Docks Event Resolve]]>><<pass 16>>
	<<set $mpDocksEvId to 6>>
	<<if ($skulduggery or 0) gte 220 or ($athletics or 0) gte 220>>
