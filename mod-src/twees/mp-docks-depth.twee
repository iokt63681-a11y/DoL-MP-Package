	<<if ($science or 0) gte 230 or ($skulduggery or 0) gte 230 or ($mpJobFishExp or 0) gte 4>>
		<<set $mpDocksEvOk to 1>><<money 620>><<set $mpDockTimber to ($mpDockTimber or 0) + 1>><<stress -4>><<tiredness 2>>
	<<else>>
		<<set $mpDocksEvOk to 0>><<pain 4>><<stress 6>><<tiredness 3>>
	<</if>>
<</link>>
