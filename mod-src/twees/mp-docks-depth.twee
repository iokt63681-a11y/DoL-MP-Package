		<<set $mpDocksEvOk to 1>><<money 550>><<set $mpLanternOil to ($mpLanternOil or 0) + 1>><<stress -3>><<tiredness 3>>
	<<else>>
		<<set $mpDocksEvOk to 0>><<pain 5>><<stress 6>><<tiredness 4>>
	<</if>>
<</link>>
<br>
