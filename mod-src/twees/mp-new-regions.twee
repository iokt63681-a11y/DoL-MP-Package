<<if $skulduggerysuccess is 1>>
	<<if currentSkillValue("skulduggery") gte 600 and window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("region_unique_MP_Region_Clockwork_Vault")>>
		底板咔哒弹起，你取出未公开的市政厅古物和半枚王冠齿轮残片；夹层信封里还有一张约 £5 的不记名银票。
		<<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>
		<<if ($mpFragCrownGear or 0) lt 3>><<set $mpFragCrownGear to ($mpFragCrownGear or 0) + 1>><</if>>
		<<money 500>>
		<<stress -3>>
	<<else>>
		<<if !$daily>><<set $daily to {}>><</if>>
		<<if !$daily.mpRegionLoot_clockwork_vault>>
			<<set $daily.mpRegionLoot_clockwork_vault to 1>>
			你从差分机摇柄旁的铁盒里摸出两张早年兑付券和一枚旧银币，券面盖着市政厅的褪色印章。<span class="green">你把找到的物件妥善收好。</span>
			<<stress -2>>
		<<else>>
			<span class="teal">差分机旁的铁盒今日已被你查过，只余下几截空白纸带。</span>
			<<stress -1>>
		<</if>>
	<</if>>
<<else>>
	双层底板的防盗弹簧回弹夹住指尖，密库顶部的警报铜铃轻响一声。你连忙抽手退到门边。
	<<stress 5>><<pain 3>>
<</if>>
<</replace>><</link>>
<br>
<<link "摇差分机手柄 (0:08)">><<pass 8>><<replace "#clockwork-vault-choices">>
<<if $maths gte 300 or $science gte 280>>
	差分机咔嗒吐出一截纸带，上面打着一组柜号和一个人名，末尾还标着“未归档”。
	<<stress -1>>
<<else>>
	手柄摇到一半便卡死，纸带只吐出半行乱码。
	<<tiredness 2>><<stress 3>>
<</if>>
<</replace>><</link>>
</div>

