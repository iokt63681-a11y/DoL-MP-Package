<<if $mpKeepsake and $mpKeepsake["keepsake_glasshouse_amber"]>><br><<keepsakeicon>><<link [[对准温室古琥珀折光 (0:04)|MP Keepsake Use Amber]]>><<pass 4>><</link>><</if>>

