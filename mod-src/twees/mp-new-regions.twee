<<walkicon>><<link [[返回断桅沉船滩 (0:02)|MP Region Foghorn Wreck]]>><<pass 2>><</link>>
<br>
<div id="foghorn-wreck-choices">
<<investigateicon>><<link "撬开肋木锡盒 (0:12)">><<pass 12>><<replace "#foghorn-wreck-choices">>
<<set $skulduggerydifficulty to 380>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
	<<set $mpKnown["foghorn_echo"] to 1>>
