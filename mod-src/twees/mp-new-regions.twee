/* 八大全新可探索地区 / 互通场景节点与场景池路由 / V4 检定与发现门控规范 */

:: MP Region Pool Router [nobr]
<<set $outside to 0>><<set $location to "underground">><<effects>>
<<set $mpSeenScenes to ($mpSeenScenes or {})>>
<<set _reg to ($mpCurrentRegion or "Foghorn")>>
<<set _ret to ($mpReturnPassage or "")>>
<<if _ret.includes("Clockwork")>><<set _reg to "Clockwork">>
<<elseif _ret.includes("Abbey")>><<set _reg to "Abbey">>
<<elseif _ret.includes("Glasshouse")>><<set _reg to "Glasshouse">>
<<elseif _ret.includes("Blackiron")>><<set _reg to "Blackiron">>
<<elseif _ret.includes("Druid")>><<set _reg to "Druid">>
<<elseif _ret.includes("Velvet")>><<set _reg to "Velvet">>
<<elseif _ret.includes("Observatory")>><<set _reg to "Observatory">>
<<elseif _ret.includes("Foghorn")>><<set _reg to "Foghorn">><</if>>
<<switch _reg>>
<<case "Foghorn">>
	<<set _regionScenes to ["MP Region Foghorn CompassBox", "MP Region Foghorn SmugglerRope", "MP Region Foghorn OneEyedGull", "MP Region Foghorn SignalBarrel", "MP Region Foghorn WhaleOilCan", "MP Region Foghorn StormBarometer", "MP Region Foghorn SailorTrunk", "MP Region Foghorn CharredLogbook", "MP Region Foghorn FigureheadGem", "MP Region Foghorn CrossedMasts", "MP Region Foghorn BilgeFlask", "MP Region Foghorn GiltSextant", "MP Region Foghorn SaltStalactite", "MP Region Foghorn BlackMotherPearl", "MP Region Foghorn TideNicheChain", "MP Region Foghorn FoghornReedWrap", "MP Region Foghorn CrabPotCigarBox", "MP Region Foghorn OiledCoatPocket", "MP Region Foghorn SaltJarSeaChart", "MP Region Foghorn LoftRungChain", "MP Region Foghorn CaptainDoorWallet", "MP Region Foghorn RustedCannonTube", "MP Region Foghorn DivingHelmetGlint", "MP Region Foghorn SpiralWaveGroove", "MP Region Foghorn ObsidianSeaChess", "MP Region Foghorn StarfishBronzeKey"]>>
<<case "Clockwork">>
	<<set _regionScenes to ["MP Region Clockwork MainEscapement", "MP Region Clockwork BrassSpeakTube", "MP Region Clockwork GasLampWeight", "MP Region Clockwork RubyBearing", "MP Region Clockwork BoilerRedline", "MP Region Clockwork SteamHammock", "MP Region Clockwork CondenserLeadBox", "MP Region Clockwork SpiralStepChain", "MP Region Clockwork TiltedArmillary", "MP Region Clockwork CrystalLensBench", "MP Region Clockwork ScorpioPearl", "MP Region Clockwork GrandfatherDraft", "MP Region Clockwork BlastDoorFiles", "MP Region Clockwork DifferenceEngine", "MP Region Clockwork VentCipherTube", "MP Region Clockwork DryOilCupKey", "MP Region Clockwork PulleyMeshBasket", "MP Region Clockwork CoolingTowerTube", "MP Region Clockwork BrokenGaugeTin", "MP Region Clockwork QuartzSandSundial", "MP Region Clockwork CometChartWax", "MP Region Clockwork HalfOpenSafe12", "MP Region Clockwork LampshadeMicrofilm", "MP Region Clockwork DatedLeadSealBox"]>>
<<case "Abbey">>
	<<set _regionScenes to ["MP Region Abbey MossyGargoyleRing", "MP Region Abbey HeadlessMonkBowl", "MP Region Abbey RedThreadBells", "MP Region Abbey WalnutLetterKnife", "MP Region Abbey PrayerBenchSilk", "MP Region Abbey FrescoWhisperPassage", "MP Region Abbey OctagonPitchDisc", "MP Region Abbey SilverPsalter", "MP Region Abbey CollapsedShelfCoffer", "MP Region Abbey FluoriteRailLamp", "MP Region Abbey BrickedHearthStone", "MP Region Abbey HornLanternSkiff", "MP Region Abbey SubmergedMailbag", "MP Region Abbey SluiceWinchPack", "MP Region Abbey EddyGlassFloat", "MP Region Abbey BrokenWingCoin", "MP Region Abbey HollowBalusterStove", "MP Region Abbey ObsidianRosarySlot", "MP Region Abbey SoothingDewVial", "MP Region Abbey BookpressParchment", "MP Region Abbey StoneLanternRoll", "MP Region Abbey RotatableCandelabra", "MP Region Abbey MyrrhBadgeCase"]>>
<<case "Glasshouse">>
	<<set _regionScenes to ["MP Region Glasshouse SilverVeinOrchid", "MP Region Glasshouse GiltCagePitcher", "MP Region Glasshouse BreedingDiaryBox", "MP Region Glasshouse TiltedFloraStatue", "MP Region Glasshouse UnsealedAmberJar", "MP Region Glasshouse BinocularPetal", "MP Region Glasshouse WhaleRibCasket", "MP Region Glasshouse EarlGreyTeapot", "MP Region Glasshouse RosemarySpyglass", "MP Region Glasshouse WeathervaneCanvas", "MP Region Glasshouse LooseBungCask", "MP Region Glasshouse AlembicSilverChain", "MP Region Glasshouse UnlabeledGreenBottle", "MP Region Glasshouse GardenerApron", "MP Region Glasshouse NurseryWaterValve", "MP Region Glasshouse SpecimenTagNine", "MP Region Glasshouse FunnelGoldRing", "MP Region Glasshouse TerraceSundialLetter", "MP Region Glasshouse IceCellarBrassCan", "MP Region Glasshouse HygrometerHiddenBox"]>>
<<case "Blackiron">>
	<<set _regionScenes to ["MP Region Blackiron RustedSwitchWatch", "MP Region Blackiron DerailedCoalTarp", "MP Region Blackiron BufferSignalLamp", "MP Region Blackiron BumperOiledPipe", "MP Region Blackiron RifleRackGap", "MP Region Blackiron EscortCotBriefcase", "MP Region Blackiron AxleMeshCrates", "MP Region Blackiron RedClothLever", "MP Region Blackiron WarmTelegraphKey", "MP Region Blackiron ArcSearchlightLatch", "MP Region Blackiron CamphorHerbCart", "MP Region Blackiron SewerSluiceBell", "MP Region Blackiron WetFootprintKeys", "MP Region Blackiron WaterTowerToolbag", "MP Region Blackiron PriedWeaponLocker", "MP Region Blackiron LouverAnchorFlask", "MP Region Blackiron StoppedClockKey", "MP Region Blackiron LeadSealedOakBarrel", "MP Region Blackiron DeadEndFlagTube"]>>
<<case "Druid">>
	<<set _regionScenes to ["MP Region Druid CleftStoneSickle", "MP Region Druid RavenNestChain", "MP Region Druid MistletoePouch", "MP Region Druid StarPointerSlab", "MP Region Druid TwinSilverfloraPool", "MP Region Druid MeadBronzeJue", "MP Region Druid BoneChimeHollow", "MP Region Druid RootFluoriteOrb", "MP Region Druid MossyBronzeShield", "MP Region Druid WhiteFeatherUrn", "MP Region Druid HomingPigeonLoft", "MP Region Druid WolfskinHuntingKnife", "MP Region Druid CrouchingStoneHilt", "MP Region Druid JadeCicadaSpout", "MP Region Druid WaxSealedGourd", "MP Region Druid FirewoodBiscuitTin", "MP Region Druid ShutterEagleWhistle"]>>
<<case "Velvet">>
	<<set _regionScenes to ["MP Region Velvet SilverFoxMaskGlint", "MP Region Velvet CarpetFloorLock", "MP Region Velvet ChampagneCartInvite", "MP Region Velvet SableShawlFan", "MP Region Velvet RotatingDaisBox", "MP Region Velvet MannequinGoldThread", "MP Region Velvet AmethystAtomiser", "MP Region Velvet BalustradeCatalogue", "MP Region Velvet SilverCharcoalBrazier", "MP Region Velvet CliffGateNecktie", "MP Region Velvet VelvetCoveredPodium", "MP Region Velvet VIPBoxAshtrayNote", "MP Region Velvet CupidQuiverFoil", "MP Region Velvet ChaiseCoralPurse", "MP Region Velvet PlanterSilverCase", "MP Region Velvet AbacusWaxLetter", "MP Region Velvet DumbwaiterRosewoodBox", "MP Region Velvet HollowCrystalTassel"]>>
<<case "Observatory">>
	<<set _regionScenes to ["MP Region Observatory EquatorialBookmark", "MP Region Observatory SlideRailSchoolBadge", "MP Region Observatory AstrolabeSealingWax", "MP Region Observatory Tube1894Cap", "MP Region Observatory EclipseMapKey", "MP Region Observatory GlobeEquatorialCrack", "MP Region Observatory MicrofilmStandbyReel", "MP Region Observatory UnlockedAmethystBase", "MP Region Observatory TiltedFossilPlaque", "MP Region Observatory AmberJarSignet", "MP Region Observatory GargoyleTinBox", "MP Region Observatory CeilingHatchCord", "MP Region Observatory CounterweightStarMap", "MP Region Observatory FoghornIndexCard", "MP Region Observatory NautilusVelvetPlug", "MP Region Observatory BottomShelfLeadBox", "MP Region Observatory AnemometerLeatherCase", "MP Region Observatory LooseStepRedRibbon"]>>
<<default>>
	<<set _regionScenes to ["MP Region Foghorn CompassBox", "MP Region Foghorn SmugglerRope", "MP Region Foghorn OneEyedGull", "MP Region Foghorn SignalBarrel", "MP Region Foghorn WhaleOilCan", "MP Region Foghorn StormBarometer", "MP Region Foghorn SailorTrunk", "MP Region Foghorn CharredLogbook", "MP Region Foghorn FigureheadGem", "MP Region Foghorn CrossedMasts", "MP Region Foghorn BilgeFlask", "MP Region Foghorn GiltSextant", "MP Region Foghorn SaltStalactite", "MP Region Foghorn BlackMotherPearl", "MP Region Foghorn TideNicheChain", "MP Region Foghorn FoghornReedWrap", "MP Region Foghorn CrabPotCigarBox", "MP Region Foghorn OiledCoatPocket", "MP Region Foghorn SaltJarSeaChart", "MP Region Foghorn LoftRungChain", "MP Region Foghorn CaptainDoorWallet", "MP Region Foghorn RustedCannonTube", "MP Region Foghorn DivingHelmetGlint", "MP Region Foghorn SpiralWaveGroove", "MP Region Foghorn ObsidianSeaChess", "MP Region Foghorn StarfishBronzeKey"]>>
<</switch>>
<<set _pool to _regionScenes.filter(function (n) { return !$mpSeenScenes[n]; })>>
<<if _pool.length is 0>>
	<<set _pool to _regionScenes>>
	<<run _regionScenes.forEach(function (n) { delete V.mpSeenScenes[n]; })>>
<</if>>
<<set _pick to _pool.random()>>
<<set $mpSeenScenes[_pick] to 1>>
<<include _pick>>

:: MP Region Foghorn Island [nobr]
<<set $outside to 1>><<set $location to "sea">><<effects>>
<<set $mpKnown to ($mpKnown or {})>><<set $mpKnown["foghorn_pier"] to 1>>
海雾在孤悬外海的黑色礁岛四周翻涌，高耸的雾角灯塔立在岩崖顶上。潮水拍打着岛屿南侧的系船石阶，咸涩的浪沫随风扑面而来。
<<if $willpower gte 450 or $athletics gte 250>>你稳住呼吸踩实湿滑的礁盘，在浓雾里辨清了近处的方向。<<else>>湿冷的狂风吹得你步履微晃，视线被浓雾遮去了大半。<</if>>
<br><br>
<<if $mpKnown["foghorn_pier"]>>
	<<walkicon>><<link [[前往雾角栈桥 (0:06)|MP Region Foghorn Pier]]>><<pass 6>><</link>>
	<br>
<</if>>
<<if $mpKnown["foghorn_keeper"]>>
	<<walkicon>><<link [[前往守塔人旧居 (0:08)|MP Region Foghorn Keeper]]>><<pass 8>><</link>>
	<br>
<</if>>
<<if $mpKnown["foghorn_wreck"]>>
	<<walkicon>><<link [[前往断桅沉船滩 (0:12)|MP Region Foghorn Wreck]]>><<pass 12>><</link>>
	<br>
<</if>>
<<if $mpKnown["foghorn_echo"]>>
	<<walkicon>><<link [[前往海蚀回音廊 (0:09)|MP Region Foghorn Echo]]>><<pass 9>><</link>>
	<br>
<</if>>
<<if !$mpKnown["foghorn_keeper"] or !$mpKnown["foghorn_wreck"] or !$mpKnown["foghorn_echo"]>>
	<<investigateicon>><<link [[留意四周动静 (0:06)|MP Region Foghorn Island Scout]]>><<pass 6>><</link>>
	<br>
	<<socialiseicon>><<link [[向守船老汉打听 (0:05)|MP Region Foghorn Island Ask]]>><<pass 5>><</link>>
	<br>
<</if>>
<<getouticon>><<link [[返回海礁 (0:18)|Sea Rocks]]>><<set $outside to 1>><<set $location to "searocks">><<pass 18>><<set $eventskip to 1>><<endevent>><</link>>

:: MP Region Foghorn Island Scout [nobr]
<<set $outside to 1>><<set $location to "sea">><<effects>>
<<set $mpKnown to ($mpKnown or {})>>
你贴着背风的玄武岩壁放慢脚步，借着灯塔旋转的微光观察崖壁与潮汐的走向。
<<set $skulduggerydifficulty to 300>><<skulduggerycheck>>
<<if $skulduggerysuccess is 1 or $athletics gte 320>>
	<<if !$mpKnown["foghorn_keeper"]>>
		<<set $mpKnown["foghorn_keeper"] to 1>>
		你在岩壁苔藓间发现一排半掩的铁扶手，石阶直通半山腰的守塔人旧居。<<stress -2>>
	<<elseif !$mpKnown["foghorn_wreck"]>>
		<<set $mpKnown["foghorn_wreck"] to 1>>
		你顺着退潮露出的礁脊往东眺望，看清了布满商船肋木的断桅沉船滩。<<stress -2>>
	<<else>>
		<<set $mpKnown["foghorn_echo"] to 1>>
		你循着岩壁深处的低沉风鸣摸索过去，找到了绝壁下方的海蚀回音廊入口。<<stress -2>>
	<</if>>
<<else>>
	浓雾忽然合拢，湿滑的页岩让你脚下一滑，小腿磕在礁石棱角上，只能退回栈道边。<<stress 5>><<pain 2>>
<</if>>
<br><br>
<<walkicon>><<link [[返回雾角灯塔岛 (0:02)|MP Region Foghorn Island]]>><<pass 2>><</link>>

:: MP Region Foghorn Island Ask [nobr]
<<set $outside to 1>><<set $location to "sea">><<effects>>
<<set $mpKnown to ($mpKnown or {})>>
系船石阶旁蹲着一名添煤油的守船老汉，你走上前向他打听岛上的僻静去处。
<<set $seductiondifficulty to 4200>><<seductioncheck>>
<<if $seductionrating gte $seductionrequired or $skulduggery gte 260>>
	<<if !$mpKnown["foghorn_keeper"]>>
		<<set $mpKnown["foghorn_keeper"] to 1>>
		「维斯交代过让我照看生面孔，」老汉抬起烟斗指了指岩壁上方，「顺着那道铁索往上爬，半山腰有间守塔人旧居可以避风。」<<stress -2>>
	<<elseif !$mpKnown["foghorn_wreck"]>>
		<<set $mpKnown["foghorn_wreck"] to 1>>
		「想淘旧货就趁退潮往东走，」老汉压低嗓音提醒道，「礁盘后面那片断桅沉船滩，常有早年商船留下的锡匣。」<<stress -2>>
	<<else>>
		<<set $mpKnown["foghorn_echo"] to 1>>
		「绝壁底下那阵嗡鸣来自海蚀回音廊，」老汉朝南侧努了努嘴，「顺着退潮石槽就能钻进去。」<<stress -2>>
	<</if>>
<<else>>
	「雾大浪急，少往不熟的崖根底下乱跑，」老汉拧紧油壶盖转过身去，让你在冷风里碰了一鼻子灰。<<stress 4>>
<</if>>
<br><br>
<<walkicon>><<link [[返回雾角灯塔岛 (0:02)|MP Region Foghorn Island]]>><<pass 2>><</link>>

:: MP Region Foghorn Pier [nobr]
<<set $outside to 1>><<set $location to "sea">><<effects>>
<<set $mpKnown to ($mpKnown or {})>><<set $mpKnown["foghorn_pier"] to 1>>
青石垒成的古老栈桥延伸入迷雾笼罩的海面，系船柱上缠绕着潮湿的缆绳与墨绿海草。浪涌拍击着桥墩木桩，激起一阵细碎的白色水沫。
<<if $athletics gte 260 or $physique gte 11000>>你踩稳湿滑的青石条，任凭海风吹拂衣角。<<else>>湿滑的青苔让你每迈一步都不得不抓紧系船铁环。<</if>>
<br><br>
<<investigateicon>><<link [[翻找石柱缝隙 (0:10)|MP Region Foghorn Pier Search]]>><<pass 10>><</link>>
<br>
<<bedicon "zzz">><<link [[背风靠坐歇息 (0:10)|MP Region Foghorn Pier Rest]]>><<pass 10>><</link>>
<br>
<<sneakicon>><<link [[搜寻周边奇遇 (0:08)|MP Region Pool Router]]>><<set $mpCurrentRegion to "Foghorn">><<set $mpReturnPassage to "MP Region Foghorn Pier">><<pass 8>><</link>>
<br>
<<if $mpKnown["foghorn_keeper"]>>
	<<walkicon>><<link [[前往守塔人旧居 (0:08)|MP Region Foghorn Keeper]]>><<pass 8>><</link>>
	<br>
<</if>>
<<if $mpKnown["foghorn_wreck"]>>
	<<walkicon>><<link [[前往断桅沉船滩 (0:12)|MP Region Foghorn Wreck]]>><<pass 12>><</link>>
	<br>
<</if>>
<<if $mpKnown["foghorn_echo"]>>
	<<walkicon>><<link [[前往海蚀回音廊 (0:09)|MP Region Foghorn Echo]]>><<pass 9>><</link>>
	<br>
<</if>>
<<getouticon>><<link [[退回岛屿入口 (0:04)|MP Region Foghorn Island]]>><<pass 4>><</link>>

:: MP Region Foghorn Pier Search [nobr]
<<set $outside to 1>><<set $location to "sea">><<effects>>
<<set $mpKnown to ($mpKnown or {})>>
你蹲在栈桥第三根系船石柱旁，伸手探向覆满牡蛎壳的暗槽。
<<set $skulduggerydifficulty to 300>><<skulduggerycheck>>
<<if $skulduggerysuccess is 1>>
	<<set _sk to currentSkillValue("skulduggery")>>
	<<if _sk gte 800>><<set _reward to 750>><<elseif _sk gte 600>><<set _reward to 680>><<elseif _sk gte 400>><<set _reward to 600>><<else>><<set _reward to 520>><</if>>
	<<set $mpKnown["foghorn_keeper"] to 1>>
	<<if _sk gte 600 and window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("region_unique_MP_Region_Foghorn_Pier")>>
		你避开锋利的贝壳撬开黄铜防水匣，取出了船锚徽记、印戒残片与约 £<<print Math.floor(_reward / 100)>> 的旧港银币。
		<<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>
		<<if ($mpFragSmugglerRing or 0) lt 3>><<set $mpFragSmugglerRing to ($mpFragSmugglerRing or 0) + 1>><</if>>
		<<money _reward>><<stress -3>>
	<<else>>
		你顺着麻缆暗结摸索进去，从石槽底层拈出一小袋被海浪冲进来的旧港硬币，掂量着约有 £<<print Math.floor(_reward / 100)>>。
		<<money _reward>><<stress -2>>
	<</if>>
<<else>>
	冰冷的浪头突然漫过栈桥台阶，锋利的牡蛎壳划破了你的指腹。你慌忙缩回手，什么也没能从石缝里捞出来。
	<<stress 5>><<pain 3>>
<</if>>
<br><br>
<<walkicon>><<link [[返回雾角栈桥 (0:02)|MP Region Foghorn Pier]]>><<pass 2>><</link>>

:: MP Region Foghorn Pier Rest [nobr]
<<set $outside to 1>><<set $location to "sea">><<effects>>
你退到栈桥背风侧的青石高阶上坐下，拉紧衣领抵御海面吹来的潮气。
<<if $willpower gte 420 or $physique gte 11500>>
	你随着潮水拍岸的节拍放缓呼吸，冰凉的海风渐渐吹散了额角的燥热。紧绷的肩背松弛下来，四肢恢复了不少力气。
	<<tiredness -4>><<stress -5>>
<<else>>
	咸湿的冷风顺着石缝直往领口里灌，冻得你指尖发麻。你缩在石阶上打了个寒颤，反而觉得更加疲乏。
	<<stress 4>><<tiredness 2>>
<</if>>
<br><br>
<<walkicon>><<link [[返回雾角栈桥 (0:02)|MP Region Foghorn Pier]]>><<pass 2>><</link>>

:: MP Region Foghorn Keeper [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set $mpKnown to ($mpKnown or {})>><<set $mpKnown["foghorn_keeper"] to 1>>
半嵌在岩壁里的守塔人石屋隔绝了外海的风浪，石砌壁炉旁摆放着防风煤油灯与历年的潮汐手札。厚重的橡木窗板合拢着，屋里留着淡淡的松木烟气。
<<if $history gte 260 or $housekeeping gte 240>>你扫了一眼桌上的值班记录，立刻看出了壁炉砖缝里的异样。<<else>>昏暗的石屋陈设简陋，壁炉角落积着一层薄灰。<</if>>
<br><br>
<<investigateicon>><<link [[摸索壁炉活砖 (0:12)|MP Region Foghorn Keeper Search]]>><<pass 12>><</link>>
<br>
<<bedicon "zzz">><<link [[靠在炉边小憩 (0:10)|MP Region Foghorn Keeper Rest]]>><<pass 10>><</link>>
<br>
<<sneakicon>><<link [[搜寻周边奇遇 (0:08)|MP Region Pool Router]]>><<set $mpCurrentRegion to "Foghorn">><<set $mpReturnPassage to "MP Region Foghorn Keeper">><<pass 8>><</link>>
<br>
<<if $mpKnown["foghorn_pier"]>>
	<<walkicon>><<link [[前往雾角栈桥 (0:06)|MP Region Foghorn Pier]]>><<pass 6>><</link>>
	<br>
<</if>>
<<if $mpKnown["foghorn_wreck"]>>
	<<walkicon>><<link [[前往断桅沉船滩 (0:12)|MP Region Foghorn Wreck]]>><<pass 12>><</link>>
	<br>
<</if>>
<<if $mpKnown["foghorn_echo"]>>
	<<walkicon>><<link [[前往海蚀回音廊 (0:09)|MP Region Foghorn Echo]]>><<pass 9>><</link>>
	<br>
<</if>>
<<getouticon>><<link [[退回岛屿入口 (0:04)|MP Region Foghorn Island]]>><<pass 4>><</link>>

:: MP Region Foghorn Keeper Search [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set $mpKnown to ($mpKnown or {})>>
你凑到石屋壁炉上方，用指节轻轻叩击烟道侧面的青石砖。
<<set $skulduggerydifficulty to 340>><<skulduggerycheck>>
<<if $skulduggerysuccess is 1>>
	<<set _sk to currentSkillValue("skulduggery")>>
	<<if _sk gte 800>><<set _reward to 780>><<elseif _sk gte 600>><<set _reward to 700>><<elseif _sk gte 400>><<set _reward to 620>><<else>><<set _reward to 540>><</if>>
	<<set $mpKnown["foghorn_wreck"] to 1>>
	<<if _sk gte 600 and window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("region_unique_MP_Region_Foghorn_Keeper")>>
		你抽出松动的活络石砖，从里面摸出一只裹着黄铜星盘与印戒残片的油纸包。包底还夹着守塔人私藏的 £<<print Math.floor(_reward / 100)>> 应急银钞。
		<<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>
		<<if ($mpFragSmugglerRing or 0) lt 3>><<set $mpFragSmugglerRing to ($mpFragSmugglerRing or 0) + 1>><</if>>
		<<money _reward>><<stress -3>>
	<<else>>
		你拉开木桌底层的暗抽屉，在旧海图下面翻出了一小卷备用的灯塔补贴零钞，数下来大约有 £<<print Math.floor(_reward / 100)>>。
		<<money _reward>><<stress -2>>
	<</if>>
<<else>>
	烟道里突然落下一蓬呛人的陈年煤灰，迷得你眼眶发酸，手背也在粗糙的石棱上蹭破了一块皮。你空手退回了屋子中央。
	<<stress 5>><<pain 2>>
<</if>>
<br><br>
