<<if $skulduggerysuccess is 1>>
	<<set _sk to currentSkillValue("skulduggery")>>
	<<if _sk gte 800>><<set _reward to 820>><<elseif _sk gte 600>><<set _reward to 720>><<elseif _sk gte 400>><<set _reward to 640>><<else>><<set _reward to 550>><</if>>
	<<set $mpKnown["clockwork_astro"] to 1>>
	<<if _sk gte 600 and window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("region_unique_MP_Region_Clockwork_Steam")>>
		你卸下法兰盖，从干燥的管腔内抽出一卷黄铜蓝图与王冠齿轮残片。图纸筒里还封着约 £<<print Math.floor(_reward / 100)>> 的工程备用金。
		<<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>
		<<if ($mpFragCrownGear or 0) lt 3>><<set $mpFragCrownGear to ($mpFragCrownGear or 0) + 1>><</if>>
		<<money _reward>><<stress -3>>
	<<else>>
