<<if ($mpAlert or 0) gte 100>>
<<if Math.max(($seductionskill or 0), ($english or 0), ($willpower or 0), ($history or 0)) gte 260>><<link [[虚张声势 (0:08)|MP Alert Abbey Bluff]]>><<pass 8>><</link>><<else>><<link [[虚张声势 (0:08)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "虚张声势">><<set $mpInsuffReq to "魅力等级：<span class='purple'>D</span> 或 英语等级：<span class='purple'>D</span> 或 意志等级：<span class='purple'>D</span> 或 历史等级：<span class='purple'>D</span>">><<pass 8>><</link>><</if>>
