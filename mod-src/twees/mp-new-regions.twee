<<if $skulduggerysuccess is 1>>
	<<if currentSkillValue("skulduggery") gte 600 and window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("region_unique_MP_Region_Foghorn_Echo")>>
		你抠开蜂蜡封口，取出一支完好的定音古音叉和半枚印戒残片；暗槽底部压着一小片写着“六响”的铜牌。
		<<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>
		<<if ($mpFragSmugglerRing or 0) lt 3>><<set $mpFragSmugglerRing to ($mpFragSmugglerRing or 0) + 1>><</if>>
		<<stress -3>>
	<<else>>
		<<if !$daily>><<set $daily to {}>><</if>>
		<<if !$daily.mpRegionLoot_foghorn_echo>>
			<<set $daily.mpRegionLoot_foghorn_echo to 1>>
			你从气孔内侧夹出几枚黑珍珠母贝与一枚旧钱币；槽壁上还留着指甲划出的六道短痕。<span class="green">你把找到的物件妥善收好。</span>
			<<stress -2>>
		<<else>>
			<span class="teal">螺旋气孔内侧今日已被你探过，只留下湿咸的海风回响。</span>
			<<stress -1>>
		<</if>>
	<</if>>
<<else>>
	气孔里骤然喷出一股夹着盐粒的水雾，啸声震得耳膜生疼。你踉跄后退，没能取出槽里的东西。
	<<stress 5>><<pain 2>>
<</if>>
<</replace>><</link>>
<br>
<<link "听辨风鸣方位 (0:06)">><<pass 6>><<replace "#foghorn-echo-choices">>
<<if $science gte 260 or $willpower gte 460>>
	你顺着共鸣最稳的那道石缝摸过去，发现一处被盐晶半封的干龛，里面有一枚刻着船锚的铜扣。
	<<stress -1>>
<<else>>
	回声忽高忽低，你贴壁听了半晌，只落得满耳嗡鸣，没找到干龛。
	<<tiredness 2>><<stress 3>>
<</if>>
<</replace>><</link>>
</div>

