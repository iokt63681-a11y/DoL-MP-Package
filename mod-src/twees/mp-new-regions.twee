<br>
<div id="blackiron-siding-choices">
<<investigateicon>><<link "别开扳道暗盒 (0:10)">><<pass 10>><<replace "#blackiron-siding-choices">>
<<set $skulduggerydifficulty to 330>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
