<<elseif _qstage is 2>>
	<<include "MP Quest Connudatus Velvet Stage 2">>
<<elseif _qstage is 3>>
	<<include "MP Quest Connudatus Velvet Stage 3">>
<<elseif _qstage is 4>>
	<<include "MP Quest Connudatus Velvet Stage 4">>
<<elseif _qstage is 5>>
	<<include "MP Quest Connudatus Velvet Stage 5">>
