<<if _qstage is 0>>
	<<include "MP Quest Docks Smuggler Stage 0">>
<<elseif _qstage is 1>>
	<<include "MP Quest Docks Smuggler Stage 1">>
<<elseif _qstage is 2>>
	<<include "MP Quest Docks Smuggler Stage 2">>
<<elseif _qstage is 3>>
	<<include "MP Quest Docks Smuggler Stage 3">>
<<elseif _qstage is 4>>
	<<include "MP Quest Docks Smuggler Stage 4">>
<<elseif _qstage is 5>>
	<<include "MP Quest Docks Smuggler Stage 5">>
<<elseif _qstage is 6>>
	<<include "MP Quest Docks Smuggler Stage 6">>
<<else>>
