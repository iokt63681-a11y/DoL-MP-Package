/* ==================== Bakery 小故事 第一阶段：复苏传世老酵 ==================== */

:: MP Job Story Bakery 1 [nobr]
<<set $outside to 0>><<set $location to "town">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>>
<<if ($mpJobStoryBakery or 0) is 2 and ($mpJobBakeryCount or 0) gte 10>><<goto "MP Job Story Bakery 3">><<elseif ($mpJobStoryBakery or 0) is 1 and ($mpJobBakeryCount or 0) gte 6>><<goto "MP Job Story Bakery 2">><</if>>
<<getouticon>><<link [[返回早班烤炉 (0:02)|MP Job Bakery]]>><<pass 2>><</link>>
<br><br>
<<if $daily.mpJobStoryBakery>>
	今日这桩差事已经料理妥当，不急在一时。
<<elseif ($mpJobStoryBakery or 0) gte 1>>
	这一章的事务已经办妥，等你在这行当里攒足资历，后续的安排自会浮现。
<<else>>
	发酵室最里层的陶瓮揭开了封泥，传了二十年的黑麦老酵头因换季温差表面泛起酸泡。老师傅把送奶工内尔刚送来的温牛乳与河湾农场的头茬红麦粉摆在案上：「老酵头是石炉的魂，今日你来调温喂粉，把它的劲道养回来。」
	<br><br>
	<div id="mp-job-story-bakery-1">
	<<mpcookicon>><<if ($tending or 0) gte 230>><<link "温乳喂粉养酵 (0:07)">><<pass 7>><<replace "#mp-job-story-bakery-1">>
	<<if ($tending or 0) gte 230 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryBakery to 1>><<set $mpJobStoryBakery to Math.max(($mpJobStoryBakery or 0), 1)>><<set $mpJobReg_Bakery_2 to ($mpJobReg_Bakery_2 or 0) + 1>>
		你按三份红麦粉配两份温牛乳的比例揉入老酵心，守在炉壁余温旁每隔两刻翻折一次。陶瓮里的酵团渐渐鼓起绵密均匀的蜂窝眼，散发出一股醇厚的麦芽酒香，老师傅欣慰地点了点头。<span class="green">这桩关口被你漂亮地拿下了。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_bakery_1")>><<money 480>><</if>>
		<<tending 1>><<stress -2>><<lstress>>
	<<else>>
		温水兑得稍急，酵团表层起了一圈浮泡，老师傅连忙加了一把干粉替你稳住酸度。<span class="red">差了一口气，只能改日再试。</span><<stress 3>><<tiredness 1>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回早班烤炉 (0:02)|MP Job Bakery]]>><<pass 2>><</link>>
	<</replace>><</link>><<else>><<link [[温乳喂粉养酵 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "温乳喂粉养酵">><<set $mpInsuffReq to "照料等级：<span class='purple'>D</span>">><<pass 7>><</link>><</if>>
	<br>
	<<mpcalculateicon>><<if ($science or 0) gte 220>><<link "测准瓮内酸温 (0:06)">><<pass 6>><<replace "#mp-job-story-bakery-1">>
	<<if ($science or 0) gte 220 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryBakery to 1>><<set $mpJobStoryBakery to Math.max(($mpJobStoryBakery or 0), 1)>><<set $mpJobReg_Bakery_2 to ($mpJobReg_Bakery_2 or 0) + 1>>
		你用温度计测准发酵室背风角的恒温点，用干净竹刮刀撇去表层老化酸膜，再裹上厚亚麻布保温。傍晚揭盖时，老酵头活性十足。<span class="green">你的巧思让事情顺利推进了一步。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_bakery_1")>><<money 420>><</if>>
		<<scienceskill 1 "no_star">><<stress -2>><<lstress>>
	<<else>>
		瓮盖揭开太久散了暖气，酵头醒发慢了半个时辰，你只得留在炉边多守了一阵。<span class="red">一时没能奏效，还得再寻时机。</span><<stress 2>><<tiredness 2>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回早班烤炉 (0:02)|MP Job Bakery]]>><<pass 2>><</link>>
	<</replace>><</link>><<else>><<link [[测准瓮内酸温 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "测准瓮内酸温">><<set $mpInsuffReq to "科学等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
	<br>
