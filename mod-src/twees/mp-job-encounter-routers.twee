	<br><br>
	<div id="mp-job-story-pubkitchen-3">
	<<mpcookicon>><<if ($housekeeping or 0) gte 270>><<link "掌勺船员大宴 (0:07)">><<pass 7>><<replace "#mp-job-story-pubkitchen-3">>
