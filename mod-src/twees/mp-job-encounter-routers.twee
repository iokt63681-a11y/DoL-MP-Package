	<</if>>
	<br><br>
	<<link [[返回栈桥木棚 (0:02)|MP Job Fish]]>><<pass 2>><<mpalertclear>><</link>>
	<</replace>><</link>><<else>><<link [[定下分潮供货 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "定下分潮供货">><<set $mpInsuffReq to "英语等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
	<br>
	<<mpcleanicon>><<link "优先保酒馆单 (0:05)">><<pass 5>><<replace "#mp-job-story-fish-2">>
	<<set $daily.mpJobStoryFish to 1>><<set $mpJobStoryFish to Math.max(($mpJobStoryFish or 0), 2)>><<set $mpJobReg_Fish_1 to ($mpJobReg_Fish_1 or 0) + 1>>
	你按老主顾优先的规矩先给布鲁诺挑足了去刺鱼柳，再带外埠客商去隔壁拖网船补货。<span class="teal">你稳扎稳打地办妥了这一步。</span>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_fish_2")>><<money 340>><</if>>
