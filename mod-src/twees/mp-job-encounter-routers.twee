:: MP Job Cafe Encounter Router [nobr]
<<set _pool to ["MP Job Cafe Encounter", "MP Job Cafe Encounter 2", "MP Job Cafe Encounter 3"]>>
<<set $mpJobCafeEncountersSeen to ($mpJobCafeEncountersSeen or {})>>
<<set _avail to _pool.filter(function (n) { return !$mpJobCafeEncountersSeen[n]; })>>
<<if _avail.length is 0>><<set $mpJobCafeEncountersSeen to {}>><<set _avail to _pool>><</if>>
<<set _pick to _avail.random()>><<set $mpJobCafeEncountersSeen[_pick] to 1>>
<<goto _pick>>

