<</if>>

/* ==================== Bakery 小故事 第二阶段：同炉喜丧双宴 ==================== */

:: MP Job Story Bakery 2 [nobr]
<<set $outside to 0>><<set $location to "town">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>>
<<if ($mpJobStoryBakery or 0) is 2 and ($mpJobBakeryCount or 0) gte 10>><<goto "MP Job Story Bakery 3">><</if>>
<<getouticon>><<link [[返回烘焙前厅 (0:02)|MP Job Bakery]]>><<pass 2>><</link>>
