/* ==================== V34 零工底层共用组件与插曲路由、三阶段小故事 ==================== */

:: Widgets MP Job [widget nobr]
<<widget "mpJobSeasonWeather">>
<<set _jk to _args[0]>>
<<if _jk is "Bakery">>
	<<if Time.season is "spring">>春晨的湿气让老酵头发得比往日快，木案板边新添了一盅槐花蜜。
	<<elseif Time.season is "summer">>盛夏的烤炉房热浪滚滚，老师傅把顶层排风铁窗支到了最大格。
	<<elseif Time.season is "autumn">>秋收的头茬红麦刚进仓，整间烘房都飘着新麦壳的焦香。
	<<else>>寒冬清晨炉壁凝着白霜，第一铲黑麦包出炉时白汽几乎遮住前厅。<</if>>
	<<if Weather.isSnow>>窗外雪粒敲打着玻璃，买热面包暖手的街坊把门帘掀得一刻不停。
	<<elseif Weather.precipitation is "rain">>雨气顺着门缝往里钻，老师傅嘱咐你筛粉时多垫一层干麻布。
	<<else>>晴朗的阳光穿过高窗落在铁烤架上，面粉星子在光柱里轻轻浮动。<</if>>
	<<if Time.hour lt 10>>早市的铜铃响个不停，刚下夜班的码头工正等着头炉热包。
	<<elseif Time.hour lt 15>>午后的主炉转入慢火，案板上排开了下午茶的杏仁甜酥。
	<<else>>傍晚收炉前余温尚存，正是烘烤次日干面包片与核对面粉账的钟点。<</if>>
<<elseif _jk is "Cafe">>
	<<if Time.season is "spring">>春日海风带着微潮的花气吹过露台，每张圆桌上都插了一支黄水仙。
	<<elseif Time.season is "summer">>夏日午后碎冰机嗡嗡作响，薄荷冰咖与冷萃茶点单压满了铜夹。
	<<elseif Time.season is "autumn">>秋风微凉，吧台换上了肉桂摩卡与烤南瓜司康的特餐木牌。
	<<else>>冬日玻璃窗上蒙着厚厚水雾，铜壶里的热可可与苹果酒一直温在暗火上。<</if>>
	<<if Weather.isSnow>>雪天露台收起了伞座，客人们全挤在吧台边的暖炉旁烘手。
	<<elseif Weather.precipitation is "rain">>雨水顺着遮阳棚滴落，伞桶满了大半，过道比晴日窄了一截。
	<<else>>海面在晴光下泛着碎银似的光，露台靠栏杆的座位一早便坐满了人。<</if>>
	<<if Time.hour lt 11>>早班的浓缩咖啡香刚漫开，赶早报的客人正低头翻看墨迹未干的报纸。
	<<elseif Time.hour lt 17>>午后茶座人声鼎沸，三层点心架与手冲铜壶在卡座间穿梭不息。
	<<else>>暮色漫上窗棂，煤气壁灯点亮后，店里只剩低声交谈的熟客。<</if>>
<<elseif _jk is "Fish">>
	<<if Time.season is "spring">>春汛回暖，近岸浅水区成群的银鱼顺着暖流游进栈桥阴影下。
	<<elseif Time.season is "summer">>盛夏日头毒辣，冰棚里的碎冰化得快，每隔半个时辰就得补一铲盐冰。
	<<elseif Time.season is "autumn">>秋潮水位最高，外礁洄游的青背银鳕肥得压弯了竹鱼篓。
	<<else>>隆冬的海风像刀子一样刮脸，缆绳上结了一层硬霜，鱼鳞在灰光里泛着冷铁色。<</if>>
	<<if Weather.isSnow>>雪粒子斜打在栈桥木板上，老鱼贩把防风油布压上了两块鹅卵石。
	<<elseif Weather.precipitation is "rain">>雨点把海面敲出密密麻麻的白沫，水下暗流比晴日更难捉摸。
	<<else>>天高浪稳，远处防波堤与灯塔的轮廓清晰可见，正是下网的好天色。<</if>>
	<<if Time.hour lt 10>>早潮刚退，第一批从拖网船卸下的鲜鱼正在磅秤边抢鲜过秤。
	<<elseif Time.hour lt 18>>午后海鸥围着刮鳞案打转，餐馆与酒馆的采买学徒络绎不绝。
	<<else>>夜潮漫过外礁暗桩，防雾风灯在漆黑的海面上映出一圈昏黄光晕。<</if>>
<<elseif _jk is "Spa">>
	<<if Time.season is "spring">>春分后蒸汽房换上了新采的鲜白桦叶，水雾里透着一股草木初生的清气。
	<<elseif Time.season is "summer">>暑日里北侧汤池引了深井冷泉，白瓷池壁上凝着一层沁凉水珠。
	<<elseif Time.season is "autumn">>深秋风燥，私汤隔间多备了甘菊牛乳膏与甜橙香薰炉。
	<<else>>寒冬腊月里温泉白雾最浓，推开更衣室木门便是一股裹人的暖流。<</if>>
	<<if Weather.isSnow>>天井外飘着细雪，露天汤池水面腾起丈许高的白汽，冷热交融。
	<<elseif Weather.precipitation is "rain">>雨声敲打着玻璃天窗，回廊石阶比往常更潮，烘巾架火力开了满格。
	<<else>>晴光透过高处的彩绘玻璃斜照进水雾，在池面上投下斑斓光影。<</if>>
	<<if Time.hour lt 12>>早场来泡汤的多是清静养神的老人，池边只闻水流轻响。
	<<elseif Time.hour lt 18>>午后私汤铜铃频频响起，赴宴前夕的名流贵妇纷纷点名要调香擦背。
	<<else>>入夜后铜灯调暗，浴场笼罩在安谧的檀香与蒸汽之中。<</if>>
<<elseif _jk is "Farm">>
	<<if Time.season is "spring">>春耕时节泥土翻出湿润的腥甜，靠河的畦面刚冒出一层嫩绿麦芽。
	<<elseif Time.season is "summer">>盛夏蝉鸣聒噪，麦秆一天一个高度，引水渠的木闸从早到晚哗哗流淌。
	<<elseif Time.season is "autumn">>秋收的金黄麦浪压弯了田埂，谷仓外排满了等过秤的四轮板车。
	<<else>>冬日田垄覆着白霜，农活全转进了暖意融融的玻璃温室与谷仓。<</if>>
	<<if Weather.isSnow>>大雪封住了远坡，温室炉膛烧得通红，得随时扫去玻璃顶上的积雪。
	<<elseif Weather.precipitation is "rain">>雨水泡软了田埂，排水沟里浊水急流，下地时靴底粘满厚泥。
	<<else>>晴空万里，河湾吹来的风干爽温和，正适合翻晒新收的麦粒与草捆。<</if>>
	<<if Time.hour lt 11>>晨露还挂在叶尖，早起下地最是凉爽出活。
	<<elseif Time.hour lt 17>>日头正高，田垄间热气蒸腾，连挽马都躲在谷仓檐下喘息。
	<<else>>夕阳压向河湾芦苇荡，归仓的板车在土路上拉出长长的斜影。<</if>>
<<elseif _jk is "Clock">>
	<<if Time.season is "spring">>春潮湿气渐起，塞拉在每个精密机芯匣里都多放了一小包吸潮生石灰。
	<<elseif Time.season is "summer">>夏日金属热胀，座钟的补偿摆轮需要往回微调半格才不致走慢。
	<<elseif Time.season is "autumn">>秋高气爽，正是拆洗古董怀表、给红宝石轴承换新钟表油的黄金时节。
	<<else>>冬夜严寒容易冻凝旧表油，工作台边的烤蓝酒精灯从早亮到晚。<</if>>
	<<if Weather.isSnow>>窗外雪落无声，铺子里大大小小几十座钟表的滴答声显得分外清脆。
	<<elseif Weather.precipitation is "rain">>阴雨天光线幽暗，黄铜台灯罩压得很低，放大镜片上偶有水雾。
	<<else>>晴日阳光斜映进玻璃展柜，擦拭一新的银壳怀表与黄铜齿轮熠熠生辉。<</if>>
	<<if Time.hour lt 12>>上午多是铁路与商行伙计来校对标准时，柜台前节奏紧凑。
	<<elseif Time.hour lt 17>>午后街面安静下来，适合屏息静气拆解最精密的复杂擒纵机构。
	<<else>>暮色四合，煤油灯芯挑亮，整点报时的钟鸣在幽静的高街上回荡。<</if>>
<<elseif _jk is "Laundry">>
	<<if Time.season is "spring">>春日穿堂风干爽，后院竹竿上的白床单半个时辰就能吹得松软透亮。
	<<elseif Time.season is "summer">>盛夏送洗的夏布与纱衣极多，装订台边的浆糊盆得加点明矾防酸。
	<<elseif Time.season is "autumn">>秋风起时孤儿院开始浆洗厚棉被套，旧书摊也送来大批防虫重订的旧册。
	<<else>>冬天后院滴水成冰，所有床单都得靠烘衣室的暖石板与炭火熨斗慢慢烘透。<</if>>
	<<if Weather.isSnow>>雪天晾衣绳收进了内廊，满屋子都是白茫茫的皂角蒸汽与炭火暖意。
	<<elseif Weather.precipitation is "rain">>连绵阴雨让湿布难以干透，绞干机摇得咯吱作响，熨斗一刻不能离手。
	<<else>>晴天日头晒足了后院，收下来的亚麻布自带一股阳光的暖香。<</if>>
	<<if Time.hour lt 11>>清晨大木盆里热水滚滚，头一批来自桑拿房与神殿的布草正待浸洗。
	<<elseif Time.hour lt 17>>午后熨衣台白汽嘶鸣，装订桌上的锥子与蜡线也忙个不停。
	<<else>>夜深人静，走廊只剩浆洗房这盏昏黄孤灯，伴着院童均匀的呼吸声。<</if>>
<<elseif _jk is "Tailor">>
	<<if Time.season is "spring">>春季换装潮刚到，高街淑女们纷纷送来薄绸春衫改收腰线。
	<<elseif Time.season is "summer">>盛夏剧团与晚宴演出频繁，冰丝礼服与薄纱披肩挂满了试衣间。
	<<elseif Time.season is "autumn">>入秋后厚呢大衣与猎装订单激增，重锤蒸汽熨斗压得案板咚咚作响。
	<<else>>隆冬时节尽是天鹅绒晚装与毛皮领口的精修活，银针在灯下寒光闪闪。<</if>>
	<<if Weather.isSnow>>窗外风雪交加，厚绒门帘挡住了寒气，取衣的主顾都由跑腿行代领。
	<<elseif Weather.precipitation is "rain">>雨天空气潮湿，呢料容易吸潮变沉，下剪前必先用温熨斗走一遍。
	<<else>>晴光映亮了三面落地铜镜，丝线匣里的百种色号线轴分外鲜亮。<</if>>
	<<if Time.hour lt 12>>早班先理清昨日留下的改衣签，把拆线与锁边的急活按钟点排开。
	<<elseif Time.hour lt 17>>午后试衣间门帘频频掀动，量体软尺与裁布剪片刻不得闲。
	<<else>>晚间剧院开场前，常有舞者与乐手赶来救急修补礼服。<</if>>
<<elseif _jk is "Courier">>
	<<if Time.season is "spring">>春风和煦，街巷间的石板路干爽轻快，正是跑远线急件的好时节。
	<<elseif Time.season is "summer">>夏日暑气蒸腾，背着帆布邮包跑上两趟便汗流浃背，得随身带壶凉茶。
	<<elseif Time.season is "autumn">>秋日商行盘点与契约往来最密，加盖火漆的专送皮袋塞得满满当当。
	<<else>>冬日街面结着暗冰，老掌柜给每双跑腿靴都绑上了防滑麻草绳。<</if>>
	<<if Weather.isSnow>>风雪迷眼，街牌被白雪盖住一半，全凭平日记熟的门户特征认路。
	<<elseif Weather.precipitation is "rain">>大雨倾盆，帆布挎包抹了三遍防雨蜡，抄近道时得时刻提防屋檐水柱。
	<<else>>晴天视野开阔，连廊与后巷近道畅通无阻，脚程比平时快上两成。<</if>>
	<<if Time.hour lt 11>>早班紧着派送晨报清样与商行开盘汇票，一路小跑不能停脚。
	<<elseif Time.hour lt 17>>午后多是钟表铺、裁缝铺与医院之间的贵重包裹面签。
	<<else>>暮色降临，街灯渐次亮起，夜间急件更讲究轻手轻脚与眼观六路。<</if>>
<<elseif _jk is "PubKitchen">>
	<<if Time.season is "spring">>春汛鲜鱼上市，后厨每日都要现炸十几盘外酥里嫩的银鳕鱼排。
	<<elseif Time.season is "summer">>夏夜酒客贪凉，地窖里的冰镇黑麦啤酒桶换得比平时快一倍。
	<<elseif Time.season is "autumn">>秋日丰收节前后，烤猪肋排与新麦黑啤的香气能飘出半条丰收街。
	<<else>>寒冬夜里热汤最俏，两大锅黑啤炖牛肉从早煨到晚，白汽模糊了传菜窗。<</if>>
	<<if Weather.isSnow>>外面大雪封街，避寒的水手与巡夜人把前厅挤得水泄不通，催菜铃响个不停。
	<<elseif Weather.precipitation is "rain">>雨夜潮冷，烟道抽风略慢，后厨油锅与烤炉的热气熏得人满面通红。
	<<else>>晴朗的日子里后院通风顺畅，卸酒桶与劈柴备料的活计利落了许多。<</if>>
	<<if Time.hour lt 14>>午市刚开灶，主要是切配炖肉、削马铃薯与接收鱼档送来的鲜货。
	<<elseif Time.hour lt 19>>傍晚换班时分，第一批下工的船坞匠人已经坐进前厅点起了烤肉。
	<<else>>入夜后酒馆进入真正的高峰，传菜口铜铃与酒杯碰撞声震耳欲聋。<</if>>
<<elseif _jk is "Stable">>
	<<if Time.season is "spring">>开春草场返青，挽马换了春毛，精神抖擞地在栏里刨着前蹄。
	<<elseif Time.season is "summer">>盛夏蚊蝇多，老马夫在马厩四角点起艾草绳，每趟出车都备足饮水桶。
	<<elseif Time.season is "autumn">>秋收驮运最忙，装满新麦与苹果桶的四轮重车从早到晚络绎不绝。
	<<else>>寒冬土路冻得硬实，挽马呼出一团团白汽，马栏里铺了双层厚干草。<</if>>
	<<if Weather.isSnow>>雪地车轮容易打滑，出车前必须给车轮缠上防滑铁链，给马披上防风毯。
	<<elseif Weather.precipitation is "rain">>大雨把河湾土路泡成泥浆，过石桥坡道时得格外留心车辕与绳结。
	<<else>>晴日土路干爽坚实，挽马脚下轻快，车铃声一路传出老远。<</if>>
	<<if Time.hour lt 11>>清晨先饮马刷鬃、检查蹄铁，赶着头班板车把鲜货送进高街。
	<<elseif Time.hour lt 17>>午后多是粮商与磨坊的重载短驳，院子里装卸号子声此起彼伏。
	<<else>>傍晚收车回栏，给跑了一天的挽马卸套擦汗、添足夜草。<</if>>
<<elseif _jk is "Trawler">>
	<<if Time.season is "spring">>春潮涌动，近海黑鲷与银鱼群集，拖网下水不久便沉甸甸地绷紧。
	<<elseif Time.season is "summer">>夏日海面风平浪静，视野极远，但底舱鱼箱必须多加碎冰防鲜鱼变质。
	<<elseif Time.season is "autumn">>秋汛大鱼最多，深水区的肥硕银鳕与大青蟹常常一网满舱。
	<<else>>冬季北风凛冽，甲板上滴水成冰，每一网起鱼都是同寒浪硬拼。<</if>>
	<<if Weather.isSnow>>海上飘雪时能见度极低，全靠船首铜罗盘与外礁雾角声指引航向。
	<<elseif Weather.precipitation is "rain">>雨幕遮蔽了远海，横浪拍上甲板，摇绞盘时必须死死扣住安全绳。
	<<else>>晴海碧波万顷，海鸥追着拖网尾流盘旋啼叫，起网号子声格外响亮。<</if>>
	<<if Time.hour lt 11>>早潮出港，柴油机突突冒着白烟，抢在鱼商开市前起出头网鲜货。
	<<elseif Time.hour lt 17>>午后外礁平潮，适合深水拖网与底舱分拣装箱。
	<<else>>暮色压低海平线，远方雾角灯塔亮起引航金光，催促渔船满载归航。<</if>>
<</if>>
<</widget>>

<<widget "mpJobRegularPresence">>
<<set _jk to _args[0]>>
<<if _jk is "Bakery">>
	<<set _r1 to ($mpJobReg_Bakery_1 or 0)>><<set _r2 to ($mpJobReg_Bakery_2 or 0)>><<set _r3 to ($mpJobReg_Bakery_3 or 0)>>
	<<if Time.hour lt 10>>
		送奶工内尔把两只白铁牛奶罐搁在侧门台阶上。<<if _r2 gte 2>>她熟稔地冲你晃了晃热奶瓶：「今天给我也留两只刚出炉的椒盐扭结，我给你带了顶层厚奶皮。」<<else>>她擦了擦额角的汗，踮脚往烤炉那边张望早班的热面包。<</if>>
	<<elseif Time.hour lt 15>>
		殡仪行伙计卡莱布抱着一卷黑纱站在柜台边。<<if _r1 gte 2>>他朝你低声点头：「还是你接单最省心，家属点名要你压字模的那款圆包。」<<else>>他正对着订户木牌核对午后丧宴圆包的取货时辰。<</if>>
	<<else>>
		老账房霍恩揣着银壳怀表站在橱窗前。<<if _r3 gte 2>>他推了推眼镜，温和地向你打招呼：「你看的炉火最准，今天那根黑麦长棍帮我切薄片。」<<else>>他正一板一眼地等着傍晚这一炉黑麦长棍出炉。<</if>>
	<</if>>
<<elseif _jk is "Cafe">>
	<<set _r1 to ($mpJobReg_Cafe_1 or 0)>><<set _r2 to ($mpJobReg_Cafe_2 or 0)>><<set _r3 to ($mpJobReg_Cafe_3 or 0)>>
	<<if Time.hour lt 12>>
		退休领航员温特斯照例坐在靠窗二号桌。<<if _r1 gte 2>>他没敲杯垫，只朝你抬了抬烟斗：「老规矩，深烘黑咖撒一撮海盐，你冲的味儿最正。」<<else>>他把旧怀表摆在桌角，等着他那杯加盐的深烘黑咖啡。<</if>>
	<<elseif Time.hour lt 17>>
		《海风日报》记者林赛在吧台角摊开速写本。<<if _r3 gte 2>>他笑着朝你晃了晃钢笔：「今天有什么海港新鲜事？你上次帮我救回的稿子反响好极了。」<<else>>他正一边抿着摩卡，一边飞快记录邻桌客人的闲谈。<</if>>
	<<else>>
		老乐手埃利奥特把旧提琴盒靠在三号桌椅背上。<<if _r2 gte 2>>他温和地朝你颔首：「今晚风柔，等你忙完这一阵，我拉段旧港船歌给你听。」<<else>>他正就着壁灯光亮，用铅笔修改膝上的五线谱。<</if>>
	<</if>>
<<elseif _jk is "Fish">>
	<<set _r1 to ($mpJobReg_Fish_1 or 0)>><<set _r2 to ($mpJobReg_Fish_2 or 0)>><<set _r3 to ($mpJobReg_Fish_3 or 0)>>
	<<if Time.hour lt 11>>
		冰厂的罗婶叉着腰站在碎冰车旁。<<if _r2 gte 2>>她爽朗地拍了拍冰筐：「给你留了半块最瓷实的底冰，今天的好鱼别忘了给老娘留两条！」<<else>>她正扯着嗓门跟栈桥小贩核算今日的碎冰斤两。<</if>>
	<<elseif Time.hour lt 17>>
		酒馆采买厨师布鲁诺拎着空鱼篓站在秤边。<<if _r1 gte 2>>他冲你比了个手势：「胖厨长说了，只要你亲手剔刺的银鳕鱼柳，价钱好商量。」<<else>>他正挑剔地翻看碎冰筐里的银鳕鱼鳃。<</if>>
	<<else>>
		老领航员哈克叼着短烟斗蹲在缆桩旁看潮水。<<if _r3 gte 2>>他用烟斗杆指了指外礁暗流：「今晚流缓，往黑礁东侧下竿准有大货。」<<else>>他眯着眼打量海面风浪，不时提点两句潮汐涨落。<</if>>
	<</if>>
<<elseif _jk is "Spa">>
	<<set _r1 to ($mpJobReg_Spa_1 or 0)>><<set _r2 to ($mpJobReg_Spa_2 or 0)>><<set _r3 to ($mpJobReg_Spa_3 or 0)>>
	<<if Time.hour lt 13>>
		草药商赫伯特提着藤编药篮站在前厅。<<if _r3 gte 2>>他笑着递来一枝鲜迷迭香：「多亏你上次替我解暑，今天这批上等甘菊特意给你留着。」<<else>>他正同前台核对本周蒸汽房的香草包分量。<</if>>
	<<elseif Time.hour lt 18>>
		老议员夫人维奥拉披着真丝浴袍从一号私汤走过。<<if _r2 gte 2>>她温和地朝你颔首：「今天还是你当班？把甜橙香薰点上，我只信你的手艺。」<<else>>她挑剔地扫了一眼托盘上的热敷毛巾与海盐盅。<</if>>
	<<else>>
		退休歌剧女高音塞西莉亚挽着象牙簪靠在二号私汤竹帘边。<<if _r1 gte 2>>她轻敲池沿铜片朝你微笑：「水温和蒸汽厚度刚好，今晚我的嗓子全靠你照应了。」<<else>>她正轻声哼着练声曲，试探池面水雾的润度。<</if>>
	<</if>>
<<elseif _jk is "Farm">>
	<<set _r1 to ($mpJobReg_Farm_1 or 0)>><<set _r2 to ($mpJobReg_Farm_2 or 0)>><<set _r3 to ($mpJobReg_Farm_3 or 0)>>
	<<if Time.hour lt 11>>
		老佃农巴恩斯背着铁锹走在田埂上。<<if _r3 gte 2>>他乐呵呵地冲你招手：「西边那条泄水沟多亏你挖得深，今早的麦苗壮实得很！」<<else>>他正弯腰查看排水渠与靠河麦垄的墒情。<</if>>
	<<elseif Time.hour lt 16>>
		草药商玛莎蹲在温室外的晾晒架旁。<<if _r2 gte 2>>她捏起一枝干迷迭香朝你晃了晃：「你分拣的草叶一棵杂草也没有，桑拿房那边点名要你的货。」<<else>>她正仔细翻检竹匾里晾晒的薄荷与冬季香草。<</if>>
	<<else>>
		磨坊主霍利斯把黄铜秤盘搁在谷仓石阶上。<<if _r1 gte 2>>他拍了拍账册笑道：「只要是你经手过筛的头茬红麦，我免检直收！」<<else>>他正捻着麦粒估算今日送往磨坊与面包房的成色。<</if>>
	<</if>>
<<elseif _jk is "Clock">>
	<<set _r1 to ($mpJobReg_Clock_1 or 0)>><<set _r2 to ($mpJobReg_Clock_2 or 0)>><<set _r3 to ($mpJobReg_Clock_3 or 0)>>
	<<if Time.hour lt 12>>
		老火车站副站长康纳站在柜台前核对月台表。<<if _r1 gte 2>>他竖起大拇指：「自从你替我调准了快慢针，车站的班次交接再也没慢过半秒。」<<else>>他正盯着标准座钟的秒针核对怀表误差。<</if>>
	<<elseif Time.hour lt 17>>
		古董商格里芬戴着单眼放大镜站在展柜旁。<<if _r2 gte 2>>他压低声音笑道：「我刚收了一只镂空金表，塞拉说现在复杂音簧的活找你一样稳当。」<<else>>他正借着灯光端详绒布盘里的几枚古旧机芯。<</if>>
	<<else>>
		老琴师阿诺德抱着紫檀木节拍器坐在长凳上。<<if _r3 gte 2>>他温和地敲了敲音叉：「你调过的发条拍子最稳，连学院挑剔的考官都挑不出刺。」<<else>>他正侧耳倾听铺子里几座落地摆钟的报时共鸣。<</if>>
	<</if>>
<<elseif _jk is "Laundry">>
	<<set _r1 to ($mpJobReg_Laundry_1 or 0)>><<set _r2 to ($mpJobReg_Laundry_2 or 0)>><<set _r3 to ($mpJobReg_Laundry_3 or 0)>>
	<<if Time.hour lt 11>>
		老账房彭斯先生夹着公文包站在交接台前。<<if _r1 gte 2>>他摸了摸挺括的衬衫硬领：「满城就数你浆熨的领子最挺括，穿三天都不塌角。」<<else>>他正仔细核对送洗簿上的衣物编号。<</if>>
	<<elseif Time.hour lt 17>>
		旧书商莫里斯站在装订桌边翻看古籍。<<if _r3 gte 2>>他抚着书脊连连点头：「你锁的麻线书脊又牢又平，这批孤本全交给你经手了。」<<else>>他正检查待修硬壳书的散页与浆糊干湿度。<</if>>
	<<else>>
		神殿执事西蒙捧着一叠祭坛白麻布走进门。<<if _r2 gte 2>>他温和地向你颔首：「你退染熏香的手艺极好，神殿的礼袍交给你最让人放心。」<<else>>他正叮嘱管事注意神殿白麻法衣的净水漂洗规矩。<</if>>
	<</if>>
<<elseif _jk is "Tailor">>
	<<set _r1 to ($mpJobReg_Tailor_1 or 0)>><<set _r2 to ($mpJobReg_Tailor_2 or 0)>><<set _r3 to ($mpJobReg_Tailor_3 or 0)>>
	<<if Time.hour lt 13>>
		银行家夫人克拉拉站在三面铜镜前比量披肩。<<if _r2 gte 2>>她对着镜中的你微微一笑：「上次那朵银线鸢尾被夫人们问了一整晚，这件晚装也交给你改。」<<else>>她正挑剔地打量丝绸礼服的收腰线条。<</if>>
	<<elseif Time.hour lt 17>>
		剧团舞者伊芙琳扶着试衣间木门试旋转步。<<if _r1 gte 2>>她亲昵地朝你眨眨眼：「你锁的亮片裙摆转十圈都不掉一颗，今晚的包厢票我还给你留着！」<<else>>她正催促学徒尽快改好今晚登台的旋转舞裙。<</if>>
	<<else>>
		乐团指挥奥托先生披着黑色燕尾服站在副台边。<<if _r3 gte 2>>他欣慰地抬了抬右臂：「你嵌的那块活褶衬真是神来之笔，挥完全场交响曲都毫不紧绷。」<<else>>他正拿着指挥棒比划抬臂幅度，测试袖笼余量。<</if>>
	<</if>>
<<elseif _jk is "Courier">>
	<<set _r1 to ($mpJobReg_Courier_1 or 0)>><<set _r2 to ($mpJobReg_Courier_2 or 0)>><<set _r3 to ($mpJobReg_Courier_3 or 0)>>
	<<if Time.hour lt 11>>
		报馆排字工汉克带着一身油墨味趴在代办亭窗口。<<if _r3 gte 2>>他把加急稿袋直接递给你：「只有你跑近巷从不误点，主编的头版清样全靠你了！」<<else>>他正焦急地催问早班加急清样的派送人手。<</if>>
	<<elseif Time.hour lt 16>>
		药剂师温德尔提着锡皮保温药匣候在亭外。<<if _r1 gte 2>>他放心地把药匣交到你手里：「你懂避暑防震的门道，医院那批血清非你送不可。」<<else>>他正反复叮嘱邮差路上切勿颠簸药匣。<</if>>
	<<else>>
		钟表学徒芬恩捧着封蜡木盒跑来投件。<<if _r2 gte 2>>他冲你一笑：「塞拉师父特意交代，精密游丝盒只准交给你背。」<<else>>他正核对火漆印章与整点投递的时刻签。<</if>>
	<</if>>
<<elseif _jk is "PubKitchen">>
	<<set _r1 to ($mpJobReg_PubKitchen_1 or 0)>><<set _r2 to ($mpJobReg_PubKitchen_2 or 0)>><<set _r3 to ($mpJobReg_PubKitchen_3 or 0)>>
	<<if Time.hour lt 15>>
		船木匠老乔里坐在靠近传菜窗的圆桌旁。<<if _r3 gte 2>>他举起麦酒杯朝后厨晃了晃：「你炙烤的那手蜜汁肋排太地道了，今天徒弟们的伙食还找你！」<<else>>他正敲着桌面打听今日烤肋排与炖肉的火候。<</if>>
	<<elseif Time.hour lt 20>>
		水手长布兰德嗓门洪亮地拍着吧台点单。<<if _r1 gte 2>>他隔着传菜口冲你竖起大拇指：「把你炸的头等银鳕鱼排先上四大盘，赏钱少不了你的！」<<else>>他正催促跑堂快上招牌炸鱼排与黑麦啤酒。<</if>>
	<<else>>
		巡夜人麦考伊披着湿冷的斗篷在后门边喝热汤。<<if _r2 gte 2>>他捧着热汤碗朝你温和一笑：「每次值夜班闻见你煨的黑啤牛肉香，骨头缝里的寒气就散了一半。」<<else>>他正借着后厨炉火烘烤微湿的手套。<</if>>
	<</if>>
<<elseif _jk is "Stable">>
	<<set _r1 to ($mpJobReg_Stable_1 or 0)>><<set _r2 to ($mpJobReg_Stable_2 or 0)>><<set _r3 to ($mpJobReg_Stable_3 or 0)>>
	<<if Time.hour lt 11>>
		粮商吉尔伯特拿着账夹站在四轮板车旁。<<if _r1 gte 2>>他拍了拍你的肩膀：「只要是你控缰押车，十篓鸡蛋过石桥都不碎一个，今天头车归你带！」<<else>>他正检查板车上的麦袋捆绳是否勒紧。<</if>>
	<<elseif Time.hour lt 16>>
		铁匠巴尔德拎着钉掌工具袋走过马栏。<<if _r2 gte 2>>他洪亮地笑道：「你修蹄扩掌的眼力不输我铺子里的大徒弟，这副精钢掌铁留给你用！」<<else>>他正俯身查看几匹重挽马的蹄铁磨损情况。<</if>>
	<<else>>
		老邮差托马斯牵着换乘的邮马走进院子。<<if _r3 gte 2>>他把热麦茶壶递给你：「上次断轴多亏你救急，城郊的快马接力有你我就踏实了。」<<else>>他正给长途奔波的邮马擦拭脖颈汗水。<</if>>
	<</if>>
<<elseif _jk is "Trawler">>
	<<set _r1 to ($mpJobReg_Trawler_1 or 0)>><<set _r2 to ($mpJobReg_Trawler_2 or 0)>><<set _r3 to ($mpJobReg_Trawler_3 or 0)>>
	<<if Time.hour lt 11>>
		补网妇梅芙坐在防波堤石墩上飞梭补网。<<if _r3 gte 2>>她抬头冲你温和一笑：「你那手双股油麻插绳法越来越老练了，主网底纲我都替你加固好了。」<<else>>她正低头挑检拖网底纲上被礁石磨毛的麻股。<</if>>
	<<elseif Time.hour lt 17>>
		鱼商克劳斯拄着文明杖站在三号泊位磅秤旁。<<if _r1 gte 2>>他爽快地朝你招手：「你分拣保冰的底舱银鳕成色最好，今天全舱我按头等牌价收！」<<else>>他正盯着返航渔船的吃水线盘算今日批价。<</if>>
	<<else>>
		老灯塔守望人摩根提着铜风灯走下防波堤。<<if _r2 gte 2>>他拍了拍你的手背：「起雾的时候听准我的铜钟，外礁的水道你现在比谁都熟。」<<else>>他正与独眼船长核对今夜外礁的潮位与风向。<</if>>
	<</if>>
<</if>>
<</widget>>

<<widget "mpJobRegularRoster">>
<<set _jk to _args[0]>>
<<if _jk is "Bakery">>
	常客熟稔度：殡仪伙计卡莱布（<<print ($mpJobReg_Bakery_1 or 0) gte 2 ? "已认准你的字模手艺" : "点头之交">>）｜送奶工内尔（<<print ($mpJobReg_Bakery_2 or 0) gte 2 ? "每日互留早点鲜奶" : "晨间交接">>）｜老账房霍恩（<<print ($mpJobReg_Bakery_3 or 0) gte 2 ? "指名要你切黑麦包" : "按表取包">>）。
<<elseif _jk is "Cafe">>
	常客熟稔度：退休领航员温特斯（<<print ($mpJobReg_Cafe_1 or 0) gte 2 ? "认准你的撒盐黑咖" : "常坐二号桌">>）｜老乐手埃利奥特（<<print ($mpJobReg_Cafe_2 or 0) gte 2 ? "常为你留旧港船歌" : "靠窗改谱">>）｜记者林赛（<<print ($mpJobReg_Cafe_3 or 0) gte 2 ? "常找你打听市井趣闻" : "吧台赶稿">>）。
<<elseif _jk is "Fish">>
	常客熟稔度：采买厨师布鲁诺（<<print ($mpJobReg_Fish_1 or 0) gte 2 ? "包下你的去刺鱼柳" : "按单验鳃">>）｜冰厂罗婶（<<print ($mpJobReg_Fish_2 or 0) gte 2 ? "常为你私留厚底冰" : "磅秤卖冰">>）｜老领航员哈克（<<print ($mpJobReg_Fish_3 or 0) gte 2 ? "倾囊相授外礁潮位" : "栈桥看潮">>）。
<<elseif _jk is "Spa">>
	常客熟稔度：女高音塞西莉亚（<<print ($mpJobReg_Spa_1 or 0) gte 2 ? "演前必请你调蒸汽" : "二号私汤客">>）｜议员夫人维奥拉（<<print ($mpJobReg_Spa_2 or 0) gte 2 ? "点名要你配甜橙香" : "一号私汤客">>）｜草药商赫伯特（<<print ($mpJobReg_Spa_3 or 0) gte 2 ? "常赠上品甘菊药包" : "前厅送药">>）。
<<elseif _jk is "Farm">>
	常客熟稔度：磨坊主霍利斯（<<print ($mpJobReg_Farm_1 or 0) gte 2 ? "对你的新麦免检直收" : "谷仓过秤">>）｜草药商玛莎（<<print ($mpJobReg_Farm_2 or 0) gte 2 ? "包销你的温室迷迭香" : "晾棚收草">>）｜老佃农巴恩斯（<<print ($mpJobReg_Farm_3 or 0) gte 2 ? "与你共管河湾水闸" : "田埂巡渠">>）。
<<elseif _jk is "Clock">>
	常客熟稔度：副站长康纳（<<print ($mpJobReg_Clock_1 or 0) gte 2 ? "将月台怀表全权托你" : "按点校表">>）｜古董商格里芬（<<print ($mpJobReg_Clock_2 or 0) gte 2 ? "高价名表指名找你" : "展柜看货">>）｜老琴师阿诺德（<<print ($mpJobReg_Clock_3 or 0) gte 2 ? "常借音叉助你听簧" : "校节拍器">>）。
<<elseif _jk is "Laundry">>
	常客熟稔度：老账房彭斯（<<print ($mpJobReg_Laundry_1 or 0) gte 2 ? "只穿你浆熨的硬领衫" : "按号取衣">>）｜神殿执事西蒙（<<print ($mpJobReg_Laundry_2 or 0) gte 2 ? "将祭坛白麻托付于你" : "查验法衣">>）｜旧书商莫里斯（<<print ($mpJobReg_Laundry_3 or 0) gte 2 ? "善本锁线非你莫属" : "旧书送订">>）。
<<elseif _jk is "Tailor">>
	常客熟稔度：剧团舞者伊芙琳（<<print ($mpJobReg_Tailor_1 or 0) gte 2 ? "首演舞裙必请你锁边" : "试衣间常客">>）｜银行家夫人克拉拉（<<print ($mpJobReg_Tailor_2 or 0) gte 2 ? "盛赞你的暗绣手艺" : "定制晚装">>）｜乐团指挥奥托（<<print ($mpJobReg_Tailor_3 or 0) gte 2 ? "认准你的活褶燕尾服" : "改演出服">>）。
<<elseif _jk is "Courier">>
	常客熟稔度：药剂师温德尔（<<print ($mpJobReg_Courier_1 or 0) gte 2 ? "冰镇药匣放心交你" : "窗口投匣">>）｜钟表学徒芬恩（<<print ($mpJobReg_Courier_2 or 0) gte 2 ? "精密游丝专托你手" : "钟表急件">>）｜排字工汉克（<<print ($mpJobReg_Courier_3 or 0) gte 2 ? "晚报清样指名你跑" : "报馆送样">>）。
<<elseif _jk is "PubKitchen">>
	常客熟稔度：水手长布兰德（<<print ($mpJobReg_PubKitchen_1 or 0) gte 2 ? "每晚必点你的炸鱼排" : "前厅催菜">>）｜巡夜人麦考伊（<<print ($mpJobReg_PubKitchen_2 or 0) gte 2 ? "夜班专喝你煨的热汤" : "后门宵夜">>）｜船木匠老乔里（<<print ($mpJobReg_PubKitchen_3 or 0) gte 2 ? "包席烤肉非你不可" : "长桌豪饮">>）。
<<elseif _jk is "Stable">>
	常客熟稔度：粮商吉尔伯特（<<print ($mpJobReg_Stable_1 or 0) gte 2 ? "头等粮车指名你押" : "雇车运粮">>）｜铁匠巴尔德（<<print ($mpJobReg_Stable_2 or 0) gte 2 ? "常为你留精锻马掌" : "送蹄铁片">>）｜老邮差托马斯（<<print ($mpJobReg_Stable_3 or 0) gte 2 ? "与你结下快马接力契" : "借马换乘">>）。
<<elseif _jk is "Trawler">>
	常客熟稔度：鱼商克劳斯（<<print ($mpJobReg_Trawler_1 or 0) gte 2 ? "对你分拣的鱼按顶价收" : "防波堤收鱼">>）｜守塔人摩根（<<print ($mpJobReg_Trawler_2 or 0) gte 2 ? "浓雾夜专为你敲引航钟" : "外礁守塔">>）｜补网妇梅芙（<<print ($mpJobReg_Trawler_3 or 0) gte 2 ? "出海前必替你查底纲" : "岸边补网">>）。
<</if>>
<</widget>>

