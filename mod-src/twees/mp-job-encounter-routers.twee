/* ==================== Cafe 小故事 第二阶段：记者林赛的专栏 ==================== */

:: MP Job Story Cafe 2 [nobr]
<<set $outside to 0>><<set $location to "cafe">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>>
<<if ($mpJobStoryCafe or 0) is 2 and ($mpJobCafeExp or 0) gte 10>><<goto "MP Job Story Cafe 3">><</if>>
<<getouticon>><<link [[返回海风前厅 (0:02)|MP Job Cafe]]>><<pass 2>><</link>>
<br><br>
<<if $daily.mpJobStoryCafe>>
	今日这桩差事已经料理妥当，不急在一时。
<<elseif ($mpJobStoryCafe or 0) gte 2>>
	这一章的事务已经办妥，等你在这行当里攒足资历，后续的安排自会浮现。
<<else>>
	《海风日报》记者林赛听说旧港船歌残谱现世，特地带着报馆档案袋赶来咖啡馆。他在旧报纸合订本里查到了船歌的后半段歌词，却缺了过门的和弦，正请埃利奥特与温特斯对证。
	<br><br>
	<div id="mp-job-story-cafe-2">
	<<mpreadicon>><<if ($english or 0) gte 250>><<link "校对古旧歌词 (0:07)">><<pass 7>><<replace "#mp-job-story-cafe-2">>
	<<if ($english or 0) gte 250 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryCafe to 1>><<set $mpJobStoryCafe to Math.max(($mpJobStoryCafe or 0), 2)>><<set $mpJobReg_Cafe_3 to ($mpJobReg_Cafe_3 or 0) + 1>>
		你对着发黄的合订本，辨认出旧港水手俚语里的潮汐隐喻，帮埃利奥特把缺失的四小节和弦与温特斯的航标口诀严丝合缝地对上了号。林赛兴奋地把你的名字也写进了专栏初稿。<span class="green">这桩关口被你漂亮地拿下了。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_cafe_2")>><<money 680>><</if>>
		<<englishskill 1 "no_star">><<stress -2>><<lstress>>
	<<else>>
		有两句古俚语拼写生僻，你翻了半晌词典才勉强认全。<span class="red">差了一口气，只能改日再试。</span><<stress 3>><<tiredness 1>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回海风前厅 (0:02)|MP Job Cafe]]>><<pass 2>><</link>>
	<</replace>><</link>><<else>><<link [[校对古旧歌词 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "校对古旧歌词">><<set $mpInsuffReq to "英语等级：<span class='purple'>D+</span>">><<pass 7>><</link>><</if>>
	<br>
	<<windowicon>><<if ($seductionskill or 0) gte 240>><<link "主持窗边沙龙 (0:06)">><<pass 6>><<replace "#mp-job-story-cafe-2">>
