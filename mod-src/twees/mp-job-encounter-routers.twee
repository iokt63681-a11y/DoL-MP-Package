/* ==================== Cafe 小故事 第三阶段：雨夜打烊的船歌 ==================== */

:: MP Job Story Cafe 3 [nobr]
<<set $outside to 0>><<set $location to "cafe">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>>

<<getouticon>><<link [[返回露台餐桌 (0:02)|MP Job Cafe]]>><<pass 2>><</link>>
<br><br>
<<if $daily.mpJobStoryCafe>>
	今日这桩差事已经料理妥当，不急在一时。
<<elseif ($mpJobStoryCafe or 0) gte 3>>
	这一章的事务已经办妥，等你在这行当里攒足资历，后续的安排自会浮现。
<<else>>
	晚报刊出旧港船歌专栏的那天傍晚，埃利奥特带上了擦得锃亮的小提琴，温特斯换上了旧礼服，林赛还买来一束黄水仙放在吧台。打烊翻牌后，格威岚把吧台主灯留给你，请你在弦音中调出今晚的压轴特饮。
	<br><br>
	<div id="mp-job-story-cafe-3">
	<<mpcookicon>><<if ($tending or 0) gte 260>><<link "调海风琥珀饮 (0:07)">><<pass 7>><<replace "#mp-job-story-cafe-3">>
	<<if ($tending or 0) gte 260 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryCafe to 1>><<set $mpJobStoryCafe to Math.max(($mpJobStoryCafe or 0), 3)>><<set $mpJobReg_Cafe_2 to ($mpJobReg_Cafe_2 or 0) + 1>>
		你以深烘浓缩为底，淋入农场鲜奶油与一滴海盐焦糖，表面炙出一层琥珀糖壳。提琴声在温暖的咖啡馆里回荡，三位常客举杯向你致意，格威岚把专属吧台红封塞进你围裙口袋。<span class="green">这桩关口被你漂亮地拿下了。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_cafe_3")>><<money 1500>><</if>>
		<<tending 1>><<stress -2>><<lstress>>
	<<else>>
		炙烤糖壳时火候略偏，你迅速点缀了一片柠檬叶补救，香气依旧迷人。<span class="red">差了一口气，只能改日再试。</span><<stress 3>><<tiredness 1>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回露台餐桌 (0:02)|MP Job Cafe]]>><<pass 2>><</link>>
	<</replace>><</link>><<else>><<link [[调海风琥珀饮 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "调海风琥珀饮">><<set $mpInsuffReq to "照料等级：<span class='purple'>D+</span>">><<pass 7>><</link>><</if>>
	<br>
	<<socialiseicon>><<if ($seductionskill or 0) gte 250>><<link "领唱副歌和声 (0:06)">><<pass 6>><<replace "#mp-job-story-cafe-3">>
	<<if ($seductionskill or 0) gte 250 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryCafe to 1>><<set $mpJobStoryCafe to Math.max(($mpJobStoryCafe or 0), 3)>><<set $mpJobReg_Cafe_2 to ($mpJobReg_Cafe_2 or 0) + 1>>
		你顺着埃利奥特的琴弓节拍轻声和起船歌副歌，温特斯用杯垫打着拍子，林赛拍案叫绝，整间海风咖啡馆都记住了你这位当家主理人。<span class="green">你的巧思让事情顺利推进了一步。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_cafe_3")>><<money 1250>><</if>>
		<<seductionskill 1>><<stress -2>><<lstress>>
	<<else>>
		你唱到高音处有些害羞忘词，引得众人善意地哄笑鼓掌。<span class="red">一时没能奏效，还得再寻时机。</span><<stress 2>><<tiredness 2>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回露台餐桌 (0:02)|MP Job Cafe]]>><<pass 2>><</link>>
	<</replace>><</link>><<else>><<link [[领唱副歌和声 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "领唱副歌和声">><<set $mpInsuffReq to "魅力等级：<span class='purple'>D+</span>">><<pass 6>><</link>><</if>>
	<br>
	<<mpcleanicon>><<link "静听弦音收杯 (0:05)">><<pass 5>><<replace "#mp-job-story-cafe-3">>
	<<set $daily.mpJobStoryCafe to 1>><<set $mpJobStoryCafe to Math.max(($mpJobStoryCafe or 0), 3)>><<set $mpJobReg_Cafe_2 to ($mpJobReg_Cafe_2 or 0) + 1>>
	你倚在锃亮的咖啡机旁静静听完一整曲船歌，收下三位常客联名相赠的纪念红封。<span class="teal">你稳扎稳打地办妥了这一步。</span>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_cafe_3")>><<money 900>><</if>>
	<<stress -1>><<lstress>>
	<br><br>
	<<link [[返回露台餐桌 (0:02)|MP Job Cafe]]>><<pass 2>><</link>>
	<</replace>><</link>>
	</div>
<</if>>

/* ==================== Fish 小故事 第一阶段：外礁水道的铁锈钩 ==================== */

:: MP Job Story Fish 1 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>><<mpAmbient>>
<<if Time.dayState is "night">><<if ($mpAlertArea or "") isnot "docks">><<mpalertinit "docks">><</if>><<mpalerttext>><<mpalertcheck>><</if>>
<<set $daily to ($daily or {})>>
<<if ($mpJobStoryFish or 0) is 2 and ($mpJobFishExp or 0) gte 10>><<goto "MP Job Story Fish 3">><<elseif ($mpJobStoryFish or 0) is 1 and ($mpJobFishExp or 0) gte 6>><<goto "MP Job Story Fish 2">><</if>>
<<getouticon>><<link [[返回海礁鱼档 (0:02)|MP Job Fish]]>><<pass 2>><<mpalertclear>><</link>>
<br><br>
<<if $daily.mpJobStoryFish>>
	今日这桩差事已经料理妥当，不急在一时。
<<elseif ($mpJobStoryFish or 0) gte 1>>
	这一章的事务已经办妥，等你在这行当里攒足资历，后续的安排自会浮现。
<<else>>
	近来早潮起网时，近岸网底总挂上几片带着暗绿铜锈的船板碎屑。老领航员哈克蹲在栈桥尽头，指着外礁两块黑石间的旋涡说：「季风把海底旧沉船的残骸推偏了，摸不清新的水道，好网迟早要被刮烂。」
	<br><br>
	<div id="mp-job-story-fish-1">
	<<swimicon>><<if ($swimmingskill or 0) gte 240>><<link "潜探黑礁水道 (0:07)">><<pass 7>><<replace "#mp-job-story-fish-1">>
	<<if ($swimmingskill or 0) gte 240 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryFish to 1>><<set $mpJobStoryFish to Math.max(($mpJobStoryFish or 0), 1)>><<set $mpJobReg_Fish_3 to ($mpJobReg_Fish_3 or 0) + 1>>
		你趁平潮潜入黑礁内侧，摸清沉船肋木凸起的位置，在安全水道两侧系上白色浮标贝壳。老鱼贩与哈克照着你的浮标下网，一网起出满满两筐银鳕而网线未伤分毫。<span class="green">这桩关口被你漂亮地拿下了。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_fish_1")>><<money 520>><</if>>
		<<swimmingskill 1>><<stress -2>><<lstress>>
	<<else>>
		水底暗流冰冷湍急，你只标出了一侧暗桩便不得不浮出水面换气。<span class="red">差了一口气，只能改日再试。</span><<stress 3>><<tiredness 1>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回海礁鱼档 (0:02)|MP Job Fish]]>><<pass 2>><<mpalertclear>><</link>>
	<</replace>><</link>><<else>><<link [[潜探黑礁水道 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "潜探黑礁水道">><<set $mpInsuffReq to "游泳等级：<span class='purple'>D</span>">><<pass 7>><</link>><</if>>
	<br>
	<<mpcalculateicon>><<if ($maths or 0) gte 230>><<link "铅锤测绘水深 (0:06)">><<pass 6>><<replace "#mp-job-story-fish-1">>
	<<if ($maths or 0) gte 230 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryFish to 1>><<set $mpJobStoryFish to Math.max(($mpJobStoryFish or 0), 1)>><<set $mpJobReg_Fish_3 to ($mpJobReg_Fish_3 or 0) + 1>>
		你用涂了牛油的测深铅锤沿栈桥外围逐点投测，根据铅底粘上的泥沙与铜锈绘出退潮等深图，哈克看后连称精准。<span class="green">你的巧思让事情顺利推进了一步。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_fish_1")>><<money 450>><</if>>
		<<mathsskill 1 "no_star">><<stress -2>><<lstress>>
	<<else>>
		铅锤线被海流冲斜，重测了三遍才算准暗礁距离。<span class="red">一时没能奏效，还得再寻时机。</span><<stress 2>><<tiredness 2>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回海礁鱼档 (0:02)|MP Job Fish]]>><<pass 2>><<mpalertclear>><</link>>
	<</replace>><</link>><<else>><<link [[铅锤测绘水深 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "铅锤测绘水深">><<set $mpInsuffReq to "算术等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
	<br>
	<<mpfishicon>><<link "记下哈克口诀 (0:05)">><<pass 5>><<replace "#mp-job-story-fish-1">>
	<<set $daily.mpJobStoryFish to 1>><<set $mpJobStoryFish to Math.max(($mpJobStoryFish or 0), 1)>><<set $mpJobReg_Fish_3 to ($mpJobReg_Fish_3 or 0) + 1>>
	你拿出小本子把哈克说的早晚潮避礁口诀一字不差地记在潮位板背面，供每日下网参照。<span class="teal">你稳扎稳打地办妥了这一步。</span>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_fish_1")>><<money 280>><</if>>
	<<stress -1>><<lstress>>
	<br><br>
	<<link [[返回海礁鱼档 (0:02)|MP Job Fish]]>><<pass 2>><<mpalertclear>><</link>>
	<</replace>><</link>>
	</div>
<</if>>

