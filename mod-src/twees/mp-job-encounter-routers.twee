	<</if>>
	<br><br>
	<<link [[返回传菜窗口 (0:02)|MP Job PubKitchen]]>><<pass 2>><<mpalertclear>><</link>>
	<</replace>><</link>><<else>><<link [[掌勺船员大宴 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "掌勺船员大宴">><<set $mpInsuffReq to "家政等级：<span class='purple'>D+</span>">><<pass 7>><</link>><</if>>
	<br>
	<<socialiseicon>><<if ($willpower or 0) gte 260>><<link "定下宵夜专席 (0:06)">><<pass 6>><<replace "#mp-job-story-pubkitchen-3">>
