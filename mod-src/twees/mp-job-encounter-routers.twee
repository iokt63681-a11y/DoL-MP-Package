:: MP Job Story Spa 2 [nobr]
<<set $outside to 0>><<set $location to "spa">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>>
<<if ($mpJobStorySpa or 0) is 2 and ($mpJobSpaExp or 0) gte 10>><<goto "MP Job Story Spa 3">><</if>>
<<getouticon>><<link [[返回私汤回廊 (0:02)|MP Job Spa]]>><<pass 2>><</link>>
