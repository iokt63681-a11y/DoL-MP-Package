<</if>>

/* ==================== Farm 小故事 第一阶段：靠河田垄的白碱霜 ==================== */

:: MP Job Story Farm 1 [nobr]
<<set $outside to 1>><<set $location to "farm">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>>
<<if ($mpJobStoryFarm or 0) is 2 and ($mpJobFarmExp or 0) gte 10>><<goto "MP Job Story Farm 3">><<elseif ($mpJobStoryFarm or 0) is 1 and ($mpJobFarmExp or 0) gte 6>><<goto "MP Job Story Farm 2">><</if>>
<<getouticon>><<link [[返回河湾田埂 (0:02)|MP Job Farm]]>><<pass 2>><</link>>
<br><br>
<<if $daily.mpJobStoryFarm>>
	今日这桩差事已经料理妥当，不急在一时。
<<elseif ($mpJobStoryFarm or 0) gte 1>>
	这一章的事务已经办妥，等你在这行当里攒足资历，后续的安排自会浮现。
<<else>>
	春雨过后，靠河湾最低洼的那两垄麦畦表土泛出一层淡淡的白碱花。老佃农巴恩斯蹲在田头直叹气，磨坊主霍利斯也担心今年头茬红麦的出粉率受影响，亚历克斯把铁锹递给你商议对策。
	<br><br>
	<div id="mp-job-story-farm-1">
	<<mpfarmicon>><<if ($tending or 0) gte 240>><<link "开挖排碱盲沟 (0:07)">><<pass 7>><<replace "#mp-job-story-farm-1">>
	<<if ($tending or 0) gte 240 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryFarm to 1>><<set $mpJobStoryFarm to Math.max(($mpJobStoryFarm or 0), 1)>><<set $mpJobReg_Farm_3 to ($mpJobReg_Farm_3 or 0) + 1>>
		你在两垄之间深挖三尺，底部铺满碎石与干芦苇秆做成暗排盲沟，再用河湾甜水漫灌洗碱。三天后白碱尽退，黑油油的土面冒出齐刷刷的壮苗，巴恩斯竖起大拇指夸你懂田。<span class="green">这桩关口被你漂亮地拿下了。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_farm_1")>><<money 520>><</if>>
		<<tending 1>><<stress -2>><<lstress>>
	<<else>>
		沟底碎石铺得不够匀，有一角水流稍慢，你又补挖了半刻钟才彻底通畅。<span class="red">差了一口气，只能改日再试。</span><<stress 3>><<tiredness 1>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回河湾田埂 (0:02)|MP Job Farm]]>><<pass 2>><</link>>
	<</replace>><</link>><<else>><<link [[开挖排碱盲沟 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "开挖排碱盲沟">><<set $mpInsuffReq to "照料等级：<span class='purple'>D</span>">><<pass 7>><</link>><</if>>
	<br>
	<<investigateicon>><<if ($science or 0) gte 230>><<link "拌入草木腐殖 (0:06)">><<pass 6>><<replace "#mp-job-story-farm-1">>
	<<if ($science or 0) gte 230 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryFarm to 1>><<set $mpJobStoryFarm to Math.max(($mpJobStoryFarm or 0), 1)>><<set $mpJobReg_Farm_3 to ($mpJobReg_Farm_3 or 0) + 1>>
		你拉来马厩发酵透的苜蓿堆肥与细沙混入表土，中和了河湾潮土的盐碱，麦苗根须扎得又深又白。<span class="green">你的巧思让事情顺利推进了一步。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_farm_1")>><<money 450>><</if>>
		<<scienceskill 1 "no_star">><<stress -2>><<lstress>>
	<<else>>
		堆肥翻拌得太沉，累得你双臂发酸才把两垄地全部翻匀。<span class="red">一时没能奏效，还得再寻时机。</span><<stress 2>><<tiredness 2>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回河湾田埂 (0:02)|MP Job Farm]]>><<pass 2>><</link>>
	<</replace>><</link>><<else>><<link [[拌入草木腐殖 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "拌入草木腐殖">><<set $mpInsuffReq to "科学等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
	<br>
	<<mpcarryicon>><<link "挑甜井水洗畦 (0:05)">><<pass 5>><<replace "#mp-job-story-farm-1">>
	<<set $daily.mpJobStoryFarm to 1>><<set $mpJobStoryFarm to Math.max(($mpJobStoryFarm or 0), 1)>><<set $mpJobReg_Farm_3 to ($mpJobReg_Farm_3 or 0) + 1>>
	你和巴恩斯一担担挑来谷仓后井的甜水冲刷畦面，稳稳压下了泛起的白碱。<span class="teal">你稳扎稳打地办妥了这一步。</span>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_farm_1")>><<money 280>><</if>>
	<<stress -1>><<lstress>>
	<br><br>
	<<link [[返回河湾田埂 (0:02)|MP Job Farm]]>><<pass 2>><</link>>
	<</replace>><</link>>
	</div>
<</if>>

/* ==================== Farm 小故事 第二阶段：麦垄与香草的套种 ==================== */

:: MP Job Story Farm 2 [nobr]
<<set $outside to 1>><<set $location to "farm">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>>
<<if ($mpJobStoryFarm or 0) is 2 and ($mpJobFarmExp or 0) gte 10>><<goto "MP Job Story Farm 3">><</if>>
<<getouticon>><<link [[返回谷仓木棚 (0:02)|MP Job Farm]]>><<pass 2>><</link>>
<br><br>
<<if $daily.mpJobStoryFarm>>
	今日这桩差事已经料理妥当，不急在一时。
<<elseif ($mpJobStoryFarm or 0) gte 2>>
	这一章的事务已经办妥，等你在这行当里攒足资历，后续的安排自会浮现。
<<else>>
	初夏虫害渐起，草药商玛莎提着一篮耐寒迷迭香与薄荷苗来到田头，提议在红麦垄边套种香草，既能借辛香驱赶麦蚜，收割的香草还能直供桑拿房与面包房。
	<br><br>
	<div id="mp-job-story-farm-2">
	<<mpherbicon>><<if ($tending or 0) gte 250>><<link "精排三畦套种 (0:07)">><<pass 7>><<replace "#mp-job-story-farm-2">>
	<<if ($tending or 0) gte 250 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryFarm to 1>><<set $mpJobStoryFarm to Math.max(($mpJobStoryFarm or 0), 2)>><<set $mpJobReg_Farm_2 to ($mpJobReg_Farm_2 or 0) + 1>>
		你按向阳垄种红麦、背风埂种迷迭香、渠边湿土植薄荷的格局排定三畦轮作。一连半月麦穗上不见半只麦蚜，连吹过田垄的风都带着草木清香，玛莎当场预付了整季定金。<span class="green">这桩关口被你漂亮地拿下了。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_farm_2")>><<money 680>><</if>>
		<<tending 1>><<stress -2>><<lstress>>
	<<else>>
		薄荷根系蔓延太快，你赶紧用木板隔在土下才没让它抢了麦苗的肥力。<span class="red">差了一口气，只能改日再试。</span><<stress 3>><<tiredness 1>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回谷仓木棚 (0:02)|MP Job Farm]]>><<pass 2>><</link>>
	<</replace>><</link>><<else>><<link [[精排三畦套种 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "精排三畦套种">><<set $mpInsuffReq to "照料等级：<span class='purple'>D+</span>">><<pass 7>><</link>><</if>>
	<br>
	<<mpcalculateicon>><<if ($maths or 0) gte 230>><<link "核算两季产值 (0:06)">><<pass 6>><<replace "#mp-job-story-farm-2">>
	<<if ($maths or 0) gte 230 and random(1, 4) gte 2>>
		<<set $daily.mpJobStoryFarm to 1>><<set $mpJobStoryFarm to Math.max(($mpJobStoryFarm or 0), 2)>><<set $mpJobReg_Farm_2 to ($mpJobReg_Farm_2 or 0) + 1>>
		你在农活账上算明麦粮与香草的采收周期差，正好填补夏秋之交的空档，亚历克斯照你的账本排定了全年农事。<span class="green">你的巧思让事情顺利推进了一步。</span>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_farm_2")>><<money 560>><</if>>
		<<mathsskill 1 "no_star">><<stress -2>><<lstress>>
	<<else>>
		起初算漏了烘干损耗，霍利斯提醒后你才把秤率修正过来。<span class="red">一时没能奏效，还得再寻时机。</span><<stress 2>><<tiredness 2>><<gstress>>
	<</if>>
	<br><br>
	<<link [[返回谷仓木棚 (0:02)|MP Job Farm]]>><<pass 2>><</link>>
	<</replace>><</link>><<else>><<link [[核算两季产值 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "核算两季产值">><<set $mpInsuffReq to "算术等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
	<br>
	<<mpfarmicon>><<link "沿田埂试种一排 (0:05)">><<pass 5>><<replace "#mp-job-story-farm-2">>
	<<set $daily.mpJobStoryFarm to 1>><<set $mpJobStoryFarm to Math.max(($mpJobStoryFarm or 0), 2)>><<set $mpJobReg_Farm_2 to ($mpJobReg_Farm_2 or 0) + 1>>
	你先在最靠河的一条田埂上试种了一排迷迭香，长势喜人，稳步推开了轮作新法。<span class="teal">你稳扎稳打地办妥了这一步。</span>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_farm_2")>><<money 340>><</if>>
	<<stress -1>><<lstress>>
	<br><br>
	<<link [[返回谷仓木棚 (0:02)|MP Job Farm]]>><<pass 2>><</link>>
	<</replace>><</link>>
	</div>
<</if>>

/* ==================== Farm 小故事 第三阶段：谷仓石阶的三家契 ==================== */

:: MP Job Story Farm 3 [nobr]
<<set $outside to 1>><<set $location to "farm">><<effects>><<mpAmbient>>
