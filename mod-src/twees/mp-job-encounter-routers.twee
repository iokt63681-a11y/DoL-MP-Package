<<if ($mpJobStoryCafe or 0) is 2 and ($mpJobCafeExp or 0) gte 10>><<goto "MP Job Story Cafe 3">><<elseif ($mpJobStoryCafe or 0) is 1 and ($mpJobCafeExp or 0) gte 6>><<goto "MP Job Story Cafe 2">><</if>>
