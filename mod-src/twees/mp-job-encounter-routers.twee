	<</if>>
	<br><br>
	<<link [[返回发酵内室 (0:02)|MP Job Bakery]]>><<pass 2>><</link>>
	<</replace>><</link>><<else>><<link [[立下三家供契 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "立下三家供契">><<set $mpInsuffReq to "英语等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
	<br>
	<<mpcleanicon>><<link "敬谢师父收罐 (0:05)">><<pass 5>><<replace "#mp-job-story-bakery-3">>
	<<set $daily.mpJobStoryBakery to 1>><<set $mpJobStoryBakery to Math.max(($mpJobStoryBakery or 0), 3)>><<set $mpJobReg_Bakery_3 to ($mpJobReg_Bakery_3 or 0) + 1>>
	你双手接过青釉酵罐与刻名木铲，把主炉案板擦得纤尘不染，正式成了石炉面包房的副掌炉人。<span class="teal">你稳扎稳打地办妥了这一步。</span>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("job_story_bakery_3")>><<money 900>><</if>>
