<<getouticon>><<link [[把线索钉回布告栏 (0:03)|MP Town Extra Stories Hub]]>><<pass 3>><</link>>
<br>
<<socialiseicon>><<link [[陪男生把信送到门房 (0:04)|Hallways]]>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Leighton")>><<npcincr Leighton love 1>><</if>><<pass 4>><<set $eventskip to 1>><<endevent>><</link>>
