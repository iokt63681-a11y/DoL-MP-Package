<<socialiseicon>><<link [[筑起寒潮守御 (0:12)|MP Season Hooks Hub]]>><<pass 12>><<mpSeasonMod "winter">><<set $mpSeasonHooks.outcome to "warded">><<tiredness -2>><</link>>
