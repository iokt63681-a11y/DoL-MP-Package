/* DoL-MP v1.2.0-dev9: mp-keepsake-uses-2.twee (8 passages: MP Keepsake Use <Item> 3) */

:: MP Keepsake Use Whistle 3 [nobr]
<<set $outside to 1>><<set $location to "sea">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Time.dayState is "night" or Weather.precipitation is "rain">>海雾深锁的雾角灯塔顶层露台外，<<else>>海风猎猎的雾角灯塔回音廊尽头，<</if>>你取出守塔人铜哨对准外海古航标石柱吹出三短一长的归航讯号。铜哨管身中段套着一圈可调节音高与折射角度的黄铜副环。

<br><br>
<<getouticon>><<link [[收好信物返回 (0:03)|MP Region Foghorn Island]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpKsUse3_mp_keepsake_use_whistle_3 is 1>>
守塔人铜哨今日已与外海古航标共鸣过，哨管尚存海风微凉。
<<else>>
<div id="act-mp-keepsake-use-whistle-3">
<<keepsakeicon>><<link "屏息吹出三短一长归航音 (0:07)">><<pass 7>><<replace "#act-mp-keepsake-use-whistle-3">>
<<if ($willpower or 0) gte 430 or ($athletics or 0) gte 250>>
	<<set $daily.mpKsUse3_mp_keepsake_use_whistle_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("ks_use3_rew_mp_keepsake_use_whistle_3")>><<money 420>>古航标石柱底部的潮汐机括应声开启，吐出一匣封存的远洋航海银币。<<else>>你熟练地复现了先前的步骤，里头的钱物虽已取走，仔细核验一遍仍让你心里踏实不少。<</if>><span class="green">守塔人铜哨唤醒了外海古航标暗格。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好铜哨与航海银币返回 (0:04)|MP Region Foghorn Island]]>><<pass 4>><</link>>
<<else>>
	海风逆灌进铜哨音孔，震得你唇角发麻。<span class="red">你侧身背对海风平复呼吸。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[稳住指尖重新尝试 (0:04)|MP Keepsake Use Whistle 3]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回灯塔露台门内 (0:03)|MP Region Foghorn Island]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "旋动铜哨副环借石壁折音 (0:08)">><<pass 8>><<replace "#act-mp-keepsake-use-whistle-3">>
<<if ($science or 0) gte 250 or ($skulduggery or 0) gte 250>>
	<<set $daily.mpKsUse3_mp_keepsake_use_whistle_3 to 1>><<set $mpClues["mpKsUse3_mp_keepsake_use_whistle_3_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("ks_use3_rew_mp_keepsake_use_whistle_3_alt")>><<money 480>>折射哨音精准传入礁石盲区，暗龛石门滑开，露出守塔人珍藏的津贴。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">声学折射让守塔人铜哨发挥了真正妙用。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[整理信物离开 (0:04)|MP Region Foghorn Island]]>><<pass 4>><</link>>
<<else>>
	回音壁角度偏了半寸，共鸣声散在海浪里。<span class="red">你对准石拱焦点准备再试。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<walkicon>><<link [[调整铜哨副环角度再试 (0:04)|MP Keepsake Use Whistle 3]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回主区域 (0:03)|MP Region Foghorn Island]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>
<br>
<<keepsakeicon>><<link [[带信物查探(0:04)|MP Keepsake Use Whistle 4]]>><<pass 4>><</link>>

:: MP Keepsake Use Core 3 [nobr]
<<set $outside to 0>><<set $location to "underground">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Time.dayState is "night">>深夜寂静的机括城停摆天文台内，<<else>>机括城中央星象沙盘的副轴座前，<</if>>你将蓝钢怀表芯嵌入十二宫副轴的校准孔，测试整座天球仪的联动齿比。校准孔外围刻着一圈精细的十二宫齿比刻度盘，主卡槽就在正中央。

<br><br>
<<getouticon>><<link [[收好信物返回 (0:03)|MP Region Clockwork Undercity]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpKsUse3_mp_keepsake_use_core_3 is 1>>
蓝钢怀表芯今日已完成十二宫副轴联动校准，星轨运转分毫不差。
<<else>>
<div id="act-mp-keepsake-use-core-3">
<<keepsakeicon>><<link "将蓝钢怀表芯推入主卡槽 (0:07)">><<pass 7>><<replace "#act-mp-keepsake-use-core-3">>
<<if ($science or 0) gte 260 or ($skulduggery or 0) gte 250>>
	<<set $daily.mpKsUse3_mp_keepsake_use_core_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("ks_use3_rew_mp_keepsake_use_core_3")>><<money 420>>蓝钢游丝与主轴瞬间同步，沙盘底座弹出一只装满机括城纪念银币的铜盒。<<else>>你熟练地复现了先前的步骤，里头的钱物虽已取走，仔细核验一遍仍让你心里踏实不少。<</if>><span class="green">蓝钢怀表芯完美激活了星象副轴。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收起怀表芯返回机括城 (0:04)|MP Region Clockwork Undercity]]>><<pass 4>><</link>>
<<else>>
	副轴棘爪回弹了一下，震痛了你的食指指尖。<span class="red">你拨开止逆爪准备重新嵌入。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[稳住指尖重新尝试 (0:04)|MP Keepsake Use Core 3]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回星象沙盘外圈 (0:03)|MP Region Clockwork Undercity]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "拨齐刻度盘让怀表芯啮合 (0:08)">><<pass 8>><<replace "#act-mp-keepsake-use-core-3">>
<<if ($maths or 0) gte 250 or ($housekeeping or 0) gte 250>>
	<<set $daily.mpKsUse3_mp_keepsake_use_core_3 to 1>><<set $mpClues["mpKsUse3_mp_keepsake_use_core_3_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("ks_use3_rew_mp_keepsake_use_core_3_alt")>><<money 480>>齿轮咬合声清脆悦耳，底座暗抽屉缓缓滑出，奉上一卷工程红利券。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">精准计算让蓝钢怀表芯严丝合缝地啮合。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[整理信物离开 (0:04)|MP Region Clockwork Undercity]]>><<pass 4>><</link>>
<<else>>
	刻度盘内圈积着少许油泥，转到半途卡了一下。<span class="red">你擦净油泥准备再次拨盘。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<walkicon>><<link [[重新拨齐十二宫刻度再试 (0:04)|MP Keepsake Use Core 3]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回主区域 (0:03)|MP Region Clockwork Undercity]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>
<br>
<<keepsakeicon>><<link [[带信物查探(0:04)|MP Keepsake Use Core 4]]>><<pass 4>><</link>>

:: MP Keepsake Use Ring 3 [nobr]
<<set $outside to 0>><<set $location to "temple">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Time.dayState is "night" or Time.dayState is "dusk">>幽暗的地下古修道院灰烬藏经阁深处，<<else>>长明灯摇曳的古修道院藏经阁石台前，<</if>>你将银鸽指环按进泥金秘典封面的橄榄枝凹槽。凹槽底部封着一层陈年蜂蜡锁，旁边石灯的火苗正散发着微温。

<br><br>
<<getouticon>><<link [[收好信物返回 (0:03)|MP Region Sunken Abbey]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpKsUse3_mp_keepsake_use_ring_3 is 1>>
银鸽指环的羽翼印记今日已开启过秘典铜扣，藏经阁内檀香静谧。
<<else>>
<div id="act-mp-keepsake-use-ring-3">
<<keepsakeicon>><<link "将银鸽指环正嵌入橄榄枝槽 (0:07)">><<pass 7>><<replace "#act-mp-keepsake-use-ring-3">>
<<if ($history or 0) gte 250 or ($skulduggery or 0) gte 250>>
	<<set $daily.mpKsUse3_mp_keepsake_use_ring_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("ks_use3_rew_mp_keepsake_use_ring_3")>><<money 420>>秘典铜扣应声弹开，夹层里露出一叠古修道院奉纳银券与密文抄页。<<else>>你熟练地复现了先前的步骤，里头的钱物虽已取走，仔细核验一遍仍让你心里踏实不少。<</if>><span class="green">银鸽指环开启了泥金秘典的封存夹层。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[合拢秘典返回修道院 (0:04)|MP Region Sunken Abbey]]>><<pass 4>><</link>>
<<else>>
	铜扣内侧簧片紧绷，按压时硌红了你的指节。<span class="red">你揉了揉指节准备垂直发力。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[稳住指尖重新尝试 (0:04)|MP Keepsake Use Ring 3]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回藏经阁长明灯旁 (0:03)|MP Region Sunken Abbey]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "烘温银鸽指环印开蜂蜡锁 (0:08)">><<pass 8>><<replace "#act-mp-keepsake-use-ring-3">>
<<if ($science or 0) gte 250 or ($tending or 0) gte 240>>
	<<set $daily.mpKsUse3_mp_keepsake_use_ring_3 to 1>><<set $mpClues["mpKsUse3_mp_keepsake_use_ring_3_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("ks_use3_rew_mp_keepsake_use_ring_3_alt")>><<money 480>>微温的银鸽指环融开陈年蜂蜡，秘典内页的奉纳银券完好呈现在眼前。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">温热银鸽指环无损解开了蜂蜡暗锁。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[整理信物离开 (0:04)|MP Region Sunken Abbey]]>><<pass 4>><</link>>
<<else>>
	灯火距离稍远，指环温度还没烘够。<span class="red">你凑近长明灯焰心再烘片刻。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<walkicon>><<link [[借石灯余温烘软蜂蜡再试 (0:04)|MP Keepsake Use Ring 3]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回主区域 (0:03)|MP Region Sunken Abbey]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>
<br>
<<keepsakeicon>><<link [[带信物查探(0:04)|MP Keepsake Use Ring 4]]>><<pass 4>><</link>>

:: MP Keepsake Use Amber 3 [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Weather.precipitation is "rain">>雨声淅沥的秘密温室地下酿造室里，<<else>>恒温幽静的秘密温室标本廊深处，<</if>>你旋开琥珀香膏瓶的鎏金内盖，将其凑近一株闭合的千年夜光银脉兰。瓶盖内侧插着一枚挑香膏用的纯银细挑针。

<br><br>
<<getouticon>><<link [[收好信物返回 (0:03)|MP Region Glasshouse Manor]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpKsUse3_mp_keepsake_use_amber_3 is 1>>
琥珀香膏瓶今日已催开过那株夜光银脉兰，幽香仍在玻璃罩内流转。
<<else>>
<div id="act-mp-keepsake-use-amber-3">
<<keepsakeicon>><<link "用银挑针挑出香膏点在花萼 (0:07)">><<pass 7>><<replace "#act-mp-keepsake-use-amber-3">>
<<if ($tending or 0) gte 260 or ($science or 0) gte 250>>
	<<set $daily.mpKsUse3_mp_keepsake_use_amber_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("ks_use3_rew_mp_keepsake_use_amber_3")>><<money 420>>银脉兰花瓣缓缓舒展，花心托出一枚早年庄园主留下的纯金花蕊章与赏金。<<else>>你熟练地复现了先前的步骤，里头的钱物虽已取走，仔细核验一遍仍让你心里踏实不少。<</if>><span class="green">琥珀香膏瓶成功唤醒了千年银脉兰。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[盖好香膏瓶返回温室 (0:04)|MP Region Glasshouse Manor]]>><<pass 4>><</link>>
<<else>>
	花萼外侧凝着冷露，香膏滑落了一小滴。<span class="red">你先用吸水纸拭干花萼冷露。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[稳住指尖重新尝试 (0:04)|MP Keepsake Use Amber 3]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回标本廊恒温门边 (0:03)|MP Region Glasshouse Manor]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "温热琥珀香膏瓶熏开兰花 (0:08)">><<pass 8>><<replace "#act-mp-keepsake-use-amber-3">>
<<if ($housekeeping or 0) gte 250 or ($tending or 0) gte 240>>
	<<set $daily.mpKsUse3_mp_keepsake_use_amber_3 to 1>><<set $mpClues["mpKsUse3_mp_keepsake_use_amber_3_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("ks_use3_rew_mp_keepsake_use_amber_3_alt")>><<money 480>>温润甜香笼罩花冠，夜光兰吐露芳华，底座暗格随之弹出育种礼金。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">熏香之法让银脉兰毫无损伤地盛放。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[整理信物离开 (0:04)|MP Region Glasshouse Manor]]>><<pass 4>><</link>>
<<else>>
	温水皿水温稍低，香气散得慢了些。<span class="red">你添入少许热水准备重新熏香。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<walkicon>><<link [[控制香膏瓶温热火候再试 (0:04)|MP Keepsake Use Amber 3]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回主区域 (0:03)|MP Region Glasshouse Manor]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>
<br>
<<keepsakeicon>><<link [[带信物查探(0:04)|MP Keepsake Use Amber 4]]>><<pass 4>><</link>>

:: MP Keepsake Use Medal 3 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Time.dayState is "night" or Time.dayState is "dusk">>夜色下的黑铁货运站信号塔顶层，<<else>>黑铁货运站地下走私月台的主控箱前，<</if>>你取出站长纪念铜章，对准联锁机箱侧面的八角母槽按了下去。母槽下方的面板上并排立着三根带刻度的联锁小拉杆。

<br><br>
<<getouticon>><<link [[收好信物返回 (0:03)|MP Region Blackiron Yard]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpKsUse3_mp_keepsake_use_medal_3 is 1>>
站长纪念铜章今日已开启过联锁机箱副格，信号灯静静闪烁。
<<else>>
<div id="act-mp-keepsake-use-medal-3">
<<keepsakeicon>><<link "将站长纪念铜章拧入八角槽 (0:07)">><<pass 7>><<replace "#act-mp-keepsake-use-medal-3">>
<<if ($skulduggery or 0) gte 250 or ($physique or 10000) gte 11400>>
	<<set $daily.mpKsUse3_mp_keepsake_use_medal_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("ks_use3_rew_mp_keepsake_use_medal_3")>><<money 420>>八角母槽转动半圈，机箱底层弹出一盒早期铁路押运银币。<<else>>你熟练地复现了先前的步骤，里头的钱物虽已取走，仔细核验一遍仍让你心里踏实不少。<</if>><span class="green">站长纪念铜章打开了信号塔备用金匣。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好纪念铜章返回货站 (0:04)|MP Region Blackiron Yard]]>><<pass 4>><</link>>
<<else>>
	母槽内有铁锈阻滞，拧动时震麻了手腕。<span class="red">你拍散槽内铁锈准备再拧。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[稳住指尖重新尝试 (0:04)|MP Keepsake Use Medal 3]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回走私月台立柱后 (0:03)|MP Region Blackiron Yard]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "对照铜章刻痕拨齐三拉杆 (0:08)">><<pass 8>><<replace "#act-mp-keepsake-use-medal-3">>
<<if ($science or 0) gte 250 or ($maths or 0) gte 250>>
	<<set $daily.mpKsUse3_mp_keepsake_use_medal_3 to 1>><<set $mpClues["mpKsUse3_mp_keepsake_use_medal_3_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("ks_use3_rew_mp_keepsake_use_medal_3_alt")>><<money 480>>三根联锁拉杆齐齐落位，机箱侧门自动弹开，露出里面的铁路津贴券。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">你破译站长纪念铜章刻痕解开了联锁箱。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[整理信物离开 (0:04)|MP Region Blackiron Yard]]>><<pass 4>><</link>>
<<else>>
	第二根拉杆弹簧略紧，没能一次拉到位。<span class="red">你双手握住拉杆准备重新对齐。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<walkicon>><<link [[核对铜章背面刻痕再试 (0:04)|MP Keepsake Use Medal 3]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回主区域 (0:03)|MP Region Blackiron Yard]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>
