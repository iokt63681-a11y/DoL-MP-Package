	<<if _first>><<money _reward>><<stress -3>><<else>><<stress -1>><</if>>
<<else>>
	你开口太急，声音在石室里撞出回音。井口的人立刻停住，白布被扯下来，换成红布。<<pain 2>><<stress 6>><<set $mpClues["wild_extra_vent_hider"] to 0>>
