<<if ($skulduggery or 0) gte 250 or ($science or 0) gte 240>>
	<<set $daily.mpReg4_mp_region_moment_blackiron_8 to 1>><<set $mpClues["mpReg4_mp_region_moment_blackiron_8_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("reg4_rew_mp_region_moment_blackiron_8_alt")>><<money 360>>扁铁片巧劲一挑，防水油布夹毫发无损地滑入你掌心。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">你顺着枕木纹理巧取了油布夹。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
