<<if $skulduggerysuccess is 1>>
	<<set _sk to currentSkillValue("skulduggery")>>
	<<if _sk gte 800>><<set _reward to 1350>><<elseif _sk gte 550>><<set _reward to 1020>><<else>><<set _reward to 700>><</if>>
