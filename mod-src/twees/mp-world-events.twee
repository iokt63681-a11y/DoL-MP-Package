<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_event_arcade_neon_repair")>><<money _reward>><</if>><<stress -2>>
	<br><br>
	<<socialiseicon>><<if $NPCNameList and $NPCNameList.includes("Robin")>><<link [[娃娃机旁找罗宾 (0:03)|MP World Event Arcade Neon Robin]]>><<pass 3>><</link>><<else>><span class="disabled">娃娃机旁找罗宾 (0:03)（尚未结识）</span><</if>>
<<else>>
