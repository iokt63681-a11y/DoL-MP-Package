<</replace>><</link>><<else>><<link [[借理香灰摸底槽 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "借理香灰摸底槽">><<set $mpInsuffReq to "诡术等级：<span class='purple'>D+</span>">><<pass 6>><</link>><</if>>
</div>
