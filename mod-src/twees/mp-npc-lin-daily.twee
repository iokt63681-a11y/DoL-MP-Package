	<<mpalert -2>><<stress -1>>
<</link>>
<br>
<<runicon>><<link [[绕到侧面夺瓶 (0:08)|MP NPC Lin Street Hub]]>><<pass 8>>
	<<if ($athletics or 0) gte 230 or (_lin.axis or 0) gte 35>>
		<<set _lin.axis to Math.min(100, (_lin.axis or 0) + 2)>>
		<<set _lin.trust to Math.min(100, (_lin.trust or 0) + 1)>>
		<<mpalert -4>><<stress -2>>
	<<else>>
