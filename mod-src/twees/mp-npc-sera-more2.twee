<<if !$mpNpcs>><<set $mpNpcs to {}>><</if>>
<<if !$mpNpcs.sera>><<set $mpNpcs.sera to { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0, hasMet: 1, cadence: 25, axis: 25, fatherLog: 0 }>><</if>>
