	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("obs_wing_9_rew")>><<money 460>>天球仪底座无声滑开，露出一封早年校董会留存的特别观测奖学金。<<else>>水晶天球仪折射出绚丽星芒，将整间暗阁映照得纤毫毕现。<</if>><span class="green">你彻底解开了旧天文翼楼最高处的星轨奥秘。</span><<stress -3>><<lstress>>
	<br><br>
	<<link [[离开 (0:04)|MP Region Observatory Dome]]>><<pass 4>><</link>>
<<else>>
	水晶球面光滑冰凉，旋动赤纬环时指尖滑了半寸。<span class="red">你哈了口热气暖了暖指尖。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Quest Observatory Wing 9]]>><<pass 4>><</link>>
	<br>
	<<link [[回折光穹顶 (0:03)|MP Region Observatory Dome]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "拓印隐藏星位 (0:08)">><<pass 8>><<replace "#act-mp-quest-observatory-wing-9">>
<<if ($history or 0) gte 260 or ($english or 0) gte 260>>
	<<set $daily.mpObsWing9 to 1>><<if !$mpClues or !$mpClues["clue_obs_wing_9"]>><<set $mpClues["clue_obs_wing_9"] to 1>><span class="blue">线索已记录</span><</if>><<set $mpQuestObservatoryWing to Math.max(($mpQuestObservatoryWing or 0), 9)>><<history 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("obs_wing_9_rew_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span>铜版星表底槽弹出一只扁盒，里面装着历代首席观测员传承的观测纪念铜章。<<else>>拓印出的星表线条工整清晰，与穹顶主镜的视场完美重合。<</if>><span class="green">你将旧天文翼楼百年来的星图脉络尽数掌握。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[返回天文翼楼 (0:04)|MP Quest Observatory Wing 10]]>><<pass 4>><</link>>
<<else>>
	铜版星表边角微翘，铺拓纸时被风吹起了一角。<span class="red">你拿黄铜镇纸压稳四角。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Quest Observatory Wing 9]]>><<pass 4>><</link>>
	<br>
	<<link [[回到折光穹顶 (0:03)|MP Region Observatory Dome]]>><<pass 3>><</link>>
