<<if !$daily.mpNpcSrv_lin>><<set $daily.mpNpcSrv_lin to 1>><<physique 3>><<athletics 2>><<stress -4>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>握住你的小臂带你演练了三遍反关节脱身术。发力技巧融会贯通，你的筋骨愈发舒展。<span class="green">你的防身反应快了一截。</span><<else>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>替你纠正了重心不稳的站姿，拍了拍你的肩膀。<span class="teal">你觉得下盘稳健了不少。</span><<stress -2>><</if>>
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[回林恩身边 (0:02)|MP NPC Lin Hub]]>><<pass 2>><</link>><<else>><span class="disabled">回林恩身边 (0:02)（尚未结识）</span><</if>>
<br>
<div id="srv-sub-lin">
<<investigateicon>><<link "练寸拳发力 (0:04)">><<pass 4>><<replace "#srv-sub-lin">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240 or ($athletics or 0) gte 240>>拳峰砸出沉闷声响。<span class="green">林恩颔首赞许你的发力时机。</span><<stress -2>><<else>>出拳偏了半寸，手腕微酸。<span class="red">林恩按住你手腕让你先放松。</span><<stress 2>><</if>>
<</replace>><</link>>
</div>
<<if $mpKeepsake and $mpKeepsake["keepsake_blackiron_medal"]>><br><<keepsakeicon>><<link [[给他看铜章 (0:06)|MP Keepsake Show Medal]]>><<pass 6>><</link>><</if>>

:: MP NPC Lin Help [nobr]
<<set $outside to 1>><<set $location to "town">><<effects>><<mpAmbient>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.lin to ($mpNpcs.lin or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.lin>><<set _npc.hasMet to 1>>
