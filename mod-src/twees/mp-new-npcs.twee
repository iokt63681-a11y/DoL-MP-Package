:: MP NPC Lin Hub [nobr]
<<set $outside to 1>><<set $location to "domus">>
<<effects>>
<<if !$mpNpcs>><<set $mpNpcs to {}>><</if>>
<<if !$mpNpcs.lin>><<set $mpNpcs.lin to { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0, hasMet: 1 }>><</if>>
<<set _npc to $mpNpcs.lin>>
<<set _npc.hasMet to 1>>
<<set _exitPas to ($mpReturnPassage or "Domus Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Domus Street">>
<</if>>
<<endevent>>
<<generateNPC 1 "a" "m" "m">>
<<person1>>
<<if (_npc.love or 0) gte 18>>
	宅邸街拐角的路灯下，缠着护腕绷带的林恩一看到你便掐灭了烟头，快步迎上来将你护在靠墙的内侧。他脱下身上带着体温的皮夹克披在你肩上，眼神坚定而温柔："我在这一直盯着呢，有我在，没人能欺负你。"
<<elseif (_npc.love or 0) gte 6 or (_npc.trust or 0) gte 6>>
	倒钩街旧修车库的铁卷门半开着，林恩正对着沙袋练习拳法。听见你的脚步声，他立刻收拳抓起毛巾擦了擦汗，笑着朝你招手："来啦？锅里还温着肉汤，先喝一碗垫垫肚子。"
<<else>>
	宅邸街与孤儿院交界的暗巷口，身材精悍的林恩正靠在砖墙边缠着指节上的白绷带。他抬起那双锐利的眼睛打量了你一番，看清是你后才放低了拳架，声音干脆利落："这么晚还在街上晃？需要搭把手尽管开口。"
<</if>>
<<if Weather.precipitation is "rain">>
	雨水顺着旧修车库的铁皮屋檐倾泻而下，屋内的炭火盆却烧得噼啪作响。
<<else>>
	静谧的街巷里只有林恩击打沙袋的沉闷响声，给人一种无比踏实的安全感。
<</if>>
<br><br>
<<link [[告别离开 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<link [[坐在修车库木箱上与林恩闲聊巡夜见闻 (0:06)|MP NPC Lin Chat]]>><<pass 6>><<stress -5>><</link>><<lstress>><<glove>>
<br>
<<link [[请林恩指导近身防身步法与反关节脱困 (0:15)|MP NPC Lin Service]]>><<pass 15>><</link>><<glove>>
<br>
<<link [[帮林恩更换手腕绷带与整理巡夜装备 (0:14)|MP NPC Lin Help]]>><<pass 14>><<tiredness 2>><<stress -4>><</link>><<gtiredness>><<lstress>><<glove>>
<br>
<<if (_npc.love or 0) gte 4 or ($promiscuity or 0) gte 15>>
	<<link [[伸手触碰林恩眉骨的旧疤并贴近他胸口 (0:04)|MP NPC Lin Flirt]]>><<pass 4>><<arousal 500>><</link>><<promiscuous1>><<glove>><<garousal>>
	<br>
<</if>>
<<if ((_npc.love or 0) gte 15 or (_npc.lust or 0) gte 12) and (!$daily or !$daily.mpNpcIntimate_lin)>>
	<<link [[在修车库阁楼的软垫上与林恩热烈相拥 (0:26)|MP NPC Lin Intimate]]>><<if !$daily>><<set $daily to {}>><</if>><<set $daily.mpNpcIntimate_lin to 1>><<pass 26>><<arousal 1800>><<stress -12>><</link>><<promiscuous2>><<lstress>><<glove>><<ggarousal>>
	<br>
<</if>>
<<if (_npc.stage or 0) lt 10 and (!$daily or !$daily.mpNpcQuest_lin)>>
	<<link [[并肩推进『地下铁笼与孤儿院守夜人』 (0:22)|MP NPC Lin Quest]]>><<if !$daily>><<set $daily to {}>><</if>><<set $daily.mpNpcQuest_lin to 1>><<pass 22>><</link>>
	<br>
<</if>>

