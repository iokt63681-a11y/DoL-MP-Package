<<set $outside to 1>><<set $location to "forest">><<effects>><<mpAmbient>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.ash to ($mpNpcs.ash or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.ash>><<set _npc.hasMet to 1>>
<<if !$daily>><<set $daily to {}>><</if>>
<<if !$daily.mpNpcSrv_ash>><<set $daily.mpNpcSrv_ash to 1>><<tending 2>><<tiredness -3>><<stress -5>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if $mpNpcs and $mpNpcs.ash and $mpNpcs.ash.hasMet>>阿什<<else>>守灯人<</if>>带你走过一段隐秘的树根高地，教你用松针掩去气味。你在山林里的步伐愈发轻巧。<span class="green">你熟悉了深林避险的法门。</span><<else>><<if $mpNpcs and $mpNpcs.ash and $mpNpcs.ash.hasMet>>阿什<<else>>守灯人<</if>>替你绑紧松脱的靴带，递给你一截驱虫艾草。<span class="teal">你在林间行走安心了许多。</span><<stress -2>><</if>>
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.ash and $mpNpcs.ash.hasMet>><<link [[回阿什身边 (0:02)|MP NPC Ash Hub]]>><<pass 2>><</link>><<else>><span class="disabled">回阿什身边 (0:02)（尚未结识）</span><</if>>
