	<<set _exitPas to "School Library">>
<</if>>
<<endevent>>
<<generateNPC 1 "a" "f" "f">>
<<person1>>
<<if (_npc.love or 0) gte 18>>
	旧理科准备室的阳光透过玻璃烧瓶，照在诺艾尔微垂的眼睫上。一抬头看见你，她的脸颊顿时浮起两朵红云，连忙放下手里的羽毛笔迎上来牵住你的衣袖："我刚刚泡好了加了蜜糖的洋甘菊茶，正盼着你能来陪我呢。"
<<elseif (_npc.love or 0) gte 6 or (_npc.trust or 0) gte 6>>
	安静的标本架旁，诺艾尔正小心翼翼地用镊子压平一片银杏叶。听到你的脚步声，她欣喜地抬起头，推了推鼻梁上的细框眼镜，将一碟烘干的香草饼干推到你面前："你来啦，今天在外面累不累？"
<<else>>
	学园角落的标本准备室里飘着淡淡的薄荷与干花清香。诺艾尔正抱着一摞厚重的植物图谱站在木梯旁，看见你走进来，她有些局促地拢了拢裙摆，小声问道："那个……你也是来借阅植物图谱，还是需要跌打草药？"
<</if>>
<<if Weather.precipitation is "rain">>
	窗外细雨打在学园的爬山虎叶片上，准备室的小酒精灯散发着融融暖意。
<<else>>
	微风吹拂着窗台上的风干薰衣草束，空气里满是令人心安的草木甜香。
<</if>>
<br><br>
<<link [[告别诺艾尔离开 (0:02)|_exitPas]]>><<set $outside to 0>><<set $location to "school">><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<link [[在标本架旁聊起花草 (0:06)|MP NPC Noel Chat]]>><<pass 6>><<stress -5>><</link>><<lstress>><<glove>>
<br>
<<link [[请她调配蓝冠草香膏 (0:09)|MP NPC Noel Service]]>><<pass 9>><</link>><<glove>>
<br>
<<link [[帮她压制干花标本 (0:16)|MP NPC Noel Help]]>><<pass 16>><<tiredness 2>><<stress -4>><</link>><<gtiredness>><<lstress>><<glove>>
<br>
<<if (_npc.love or 0) gte 4 or ($promiscuity or 0) gte 15>>
	<<link [[替她摘下发间干花瓣 (0:04)|MP NPC Noel Flirt]]>><<pass 4>><<arousal 500>><</link>><<promiscuous1>><<glove>><<garousal>>
	<br>
<</if>>
<<if ((_npc.love or 0) gte 15 or (_npc.lust or 0) gte 12) and (!$daily or !$daily.mpNpcIntimate_noel)>>
	<<link [[随她进温室花房深处 (0:26)|MP NPC Noel Intimate]]>><<if !$daily>><<set $daily to {}>><</if>><<set $daily.mpNpcIntimate_noel to 1>><<pass 26>><<arousal 1800>><<stress -12>><</link>><<promiscuous2>><<lstress>><<glove>><<ggarousal>>
	<br>
<</if>>
<<if (_npc.stage or 0) lt 10 and (!$daily or !$daily.mpNpcQuest_noel)>>
