<<if ($seductionskill or 0) gte 240 or (_npc.love or 0) gte 10>>你低头替<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>系紧皮护腕，指尖摩挲过他脉搏。他耳根微热，反手将你拉进怀里护在风衣下：「别乱动，让我抱一会儿。」<span class="green">他有力双臂将你护得严严实实。</span><<stress -3>><<else>>你替<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>拂去额角细汗。他偏过头轻咳一声，嘴角却压不住笑意。<span class="teal">冷硬的气场融化了几分。</span><</if>>
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[回林恩身边 (0:02)|MP NPC Lin Hub]]>><<pass 2>><</link>><<else>><span class="disabled">回林恩身边 (0:02)（尚未结识）</span><</if>>
<br>
<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<socialiseicon>><<link [[低声交谈 (0:04)|MP NPC Lin Chat]]>><<pass 4>><<stress -2>><</link>><<else>><span class="disabled">低声交谈 (0:04)（尚未结识）</span><</if>>

:: MP NPC Lin Intimate [nobr]
<<set $outside to 0>><<set $location to "town">><<effects>><<mpAmbient>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.lin to ($mpNpcs.lin or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.lin>><<set _npc.hasMet to 1>>
<<set _npc.love to Math.min(100, (_npc.love or 0) + 3)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>><<set _npc.lust to Math.max(0, (_npc.lust or 0) - 3)>>
值班室的铁炉烧得正旺。<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>卸下护具，将你困在行军床与木墙之间，温热指腹轻抚过你肩头旧伤，动作克制而滚烫。<span class="green">你在他怀中睡得无比踏实。</span><<stress -12>><<tiredness -4>><<trauma -4>>
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[整理衣衫 (0:04)|MP NPC Lin Hub]]>><<pass 4>><</link>><<else>><span class="disabled">整理衣衫 (0:04)（尚未结识）</span><</if>>

:: MP NPC Lin Quest [nobr]
<<set $outside to 1>><<set $location to "town">><<effects>><<mpAmbient>>
<<if !$mpNpcs>><<set $mpNpcs to {}>><</if>>
<<if !$mpNpcs.lin>><<set $mpNpcs.lin to { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0, hasMet: 0 }>><</if>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.lin to ($mpNpcs.lin or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.lin>><<set _npc.hasMet to 1>><<set _stg to (_npc.stage or 0)>>
<<if _stg gte 5>>
	<<include "MP NPC Lin Quest Late">>
<<elseif _stg is 2>>
	黑铁货运站保卫科的铁皮窗紧锁，里面存着地下拳场的假拳分红底单。<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>在巷口放哨，让你用钢片顶开窗扣，或从屋顶气窗顺绳滑入。
	<br><br>
	<<getouticon>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[回林恩身边 (0:03)|MP NPC Lin Hub]]>><<pass 3>><</link>><<else>><span class="disabled">回林恩身边 (0:03)（尚未结识）</span><</if>>
	<br>
	<<if ($skulduggery or 0) gte 260 or ($science or 0) gte 240>>
		<<sneakicon>><<link [[顶开双簧窗扣 (0:08)|MP NPC Lin Quest 3 Pass]]>><<set $mpNpcQuestAct to 1>><<pass 8>><</link>>
	<<else>>
		<<walkicon>><<link [[顶开双簧窗扣 (0:08)|MP NPC Lin Quest 3 Fail]]>><<set $mpNpcQuestAct to 1>><<pass 8>><</link>>
	<</if>>
	<br>
	<<if ($athletics or 0) gte 260 or ($physique or 10000) gte 11600 or (_npc.trust or 0) gte 10>>
		<<runicon>><<link [[从天窗翻入 (0:08)|MP NPC Lin Quest 3 Pass]]>><<set $mpNpcQuestAct to 2>><<pass 8>><</link>>
	<<else>>
		<<link [[从天窗翻入 (0:08)|MP NPC Lin Quest 3 Fail]]>><<set $mpNpcQuestAct to 2>><<pass 8>><</link>>
	<</if>>
<<else>>
	<<set _npc.stage to Math.min(10, _stg + 1)>><<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>>
	<<if _stg is 0>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>把一张黑拳赛催命单拍在木箱上：「赌庄老板要逼孤儿院大孩子打黑赛抵债，帮我摸清他们账房底细。」
	<<elseif _stg is 1>>你们换上粗布工装混进丰收街酒馆后院，借搬运空酒桶摸清了地下拳场暗门守卫的换班钟点。
	<<elseif _stg is 3>>撤出工业巷时三名打手堵住去路，<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>与你互成掎角之势，三拳两脚将对方放倒在泥水里。
	<<elseif _stg is 4>>回到修车库二楼阁楼，你用温热药酒替<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>擦拭肩背淤青，他在昏黄灯下低声说绝不让人动你分毫。
	<</if>>
	<br><br>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("npc_quest_lin_" + _npc.stage)>>
		<<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250 or ($science or 0) gte 250>><<money 1500>><<stress -4>><span class="gold"><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>将 <span class="gold">£15</span> 补贴塞进你掌心。</span><<else>><<stress 2>><span class="gold"><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>没有补贴。</span><</if>>
	<<else>><<stress -2>><</if>>
	<br><br>
	<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[收好东西回去 (0:03)|MP NPC Lin Hub]]>><<pass 3>><</link>><<else>><span class="disabled">收好东西回去 (0:03)（尚未结识）</span><</if>>
	<br>
	<<if _npc.stage gte 5>><<link [[翻看后续卷宗 (0:03)|MP NPC Lin Quest Late]]>><<pass 3>><</link>><<else>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[核对下一步去向 (0:04)|MP NPC Lin Hub]]>><<pass 4>><<stress -2>><</link>><<else>><span class="disabled">核对下一步去向 (0:04)（尚未结识）</span><</if>><</if>>
<</if>>

:: MP NPC Lin Quest Late [nobr]
<<set $outside to 1>><<set $location to "town">><<effects>><<mpAmbient>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.lin to ($mpNpcs.lin or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.lin>><<set _stg to (_npc.stage or 5)>>
<<if _stg is 5>>
	酒馆地窖铁笼里关着被逼签字的大孩子，笼门挂着沉重的棘轮锁。<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>用铁棍卡住门轴，让你撬开棘轮簧片，或合力将生锈的门轴插销直接拔出。
	<br><br>
	<<getouticon>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[回林恩身边 (0:03)|MP NPC Lin Hub]]>><<pass 3>><</link>><<else>><span class="disabled">回林恩身边 (0:03)（尚未结识）</span><</if>>
	<br>
	<<if ($skulduggery or 0) gte 270 or ($willpower or 0) gte 450>>
		<<sneakicon>><<link [[拨开棘轮止回爪 (0:09)|MP NPC Lin Quest 6 Pass]]>><<set $mpNpcQuestAct to 1>><<pass 9>><</link>>
	<<else>>
		<<walkicon>><<link [[拨开棘轮止回爪 (0:09)|MP NPC Lin Quest 6 Fail]]>><<set $mpNpcQuestAct to 1>><<pass 9>><</link>>
	<</if>>
	<br>
	<<if ($physique or 10000) gte 11800 or ($athletics or 0) gte 270 or (_npc.love or 0) gte 10>>
		<<fisticon>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[拔出门轴铁销 (0:09)|MP NPC Lin Quest 6 Pass]]>><<set $mpNpcQuestAct to 2>><<pass 9>><</link>><<else>><span class="disabled">拔出门轴铁销 (0:09)（尚未结识）</span><</if>>
	<<else>>
		<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[拔出门轴铁销 (0:09)|MP NPC Lin Quest 6 Fail]]>><<set $mpNpcQuestAct to 2>><<pass 9>><</link>><<else>><span class="disabled">拔出门轴铁销 (0:09)（尚未结识）</span><</if>>
	<</if>>
<<elseif _stg is 8>>
	地下赌庄今晚要把总账转移去码头，<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>拉下工业巷总蒸汽阀制造白雾。他让你趁浓雾贴身截走账房怀里的皮包，或推倒货架封死护卫退路。
	<br><br>
	<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[先退回林恩身旁 (0:03)|MP NPC Lin Hub]]>><<pass 3>><</link>><<else>><span class="disabled">先退回林恩身旁 (0:03)（尚未结识）</span><</if>>
	<br>
	<<if ($skulduggery or 0) gte 280 or ($danceskill or 0) gte 260>>
		<<link [[顺走总账皮包 (0:10)|MP NPC Lin Quest 9 Pass]]>><<set $mpNpcQuestAct to 1>><<pass 10>><</link>>
	<<else>>
		<<link [[顺走总账皮包 (0:10)|MP NPC Lin Quest 9 Fail]]>><<set $mpNpcQuestAct to 1>><<pass 10>><</link>>
	<</if>>
	<br>
	<<if ($physique or 10000) gte 12000 or ($athletics or 0) gte 280 or (_npc.trust or 0) gte 12>>
		<<link [[推倒货架拦护卫 (0:10)|MP NPC Lin Quest 9 Pass]]>><<set $mpNpcQuestAct to 2>><<pass 10>><</link>>
	<<else>>
		<<link [[推倒货架拦护卫 (0:10)|MP NPC Lin Quest 9 Fail]]>><<set $mpNpcQuestAct to 2>><<pass 10>><</link>>
	<</if>>
<<else>>
	<<set _npc.stage to Math.min(10, _stg + 1)>><<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>>
	<<if _stg is 6>>你们在商业巷截住赌庄记账师，换出了锁在暗柜里的欠条原件。
	<<elseif _stg is 7>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>当着你的面将胁迫欠条投入铁桶烧成灰烬。
	<<elseif _stg is 9>>夜巡归来，<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>将磨亮的黄铜指虎与车库副匙塞进你手心。
	<<else>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>擦净护腕，递给你一瓶温热的跌打药酒。<</if>>
	<br><br>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("npc_quest_lin_" + _npc.stage + "_keepsake")>>
		<<money 1500>><<stress -4>><span class="gold"><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>把 <span class="gold">£15</span> 分红塞进你掌心。</span>
	<<else>><<stress -2>><</if>>
	<br><br>
	<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[收好旧物回去 (0:03)|MP NPC Lin Hub]]>><<pass 3>><</link>><<else>><span class="disabled">收好旧物回去 (0:03)（尚未结识）</span><</if>>
	<br>
	<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[清点所得线索 (0:04)|MP NPC Lin Hub]]>><<pass 4>><<stress -2>><</link>><<else>><span class="disabled">清点所得线索 (0:04)（尚未结识）</span><</if>>
<</if>>

:: MP NPC Lin Quest 3 Pass [nobr]
<<set $outside to 1>><<set $location to "town">><<effects>><<mpAmbient>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.lin to ($mpNpcs.lin or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.lin>><<set _npc.stage to 3>>
<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>>
<<if ($mpNpcQuestAct or 1) is 1>>
	你将薄钢片顺着窗缝滑入，精准顶起双簧卡舌，无声推开铁窗翻出抽屉里的假拳分红底单。<span class="green">你用薄钢片悄无声息挑开了窗锁。</span>
<<else>>
	你借着雨水管攀上平顶，推开通气天窗轻巧落地，从桌上拓下假拳分红底单后原路翻出。<span class="green">你从屋顶气窗顺利取得了底单。</span>
<</if>>
<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("npc_quest_lin_3")>>
	<<money 1500>><span class="gold"><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>>林恩<<else>>守夜人<</if>>将初探所得的 <span class="gold">£15</span> 酬劳塞进你掌心。</span>
<</if>>
<<stress -5>><<lstress>>
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[回落脚处 (0:04)|MP NPC Lin Hub]]>><<pass 4>><</link>><<else>><span class="disabled">回落脚处 (0:04)（尚未结识）</span><</if>>
<br>
<<investigateicon>><<link [[收拢旧物证 (0:03)|MP NPC Lin Hub]]>><<pass 3>><<stress -2>><</link>>

:: MP NPC Lin Quest 3 Fail [nobr]
<<set $outside to 1>><<set $location to "town">><<effects>><<mpAmbient>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.lin to ($mpNpcs.lin or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.lin>>
<<if ($mpNpcQuestAct or 1) is 1>>
