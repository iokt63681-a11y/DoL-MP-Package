:: MP NPC Noel Quest [nobr]
<<set $outside to 0>><<set $location to "school">><<effects>><<mpAmbient>>
<<if !$mpNpcs>><<set $mpNpcs to {}>><</if>>
<<if !$mpNpcs.noel>><<set $mpNpcs.noel to { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0, hasMet: 0 }>><</if>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.noel to ($mpNpcs.noel or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.noel>><<set _npc.hasMet to 1>><<set _stg to (_npc.stage or 0)>>
<<if _stg gte 5>>
	<<include "MP NPC Noel Quest Late">>
<<elseif _stg is 2>>
	银脉兰块茎必须用温水剥去外层带刺的毒荨麻膜才能入土。<<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>递来竹镊，让你夹除细小毒刺，或调配薄荷碱水先行中和。
	<br><br>
	<<getouticon>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>><<link [[回诺艾尔身边 (0:03)|MP NPC Noel Hub]]>><<pass 3>><</link>><<else>><span class="disabled">回诺艾尔身边 (0:03)（尚未结识）</span><</if>>
	<br>
	<<if ($tending or 0) gte 250 or ($skulduggery or 0) gte 240>>
		<<tendingicon>><<link [[夹除毒刺 (0:08)|MP NPC Noel Quest 3 Pass]]>><<set $mpNpcQuestAct to 1>><<pass 8>><</link>>
	<<else>>
		<<walkicon>><<link [[夹除毒刺 (0:08)|MP NPC Noel Quest 3 Fail]]>><<set $mpNpcQuestAct to 1>><<pass 8>><</link>>
	<</if>>
	<br>
	<<if ($science or 0) gte 250 or ($housekeeping or 0) gte 250 or (_npc.trust or 0) gte 10>>
		<<investigateicon>><<link [[泡薄荷碱水脱膜 (0:08)|MP NPC Noel Quest 3 Pass]]>><<set $mpNpcQuestAct to 2>><<pass 8>><</link>>
	<<else>>
		<<link [[泡薄荷碱水脱膜 (0:08)|MP NPC Noel Quest 3 Fail]]>><<set $mpNpcQuestAct to 2>><<pass 8>><</link>>
	<</if>>
<<else>>
	<<set _npc.stage to Math.min(10, _stg + 1)>><<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>>
	<<if _stg is 0>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>在理科旧准备室翻出一册植物图谱，里面夹着半片泛银光的干枯花瓣：「这是失传的雾月银脉兰。」
	<<elseif _stg is 1>>宵禁后，<<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>带你从学园后门溜去公园旧玻璃花房，在荒废花坛下挖出三枚尚有生机的银脉兰块茎。
	<<elseif _stg is 3>>恒温蒸馏器接口松脱，喷出一团清甜白雾。<<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>脸颊绯红地把你拉到通风窗边，两人在微喘中贴在一起平复心跳。
	<<elseif _stg is 4>>为查最后味辅料，你们在图书馆古籍架死角翻书，<<if $NPCNameList and $NPCNameList.includes("Leighton")>>礼顿<<else>>值班校官<</if>>突然巡查经过，<<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>慌忙捂住你的嘴躲进阴影。
	<</if>>
	<br><br>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("npc_quest_noel_" + _npc.stage)>>
		<<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250 or ($science or 0) gte 250>><<money 1500>><<stress -4>><span class="gold"><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>将 <span class="gold">£15</span> 补贴塞进你掌心。</span><<else>><<stress 2>><span class="gold"><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>没有补贴。</span><</if>>
	<<else>><<stress -2>><</if>>
	<br><br>
	<<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>><<link [[收好东西回去 (0:03)|MP NPC Noel Hub]]>><<pass 3>><</link>><<else>><span class="disabled">收好东西回去 (0:03)（尚未结识）</span><</if>>
	<br>
	<<if _npc.stage gte 5>><<link [[翻看后续卷宗 (0:03)|MP NPC Noel Quest Late]]>><<pass 3>><</link>><<else>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>><<link [[核对下一步去向 (0:04)|MP NPC Noel Hub]]>><<pass 4>><<stress -2>><</link>><<else>><span class="disabled">核对下一步去向 (0:04)（尚未结识）</span><</if>><</if>>
<</if>>

:: MP NPC Noel Quest Late [nobr]
<<set $outside to 0>><<set $location to "school">><<effects>><<mpAmbient>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.noel to ($mpNpcs.noel or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.noel>><<set _stg to (_npc.stage or 5)>>
<<if _stg is 5>>
	辅料所需的月光白苔只长在沉没修道院暗河边的滑石上，稍见强光便会枯萎。<<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>遮住提灯，让你用骨刀整片刮取，或连着底石整块凿下。
	<br><br>
	<<getouticon>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>><<link [[回诺艾尔身边 (0:03)|MP NPC Noel Hub]]>><<pass 3>><</link>><<else>><span class="disabled">回诺艾尔身边 (0:03)（尚未结识）</span><</if>>
	<br>
	<<if ($tending or 0) gte 270 or ($science or 0) gte 260>>
		<<tendingicon>><<link [[刮取石缝白苔 (0:09)|MP NPC Noel Quest 6 Pass]]>><<set $mpNpcQuestAct to 1>><<pass 9>><</link>>
	<<else>>
		<<walkicon>><<link [[刮取石缝白苔 (0:09)|MP NPC Noel Quest 6 Fail]]>><<set $mpNpcQuestAct to 1>><<pass 9>><</link>>
	<</if>>
	<br>
	<<if ($athletics or 0) gte 260 or ($willpower or 0) gte 440 or (_npc.love or 0) gte 10>>
		<<sneakicon>><<link [[凿下薄石片 (0:09)|MP NPC Noel Quest 6 Pass]]>><<set $mpNpcQuestAct to 2>><<pass 9>><</link>>
	<<else>>
		<<link [[凿下薄石片 (0:09)|MP NPC Noel Quest 6 Fail]]>><<set $mpNpcQuestAct to 2>><<pass 9>><</link>>
	<</if>>
<<elseif _stg is 8>>
	寒潮夜里温室主蒸汽管压力骤降，正在开花的双生银脉兰随时会冻伤。<<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>守着温床，让你去扳开副炉分流铜阀，或用双层棉毡搭起保温内棚。
	<br><br>
	<<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>><<link [[先退回诺艾尔身旁 (0:03)|MP NPC Noel Hub]]>><<pass 3>><</link>><<else>><span class="disabled">先退回诺艾尔身旁 (0:03)（尚未结识）</span><</if>>
	<br>
	<<if ($physique or 10000) gte 11600 or ($science or 0) gte 270>>
		<<link [[扳开副炉分阀 (0:10)|MP NPC Noel Quest 9 Pass]]>><<set $mpNpcQuestAct to 1>><<pass 10>><</link>>
	<<else>>
		<<link [[扳开副炉分阀 (0:10)|MP NPC Noel Quest 9 Fail]]>><<set $mpNpcQuestAct to 1>><<pass 10>><</link>>
	<</if>>
	<br>
	<<if ($tending or 0) gte 280 or ($housekeeping or 0) gte 270 or (_npc.trust or 0) gte 12>>
		<<link [[搭起保温棚 (0:10)|MP NPC Noel Quest 9 Pass]]>><<set $mpNpcQuestAct to 2>><<pass 10>><</link>>
	<<else>>
		<<link [[搭起保温棚 (0:10)|MP NPC Noel Quest 9 Fail]]>><<set $mpNpcQuestAct to 2>><<pass 10>><</link>>
	<</if>>
<<else>>
	<<set _npc.stage to Math.min(10, _stg + 1)>><<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>>
	<<if _stg is 6>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>将银脉兰与白苔合入铜釜，萃出淡紫色的安神原液。
	<<elseif _stg is 7>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>将花露交予多瑙河街药剂行，换回经费与温室通行牌。
	<<elseif _stg is 9>>晨光洒满准备室，<<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>将双生银丝花琥珀胸针别在你领口。
	<<else>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>收好标本册，为你斟了一杯花茶。<</if>>
	<br><br>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("npc_quest_noel_" + _npc.stage + "_keepsake")>>
		<<money 1500>><<stress -4>><span class="gold"><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>把 <span class="gold">£15</span> 分红塞进你掌心。</span>
	<<else>><<stress -2>><</if>>
	<br><br>
