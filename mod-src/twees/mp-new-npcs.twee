<</if>>
<<if _helpPaid>>
	<<if ($housekeeping or 0) gte 240 or ($tending or 0) gte 240 or ($athletics or 0) gte 240>>你帮<<if $mpNpcs and $mpNpcs.monet and $mpNpcs.monet.hasMet>>莫奈<<else>>画师<</if>>绷紧六幅亚麻画框并研磨好青金石颜料。<span class="green"><<if $mpNpcs and $mpNpcs.monet and $mpNpcs.monet.hasMet>>莫奈<<else>>画师<</if>>从画金匣里取出 <span class="gold">£12</span> 塞进你手心。</span><<stress -3>><<else>>松节油倒多了些，弄脏了一角衬布。<span class="teal"><<if $mpNpcs and $mpNpcs.monet and $mpNpcs.monet.hasMet>>莫奈<<else>>画师<</if>>笑着替你擦净手指，只替你收拾好工具，没有补贴。</span><<stress 2>><</if>>
<<else>>你帮<<if $mpNpcs and $mpNpcs.monet and $mpNpcs.monet.hasMet>>莫奈<<else>>画师<</if>>把洗净的画笔按号数排在笔架上。<span class="teal">画室整洁有序，她赏了你一颗酒心巧克力。</span><</if>>
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.monet and $mpNpcs.monet.hasMet>><<link [[回莫奈身边 (0:02)|MP NPC Monet Hub]]>><<pass 2>><</link>><<else>><span class="disabled">回莫奈身边 (0:02)（尚未结识）</span><</if>>
<br>
<<tendingicon>><<link [[研磨矿物颜料 (0:06)|MP NPC Monet Hub]]>><<pass 6>><<if ($willpower or 0) gte 420>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<stress -2>><<else>><<tiredness 1>><</if>><</link>>

:: MP NPC Monet Flirt [nobr]
<<set $outside to 0>><<set $location to "cafe">><<effects>><<mpAmbient>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.monet to ($mpNpcs.monet or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.monet>><<set _npc.hasMet to 1>>
