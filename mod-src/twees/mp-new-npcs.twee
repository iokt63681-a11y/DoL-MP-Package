/* 六位常驻镇民NPC剧本库（V6精修版：含36段关键阶段检定分支、UI规范化、$location对齐） */

:: MP NPC Sera Hub [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<if !$mpNpcs>><<set $mpNpcs to {}>><</if>>
<<if !$mpNpcs.sera>><<set $mpNpcs.sera to { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0, hasMet: 1 }>><</if>>
<<set _npc to $mpNpcs.sera>><<set _npc.hasMet to 1>>
<<set _exitPas to ($mpReturnPassage or "High Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "High Street">><</if>>
<<endevent>><<generateNPC 1 "a" "f" "f">><<person1>>
<<if (_npc.love or 0) gte 18>>煤油灯暖光映着塞拉的侧脸。听见门铃响，她放下镊子翻过木牌，握住你微凉的指尖贴在颊边：「我听着钟声，就知你该来了。」<<elseif (_npc.love or 0) gte 6 or (_npc.trust or 0) gte 6>>推开高街钟表铺的玻璃门，塞拉摘下放大镜，将柜上一杯热红茶推到你手边：「外面风大，先暖暖手。」<<else>>钟表铺里浮着机油与旧纸气息。塞拉戴着单眼放大镜夹着细齿轮，抬眼看向你：「要修表，还是带了旧物？」<</if>>
<<if Weather.precipitation is "rain">>窗外雨水顺着玻璃滑落，店内座钟齐声滴答。<<else>>斜阳穿过橱窗，在黄铜钟摆上投下金光。<</if>>
<br><br>
<<getouticon>><<link [[告别塞拉离开 (0:02)|_exitPas]]>><<set $outside to 1>><<set $location to "town">><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<link [[在柜台边聊钟表旧闻 (0:06)|MP NPC Sera Chat]]>><<pass 6>><<stress -4>><</link>>
<br>
<<shopicon>><<link [[请她看随身古物 (0:08)|MP NPC Sera Service]]>><<pass 8>><</link>>
<br>
<<tendingicon>><<link [[帮她分拣机芯齿轮 (0:16)|MP NPC Sera Help]]>><<pass 16>><<tiredness 2>><<stress -3>><</link>>
<br>
<<if (_npc.stage or 0) lt 10 and (!$daily or !$daily.mpNpcQuest_sera)>>
	<<investigateicon>><<link [[问起那枚停摆怀表 (0:20)|MP NPC Sera Quest]]>><<if !$daily>><<set $daily to {}>><</if>><<set $daily.mpNpcQuest_sera to 1>><<pass 20>><</link>>
	<br>
<</if>>

:: MP NPC Sera Chat [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>><<set _npc.hasMet to 1>>
<<if !$daily>><<set $daily to {}>><</if>>
<<if !$daily.mpNpcChat_sera>><<set $daily.mpNpcChat_sera to 1>><<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><</if>>
<<if (_npc.love or 0) gte 18>>你坐在柜台内侧的高脚凳上，看塞拉用绒布擦拭古董三问表。她偏头与你低语，顺手将碎发别到你耳后。<<elseif (_npc.love or 0) gte 6>>你倚在柜台边与塞拉聊起高街近况。她转动游丝扳手，提醒你夜里避开市政厅后巷的巡哨。<<else>>你隔着玻璃展柜看塞拉校准钟摆。她话虽不多，但每当你问起机芯来历，她都会耐心解答。<</if>>
<br><br>
<<getouticon>><<link [[回到塞拉身旁 (0:02)|MP NPC Sera Hub]]>><<pass 2>><</link>>
<br>
<<link [[凑近灯下轻握她手腕 (0:04)|MP NPC Sera Flirt]]>><<pass 4>><<arousal 300>><</link>>
<br>
<<if ((_npc.love or 0) gte 15 or (_npc.lust or 0) gte 12) and (!$daily or !$daily.mpNpcIntimate_sera)>>
	<<mphearticon>><<link [[随她上钟表铺阁楼 (0:25)|MP NPC Sera Intimate]]>><<if !$daily>><<set $daily to {}>><</if>><<set $daily.mpNpcIntimate_sera to 1>><<pass 25>><<arousal 1200>><<stress -10>><</link>>
	<br>
<</if>>
<<if (_npc.love or 0) gte 8 or (_npc.trust or 0) gte 8>>
	<<walkicon>><<link [[约她打烊后去旧街走走 (0:08)|MP Extra Daily Sera 1]]>><<pass 8>><</link>>
<</if>>

:: MP NPC Sera Service [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>><<set _npc.hasMet to 1>>
<<if ($mpAntiquesUnappraised or 0) gt 0>>
	<<set _cnt to $mpAntiquesUnappraised>><<set _pay to _cnt * 1500>><<set $mpAntiquesUnappraised to 0>><<money _pay>>
	<<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>你取出收集到的未鉴定古物放在绒布垫上。塞拉戴上放大镜细看铭文，从抽屉里点出银币递给你。<span class="gold">你换到了应得的古物折现。</span>
<<else>>塞拉用绒布擦了擦放大镜：「去海滩暗礁或旧街巷尾找找，若有蒙尘的古物，随时拿来给我掌眼。」<span class="teal">她顺手替你紧了紧衣袖铜扣。</span><<stress -2>><</if>>
<br><br>
<<getouticon>><<link [[退回塞拉身旁 (0:02)|MP NPC Sera Hub]]>><<pass 2>><</link>>
<br>
<div id="srv-sub-sera">
<<investigateicon>><<link "请她用镊子调校表扣 (0:04)">><<pass 4>><<replace "#srv-sub-sera">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240 or ($athletics or 0) gte 240>>你屏息扶稳灯座，看她两指轻拨簧片。<span class="green">卡扣应声归位，你学到了一手巧劲。</span><<stress -2>><<else>>你呼吸急了些，灯影晃动。<span class="red">铜镊擦过表壳，只得下次再试。</span><<stress 2>><</if>>
<</replace>><</link>>
</div>

:: MP NPC Sera Help [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>><<set _npc.hasMet to 1>>
<<if !$daily>><<set $daily to {}>><</if>>
<<set _helpPaid to 0>>
<<if !$daily.mpNpcHelp_sera>>
	<<set $daily.mpNpcHelp_sera to 1>><<set _helpPaid to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>>
	<<if ($housekeeping or 0) gte 240 or ($tending or 0) gte 240 or ($athletics or 0) gte 240>><<money 1200>><<else>><<money 800>><</if>>
<</if>>
<<if _helpPaid>>
	<<if ($housekeeping or 0) gte 240 or ($tending or 0) gte 240 or ($athletics or 0) gte 240>>你按齿数分拣黄铜齿轮，还找出一枚卡在暗槽的银壳怀表。<span class="green">塞拉把 £12 修表分红塞进你手心。</span><<stress -3>><<else>>微小齿轮看得你眼酸，漏排了两组垫片。<span class="teal">塞拉替你收尾，仍塞给你 £8 补贴。</span><<stress 2>><</if>>
<<else>>你又陪塞拉理了一匣零散垫片。<span class="teal">木匣整整齐齐，她给你添了半杯热红茶。</span><<stress -1>><</if>>
<br><br>
<<getouticon>><<link [[擦净双手回到塞拉身旁 (0:02)|MP NPC Sera Hub]]>><<pass 2>><</link>>
<br>
<<link [[对准灯光校齐游丝 (0:06)|MP NPC Sera Hub]]>><<pass 6>><<if ($willpower or 0) gte 420>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<stress -2>><<else>><<tiredness 1>><</if>><</link>>

:: MP NPC Sera Flirt [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>><<set _npc.hasMet to 1>>
<<if !$daily>><<set $daily to {}>><</if>>
<<if !$daily.mpNpcFlirt_sera>><<set $daily.mpNpcFlirt_sera to 1>><<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.lust to Math.min(100, (_npc.lust or 0) + 2)>><</if>>
<<if ($seductionskill or 0) gte 240 or (_npc.love or 0) gte 10>>你凑近煤油灯握住塞拉微凉的手腕。她指尖一颤，反手与你十指相扣，耳根染上薄红：「别闹，游丝要偏了。」<span class="green">她眼底满是纵容。</span><<stress -3>><<else>>你借着递镊子轻轻擦过塞拉的手背。她抬眸看了你一眼，嘴角微扬。<span class="teal">气氛柔和了几分。</span><<stress -1>><</if>>
<br><br>
<<getouticon>><<link [[敛起笑意退回塞拉面前 (0:02)|MP NPC Sera Hub]]>><<pass 2>><</link>>
<br>
<<link [[继续与塞拉低声交谈 (0:04)|MP NPC Sera Chat]]>><<pass 4>><<stress -2>><</link>>

:: MP NPC Sera Intimate [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>><<set _npc.hasMet to 1>>
<<set _npc.love to Math.min(100, (_npc.love or 0) + 3)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>><<set _npc.lust to Math.max(0, (_npc.lust or 0) - 3)>>
阁楼天窗外夜色深沉。塞拉摘下眼镜，任由你将她揽在绒毯边。她温热的呼吸拂过你颈侧，在滴答钟声里紧握着你的手。<span class="green">疲惫与寒意一扫而空。</span><<stress -12>><<tiredness -4>><<trauma -4>>
<br><br>
<<getouticon>><<link [[整理衣衫回到塞拉身旁 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>

:: MP NPC Sera Quest [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<if !$mpNpcs>><<set $mpNpcs to {}>><</if>>
<<if !$mpNpcs.sera>><<set $mpNpcs.sera to { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0, hasMet: 1 }>><</if>>
<<set _npc to $mpNpcs.sera>><<set _npc.hasMet to 1>><<set _stg to (_npc.stage or 0)>>
<<if _stg is 2>>
	竖井铁栅上的铜挂锁已被水汽锈死。塞拉半蹲在青石阶上把煤油棉签递给你，让你趁巡夜换班空档挑锁，或按她手势挡住穿堂风。
	<br><br>
	<<getouticon>><<link [[先退回塞拉身旁 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
	<br>
	<<if ($skulduggery or 0) gte 250 or ($science or 0) gte 240 or (_npc.trust or 0) gte 8>>
		<<investigateicon>><<link [[顺着节拍挑开锈锁舌 (0:08)|MP NPC Sera Quest 3 Pass]]>><<pass 8>><</link>>
		<br>
		<<link [[按塞拉手势扶稳防风灯 (0:08)|MP NPC Sera Quest 3 Pass]]>><<pass 8>><</link>>
	<<else>>
		<<investigateicon>><<link [[顺着节拍挑开锈锁舌 (0:08)|MP NPC Sera Quest 3 Fail]]>><<pass 8>><</link>>
		<br>
		<<link [[按塞拉手势扶稳防风灯 (0:08)|MP NPC Sera Quest 3 Fail]]>><<pass 8>><</link>>
	<</if>>
<<elseif _stg is 5>>
	羊皮星盘底图在胡桃木桌上摊开，上面标着天文翼楼与机括城的三条联动轴线。塞拉递给你分规，让你测算空缺月相轮的朔望齿距。
	<br><br>
	<<link [[先退回塞拉身旁 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
	<br>
	<<if ($maths or 0) gte 260 or ($history or 0) gte 250 or (_npc.love or 0) gte 10>>
		<<link [[用分规测算朔望齿距 (0:08)|MP NPC Sera Quest 6 Pass]]>><<pass 8>><</link>>
		<br>
		<<link [[比对旧钟塔副轴拓片 (0:08)|MP NPC Sera Quest 6 Pass]]>><<pass 8>><</link>>
	<<else>>
		<<link [[用分规测算朔望齿距 (0:08)|MP NPC Sera Quest 6 Fail]]>><<pass 8>><</link>>
		<br>
		<<link [[比对旧钟塔副轴拓片 (0:08)|MP NPC Sera Quest 6 Fail]]>><<pass 8>><</link>>
	<</if>>
<<elseif _stg is 8>>
	高街钟塔顶层的配重副轴正在高速空转，必须在午夜正点前将鎏金发条核心嵌入主擒纵轮。塞拉握紧制动杆，喊你看准缺口推入核心。
	<br><br>
	<<link [[先退回塞拉身旁 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
	<br>
	<<if ($athletics or 0) gte 260 or ($science or 0) gte 260 or (_npc.trust or 0) gte 12>>
		<<link [[看准轮齿缺口推入核心 (0:10)|MP NPC Sera Quest 9 Pass]]>><<pass 10>><</link>>
		<br>
		<<link [[合身拽住副轴配重铁索 (0:10)|MP NPC Sera Quest 9 Pass]]>><<pass 10>><</link>>
	<<else>>
		<<link [[看准轮齿缺口推入核心 (0:10)|MP NPC Sera Quest 9 Fail]]>><<pass 10>><</link>>
		<br>
		<<link [[合身拽住副轴配重铁索 (0:10)|MP NPC Sera Quest 9 Fail]]>><<pass 10>><</link>>
	<</if>>
<<else>>
	<<set _npc.stage to Math.min(10, _stg + 1)>><<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>>
	<<if _stg is 0>>塞拉取出停在十一时四十七分的银壳怀表，挑开内盖露出十二宫齿痕：「这是旧钟塔早年的副轴制式。」
	<<elseif _stg is 1>>塞拉拼起三份市政修缮底图，量出钟塔基座下被封死的通风竖井：「明晚换班时，我们去听听擒纵叉动静。」
	<<elseif _stg is 3>>回到二楼工作台，塞拉熔化焊锡，让你用夹具稳住受损冠轮。火苗映着她的瞳孔，齿轮终于修整如初。
	<<elseif _stg is 4>>塞拉将复原的冠轮卡进副轴槽位，报时音筒转过半圈，吐出一卷藏在空心轴里的羊皮星盘底图。
	<<elseif _stg is 6>>塞拉换上深灰长裙，与你在后巷拦下旧货经纪，三言两语点破假座钟破绽，取回了装有蓝钢游丝轮的木匣。
	<<elseif _stg is 7>>午夜前，塞拉将蓝钢游丝轮嵌入古星盘底座，十二道机括簧片依次弹开，升起一枚鎏金发条核心。
	<<elseif _stg is 9>>黎明前，塞拉与你登上钟塔顶层锁死副轴封盖。晨钟敲响第一记浑厚钟声，她在钟鸣里轻轻握住你的手腕。
	<<else>>塞拉将整套旧物妥善收好，给你倒了一杯热饮。<</if>>
	<br><br>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("npc_quest_sera_" + _npc.stage)>>
		<<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250 or ($science or 0) gte 250>><<money 1500>><<stress -4>><span class="gold">塞拉将一份 £15 补贴塞进你掌心。</span><<else>><<money 800>><<stress -2>><span class="gold">塞拉分给你 £8 补贴。</span><</if>>
	<<else>><<stress -2>><</if>>
	<br><br>
	<<link [[收好东西回到塞拉身旁 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
	<br>
	<<link [[与塞拉核对下一步去向 (0:04)|MP NPC Sera Hub]]>><<pass 4>><<stress -2>><</link>>
<</if>>

:: MP NPC Sera Quest 3 Pass [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>><<set _npc.stage to 3>>
<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>>
你借着煤油润透的阻力轻轻一拨，三枚铜弹子依次落位。旋梯下露出被撬开的零件箱，塞拉拈起断齿冠轮：「有人故意卡停副钟，想掩盖地底蒸汽抽水声。」<span class="green">你们顺利摸清了竖井下的动静。</span>
<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("npc_quest_sera_3")>>
	<<money 1500>><span class="gold">塞拉把 £15 分红塞进你口袋。</span>
<</if>>
<<stress -5>><<lstress>>
<br><br>
<<getouticon>><<link [[随塞拉返回落脚处 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<br>
<<link [[整理刚找到的线索物 (0:03)|MP NPC Sera Hub]]>><<pass 3>><<stress -2>><</link>>

:: MP NPC Sera Quest 3 Fail [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>>
探针在潮湿锁芯里打滑，防风灯罩烫红了你的指背。巷口突然传来巡夜靴声，塞拉连忙吹熄灯火拉你退回暗处，锁舌仍死死卡着。<span class="red">你被灯罩烫伤手指，今晚只得无功而返。</span>
<<pain 2>><<stress 5>><<tiredness 2>><<gpain>><<gstress>><<gtiredness>>
<br><br>
<<getouticon>><<link [[随塞拉退回安全处 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<br>
<<link [[包扎擦伤平复呼吸 (0:05)|MP NPC Sera Hub]]>><<pass 5>><<pain -1>><<stress -1>><</link>>

:: MP NPC Sera Quest 6 Pass [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>><<set _npc.stage to 6>>
<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>>
你稳住分规量准圆弧夹角，算出缺失零件正是三十六齿蓝钢游丝轮。塞拉欣喜地合上账本：「那东西流进了多瑙河街私下拍场，明晚我们去拦人。」<span class="green">你算准了月相轮的制式参数。</span>
<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("npc_quest_sera_6")>>
	<<money 1500>><span class="gold">塞拉把 £15 分红塞进你口袋。</span>
<</if>>
<<stress -5>><<lstress>>
<br><br>
<<getouticon>><<link [[随塞拉返回落脚处 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<br>
<<link [[整理刚找到的线索物 (0:03)|MP NPC Sera Hub]]>><<pass 3>><<stress -2>><</link>>

:: MP NPC Sera Quest 6 Fail [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>>
煤油灯芯爆出一颗火星，你手腕一抖划花了一页草图。两套岁差刻度始终对不上，塞拉揉了揉眉心把图纸收起，让你先去歇息，改日再算。<span class="red">草图被墨迹污损，测算半途中断。</span>
<<pain 2>><<stress 5>><<tiredness 2>><<gpain>><<gstress>><<gtiredness>>
<br><br>
<<getouticon>><<link [[随塞拉退回安全处 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<br>
<<link [[包扎擦伤平复呼吸 (0:05)|MP NPC Sera Hub]]>><<pass 5>><<pain -1>><<stress -1>><</link>>

:: MP NPC Sera Quest 9 Pass [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>><<set _npc.stage to 9>>
<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>>
你顶住呼啸的冷风，在擒纵叉回摆的刹那将鎏金核心严丝合缝地按入卡槽。整座钟塔的齿轮发出低沉悦耳的共鸣，塞拉长舒一口气握紧你的手。<span class="green">鎏金发条核心稳稳咬合归位。</span>
<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("npc_quest_sera_9")>>
	<<money 1500>><span class="gold">塞拉把 £15 分红塞进你口袋。</span>
<</if>>
<<stress -5>><<lstress>>
<br><br>
<<getouticon>><<link [[随塞拉返回落脚处 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<br>
<<link [[整理刚找到的线索物 (0:03)|MP NPC Sera Hub]]>><<pass 3>><<stress -2>><</link>>

:: MP NPC Sera Quest 9 Fail [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set _npc to $mpNpcs.sera>>
狂风从百叶窗灌入，配重铁索猛地回弹擦破你的手掌。你慢了半秒，副轴安全栓自动锁死，塞拉连忙拉你退下检修梯，只能等明日午夜再试。<span class="red">铁索擦伤手掌，错过了午夜校准窗口。</span>
<<pain 2>><<stress 5>><<tiredness 2>><<gpain>><<gstress>><<gtiredness>>
<br><br>
<<getouticon>><<link [[随塞拉退回安全处 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<br>
<<link [[包扎擦伤平复呼吸 (0:05)|MP NPC Sera Hub]]>><<pass 5>><<pain -1>><<stress -1>><</link>>

:: MP NPC Sera Street Encounter [nobr]
<<set $outside to 1>><<set $location to "town">><<effects>>
<<if !$mpNpcs>><<set $mpNpcs to {}>><</if>>
<<if !$mpNpcs.sera>><<set $mpNpcs.sera to { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0, hasMet: 1 }>><</if>>
<<set $mpNpcs.sera.hasMet to 1>>
你在高街转角偶遇拎着工具箱送修座钟的塞拉。她停下脚步，摸出一包热栗子塞进你手里。<span class="green">偶遇让你心头一暖。</span>
<br><br>
<<getouticon>><<link [[向塞拉致意后继续赶路 (0:02)|($mpReturnPassage or "High Street")]]>><<set $outside to 1>><<set $location to "town">><<pass 2>><<stress -2>><<set $eventskip to 1>><</link>>
<br>
<<walkicon>><<link [[停步随塞拉坐坐 (0:04)|MP NPC Sera Hub]]>><<pass 4>><<stress -4>><</link>>

:: MP NPC Vesper Hub [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
<<if !$mpNpcs>><<set $mpNpcs to {}>><</if>>
<<if !$mpNpcs.vesper>><<set $mpNpcs.vesper to { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0, hasMet: 1 }>><</if>>
<<set _npc to $mpNpcs.vesper>><<set _npc.hasMet to 1>>
<<set _exitPas to ($mpReturnPassage or "Docks")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Docks">><</if>>
<<endevent>><<generateNPC 1 "a" "m" "m">><<person1>>
<<if (_npc.love or 0) gte 18>>防风提灯在海雾里摇晃。维斯见你走来，把防水风衣披在你肩头，带着烟草味的手掌按了按你的后颈：「海风冷，跟紧我。」<<elseif (_npc.love or 0) gte 6 or (_npc.trust or 0) gte 6>>集装箱阴影里亮起一点火星。维斯冲你招手，递来半壶温热的生姜朗姆茶：「今晚潮水稳，过来歇会儿。」<<else>>旧港栈桥尽头弥漫着咸水与焦油味。披黑风衣的维斯倚着系船柱核对舱单，抬眼打量你：「带了暗市货包，还是来打听水路？」<</if>>
<<if Weather.precipitation is "rain">>冷雨砸在集装箱铁皮上，港湾水波翻涌。<<else>>远处雾角灯塔的光束扫过黑沉沉的海面。<</if>>
<br><br>
<<getouticon>><<link [[转身离开旧港栈桥 (0:02)|_exitPas]]>><<set $outside to 1>><<set $location to "docks">><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<link [[靠在缆桩边聊水路行情 (0:06)|MP NPC Vesper Chat]]>><<pass 6>><<stress -4>><</link>>
<br>
<<shopicon>><<link [[向他出手暗市货包 (0:08)|MP NPC Vesper Service]]>><<pass 8>><</link>>
<br>
<<tendingicon>><<link [[帮他看风并清点木箱 (0:16)|MP NPC Vesper Help]]>><<pass 16>><<tiredness 2>><<stress -3>><</link>>
<br>
<<if (_npc.stage or 0) lt 10 and (!$daily or !$daily.mpNpcQuest_vesper)>>
	<<investigateicon>><<link [[追问沉船金库的航标 (0:20)|MP NPC Vesper Quest]]>><<if !$daily>><<set $daily to {}>><</if>><<set $daily.mpNpcQuest_vesper to 1>><<pass 20>><</link>>
	<br>
<</if>>

:: MP NPC Vesper Chat [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
<<set _npc to $mpNpcs.vesper>><<set _npc.hasMet to 1>>
<<if !$daily>><<set $daily to {}>><</if>>
<<if !$daily.mpNpcChat_vesper>><<set $daily.mpNpcChat_vesper to 1>><<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><</if>>
<<if (_npc.love or 0) gte 18>>你与维斯并肩坐在系船石阶上。他用小刀削着浮木，低声教你分辨走私船的三短一长灯号。<<elseif (_npc.love or 0) gte 6>>维斯靠着货堆与你聊起近期海关巡逻艇的换防路线，顺手扔给你一枚防风铜打火机。<<else>>海风呼啸，维斯言简意赅地指点你哪几座栈桥夜里少有人走。<</if>>
<br><br>
<<getouticon>><<link [[回到维斯身旁 (0:02)|MP NPC Vesper Hub]]>><<pass 2>><</link>>
<br>
<<link [[借着点烟凑近他领口 (0:04)|MP NPC Vesper Flirt]]>><<pass 4>><<arousal 300>><</link>>
<br>
<<if ((_npc.love or 0) gte 15 or (_npc.lust or 0) gte 12) and (!$daily or !$daily.mpNpcIntimate_vesper)>>
	<<mphearticon>><<link [[随他进底舱密室歇息 (0:25)|MP NPC Vesper Intimate]]>><<if !$daily>><<set $daily to {}>><</if>><<set $daily.mpNpcIntimate_vesper to 1>><<pass 25>><<arousal 1200>><<stress -10>><</link>>
	<br>
<</if>>
<<if (_npc.love or 0) gte 8 or (_npc.trust or 0) gte 8>>
	<<walkicon>><<link [[陪他沿着防波堤夜巡 (0:08)|MP Extra Daily Vesper 1]]>><<pass 8>><</link>>
<</if>>

:: MP NPC Vesper Service [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
<<set _npc to $mpNpcs.vesper>><<set _npc.hasMet to 1>>
<<if ($mpContrabandPackages or 0) gt 0>>
	<<set _cnt to $mpContrabandPackages>><<set _pay to _cnt * 1600>><<set $mpContrabandPackages to 0>><<money _pay>>
	<<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>你把封存完好的暗市货包交到维斯手里。他掂了掂分量，利落地抽出几张旧港钞票塞进你掌心。<span class="gold">货包已稳妥折算成现钱。</span>
<<else>>维斯挑眉看了看你空着的口袋：「黑铁货运站和沉船滩常有散落货包，找到了再来找我销账。」<span class="teal">他替你挡住了迎面的海风。</span><<stress -2>><</if>>
<br><br>
<<getouticon>><<link [[退回维斯身旁 (0:02)|MP NPC Vesper Hub]]>><<pass 2>><</link>>
<br>
<div id="srv-sub-vesper">
<<investigateicon>><<link "请他教你打水手盲结 (0:04)">><<pass 4>><<replace "#srv-sub-vesper">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240 or ($athletics or 0) gte 240>>你手指翻飞绕紧麻绳。<span class="green">双套盲结一拉即紧，维斯赞许地点头。</span><<stress -2>><<else>>湿滑麻绳在掌心散开。<span class="red">指节被粗麻磨红，你还没摸清绕法。</span><<stress 2>><</if>>
<</replace>><</link>>
</div>

