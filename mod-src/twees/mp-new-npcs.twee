<<set $outside to 1>><<set $location to "town">><<effects>><<mpAmbient>>
<<if !$mpNpcs>><<set $mpNpcs to {}>><</if>>
<<if !$mpNpcs.lin>><<set $mpNpcs.lin to { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0, hasMet: 0 }>><</if>>
<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.lin to ($mpNpcs.lin or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.lin>><<set _open to (Time.hour gte 16 or Time.hour lt 7)>><<if _open>><<set _npc.hasMet to 1>><</if>>
<<set _exitPas to ($mpReturnPassage or "Domus Street")>>
