<br>
<<tendingicon>><<link [[帮她压制干花与贴签 (0:16)|MP NPC Noel Help]]>><<pass 16>><<tiredness 2>><<stress -3>><</link>>
<br>
<<if (_npc.stage or 0) lt 10 and (!$daily or !$daily.mpNpcQuest_noel)>>
