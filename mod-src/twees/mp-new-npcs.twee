<<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.noel to ($mpNpcs.noel or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.noel>><<set _npc.hasMet to 1>>
<<if !$daily>><<set $daily to {}>><</if>>
<<if !$daily.mpNpcSrv_noel>><<set $daily.mpNpcSrv_noel to 1>><<stress -8>><<tiredness -4>><<pain -4>><<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>为你冲泡了一盅加了野蜂蜜的缬草安神茶。热茶入腹，紧绷的神经与酸痛渐渐平息。<span class="green">你的身心得到了温柔抚慰。</span><<else>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>用银匙搅动茶汤，让你捧着瓷杯慢慢小口啜饮。<span class="teal">温润药香驱散了大半疲惫。</span><<stress -2>><</if>>
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>><<link [[回诺艾尔身边 (0:02)|MP NPC Noel Hub]]>><<pass 2>><</link>><<else>><span class="disabled">回诺艾尔身边 (0:02)（尚未结识）</span><</if>>
<br>
<div id="srv-sub-noel">
<<investigateicon>><<link "嗅闻安神香脂 (0:04)">><<pass 4>><<replace "#srv-sub-noel">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240 or ($athletics or 0) gte 240>>清凉薄荷与雪松香气直透眉心。<span class="green">你顿觉神清气爽。</span><<stress -2>><<else>>你不小心凑得太近，浓烈樟脑味呛得打了个喷嚏。<span class="red">眼角泛起一抹酸涩。</span><<stress 2>><</if>>
<</replace>><</link>>
</div>
<<if $mpKeepsake and $mpKeepsake["keepsake_glasshouse_amber"]>><br><<keepsakeicon>><<link [[给她看香膏瓶 (0:06)|MP Keepsake Show Amber]]>><<pass 6>><</link>><</if>>

