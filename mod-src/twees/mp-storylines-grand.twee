<<getouticon>><<link [[返回麋鹿街 (0:02)|Elk Street]]>><<set $outside to 1>><<set $location to "elk">><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if ($science or 0) gte 260>><<investigateicon>><<link [[找逃生暗扣 (0:10)|MP Grand Quest Elk Workshop Step4]]>><<set $outside to 0>><<set $location to "underground">><<pass 10>><</link>><<else>><<investigateicon>><<link [[找逃生暗扣 (0:10)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "找逃生暗扣">><<set $mpInsuffReq to "科学等级：<span class='purple'>D</span>">><<pass 10>><</link>><</if>>
