<<set $mpKnown to ($mpKnown or {})>><<set $mpClues to ($mpClues or {})>>
<<set $mpKnown["velvet_masque"] to 1>><<if !$mpClues or !$mpClues["grand_elk_blueprint"]>><<set $mpClues["grand_elk_blueprint"] to 1>><span class="blue">线索已记录</span><</if>>
