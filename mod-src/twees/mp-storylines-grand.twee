<</if>>
<</replace>><</link>><<else>><<link [[喝宁神饮 (0:05)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "喝宁神饮">><<set $mpInsuffReq to "诡术等级：<span class='purple'>D</span>">><<pass 5>><</link>><</if>>
