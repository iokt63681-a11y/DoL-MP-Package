<div id="act-mp-grand-quest-hospital-wing-step4">
<<if ($skulduggery or 0) gte 280>><<sneakicon>><<link "开保险抽屉 (0:07)">><<pass 7>><<replace "#act-mp-grand-quest-hospital-wing-step4">>
<<set $skulduggerydifficulty to 340>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1 or ($willpower or 0) gte 420>>
