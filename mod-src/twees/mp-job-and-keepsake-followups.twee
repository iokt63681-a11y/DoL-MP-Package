	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("keepsake_show_core_reward")>><<money 550>><</if>>
	<<stress -4>><<lstress>>
<<else>>
	<<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>
	柜台煤油灯芯微暗，塞拉取出绒布替你把游丝芯包妥。<span class="teal">塞拉约你改天带高倍镜再细看。</span><<stress -1>>
<</if>>
<</replace>><</link>>
<br>
<<tendingicon>><<link "帮她用绒布与表油保养游丝 (0:06)">><<pass 6>><<replace "#ks-show-core">>
