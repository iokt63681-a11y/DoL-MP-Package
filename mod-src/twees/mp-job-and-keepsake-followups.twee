<<keepsakeicon>><<if $mpNpcs and $mpNpcs.sera and $mpNpcs.sera.hasMet>><<if ($science or 0) gte 250 or ($maths or 0) gte 250>><<link "请塞拉测算 (0:06)">><<pass 6>><<replace "#ks-show-core">>
