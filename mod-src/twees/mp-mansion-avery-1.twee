<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Danube Street">><</if>>
宅邸后巷煤气灯下停着深灰轿车，贝利手下的黑衣清道夫把火漆信函递给副管家：「下周五前必须按账册结清孤儿院借调尾款。」
<br><br>
<<set $mpDiscovered to ($mpDiscovered or {})>><<set $mpDiscovered["glasshouse"] to 1>><<link [[去秘密温室 (0:08)|MP Region Glasshouse Manor]]>><<pass 8>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<br>
<<getouticon>><<link [[离开 (0:08)|_exitPas]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 8>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<br>
<div id="mansion-baileyenvoy-choices">
<<investigateicon>><<link "记下火漆编号 (0:06)">><<mpalert 6>><<pass 6>><<replace "#mansion-baileyenvoy-choices">>
<<if ($willpower or 0) gte 420 or ($history or 0) gte 240>>
<span class="green">你借煤气灯光看清了残留蜡屑上的双鹰暗记与第三册账目编号。</span><<set $mpMansionBaileyClue to 1>><<willpower 2>><<stress -2>><<gwillpower>><<lstress>>
<<else>>
<span class="red">门内传来脚步声，你只看清半个模糊蜡印便匆匆缩回墙角。</span><<stress 4>><<gstress>>
<</if>>
<</replace>><</link>><<mpalertgain "煤气灯下翻看漆印">>
<br>
<<sneakicon>><<link "顺走副函 (0:07)">><<mpalert 8>><<pass 7>><<replace "#mansion-baileyenvoy-choices">>
<<set $skulduggerydifficulty to 380>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
<span class="green">你趁副管家掏钥匙开门的一瞬，夹走了他外衣袋里的火漆副函。</span><<set $mpQuestBaileyRebellion to Math.min(8, ($mpQuestBaileyRebellion or 0) + 1)>><<skulduggery 3>><<stress -3>><<lstress>>
<<else>>
<span class="red">脚下落叶轻响惊动了副管家，你只得翻墙撤退。</span><<stress 7>><<pain 3>><<gstress>><<gpain>>
<</if>>
<</replace>><</link>><<mpalertgain "火漆副函从衣袋里抽出">>
</div>

:: MP Mansion Auction GuestList [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<if ($mpAlertArea or "") isnot "velvet">><<mpalertinit "velvet">><</if>><<mpalerttext>><<mpalertcheck>>
<<set _exitPas to ($mpReturnPassage or "MP Region Glasshouse Manor")>>
<<if _exitPas is "Start" or _exitPas is "Start2">><<set _exitPas to "MP Region Glasshouse Manor">><</if>>
二层露台藤桌上摊着一本皮面签到簿，旁边摆着半杯紫罗兰利口酒，金墨字迹在灯下泛着微光。
<br><br>
<<walkicon>><<link [[去穹顶露台 (0:08)|MP Region Glasshouse Dome]]>><<pass 8>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<br>
<<getouticon>><<link [[返回夜光标本廊 (0:08)|MP Region Glasshouse Specimen]]>><<pass 8>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<br>
<<if ($mpAlert or 0) lt 100>>
<div id="mansion-guestlist-choices">
<<investigateicon>><<link "默记贵宾代号 (0:05)">><<mpalert 6>><<pass 5>><<replace "#mansion-guestlist-choices">>
<<if ($willpower or 0) gte 300 or ($history or 0) gte 250>>
<span class="green">你在执事登梯前将前三排六个贵宾代号与包厢号一字不差记下。</span><<set $mpVelvetGuestListRead to 1>><<stress -2>><<lstress>>
<<else>>
<span class="red">旋梯脚步声逼近，你翻页时被纸角刮破手指，匆忙闪到花架后。</span><<set $mpVelvetGuestListRead to 1>><<pain 2>><<stress 4>><<gpain>><<gstress>>
<</if>>
<</replace>><</link>><<mpalertgain "签到簿翻页的纸响">>
<br>
<<sneakicon>><<link "裁下兑换联 (0:04)">><<mpalert 8>><<pass 4>><<replace "#mansion-guestlist-choices">>
<<set $skulduggerydifficulty to 340>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
<span class="green">你用餐刀沿齿孔无声裁下末页筹码兑换副联。</span><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_auction_voucher_reward")>><<money 1600>><span class="gold">你兑出 £16 不记名筹码。</span><</if>><<skulduggery 2>><<stress -2>><<lstress>>
<<else>>
<span class="red">撕纸声惊动执事，你躲避时撞上藤椅扶手，空手退入暗影。</span><<pain 3>><<stress 5>><<gpain>><<gstress>>
<</if>>
<</replace>><</link>><<mpalertgain "餐刀划过齿孔的细响">>
</div>
<</if>>
<<if ($mpAlert or 0) gte 80>>
<br>
<div id="mp-alert-guestlist-exit">
<<if ($mpAlert or 0) gte 100>>
<<if ($physique or 0) gte 280 or ($combat or 0) gte 260>><<link [[拼死一搏 (0:12)|MP Elite Encounter Velvet Enforcers]]>><<set $mpReturnPassage to "Danube Street">><<set $mpAlert to 0>><<set $mpAlertCaught to 0>><<pass 12>><</link>><<else>><span class="disabled">拼死一搏 (0:12)（属性不足）</span><</if>>
<br>
<<if ($seductionskill or 0) gte 260 or ($english or 0) gte 260>><<link [[虚张声势 (0:08)|MP Alert Mansion Bluff]]>><<set $mpReturnPassage to "Danube Street">><<set $mpAlertReturn to "MP Mansion Auction GuestList">><<pass 8>><</link>><<else>><span class="disabled">虚张声势 (0:08)（属性不足）</span><</if>>
<br>
<<if ($athletics or 0) gte 260>><<link [[转身就跑 (0:06)|MP Alert Mansion Flee]]>><<set $mpReturnPassage to "Danube Street">><<pass 6>><</link>><<else>><span class="disabled">转身就跑 (0:06)（属性不足）</span><</if>>
<<else>>
<<link [[硬闯出去 (0:10)|MP Elite Encounter Velvet Enforcers]]>><<set $mpReturnPassage to "Danube Street">><<set $mpAlert to 0>><<set $mpAlertCaught to 0>><<pass 10>><</link>>
<</if>>
</div>
<</if>>

:: MP Mansion Glasshouse Cufflink [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<if ($mpAlertArea or "") isnot "velvet">><<mpalertinit "velvet">><</if>><<mpalerttext>><<mpalertcheck>>
<<set _exitPas to ($mpReturnPassage or "MP Region Glasshouse Orchid")>>
<<if _exitPas is "Start" or _exitPas is "Start2">><<set _exitPas to "MP Region Glasshouse Orchid">><</if>>
兰花厅大理石排水槽边闪着银光，一枚刻有花体字母『A』的纯银蓝宝袖扣卡在青苔石缝里，正是<<if $NPCNameList and $NPCNameList.includes("Avery")>>艾弗里<<else>>多瑙河富商<</if>>常戴的款式。
<br><br>
<<mpherbicon>><<link [[返回兰花温室 (0:02)|MP Region Glasshouse Orchid]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<br>
<<getouticon>><<link [[返回秘密温室 (0:02)|MP Region Glasshouse Manor]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<br>
<<if ($mpAlert or 0) lt 100>>
<div id="mansion-cufflink-choices">
<<mptailoricon>><<link "夹出蓝宝袖扣 (0:04)">><<mpalert 6>><<pass 4>><<replace "#mansion-cufflink-choices">>
<<if ($tending or 0) gte 220 or ($skulduggery or 0) gte 220 or ($willpower or 0) gte 400>>
<span class="green">你避开带刺蔷薇，稳稳夹出那枚蓝宝袖扣贴身收好。</span><<set $mpAveryCufflinkFound to 1>><<stress -4>><<lstress>>
<<else>>
<span class="red">青苔湿滑，你手背被蔷薇刺刮出道红印才把袖扣勾出来。</span><<set $mpAveryCufflinkFound to 1>><<pain 2>><<stress 2>><<gpain>><<gstress>>
<</if>>
<</replace>><</link>><<mpalertgain "拨开蔷薇丛的窸窣声">>
<br>
<<sneakicon>><<link "拨开槽底浮沙摸取 (0:04)">><<mpalert 8>><<pass 4>><<replace "#mansion-cufflink-choices">>
<<set $skulduggerydifficulty to 300>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
<span class="green">你夹出袖扣，还在铜箅子凹槽摸出几枚晚宴银币。</span><<set $mpAveryCufflinkFound to 1>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_glasshouse_cufflink_coin")>><<money 500>><</if>><<skulduggery 2>><<stress -2>><<lstress>>
<<else>>
<span class="red">锈蚀铜箅子刮痛了指尖，除袖扣外没摸出别的东西。</span><<set $mpAveryCufflinkFound to 1>><<pain 3>><<stress 3>><<gpain>><<gstress>>
<</if>>
<</replace>><</link>><<mpalertgain "铜箅子在石槽里刮擦">>
</div>
<</if>>
<<if ($mpAlert or 0) gte 80>>
<br>
<div id="mp-alert-cufflink-exit">
<<if ($mpAlert or 0) gte 100>>
<<if ($physique or 0) gte 280 or ($combat or 0) gte 260>><<link [[拼死一搏 (0:12)|MP Elite Encounter Velvet Enforcers]]>><<set $mpReturnPassage to "Danube Street">><<set $mpAlert to 0>><<set $mpAlertCaught to 0>><<pass 12>><</link>><<else>><span class="disabled">拼死一搏 (0:12)（属性不足）</span><</if>>
<br>
<<if ($seductionskill or 0) gte 260 or ($english or 0) gte 260>><<link [[虚张声势 (0:08)|MP Alert Mansion Bluff]]>><<set $mpReturnPassage to "Danube Street">><<set $mpAlertReturn to "MP Mansion Glasshouse Cufflink">><<pass 8>><</link>><<else>><span class="disabled">虚张声势 (0:08)（属性不足）</span><</if>>
<br>
<<if ($athletics or 0) gte 260>><<link [[转身就跑 (0:06)|MP Alert Mansion Flee]]>><<set $mpReturnPassage to "Danube Street">><<pass 6>><</link>><<else>><span class="disabled">转身就跑 (0:06)（属性不足）</span><</if>>
<<else>>
<<link [[硬闯出去 (0:10)|MP Elite Encounter Velvet Enforcers]]>><<set $mpReturnPassage to "Danube Street">><<set $mpAlert to 0>><<set $mpAlertCaught to 0>><<pass 10>><</link>>
<</if>>
</div>
