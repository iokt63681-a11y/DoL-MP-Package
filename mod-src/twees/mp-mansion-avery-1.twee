	<br>
<<else>>
	<<walkicon>><<link [[伸手去抠石缝时被花坛边缘的玫瑰刺扎痛指尖 (0:04)|MP Region Glasshouse Orchid]]>><<pass 4>><<pain 3>><<stress 2>><<set $eventskip to 1>><<endevent>><</link>><<gpain>>
	<br>
<</if>>
