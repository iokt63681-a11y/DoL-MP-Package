<</if>>
<</replace>><</link>><<mpalertloss "守在铜水槽边帮工">>
<br>
<<mpcookicon>><<link "尝烤牛肉 (0:05)">><<mpalert 6>><<pass 5>><<replace "#mansion-scullery-choices">>
