/* 宅邸与上流社交关系线（V6精修版：$location对齐、段落精简、原版UI规范） */
:: MP Mansion Pool Router [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">>
<<effects>><<mpAmbient>>
<<set $mpSeenScenes to ($mpSeenScenes or {})>>
<<set _mansionScenes to [
	"MP Mansion Avery CarInvite",
	"MP Mansion Avery GownCheck",
	"MP Mansion Avery ChampagneToast",
	"MP Mansion Quinn WineCellar",
	"MP Mansion Briar VelvetLedger",
	"MP Mansion Servant SilverTray",
	"MP Mansion Gate GuardRain",
	"MP Mansion Kitchen SculleryShift",
	"MP Mansion Conservatory ColdDraft",
	"MP Mansion Bailey DebtEnvoy",
	"MP Mansion Auction GuestList",
	"MP Mansion Glasshouse Cufflink"
]>>
<<set _pool to _mansionScenes.filter(function (n) { return !$mpSeenScenes[n]; })>>
<<if _pool.length is 0>>
	<<set _pool to _mansionScenes>>
	<<run _mansionScenes.forEach(function (n) { delete V.mpSeenScenes[n]; })>>
<</if>>
<<set _pick to _pool.random()>>
<<set $mpSeenScenes[_pick] to 1>>
<<include _pick>>

:: MP Mansion Avery CarInvite [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "Danube Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Danube Street">><</if>>
<<if $NPCName and $NPCNameList and $NPCNameList.includes("Avery")>>多瑙河街十八号铁门前停着黑色轿车。车窗半降，艾弗里看了一眼金表：「站在我身边别让我丢脸，先把衣领理好。」
<<if ($exposed or 0) gte 1>>见你衣衫不整，艾弗里脸色一沉，将后座羊绒大衣甩在你肩上。<<else>>艾弗里探身推开副驾车门，拨正你的领口。<</if>>
<<else>>多瑙河街十八号铁门前停着黑色轿车。车窗半降，一个戴金表的人打量你一眼：「新来的？上车，别多话。」<<if ($exposed or 0) gte 1>>见你衣衫不整，对方皱了皱眉，将后座羊绒大衣甩在你肩上。<<else>>对方探身推开副驾车门，朝座位抬了抬下巴。<</if>><</if>><br><br>
<<getouticon>><<link [[借口门禁离开车道 (0:03)|_exitPas]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-carinvite-choices">
<<link "拉开车门坐进副驾 (0:08)">><<pass 8>><<replace "#mansion-carinvite-choices">>
<<if ($english or 0) gte 240 or ($seductionskill or 0) gte 240 or ($willpower or 0) gte 400>>
<span class="green">你稳稳坐进真皮座椅，将烫金席位卡上的议员座次核对得一清二楚。</span><<stress -4>><<lstress>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Avery")>><<npcincr Avery love 1>><<glove>><</if>>
<<else>>
<span class="red">你衣角带翻了银雪茄剪，又念错了两位商会的头衔。</span><<stress 5>><<gstress>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Avery")>><<npcincr Avery rage 1>><</if>>
<</if>>
<</replace>><</link>>
<br>
<<if ($mpAveryCufflinkFound or 0) is 1 and ($mpAveryCufflinkReturned or 0) is 0>>
	<<investigateicon>><<link "递还捡到的蓝宝袖扣 (0:05)">><<pass 5>><<replace "#mansion-carinvite-choices">>
	<<set $mpAveryCufflinkReturned to 1>>你取出刻着字母『A』的纯银蓝宝袖扣递还。<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_avery_cufflink_return")>><<money 1000>><</if>><<stress -6>><<lstress>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Avery")>><<npcincr Avery love 2>><<glove>><</if>>
	<</replace>><</link>><br>
<</if>>
<<walkicon>><<link "退半步婉拒同乘 (0:04)">><<pass 4>><<replace "#mansion-carinvite-choices">>
<<if ($willpower or 0) gte 480>>
<span class="green">你以晚间课业为由不卑不亢地推辞了同乘。</span><<willpower 2>><<stress -2>><<gwillpower>><<lstress>>
<<else>>
<span class="red">你退避时眼神闪烁，被艾弗里冷淡的目光钉在原地。</span><<stress 5>><<gstress>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Avery")>><<npcincr Avery rage 1>><</if>>
<</if>>
<</replace>><</link>>
</div>

:: MP Mansion Avery GownCheck [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "Danube Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Danube Street">><</if>>
宅邸一楼门厅水晶灯通明，穿衣镜旁立着丝绸礼服衣架。艾弗里按住你的肩膀对着镜面冷声道：「今晚楼上都是名流，别让我丢脸。」
<<if (($worn.upper.integrity or 100) lte 60) or (($worn.lower.integrity or 100) lte 60)>>你的衣角还留着撕裂的线头，在光洁如镜的门厅里显得格格不入。<<else>>你在穿衣镜前站定，将袖口与腰侧的折痕一一抚平。<</if>>
<br><br>
<<getouticon>><<link [[从侧门退回宅邸前院 (0:03)|_exitPas]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-gowncheck-choices">
<<link "配合换上备用衬领 (0:10)">><<pass 10>><<replace "#mansion-gowncheck-choices">>
<<if ($danceskill or 0) gte 240 or ($beauty or 0) gte 3200 or ($housekeeping or 0) gte 240>>
<span class="green">你利落地换上挺括丝绸衬领，对着铜镜把胸针调整得端庄得体。</span><<stress -4>><<lstress>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Avery")>><<npcincr Avery love 1>><<glove>><</if>>
<<else>>
<span class="red">丝绸暗扣繁琐难系，你在侍女注视下把领花别歪了半寸。</span><<stress 5>><<tiredness 2>><<gstress>><<gtiredness>>
<</if>>
<</replace>><</link>>
<br>
<<investigateicon>><<link "迎着镜面谈妥置装补贴 (0:06)">><<pass 6>><<replace "#mansion-gowncheck-choices">>
<<if ($willpower or 0) gte 500 or ($seductionskill or 0) gte 320>>
你直视镜中艾弗里的眼睛，平静提出陪席应有置装补贴。<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_avery_gown_fee")>><<money 1200>><span class="gold">你收起镜台上的 £12 补贴。</span><</if>><<willpower 2>><<stress -3>><<gwillpower>><<lstress>>
<<else>>
<span class="red">你刚开口就被艾弗里冰冷的眼神逼退半步。</span><<stress 6>><<trauma 1>><<gstress>><<gtrauma>>
<</if>>
<</replace>><</link>>
</div>

:: MP Mansion Avery ChampagneToast [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "Danube Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Danube Street">><</if>>
二楼弧形露台正对着温室玻璃穹顶，冰桶里的香槟冒着细泡。艾弗里递给你高脚杯：「待会儿奎因过来敬酒，你知道该怎么应对。」
<br><br>
<<walkicon>><<link [[顺石阶去花园温室 (0:03)|MP Region Glasshouse Manor]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<getouticon>><<link [[下楼离开宅邸露台 (0:04)|_exitPas]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 4>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-champagne-choices">
<<if $NPCNameList and $NPCNameList.includes("Avery")>><<link "挽住艾弗里举杯致意 (0:09)">><<pass 9>><<replace "#mansion-champagne-choices">>
<<if ($english or 0) gte 250 or ($danceskill or 0) gte 250 or ($seductionskill or 0) gte 260>>
<span class="green">你自然挽住艾弗里小臂微笑颔首，巧妙避开了关于孤儿院的试探。</span><<stress -5>><<lstress>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Avery")>><<npcincr Avery love 1>><<glove>><</if>>
<<else>>
<span class="red">面对名流寒暄你手指发僵，回答慢了半拍。</span><<stress 5>><<tiredness 2>><<gstress>><<gtiredness>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">挽住艾弗里举杯致意 (0:09)（尚未结识）</span><</if>>
<br>
<<sneakicon>><<link "借吹风将酒倒进花盆 (0:04)">><<pass 4>><<replace "#mansion-champagne-choices">>
<<set $skulduggerydifficulty to 260>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
<span class="green">你趁众人谈论拍品时将香槟无声倾入花盆，记下了温室暗库方位。</span><<skulduggery 2>><<stress -3>><<lstress>>
<<else>>
<span class="red">侍者恰好从纱帘后转出，酒液溅湿了你的鞋尖。</span><<stress 4>><<tiredness 1>><<gstress>>
<</if>>
<</replace>><</link>>
</div>

:: MP Mansion Quinn WineCellar [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "Danube Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Danube Street">><</if>>
地下恒温酒窖圆桌上摊着市政修缮预算表。奎因市长合上文件夹冷声道：「把那瓶八二年红酒递给我，别乱看桌上的东西。」
<br><br>
<<walkicon>><<link [[从侧廊去秘密温室 (0:04)|MP Region Glasshouse Manor]]>><<pass 4>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<getouticon>><<link [[端空托盘退回地面 (0:03)|_exitPas]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-quinn-choices">
<<link "替奎因醒酒并承诺保密 (0:07)">><<pass 7>><<replace "#mansion-quinn-choices">>
<<if ($english or 0) gte 250 or ($housekeeping or 0) gte 250 or ($willpower or 0) gte 440>>
<span class="green">你稳重地将红酒注入醒酒器，垂眸表示自己只看酒标不识账目。</span><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_quinn_wine_hush")>><<money 1000>><span class="gold">你收下桌角 £10 封口钱。</span><</if>><<stress -2>><<lstress>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Quinn")>><<npcincr Quinn love 1>><<glove>><</if>>
<<else>>
<span class="red">起塞器带落半块碎木屑掉进酒液，引得奎因冷哼。</span><<stress 5>><<tiredness 2>><<gstress>><<gtiredness>>
<</if>>
<</replace>><</link>>
<br>
<<sneakicon>><<link "趁转身抽走拨款副联 (0:05)">><<pass 5>><<replace "#mansion-quinn-choices">>
<<set $skulduggerydifficulty to 340>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
<span class="green">趁内线电话铃响，你将印有温室补贴的拨款副联无声折进袖袋。</span><<set $mpQuinnCellarNote to 1>><<skulduggery 3>><<stress -3>><<lstress>>
<<else>>
<span class="red">奎因从银酒壶反光里察觉异动，猛地回手按住账册。</span><<stress 6>><<pain 2>><<gstress>><<gpain>>
<</if>>
<</replace>><</link>>
</div>

:: MP Mansion Briar VelvetLedger [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">>
<<effects>><<mpAmbient>>
<<set $mpBriarExit to ($mpReturnPassage or "Danube Street")>>
<<if $mpBriarExit is "Start" or $mpBriarExit is "Start2" or $mpBriarExit.startsWith("MP ")>>
	<<set $mpBriarExit to "Danube Street">>
<</if>>
宅邸西侧偏厅的丝绒屏风后燃着甜腻的龙涎香。布莱尔翘着腿坐在高背扶手椅上，指尖转着一支镶金钢笔。
「来得正好。」布莱尔把一叠洒金请柬推到你面前，「今晚的贵客散场后要去天鹅绒暗层，替我把这些塞进他们的大衣口袋。」
<<if ($exposed or 0) gte 1>>你衣衫不整地站在屏风边，布莱尔的目光在你肩上停了停。<<else>>布莱尔替你抚平袖口，指尖在你腕上轻轻一按。<</if>>
<br><br>
<<getouticon>><<link [[收好账册退回多瑙河街 (0:02)|($mpBriarExit or "Danube Street")]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<socialiseicon>><<link [[接过洒金请柬 (0:02)|MP Mansion Briar Cloakroom]]>><<pass 2>><</link>>
<br>
<<brothelicon>><<link [[先开口问报酬 (0:02)|MP Mansion Briar Bargain]]>><<pass 2>><</link>>

:: MP Mansion Briar Cloakroom [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">>
<<effects>><<mpAmbient>>
衣帽间在偏厅后面的窄廊尽头。两排大衣挂在黄铜架上，门边的保镖正低头擦火柴。
你手里那叠请柬被掌心焐得发潮。
<br><br>
<<walkicon>><<link [[退回偏厅核对天鹅绒名单 (0:02)|MP Mansion Briar VelvetLedger]]>><<pass 2>><</link>>
<br>
<<sneakicon>><<link [[塞进大衣内袋 (0:05)|MP Mansion Briar Distribute]]>><<pass 5>><</link>>
<br>
<<investigateicon>><<link [[看清保镖位置 (0:04)|MP Mansion Briar Observe]]>><<pass 4>><</link>>

:: MP Mansion Briar Distribute [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
两排呢料大衣垂在黄铜挂架上，门边的保镖正背过身擦火柴点烟，袖口里的洒金请柬随时可以滑入大衣内袋。
<br><br>
<<getouticon>><<link [[从窄廊退出去 (0:03)|($mpBriarExit or "Danube Street")]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="briar-dist-act">
<<sneakicon>><<link "探手滑入首件大衣内袋 (0:04)">><<pass 4>><<replace "#briar-dist-act">>
<<set $skulduggerydifficulty to ((($mpBriarCloakroomEdge or 0) is 1) ? 250 : 350)>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
	<<set _sk to currentSkillValue("skulduggery")>>
	<<if _sk gte 800>><<set _reward to 1500>><<elseif _sk gte 400>><<set _reward to 1200>><<else>><<set _reward to 1000>><</if>>
	<span class="green">请柬无声滑进丝绸衬里，保镖的火柴甚至还没划亮。</span>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_briar_distribute_reward")>>
		<<money _reward>><span class="gold">你摸出布莱尔预留的赏金袋，约有 £<<print Math.floor(_reward / 100)>>。</span>
	<</if>>
	<<stress -3>><<lstress>>
	<<if $NPCName and $NPCNameList and $NPCNameList.includes("Briar")>><<npcincr Briar love 1>><<glove>><</if>>
	<br><br>
	<<link [[从窄廊从容离开 (0:03)|($mpBriarExit or "Danube Street")]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	<span class="red">指节不慎撞响铜衣架，保镖猛地回头，你只得把请柬缩回袖口。</span><<stress 6>><<pain 2>><<gstress>><<gpain>>
	<br><br>
	<<walkicon>><<link [[屏息再试一次 (0:03)|MP Mansion Briar Distribute]]>><<pass 3>><</link>>
	<br>
	<<link [[闪身躲进帘幕后 (0:04)|MP Mansion Briar Hide]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "借挂衣架掩护分批塞入 (0:05)">><<pass 5>><<replace "#briar-dist-act">>
<<if ($danceskill or 0) gte 280 or ($athletics or 0) gte 280>>
	<span class="green">你借着挑拣披肩的动作侧身旋步，将请柬分批塞入内袋。</span>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_briar_distribute_reward")>>
		<<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="gold">你收下了末张信封里的 £11 信物铜章。</span>
	<</if>>
	<<stress -2>><<lstress>>
	<br><br>
	<<link [[从窄廊从容离开 (0:03)|Harvest Street]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	<span class="red">衣架滑轮发出轻响，保镖狐疑地走近两步。</span><<stress 4>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[躲进帘幕后方 (0:04)|MP Mansion Briar Hide]]>><<pass 4>><</link>>
	<br>
	<<link [[退回衣帽间外 (0:02)|MP Mansion Briar Cloakroom]]>><<pass 2>><</link>>
<</if>>
<</replace>><</link>>
</div>

:: MP Mansion Briar Observe [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">>
<<effects>><<mpAmbient>>
你退到窄廊的阴影里，数着保镖来回的步子。他每走到第三只大衣架就会停下来点烟。
<<if ($skulduggery or 0) gte 300 or ($athletics or 0) gte 300>>
	你看准了他转身的空档，记下了盲区。再动手时，你能多争取几秒。
	<<set $mpBriarCloakroomEdge to 1>><<stress -2>><<lstress>>
<<else>>
	你看了太久，保镖忽然朝窄廊这边瞥了一眼。你只好先退回偏厅。
	<<stress 3>><<gstress>>
<</if>>
<br><br>
<<walkicon>><<link [[回到衣帽间外 (0:02)|MP Mansion Briar Cloakroom]]>><<pass 2>><</link>>
<br>
<<getouticon>><<link [[放弃这趟差事 (0:03)|($mpBriarExit or "Danube Street")]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>

:: MP Mansion Briar Hide [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">>
<<effects>><<mpAmbient>>
帘幕后面是堆杂物的小隔间。保镖的脚步声在窄廊里停了一下，又慢慢走远。
<<set _sk to currentSkillValue("skulduggery")>>
<<if _sk gte 600>>
	你趁他走远，把剩下的请柬塞进最近两件大衣。
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_briar_hide_reward")>>
		你顺手从托盘底摸到布莱尔留的备用零钞。<<money 500>>
	<</if>>
	<<stress -2>><<lstress>>
<<elseif _sk gte 300>>
	你趁他走远，把剩下的请柬塞进最近两件大衣。
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_briar_hide_reward")>>
		<<money 200>>
	<</if>>
	<<stress -1>><<lstress>>
<<else>>
	你不敢再动，等脚步声彻底消失才从帘幕后出来。<<stress 2>><<trauma 1>><<gstress>>
<</if>>
<br><br>
<<getouticon>><<link [[趁无人退回街面 (0:03)|($mpBriarExit or "Danube Street")]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>

:: MP Mansion Briar Bargain [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">>
<<effects>><<mpAmbient>>
「报酬呢？」你没有立刻接那叠请柬。布莱尔笑了一声，把钢笔搁在茶几上：「先让我看看你值不值这个价。」
<br><br>
<<getouticon>><<link [[把请柬推回去 (0:02)|($mpBriarExit or "Danube Street")]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<brothelicon>><<link [[顺着话头抬价 (0:04)|MP Mansion Briar Deal]]>><<pass 4>><</link>>

:: MP Mansion Briar Deal [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">>
<<effects>><<mpAmbient>>
你把声音压低，替他把话说完。布莱尔的笑意慢慢收了，改成一种审视。
<<set _sk to Math.max(currentSkillValue("seductionskill"), currentSkillValue("skulduggery"))>>
<<if _sk gte 1000>>
	<<set _reward to 2000>><<set _crest to 1>>
<<elseif _sk gte 800>>
	<<set _reward to 1600>><<set _crest to 1>>
<<elseif _sk gte 600>>
	<<set _reward to 1500>><<set _crest to 0>>
<<elseif _sk gte 400>>
	<<set _reward to 1400>><<set _crest to 0>>
<<else>>
	<<set _reward to 1200>><<set _crest to 0>><</if>>
<<if _sk gte 350>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_briar_deal_reward")>>
		他从礼盒底层数出几张钞票推过来，约莫 £<<print Math.floor(_reward / 100)>>。
		<<money _reward>>
	<<else>>
		他点了点头，认可了你先前的开价。
	<</if>>
	<<if _crest is 1>>他顿了顿，又摸出一枚天鹅绒暗层通行徽记，一起推到你手边。<<set $mpFragVelvetCrest to Math.min(3, ($mpFragVelvetCrest or 0) + 1)>><</if>>
	<<if $NPCName and $NPCNameList and $NPCNameList.includes("Briar")>><<npcincr Briar love 1>><<glove>><</if>>
<<else>>
	他摇了摇头，把请柬收回抽屉。你在偏厅里站了片刻，只能离开。<<stress 4>><<gstress>>
<</if>>
<br><br>
<<getouticon>><<link [[离开西侧偏厅 (0:03)|($mpBriarExit or "Danube Street")]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>

:: MP Mansion Servant SilverTray [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "Danube Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Danube Street">><</if>>
主宴会厅餐具间堆满纯银高脚托盘。领班把侍者马甲塞给你：「三号桌银行家最挑剔，把这盘鱼子酱稳稳送过去！」
<br><br>
<<getouticon>><<link [[放下银托盘从侧门离开 (0:03)|_exitPas]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-silvertray-choices">
<<walkicon>><<link "端鱼子酱送往三号桌 (0:12)">><<pass 12>><<replace "#mansion-silvertray-choices">>
<<if ($danceskill or 0) gte 250 or ($athletics or 0) gte 250>>
<span class="green">你踩着舞曲节拍避开舞伴，将鱼子酱稳稳呈上三号主桌。</span><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_servant_tray_full")>><<money 1500>><span class="gold">你领到 £15 特勤工钱。</span><</if>><<stress -3>><<lstress>>
<<else>>
<span class="red">微醺宾客撞在你手肘上，柠檬角与银匙散落在地毯上。</span><<stress 6>><<tiredness 3>><<gstress>><<gtiredness>>
<</if>>
<</replace>><</link>>
<br>
<<tendingicon>><<link "留在餐具间擦银酒具 (0:15)">><<pass 15>><<replace "#mansion-silvertray-choices">>
<span class="green">你守在长桌旁用鹿皮布将三十只纯银高脚杯擦得透亮。</span><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_servant_tray_safe")>><<money 900>><span class="gold">领班发给你 £9 工钱。</span><</if>><<tiredness 3>><<stress -1>><<gtiredness>><<lstress>>
<</replace>><</link>>
</div>

:: MP Mansion Gate GuardRain [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "Danube Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Danube Street">><</if>>
宅邸北侧铁门挂着防盗链，披黑雨披的保安打着手电走出岗亭：「过了访客时间，没手令不准在铁门外逗留！」
<br><br>
<<walkicon>><<link [[退回铁门外避开巡夜保安 (0:02)|_exitPas]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-guardrain-choices">
<<sneakicon>><<link "趁保安回亭挑开侧门锁 (0:06)">><<pass 6>><<replace "#mansion-guardrain-choices">>
<<set $skulduggerydifficulty to 300>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
<span class="green">你趁保安回亭登记，用细铁丝拨开侧门铜锁钻入冬青回廊。</span><<set $mpKnown to ($mpKnown or {})>><<set $mpKnown["glasshouse_orchid"] to 1>><<skulduggery 3>><<stress -2>><<lstress>>
<br><br>
<<link [[步入秘密温室庄园 (0:02)|MP Region Glasshouse Manor]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
<span class="red">锁簧发涩，岗亭窗户突然推开，强光手电直照向你。</span><<pain 4>><<stress 5>><<gpain>><<gstress>>
<</if>>
<</replace>><</link>>
<br>
<<link "上前询问花匠招工时辰 (0:04)">><<pass 4>><<replace "#mansion-guardrain-choices">>
<<if ($english or 0) gte 230 or ($seductionskill or 0) gte 230>>
<span class="green">你大方询问温室采买花肥的钟点，保安告知了白日交接时间。</span><<stress -2>><<lstress>>
<<else>>
<span class="red">保安狐疑地敲了敲警棍，让你立刻离开外墙。</span><<stress 3>><<gstress>>
<</if>>
<</replace>><</link>>
</div>

:: MP Mansion Kitchen SculleryShift [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "Danube Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Danube Street">><</if>>
半地下室洗碗间热气腾腾，铜水槽泡满描金骨瓷盘。副厨长敲着台面：「十点前把三摞瓷盘擦干归柜，工钱现结！」
<br><br>
<<getouticon>><<link [[从运菜坡道返回街面 (0:03)|_exitPas]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-scullery-choices">
<<tendingicon>><<link "挽袖擦净三摞骨瓷盘 (0:25)">><<pass 25>><<replace "#mansion-scullery-choices">>
<<if ($housekeeping or 0) gte 240 or ($willpower or 0) gte 420>>
<span class="green">你将描金骨瓷盘逐一过温水抹干码入木柜，盘底金徽擦得锃亮。</span><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_scullery_shift_pay")>><<money 1100>><span class="gold">你领到 £11 帮工钱。</span><</if>><<stress -4>><<tiredness 3>><<lstress>><<gtiredness>>
<<else>>
<span class="red">凝固黄油难洗，盘沿留着水渍被责令返工重擦。</span><<stress 4>><<tiredness 4>><<gstress>><<gtiredness>>
<</if>>
<</replace>><</link>>
<br>
<<sneakicon>><<link "趁空档尝块余下烤牛肉 (0:05)">><<pass 5>><<replace "#mansion-scullery-choices">>
<<set $skulduggerydifficulty to 260>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
<span class="green">你趁副厨长离开挑起两片黑椒烤牛肉塞进嘴里，驱散了疲惫。</span><<stress -4>><<tiredness -2>><<lstress>><<ltiredness>>
<<else>>
<span class="red">滚烫肉汁烫到舌尖，副厨长推门抓个正着罚你刷铁盘。</span><<pain 2>><<stress 4>><<gpain>><<gstress>>
<</if>>
<</replace>><</link>>
</div>

:: MP Mansion Conservatory ColdDraft [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "MP Region Glasshouse Manor")>>
<<if _exitPas is "Start" or _exitPas is "Start2">><<set _exitPas to "MP Region Glasshouse Manor">><</if>>
玻璃连廊顶棚被狂风掀开天窗，冷风直灌向名贵兰花。老花匠急得跺脚：「谁身手利索帮我爬上去把铜插销扣死？」
<br><br>
<<walkicon>><<link [[步入雾化兰花厅 (0:03)|MP Region Glasshouse Orchid]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<getouticon>><<link [[从连廊侧门回多瑙河街 (0:03)|Danube Street]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-colddraft-choices">
<<runicon>><<link "攀上旋梯扣死天窗插销 (0:08)">><<pass 8>><<replace "#mansion-colddraft-choices">>
<<if ($physique or 10000) gte 11500 or ($athletics or 0) gte 280>>
<span class="green">你蹬上铸铁旋梯顶端拽回窗框，将黄铜插销死死扣入卡槽。</span><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_conservatory_latch_pay")>><<money 1000>><span class="gold">老花匠塞给你 £10 劳务费。</span><</if>><<physique 2>><<stress -4>><<lstress>>
<<else>>
<span class="red">高处冷风吹得铁梯摇晃，你冻僵的手指没能勾住拉杆。</span><<stress 5>><<pain 2>><<tiredness 2>><<gstress>><<gpain>>
<</if>>
<</replace>><</link>>
<br>
<<tendingicon>><<link "留在地面抢搬兰花盆栽 (0:10)">><<pass 10>><<replace "#mansion-colddraft-choices">>
<<if ($tending or 0) gte 240 or ($housekeeping or 0) gte 240>>
<span class="green">你帮老花匠把八盆夜光银脉兰稳稳挪进恒温内厅。</span><<stress -3>><<tiredness 2>><<lstress>><<gtiredness>>
<<else>>
<span class="red">你搬动青瓷花盆时绊在排水槽边，腰背累得发酸。</span><<stress 2>><<tiredness 3>><<gstress>><<gtiredness>>
<</if>>
<</replace>><</link>>
</div>

:: MP Mansion Bailey DebtEnvoy [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "Danube Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Danube Street">><</if>>
宅邸后巷煤气灯下停着深灰轿车，贝利手下的黑衣清道夫把火漆信函递给副管家：「下周五前必须按账册结清孤儿院借调尾款。」
<br><br>
<<walkicon>><<link [[绕角门进秘密温室 (0:04)|MP Region Glasshouse Manor]]>><<pass 4>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<getouticon>><<link [[趁无人退回多瑙河街 (0:03)|_exitPas]]>><<set $outside to 1>><<set $location to "avery_mansion">><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-baileyenvoy-choices">
<<investigateicon>><<link "摸到角门记下火漆编号 (0:06)">><<pass 6>><<replace "#mansion-baileyenvoy-choices">>
<<if ($willpower or 0) gte 420 or ($history or 0) gte 240>>
<span class="green">你借煤气灯光看清了残留蜡屑上的双鹰暗记与第三册账目编号。</span><<set $mpMansionBaileyClue to 1>><<willpower 2>><<stress -2>><<gwillpower>><<lstress>>
<<else>>
<span class="red">门内传来脚步声，你只看清半个模糊蜡印便匆匆缩回墙角。</span><<stress 4>><<gstress>>
<</if>>
<</replace>><</link>>
<br>
<<sneakicon>><<link "尾随副管家顺走副函 (0:07)">><<pass 7>><<replace "#mansion-baileyenvoy-choices">>
<<set $skulduggerydifficulty to 380>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
<span class="green">你趁副管家掏钥匙开门的一瞬，夹走了他外衣袋里的火漆副函。</span><<set $mpQuestBaileyRebellion to Math.min(8, ($mpQuestBaileyRebellion or 0) + 1)>><<skulduggery 3>><<stress -3>><<lstress>>
<<else>>
<span class="red">脚下落叶轻响惊动了副管家，你只得翻墙撤退。</span><<stress 7>><<pain 3>><<gstress>><<gpain>>
<</if>>
<</replace>><</link>>
</div>

:: MP Mansion Auction GuestList [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "MP Region Glasshouse Manor")>>
<<if _exitPas is "Start" or _exitPas is "Start2">><<set _exitPas to "MP Region Glasshouse Manor">><</if>>
二层露台藤桌上摊着一本皮面签到簿，旁边摆着半杯紫罗兰利口酒，金墨字迹在灯下泛着微光。
<br><br>
<<walkicon>><<link [[走向穹顶露台内侧 (0:03)|MP Region Glasshouse Dome]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<getouticon>><<link [[沿旋梯退回标本廊 (0:03)|MP Region Glasshouse Specimen]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-guestlist-choices">
<<investigateicon>><<link "翻看并默记贵宾代号 (0:05)">><<pass 5>><<replace "#mansion-guestlist-choices">>
<<if ($willpower or 0) gte 300 or ($history or 0) gte 250>>
<span class="green">你在执事登梯前将前三排六个贵宾代号与包厢号一字不差记下。</span><<set $mpVelvetGuestListRead to 1>><<stress -2>><<lstress>>
<<else>>
<span class="red">旋梯脚步声逼近，你翻页时被纸角刮破手指，匆忙闪到花架后。</span><<set $mpVelvetGuestListRead to 1>><<pain 2>><<stress 4>><<gpain>><<gstress>>
<</if>>
<</replace>><</link>>
<br>
<<sneakicon>><<link "裁下签到簿末页兑换联 (0:04)">><<pass 4>><<replace "#mansion-guestlist-choices">>
<<set $skulduggerydifficulty to 340>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
<span class="green">你用餐刀沿齿孔无声裁下末页筹码兑换副联。</span><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_auction_voucher_reward")>><<money 1600>><span class="gold">你兑出 £16 不记名筹码。</span><</if>><<skulduggery 2>><<stress -2>><<lstress>>
<<else>>
<span class="red">撕纸声惊动执事，你躲避时撞上藤椅扶手，空手退入暗影。</span><<pain 3>><<stress 5>><<gpain>><<gstress>>
<</if>>
<</replace>><</link>>
</div>

:: MP Mansion Glasshouse Cufflink [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "MP Region Glasshouse Orchid")>>
<<if _exitPas is "Start" or _exitPas is "Start2">><<set _exitPas to "MP Region Glasshouse Orchid">><</if>>
兰花厅大理石排水槽边闪着银光，一枚刻有花体字母『A』的纯银蓝宝袖扣卡在青苔石缝里，正是艾弗里常戴的款式。
<br><br>
<<walkicon>><<link [[返回雾化兰花厅 (0:02)|MP Region Glasshouse Orchid]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<getouticon>><<link [[退回温室庄园入口 (0:02)|MP Region Glasshouse Manor]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="mansion-cufflink-choices">
<<investigateicon>><<link "用指尖夹出蓝宝袖扣 (0:04)">><<pass 4>><<replace "#mansion-cufflink-choices">>
<<if ($tending or 0) gte 220 or ($skulduggery or 0) gte 220 or ($willpower or 0) gte 400>>
<span class="green">你避开带刺蔷薇，稳稳夹出那枚蓝宝袖扣贴身收好。</span><<set $mpAveryCufflinkFound to 1>><<stress -4>><<lstress>>
<<else>>
<span class="red">青苔湿滑，你手背被蔷薇刺刮出道红印才把袖扣勾出来。</span><<set $mpAveryCufflinkFound to 1>><<pain 2>><<stress 2>><<gpain>><<gstress>>
<</if>>
<</replace>><</link>>
<br>
<<sneakicon>><<link "拨开槽底浮沙细看 (0:04)">><<pass 4>><<replace "#mansion-cufflink-choices">>
<<set $skulduggerydifficulty to 300>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
<span class="green">你夹出袖扣，还在铜箅子凹槽摸出几枚晚宴银币。</span><<set $mpAveryCufflinkFound to 1>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mansion_glasshouse_cufflink_coin")>><<money 500>><</if>><<skulduggery 2>><<stress -2>><<lstress>>
<<else>>
<span class="red">锈蚀铜箅子刮痛了指尖，除袖扣外没摸出别的东西。</span><<set $mpAveryCufflinkFound to 1>><<pain 3>><<stress 3>><<gpain>><<gstress>>
<</if>>
<</replace>><</link>>
</div>

