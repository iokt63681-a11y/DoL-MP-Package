<<if $mpLedger.route is "escape" or ($mpSafehouses and $mpSafehouses.orphanage and $mpSafehouses.orphanage.tier gte 1)>><<walkicon>><<link [[拆账分散名单 (0:14)|MP Ledger Debt More Hub]]>><<pass 14>><<set _was to ($mpLedger.outcome is "escape")>><<set $mpLedger.outcome to "escape">><<if !_was>><<if !$mpWorldOrphanageOutcome>><<set $mpWorldOrphanageOutcome to "sheltered">><</if>><<set $mpBaileyBiweeklyNextDay to ((window.Time && Time.days) or 0) + 35>><<set $mpAlert to Math.max(0, ($mpAlert or 0) - 5)>><<if $mpSafehouses and $mpSafehouses.orphanage>><<set $mpSafehouses.orphanage.risk to Math.max(0, ($mpSafehouses.orphanage.risk or 20) - 10)>><</if>><</if>><<tiredness 4>><</link>><br><<else>><span class="disabled">拆账分散名单 (0:14)（尚无转移路线）</span><br><</if>>
