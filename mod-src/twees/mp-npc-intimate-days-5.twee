	<<set $daily.mpDaily_eden_10 to 1>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Eden")>><<npcincr Eden love 2>><<npcincr Eden trust 1>><</if>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("daily_eden_10_rew")>><<money 420>>猎靴擦得油亮防潮，伊甸满意地揉了揉你的头发，把卖鹿皮余下的银币塞给你。<<else>>蜂蜡渗入皮革纹理，伊甸顺势将你的脚踝拢在膝头暖着。<</if>><span class="green">伊甸笨拙却笃定的照拂令你格外踏实。</span><<stress -3>><<lstress>>
	<br><br>
	<<link [[道别离开 (0:04)|Forest Cabin]]>><<pass 4>><</link>>
<<else>>
	蜂蜡膏受凉略硬，涂抹时在靴尖留下一小块白蜡。<span class="red"><<if $NPCNameList and $NPCNameList.includes("Eden")>>伊甸<<else>>林间猎人<</if>>把铁盒移近炉火烤软。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[俯身再擦亮猎靴 (0:04)|MP Daily Eden 10]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|Forest Cabin]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<crimeicon "safe">><<link "缠紧刀柄 (0:08)">><<pass 8>><<replace "#act-mp-daily-eden-10">>
<<if ($physique or 10000) gte 11400 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpDaily_eden_10 to 1>><<if !$mpClues or !$mpClues["clue_eden_10_strap"]>><<set $mpClues["clue_eden_10_strap"] to 1>><span class="blue">线索已记录</span><</if>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Eden")>><<npcincr Eden love 2>><<npcincr Eden trust 2>><</if>><<trauma -1>><<ltrauma>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("daily_eden_10_rew_alt")>><<set $mpHerbsCollected to ($mpHerbsCollected or 0) + 1>><span class="blue">获得草药 ×1</span>鹿皮条缠得紧实合手，伊甸试了试握感，从铁盒里取出一卷特制护身骨哨交给你。<<else>>刀柄纹路贴合掌心，伊甸把你揽进怀里低声叮嘱林间忌讳。<</if>><span class="green">你们在静谧炉火旁配合得天衣无缝。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[继续同行 (0:04)|MP Daily Eden 11]]>><<pass 4>><</link>>
<<else>>
