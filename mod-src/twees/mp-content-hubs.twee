:: Widgets MP Light [widget nobr]
<<widget "mplightinit">>
	<<set $mpLight to 100>>
	<<set $mpLightAmbush to 0>>
<</widget>>

<<widget "mplight">>
	<<if _args[0]>>
		<<set $mpLight to Math.clamp(($mpLight or 0) + Number(_args[0]), 0, 100)>>
	<</if>>
<</widget>>

<<widget "mplighttext">>
	<<set _mpLightNow to ($mpLight or 0)>>
	火光：<<if _mpLightNow gte 100>><span class="green">「火把正旺」</span><<elseif _mpLightNow gte 80>><span class="teal">「火光稳定」</span><<elseif _mpLightNow gte 60>><span class="lblue">「火苗弱了些」</span><<elseif _mpLightNow gte 40>><span class="blue">「火光偏低」</span><<elseif _mpLightNow gte 20>><span class="purple">「快烧尽了」</span><<elseif _mpLightNow gte 1>><span class="pink">「只剩一点火星」</span><<else>><span class="red">「火把熄了」</span><</if>>
<</widget>>

<<widget "mplightloss">>
	<<if ($mpLight or 0) gte 1 and !$settings.blindStatsEnabled>> | <span class="red">- 火光</span><</if>>
<</widget>>

<<widget "mplightgain">>
	<<if !$settings.blindStatsEnabled>> | <span class="green">+ 火光</span><</if>>
<</widget>>

<<widget "mplightambush">>
	<<if ($mpLight or 0) lt 20 and random(1, 100) gt ($mpLight or 0)>>
		<<set $mpLightAmbush to 1>>
		<span class="red">火把的光弱得照不清脚边，黑暗里有什么东西正朝你靠近。</span>
	<<else>>
		<<set $mpLightAmbush to 0>>
	<</if>>
<</widget>>

:: Widgets MP Alert [widget nobr]
<<widget "mpalertinit">>
	<<if _args[0]>>
		<<set _area to String(_args[0])>>
		<<set $mpAlertArea to _area>>
		<<if _area is "docks">>
			<<set $mpAlertBase to 1.2>><<set $mpAlert to 10>>
		<<elseif _area is "blackiron">>
			<<set $mpAlertBase to 1.4>><<set $mpAlert to 20>>
		<<elseif _area is "abbey">>
			<<set $mpAlertBase to 1.3>><<set $mpAlert to 15>>
		<<elseif _area is "velvet">>
			<<set $mpAlertBase to 1.5>><<set $mpAlert to 20>>
		<<elseif _area is "school">>
			<<set $mpAlertBase to 0.9>><<set $mpAlert to 5>>
		<<elseif _area is "orphanage">>
			<<set $mpAlertBase to 1.0>><<set $mpAlert to 5>>
		<<elseif _area is "catacomb">>
			<<set $mpAlertBase to 1.1>><<set $mpAlert to 10>>
		<<else>>
			<<set $mpAlertBase to 1.0>><<set $mpAlert to 10>>
		<</if>>
		<<set $mpAlertCaught to 0>>
		<<set $mpAlertTier to 0>>
	<</if>>
<</widget>>

<<widget "mpalert">>
	<<if _args[0]>>
		<<set _delta to Number(_args[0]) * ($mpAlertBase or 1)>>
		<<if Time.dayState is "night">><<set _delta to _delta * 1.1>><</if>>
		<<if $mpAlertArea is "catacomb" and $mpLight isnot undefined and $mpLight lt 20>>
			<<set _delta to _delta * 1.5>>
		<<elseif $mpAlertArea is "catacomb" and $mpLight isnot undefined and $mpLight gte 60>>
			<<set _delta to _delta * 0.8>>
		<</if>>
		<<set $mpAlert to Math.clamp(($mpAlert or 0) + _delta, 0, 100)>>
		<<if $mpAlert gte 100>><<set $mpAlertTier to 5>>
		<<elseif $mpAlert gte 80>><<set $mpAlertTier to 4>>
		<<elseif $mpAlert gte 60>><<set $mpAlertTier to 3>>
		<<elseif $mpAlert gte 40>><<set $mpAlertTier to 2>>
		<<elseif $mpAlert gte 20>><<set $mpAlertTier to 1>>
		<<else>><<set $mpAlertTier to 0>><</if>>
	<</if>>
<</widget>>

<<widget "mpalerttext">>
	<<set _a to ($mpAlert or 0)>>
	警戒：<<if _a gte 100>><<set $mpAlertTier to 5>><span class="red">「你已经被盯上。风险：致命」</span>
	<<elseif _a gte 80>><<set $mpAlertTier to 4>><span class="pink">「你快暴露了。风险：极高」</span>
	<<elseif _a gte 60>><<set $mpAlertTier to 3>><span class="purple">「有人在找你。风险：高」</span>
	<<elseif _a gte 40>><<set $mpAlertTier to 2>><span class="blue">「守卫开始留意这边。风险：中」</span>
	<<elseif _a gte 20>><<set $mpAlertTier to 1>><span class="teal">「有人瞥了你一眼。风险：低」</span>
	<<else>><<set $mpAlertTier to 0>><span class="green">「无人注意。风险：低」</span><</if>>
<</widget>>

<<widget "mpalertgain">>
	<<if !$settings.blindStatsEnabled>> | <span class="red">+ 警戒<<if _args[0]>>（<<print _args[0]>>）<</if>></span><</if>>
<</widget>>

<<widget "mpalertloss">>
	<<if !$settings.blindStatsEnabled>> | <span class="green">- 警戒<<if _args[0]>>（<<print _args[0]>>）<</if>></span><</if>>
<</widget>>

<<widget "mpalertcheck">>
	<<set $mpAlertCaught to 0>>
	<<if ($mpAlert or 0) gte 100>>
		<<set $mpAlertCaught to 1>>
		<span class="red">搜查队已经封住去路，你被死死盯住了。</span>
	<<elseif ($mpAlert or 0) gte 40 and random(1, 100) lte ($mpAlert or 0)>>
		<<set $mpAlertCaught to 1>>
		<span class="red">巡逻的脚步朝这边靠近，有人注意到你了。</span>
	<</if>>
<</widget>>

<<widget "mpalertclear">>
	<<set $mpAlert to 0>>
	<<set $mpAlertCaught to 0>>
	<<set $mpAlertTier to 0>>
<</widget>>

:: MP Insufficient [nobr]
<<set _ret to ($mpInsuffRet or "Orphanage")>><<set _lab to ($mpInsuffLabel or "这件事")>><<set _req to ($mpInsuffReq or "对应属性")>>
你试着「<<print _lab>>」，但这一次尝试超出了你当前的能力范围。
<br>
<span class="red">需要 <<print _req>>。</span>
<br><br>
<span class="blue"><i>一定还有别的办法，只是你现在还不知道该从哪儿找起。</i></span>
<br><br>
<<getouticon>><<link [[离开|_ret]]>><<set $eventskip to 1>><<endevent>><</link>>

:: MP NotNow [nobr]
<<set _ret to ($mpNotNowRet or "Orphanage")>><<set _lab to ($mpNotNowLabel or "这件事")>><<set _req to ($mpNotNowReq or "合适的时间")>>
你试着「<<print _lab>>」，但现在不是做这件事的时候。
<br>
<span class="red">需要 <<print _req>>。</span>
<br><br>
<span class="blue"><i>换个时间再来看看。</i></span>
<br><br>
<<getouticon>><<link [[离开|_ret]]>><<set $eventskip to 1>><<endevent>><</link>>
