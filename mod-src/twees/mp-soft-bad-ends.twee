<br>
<<socialiseicon>><<link "对通风口呼救 (0:06)">><<pass 6>><<replace "#glasshouse-vent-choices">>
<<if ($willpower or 0) gte 440 or ($english or 0) gte 250>>
<span class="green">你的声音顺着铜制通风管清晰传到了外廊，接应的同伴立刻在后门制造响动引开了守夜人。</span>
<<set $mpBadEndProgress to Math.min(100, ($mpBadEndProgress or 0) + 40)>><<stress -4>><<lstress>>
<<else>>
<span class="red">甜腻的花雾让你嗓音沙哑无力，微弱的呼喊被喷淋水声彻底淹没。</span>
<<stress 4>><<arousal 300>><<gstress>><<garousal>>
<</if>>
<</replace>><</link>>
</div>

