	<br><br>
	<<trialicon>><<link [[挣脱枯藤冲门 (0:12)|MP BadEnd Glasshouse Nectar EscapeWin]]>><<pass 12>><</link>>
<<else>>
	<<if ($mpBadEndProgress or 0) gte 60>>主藤已断大半，香雾变淡。<<elseif ($mpBadEndProgress or 0) gte 30>>右手已能活动，藤蔓力道减弱。<</if>>
	<br><br>
	<<sneakicon>><<link [[碎玻璃割主藤 (0:16)|MP BadEnd Glasshouse Nectar Shard]]>><<pass 16>><</link>>
	<br>
	<<fisticon>><<link [[蹬向冷凝釜 (0:15)|MP BadEnd Glasshouse Nectar Valve]]>><<pass 15>><</link>>
	<br>
	<<mphearticon>><<link [[拽顶棚百叶绳 (0:18)|MP BadEnd Glasshouse Nectar Vent]]>><<pass 18>><</link>>
	<br>
	<<link "趁藤脉缩腕 (0:18)">><<pass 18>><<replace "#glasshouse-nectar-patience">>
	<<if ($tending or 0) gte 280 or ($willpower or 0) gte 480>>
		<span class="green">你趁银脉兰喷淋间歇气根松弛，将左腕抽出半圈。</span><<set $mpBadEndProgress to Math.min(100, ($mpBadEndProgress or 0) + 35)>><<arousal -300>><<stress -2>><<larousal>><<lstress>>
	<<else>>
		<span class="red">甜腻花粉涌入肺腑，反而引得更多细藤缠上脚踝。</span><<set $mpBadEndDays to ($mpBadEndDays or 1) + 1>><<arousal 600>><<stress 4>><<garousal>><<gstress>>
	<</if>>
	<</replace>><</link>>
	<div id="glasshouse-nectar-patience"></div>
<</if>>

