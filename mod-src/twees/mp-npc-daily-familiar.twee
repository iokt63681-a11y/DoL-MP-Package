		<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<stress -3>>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("daily_fam_vesper_1")>><<money 150>><</if>>
	<<else>>
		<<stress 2>><<tiredness 1>>
	<</if>>
<</link>>
