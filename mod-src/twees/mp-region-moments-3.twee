<</if>>
<</replace>><</link>><<else>><<link [[旋紧黄铜蜗杆 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "旋紧黄铜蜗杆">><<set $mpInsuffReq to "家政等级：<span class='purple'>D</span> 或 体魄：11300">><<pass 7>><</link>><</if>>
