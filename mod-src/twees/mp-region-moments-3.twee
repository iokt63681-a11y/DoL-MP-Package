	<br>
	<<link [[返回静默石阶 (0:03)|MP Region Abbey Steps]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>><<else>><<link [[撑稳平底舟 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "撑稳平底舟">><<set $mpInsuffReq to "诡术等级：<span class='purple'>D</span> 或 科学等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
<br>
<<if ($tending or 0) gte 250 or ($history or 0) gte 260>><<link "拉近石阶铜铃 (0:07)">><<mpalert 8>><<pass 7>><<replace "#enc-abbey-2">>
<<if ($tending or 0) gte 250 or ($history or 0) gte 260>>
