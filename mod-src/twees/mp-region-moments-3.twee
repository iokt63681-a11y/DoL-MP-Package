<</if>>
<</replace>><</link>><<else>><<link [[旋松分油母 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "旋松分油母">><<set $mpInsuffReq to "科学等级：<span class='purple'>D</span> 或 体魄：11400">><<pass 6>><</link>><</if>>
<br>
<<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>><<link "引润滑脂入槽 (0:07)">><<pass 7>><<replace "#act-mp-region-moment-clockwork-6">>
<<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>>
