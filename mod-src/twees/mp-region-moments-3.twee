<</replace>><</link>><<else>><<link [[剪牛皮绳穿滑轮 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "剪牛皮绳穿滑轮">><<set $mpInsuffReq to "诡术等级：<span class='purple'>D</span> 或 运动等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
