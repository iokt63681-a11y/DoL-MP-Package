	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("reg_mom_glasshouse_6_alt")>><<set $mpHerbsCollected to ($mpHerbsCollected or 0) + 1>><span class="blue">获得草药 ×1</span><</if>><<skulduggery 1>>蜗杆顺畅咬合锁死冷风，窗台暗槽里滚出几枚多瑙河沙龙代用币。<span class="green">兰花厅恢复了温润恒温。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
