	<<link [[再试一次 (0:04)|MP Region Encounter Blackiron 1]]>><<pass 4>><</link>>
	<br>
	<<link [[返回调车场 (0:03)|MP Region Blackiron Siding]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>><<else>><<link [[剪断铅封丝 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "剪断铅封丝">><<set $mpInsuffReq to "诡术等级：<span class='purple'>D</span> 或 科学等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
<br>
<<if ($tending or 0) gte 250 or ($history or 0) gte 260>><<link "拧开螺母拆铁匣 (0:07)">><<pass 7>><<replace "#enc-blackiron-1">>
<<if ($tending or 0) gte 250 or ($history or 0) gte 260>>
	<<set $daily.mpRegEnc_blackiron_1 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("reg_enc_blackiron_1_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>><<skulduggery 1>>蝴蝶螺母旋下后铁匣完整脱落，你从容打开暗扣取出薪饷。<span class="green">你连架拆下押运匣拿到了存银。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[前往别处 (0:04)|MP Region Blackiron Siding]]>><<pass 4>><</link>>
<<else>>
	螺母沾满煤泥，拧动了半天也没能转开。<span class="red">你擦去煤泥决定换个法子。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Region Encounter Blackiron 1]]>><<pass 4>><</link>>
	<br>
	<<link [[返回通风处 (0:03)|MP Region Blackiron Siding]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>><<else>><<link [[拧开螺母拆铁匣 (0:07)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "拧开螺母拆铁匣">><<set $mpInsuffReq to "照料等级：<span class='purple'>D</span> 或 历史等级：<span class='purple'>D</span>">><<pass 7>><</link>><</if>>
</div>
<</if>>


:: MP Region Encounter Blackiron 2 [nobr]
<<set $outside to 1>><<set $location to "elk">><<effects>><<mpAmbient>>
<<if ($mpAlertArea or "") isnot "blackiron">><<mpalertinit "blackiron">><</if>><<mpalerttext>><<mpalertcheck>>
<<set $daily to ($daily or {})>>地下走私月台西侧的排水闸门转轮后塞着一只防水帆布袋，袋口被铁链缠在齿条上。
