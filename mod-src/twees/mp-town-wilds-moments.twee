<</if>>
<</replace>><</link>>
<br>
<<link "用铁丝扎紧防风灯底座挂钩 (0:06)">><<pass 6>><<replace "#moment-docks-4">>
<<if ($skulduggery or 0) gte 250 or ($willpower or 0) gte 420>>
