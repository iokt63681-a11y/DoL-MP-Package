/* 12章主线《潮汐与雾月之蚀》与6条跨区域搜集支线 / 线索门控·NPC引路 */
:: MP Main Story Eclipse Hub [nobr]
<<set $outside to 1>><<set $location to "town">><<effects>><<mpAmbient>>
<<set $mpClues to ($mpClues or {})>>
<<set _stg to ($mpMainStoryEclipse or 0)>>
<<set _exitPas to ($mpReturnPassage or "Orphanage")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Orphanage">><</if>>
<<if _stg gte 8>>
	<<include "MP Main Story Eclipse Late">>
<<elseif _stg gte 4>>
	<<include "MP Main Story Eclipse Mid">>
<<else>>
	<<getouticon>><<link [[离开 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
	<br>
	<<if _stg is 0>>
		高街与孤儿院交界的石墙下，<<if $NPCNameList and $NPCNameList.includes("Robin")>>罗宾<<else>>熟识的院童<</if>>朝新刻的新月记号努了努嘴：「昨晚有人在这儿翻出半页旧账册。」基石缝里塞着泡软的纸角。
		<br><br>
		<<investigateicon>><<if ($history or 0) gte 260 or ($skulduggery or 0) gte 280>><<link [[撬开松动基石 (0:05)|MP Main Story Eclipse Resolve]]>><<set $mpClues["main_eclipse_1"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 1>><<pass 5>><</link>><<else>><span class="disabled">撬开松动基石 (0:05)（属性不足）</span><</if>>
		<br>
		<<socialiseicon>><<if $NPCNameList and $NPCNameList.includes("Robin")>><<link [[问罗宾细节 (0:03)|MP Main Story Eclipse Resolve]]>><<set $mpClues["main_eclipse_1"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 1>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Robin")>><<npcincr Robin love 1>><</if>><<pass 3>><</link>><<else>><span class="disabled">问罗宾细节 (0:03)（尚未结识）</span><</if>>
	<<elseif _stg is 1>>
		<<set $outside to 0>><<set $location to "cabin">>
		高街钟表铺里，<<if $mpNpcs and $mpNpcs.sera and $mpNpcs.sera.hasMet>>塞拉<<else>>修表师<</if>>用放大镜端详账册残页：「这组音筒编号是给旧学园天文翼楼赤道仪校准用的。」
		<br><br>
		<<walkicon>><<if ($science or 0) gte 260 or ($maths or 0) gte 260>><<link [[去校准赤道仪 (0:08)|MP Main Story Eclipse Resolve]]>><<set $mpClues["main_eclipse_2"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 2>><<pass 8>><</link>><<else>><span class="disabled">去校准赤道仪 (0:08)（属性不足）</span><</if>>
	<<elseif _stg is 2>>
		<<set $outside to 0>><<set $location to "school">>
		天文翼楼穹顶室里，<<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>>诺艾尔<<else>>标本学徒<</if>>看见音筒后压低声音：「赤道仪刻度与神殿地下修道院的旧碑文是同一套记号。」
		<br><br>
		<<link [[前往灰烬藏经阁 (0:10)|MP Main Story Eclipse Resolve]]>><<set $mpClues["main_eclipse_3"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 3>><<pass 10>><</link>>
	<<else>>
		<<set $outside to 0>><<set $location to "temple">>
		地下修道院藏经阁门前，<<if $NPCNameList and $NPCNameList.includes("Jordan")>>乔丹<<else>>神殿修士<</if>>把小灯留给你：「账册与这里的碑文能对上，进去拓下来吧。」
		<br><br>
		<<if ($history or 0) gte 260 or ($english or 0) gte 260>><<link [[拓下藏经阁碑文 (0:12)|MP Main Story Eclipse Resolve]]>><<set $mpClues["main_eclipse_4"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 4>><<pass 12>><</link>><<else>><span class="disabled">拓下藏经阁碑文 (0:12)（属性不足）</span><</if>>
		<br>
		<<link [[调查线索 (0:08)|MP Main Story Eclipse Mid]]>><<pass 8>><</link>>
	<</if>>
<</if>>

:: MP Main Story Eclipse Mid [nobr]
<<set $outside to 0>><<set $location to "avery_mansion">><<effects>><<mpAmbient>>
<<set $mpClues to ($mpClues or {})>>
<<set _stg to ($mpMainStoryEclipse or 4)>>
<<set _exitPas to ($mpReturnPassage or "Orphanage")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Orphanage">><</if>>
<<getouticon>><<link [[离开 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if _stg is 4>>
	多瑙河秘密温室穹顶下，侍者低声透露：「今晚有人提到黑铁货运站三号装甲车，午夜换班。」
	<br><br>
<<sneakicon>><<if Time.dayState is "night" or Time.dayState is "dusk">><<if ($skulduggery or 0) gte 280>><<link [[潜入货运站 (0:15)|MP Main Story Eclipse Resolve]]>><<pass 15>><<if ($skulduggery or 0) gte 300>><<set $mpClues["main_eclipse_5"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 5>><<else>><<stress 3>><</if>><</link>><<else>><span class="disabled">潜入货运站 (0:15)（属性不足）</span><</if>><<else>><span class="disabled">潜入货运站 (0:15)（午夜换班时才有机可乘）</span><</if>>
<<elseif _stg is 5>>
	<<set $outside to 1>><<set $location to "docks">>
	黑铁货运站信号塔下，老码头工朝铁轨尽头抬下巴：「三号车昨晚拉走的箱子，下一站在深林石环月泉。」
	<br><br>
<<walkicon>><<link [[前往深林石环 (0:12)|MP Main Story Eclipse Resolve]]>><<set $mpClues["main_eclipse_6"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 6>><<pass 12>><</link>>
<<elseif _stg is 6>>
	<<set $outside to 1>><<set $location to "forest">>
	深林月泉边，<<if $NPCNameList and $NPCNameList.includes("Eden")>>伊甸<<else>>林间猎人<</if>>用刀尖指了指水面：「半枚徽章在泉底，另外半枚今晚在峭壁天鹅绒拍卖会。」
	<br><br>
<<swimicon>><<if ($swimmingskill or 0) gte 250>><<link [[潜入月泉底 (0:08)|MP Main Story Eclipse Resolve]]>><<pass 8>><<if ($swimmingskill or 0) gte 250>><<set $mpClues["main_eclipse_7"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 7>><<else>><<stress 3>><</if>><</link>><<else>><span class="disabled">潜入月泉底 (0:08)（水性不足）</span><</if>>
<<else>>
	<<set $outside to 0>><<set $location to "brothel">>
	天鹅绒暗层拍卖厅里，<<if $NPCNameList and $NPCNameList.includes("Briar")>>布莱尔<<else>>俱乐部东家<</if>>朝你举杯低语：「压轴拍品在我后廊保险柜，能混进后台我就当没看见。」
	<br><br>
<<if Time.dayState is "night" or Time.dayState is "dusk">><<if ($seductionskill or 0) gte 250 or ($skulduggery or 0) gte 250>><<link [[混进拍卖后台 (0:10)|MP Main Story Eclipse Resolve]]>><<pass 10>><<if ($seductionskill or 0) gte 350 or ($skulduggery or 0) gte 350>><<set $mpClues["main_eclipse_8"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 8>><<else>><<stress 3>><</if>><</link>><<else>><span class="disabled">混进拍卖后台 (0:10)（属性不足）</span><</if>><<else>><span class="disabled">混进拍卖后台 (0:10)（拍卖只在夜里开场）</span><</if>>
	<br>
<<link [[翻看终局航线线索 (0:08)|MP Main Story Eclipse Late]]>><<pass 8>><<stress 1>><</link>>
<</if>>

:: MP Main Story Eclipse Late [nobr]
<<set $outside to 0>><<set $location to "underground">><<effects>><<mpAmbient>>
<<set $mpClues to ($mpClues or {})>>
<<set _stg to ($mpMainStoryEclipse or 8)>>
<<set _exitPas to ($mpReturnPassage or "Orphanage")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "Orphanage">><</if>>
<<getouticon>><<link [[离开 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if _stg is 8>>
	地下机括城蒸汽室里，两半徽章在控制盘前微烫，主阀刻度与账册末页暗号完全一致。
	<br><br>
<<investigateicon>><<if ($maths or 0) gte 280>><<link [[校准主阀 (0:12)|MP Main Story Eclipse Resolve]]>><<pass 12>><<if ($maths or 0) gte 300>><<set $mpClues["main_eclipse_9"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 9>><<else>><<stress 3>><</if>><</link>><<else>><span class="disabled">校准主阀 (0:12)（属性不足）</span><</if>>
<<elseif _stg is 9>>
	<<set $outside to 0>><<set $location to "sewers">>
	暗河渡口的小船旁，守夜人认出徽章，把装有灯塔顶层手轮与海图的防水包推给你。
	<br><br>
<<walkicon>><<link [[收下防水油布包 (0:08)|MP Main Story Eclipse Resolve]]>><<set $mpClues["main_eclipse_10"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 10>><<pass 8>><</link>>
<<elseif _stg is 10>>
	<<set $outside to 1>><<set $location to "searocks">>
	黄昏风暴欲来，你把木舟系在雾角灯塔岛南侧石阶，顶层铜门在浓雾里若隐若现。
	<br><br>
<<runicon>><<if Time.dayState is "dusk" or Time.dayState is "night">><<if ($athletics or 0) gte 280 or ($physique or 0) gte 12000>><<link [[顶着海风登塔 (0:18)|MP Main Story Eclipse Resolve]]>><<pass 18>><<if ($athletics or 0) gte 300 or ($physique or 0) gte 12000>><<set $mpClues["main_eclipse_11"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 11>><<else>><<stress 3>><</if>><</link>><<else>><span class="disabled">顶着海风登塔 (0:18)（体魄不足）</span><</if>><<else>><span class="disabled">顶着海风登塔 (0:18)（要等黄昏风暴起雾）</span><</if>>
<<elseif _stg is 11>>
	<<set $outside to 1>><<set $location to "sea">>
	灯塔顶层旋转透镜下，铁柜里的早期契约、账册与基金凭证码得整整齐齐，光束扫过夜海。
	<br><br>
<<if ($history or 0) gte 260 or ($english or 0) gte 260>><<link [[核对原件 (0:08)|MP Main Story Eclipse Resolve]]>><<set $mpClues["main_eclipse_12"] to 1>><span class="blue">线索已记录</span><<set $mpMainStoryEclipse to 12>><<pass 8>><</link>><<else>><span class="disabled">核对原件 (0:08)（属性不足）</span><</if>>
<<else>>
	<<set $outside to 1>><<set $location to "sea">>
	灯塔顶层的铁柜已经打开过，契约与账册都收进了防水暗袋。海风从透镜间穿过，剩下的只是如何处置这些证据。
<</if>>

:: MP Main Story Eclipse Resolve [nobr]
<<set $outside to 1>><<set $location to "town">>
<<effects>><<mpAmbient>><<set $mpClues to ($mpClues or {})>>
<<set _exitPas to ($mpReturnPassage or "Orphanage")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Orphanage">>
<</if>>
你将第 <<print ($mpMainStoryEclipse or 1)>> 章的物证收进防水暗袋。
<<if ($mpMainStoryEclipse or 0) gte 12>>
	灯塔顶层的铁柜已经打开，契约、账册和基金凭证都在你手里。你靠着栏杆，听着海风从透镜间穿过。
	<<stress -15>><<trauma -10>><<control 25>>
<<else>>
	你把刚才看到的细节在脑子里过了一遍，确定下一步该从哪里查起。
	<<if Time.dayState is "night">>夜风从街角卷过，你把衣领拉高。<</if>>
<</if>>
<<if $mpClues["main_eclipse_1"] or $mpClues["main_eclipse_2"] or $mpClues["main_eclipse_3"] or $mpClues["main_eclipse_4"]>><span class="teal">高街旧账、赤道仪星标与藏经阁温室的卷宗在脑海中串联成线。</span><</if>>
<<if $mpClues["main_eclipse_5"] or $mpClues["main_eclipse_6"] or $mpClues["main_eclipse_7"] or $mpClues["main_eclipse_8"]>><span class="teal">黑铁货单、石环月泉与天鹅绒机括城的暗码彼此印证。</span><</if>>
<<if $mpClues["main_eclipse_9"] or $mpClues["main_eclipse_10"] or $mpClues["main_eclipse_11"] or $mpClues["main_eclipse_12"]>><span class="teal">雾角灯塔的油布包与顶层铁柜契约彻底补齐了最后一块拼图。</span><</if>>
<br><br>
<<investigateicon>><<link [[整理线索 (0:03)|MP Main Story Eclipse Hub]]>><<pass 3>><</link>>
<br>
<<getouticon>><<link [[离开 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>




/* 6条信物收集支线 V2 / 每条3段 / 先讲残片为何值得拼，再拼合，最后处置 / 分档奖励 */

:: MP Collection Quests Hub [nobr]
<<set $outside to 1>><<set $location to "town">><<effects>><<mpAmbient>>
<<set _exitPas to ($mpReturnPassage or "High Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>><<set _exitPas to "High Street">><</if>>
你在背光的石龛旁停步，将各地寻获的信物残片取出比对。
<br><br>
<<getouticon>><<link [[离开 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if ($mpFragCrownGear or 0) gte 3 and $mpDoneCrownGear isnot 1>>
	<<keepsakeicon>><<if ($skulduggery or 0) gte 280 or ($maths or 0) gte 260>><<link [[拼合齿轮开匣 (0:16)|MP Collection Resolve CrownGear]]>><<pass 16>><</link>><<else>><span class="disabled">拼合齿轮开匣 (0:16)（属性不足）</span><</if>><br>
<</if>>
<<if ($mpFragAbyssPage or 0) gte 3 and $mpDoneAbyssPage isnot 1>>
	<<investigateicon>><<if ($english or 0) gte 260 or ($history or 0) gte 260>><<link [[拼合残页 (0:18)|MP Collection Resolve AbyssPage]]>><<pass 18>><</link>><<else>><span class="disabled">拼合残页 (0:18)（属性不足）</span><</if>><br>
<</if>>
<<if ($mpFragSmugglerRing or 0) gte 3 and $mpDoneSmugglerRing isnot 1>>
	<<shopicon>><<if ($skulduggery or 0) gte 280>><<link [[合拢印戒开箱 (0:15)|MP Collection Resolve SmugglerRing]]>><<pass 15>><</link>><<else>><span class="disabled">合拢印戒开箱 (0:15)（属性不足）</span><</if>><br>
<</if>>
<<if ($mpFragBrideFlower or 0) gte 3 and $mpDoneBrideFlower isnot 1>>
	<<if ($science or 0) gte 260>><<link [[提纯秘露 (0:14)|MP Collection Resolve BrideFlower]]>><<pass 14>><</link>><<else>><span class="disabled">提纯秘露 (0:14)（属性不足）</span><</if>><br>
<</if>>
<<if ($mpFragVelvetCrest or 0) gte 3 and $mpDoneVelvetCrest isnot 1>>
	<<if ($seductionskill or 0) gte 260 or ($english or 0) gte 260>><<link [[嵌入徽章 (0:12)|MP Collection Resolve VelvetCrest]]>><<pass 12>><</link>><<else>><span class="disabled">嵌入徽章 (0:12)（属性不足）</span><</if>><br>
<</if>>
<<if ($mpFragLedgerKey or 0) gte 3 and $mpDoneLedgerKey isnot 1>>
	<<if ($skulduggery or 0) gte 280>><<link [[开启铅封匣 (0:15)|MP Collection Resolve LedgerKey]]>><<pass 15>><</link>><<else>><span class="disabled">开启铅封匣 (0:15)（属性不足）</span><</if>><br>
<</if>>
<<if (($mpFragCrownGear or 0) lt 3 or $mpDoneCrownGear is 1) and (($mpFragAbyssPage or 0) lt 3 or $mpDoneAbyssPage is 1) and (($mpFragSmugglerRing or 0) lt 3 or $mpDoneSmugglerRing is 1) and (($mpFragBrideFlower or 0) lt 3 or $mpDoneBrideFlower is 1) and (($mpFragVelvetCrest or 0) lt 3 or $mpDoneVelvetCrest is 1) and (($mpFragLedgerKey or 0) lt 3 or $mpDoneLedgerKey is 1)>>
	<span class="teal">尚有未集齐的残片散落在机括城、古修道院、雾角岛与温室各处。</span>
<</if>>

:: MP Collection Resolve CrownGear [nobr]
<<set $outside to 0>><<set $location to "underground">>
<<effects>><<mpAmbient>>
<<set $mpClues to ($mpClues or {})>>
<<set _exitPas to ($mpReturnPassage or "High Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "High Street">>
<</if>>
地下机括城的检修石廊只剩半盏汽灯。三枚黄铜齿轮的齿数是十七、二十三、三十一，边缘留着同一种被主阀磨出的亮痕。你把它们按旧图签上的顺序摆开，三段行程正好拼成排水泵的配重周期。潮水已经在廊道尽头拍打铁门——拼不齐，整条地下街都得泡在水里。
<br><br>
<<getouticon>><<link [[离开 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="act-mp-collection-resolve-crowngear">
<<if ($skulduggery or 0) gte 280 or ($willpower or 0) gte 280>><<keepsakeicon>><<link "去高街钟表铺 (0:06)">><<pass 6>><<replace "#act-mp-collection-resolve-crowngear">>
<<if ($skulduggery or 0) gte 320 or ($willpower or 0) gte 300>>
	<<set $mpClues["collect_crown_gear_path"] to 1>><span class="blue">线索已记录</span>
	你贴着压力锤的阴影侧身滑过，指尖拨开卡死的棘爪。锤头在头顶闷响一声，停在半空。
	<<stress 2>>
	<br><br>
	<<walkicon>><<link [[前往高街钟表铺 (0:08)|MP Collection Resolve CrownGear Step2]]>><<pass 8>><</link>>
	<br>
	<<socialiseicon>><<link [[记下齿轮齿序 (0:08)|MP Collection Resolve CrownGear Step2]]>><<set $mpClues["collect_crown_gear_order"] to 1>><span class="blue">线索已记录</span><<stress -1>><<pass 8>><</link>>
<<else>>
	棘爪弹回，压力锤擦着你的肩膀砸在石台上。铁锈和蒸汽一起扑到脸上。
	<<pain 3>><<stress 5>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Collection Resolve CrownGear]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">去高街钟表铺 (0:06)（属性不足）</span><</if>>
</div>
:: MP Collection Resolve CrownGear Step2 [nobr]
<<set $outside to 0>><<set $location to "town">>
<<effects>><<mpAmbient>>
<<set $mpClues to ($mpClues or {})>>
<<set _exitPas to ($mpReturnPassage or "High Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "High Street">>
<</if>>
高街钟表铺的后间比铺面窄一半。<<if $mpNpcs and $mpNpcs.sera and $mpNpcs.sera.hasMet>>塞拉<<else>>修表师<</if>>把三枚齿轮并排夹进黄铜卡盘，煤油灯下的齿影像三圈咬合的月相。
「这不是钟，是日历，」她用镊子敲了敲最大的那枚，「十七年、二十三年、三十一年，三圈走完正好是一次大修。」
车床一开，最薄的那枚开始打摆。你得在它崩齿前把偏心轴校回来。
<<if $mpClues["collect_crown_gear_order"]>><span class="teal">对照先前记下的齿序，你一眼认出了卡盘上三枚月相齿轮的主从位置。</span><</if>>
<br><br>
<<getouticon>><<link [[离开 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="act-mp-collection-resolve-crowngear-step2">
