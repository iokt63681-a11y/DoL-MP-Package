/* DoL-MP v1.2.0-dev8: mp-npc-intimate-days-2.twee (24 passages: 12 RelDay 5..6 + 12 Vanilla Daily 4..5) */
:: MP RelDay Sera 5 [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.sera to ($mpNpcs.sera or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.sera>>
<<if Time.season is "autumn" or Time.season is "winter">>霜降后的清晨寒意微凝，<<else>>微凉的清晨薄雾未散，<</if>>塞拉在钟表铺二楼小厨房煎了培根吐司。她把烘热的羊毛护腕套在你手上，指着窗台走慢半拍的旅行闹钟轻笑：「今天不接外客，把自家的钟调准。」
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.sera and $mpNpcs.sera.hasMet>><<link [[回到塞拉身旁 (0:03)|MP NPC Sera Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">回到塞拉身旁 (0:03)（尚未结识）</span><</if>>
<br>
<<if $daily.mpRelDay_sera_5 is 1>>
今日已叙过话，改天再来吧。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Sera 6]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-sera-5">
<<tendingicon>><<link "用铜镊拨正快慢针 (0:07)">><<pass 7>><<replace "#act-mp-relday-sera-5">>
<<if ($science or 0) gte 250 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpRelDay_sera_5 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>闹钟恢复清脆匀称的滴答声，塞拉顺势把头靠在你肩侧。<span class="green">晨光里的钟声与呼吸声交织在一起。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[傍晚再与对方相伴 (0:04)|MP RelDay Sera 6]]>><<pass 4>><</link>>
<<else>>
	镊子尖碰滑了微调拨片，发条轻响一声。<span class="red">塞拉握住你的手背带你慢慢找准刻度。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[挽起衣袖凑近再试 (0:04)|MP RelDay Sera 5]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回原处 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "端起搪瓷壶替她添满热茶 (0:08)">><<pass 8>><<replace "#act-mp-relday-sera-5">>
<<if ($housekeeping or 0) gte 240 or ($tending or 0) gte 240>>
	<<set $daily.mpRelDay_sera_5 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>锡兰红茶的暖香漫过桌面，塞拉捧着茶杯与你分食焦香吐司。<span class="green">她微凉的指尖在你掌心安心舒展开。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[留到傍晚继续相处 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<<else>>
	壶嘴热气熏红了你的指节，茶汤洒在托盘边。<span class="red">塞拉忙拿餐巾替你擦干手指的水珠。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<link [[垫稳脚下石砖再试 (0:04)|MP RelDay Sera 5]]>><<pass 4>><</link>>
	<br>
	<<link [[暂且收手离开 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Sera 6 [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.sera to ($mpNpcs.sera or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.sera>>
<<if Weather.precipitation is "rain">>傍晚细雨敲打着钟表铺天窗，<<else>>傍晚暮色漫过钟表铺天窗，<</if>>塞拉搬出装着早年设计手稿的樟木匣，把画着双摆怀表的图纸摊在你膝头：「这是按我们两人的步调画的，帮我选块表壳木料好不好？」
<br><br>
<<getouticon>><<link [[告别返回 (0:03)|MP NPC Sera Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpRelDay_sera_6 is 1>>
今天的事已办妥，先歇息吧。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Sera 7]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-sera-6">
<<tendingicon>><<link "挑出紫檀木片打磨 (0:08)">><<pass 8>><<replace "#act-mp-relday-sera-6">>
<<if ($tending or 0) gte 250 or ($housekeeping or 0) gte 250>>
	<<set $daily.mpRelDay_sera_6 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_sera_6")>><<money 650>><</if>>紫檀木片在砂纸下透出温润暗光，塞拉将刻有你名字缩写的铜牌嵌进内盖。<span class="green">双摆怀表成了你们独有的默契信物。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[改日清晨再聚 (0:04)|MP RelDay Sera 7]]>><<pass 4>><</link>>
<<else>>
	砂纸磨偏了木棱，细木屑沾满了袖口。<span class="red">塞拉笑着拿软刷替你扫净袖口木屑。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[看清暗扣方向再试 (0:04)|MP RelDay Sera 6]]>><<pass 4>><</link>>
	<br>
	<<link [[退回安全处 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "凑近灯下与她核算双摆齿 (0:09)">><<pass 9>><<replace "#act-mp-relday-sera-6">>
<<if ($maths or 0) gte 250 or ($science or 0) gte 250>>
	<<set $daily.mpRelDay_sera_6 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_sera_6")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><</if>>你在草稿纸上算出精准的共鸣齿比，塞拉惊喜地吻了吻你的脸颊。<span class="green">炉火映照下她的眼眸比星光更亮。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[约好下次相伴 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<<else>>
	连算两遍都差了半齿，你看得眼眶有些发酸。<span class="red">塞拉合上图纸让你先靠在她肩上歇眼。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<link [[借着阴影掩护再试 (0:04)|MP RelDay Sera 6]]>><<pass 4>><</link>>
	<br>
	<<link [[先回入口歇息 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Vesper 5 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.vesper to ($mpNpcs.vesper or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.vesper>>
<<if Time.dayState is "dawn" or Time.dayState is "morning">>退潮后的清晨海风微咸，<<else>>退潮后的旧港海风微咸，<</if>>维斯坐在防波堤木栈上给猎风号补刷桐油。见你走来，他把干爽的帆布海员衫披在你肩上：「风大，帮我递一下热松香桶。」
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.vesper and $mpNpcs.vesper.hasMet>><<link [[回到维斯身旁 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">回到维斯身旁 (0:03)（尚未结识）</span><</if>>
<br>
<<if $daily.mpRelDay_vesper_5 is 1>>
此处今日已来过，明日再聚。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Vesper 6]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-vesper-5">
<<tendingicon>><<link "拎起铜杓替船封蜡 (0:07)">><<pass 7>><<replace "#act-mp-relday-vesper-5">>
<<if ($athletics or 0) gte 250 or ($housekeeping or 0) gte 240>>
	<<set $daily.mpRelDay_vesper_5 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>滚烫的松香严丝合缝地封住橡木板隙，维斯伸手替你拂去发梢海雾。<span class="green">晨潮拍岸声里你们配合得默契无间。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[傍晚再与对方相伴 (0:04)|MP RelDay Vesper 6]]>><<pass 4>><</link>>
<<else>>
	海风吹歪了铜杓，一滴温蜡落在鞋面上。<span class="red">维斯一把将你拉向背风侧挡住浪花。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[捏稳手头工具再试 (0:04)|MP RelDay Vesper 5]]>><<pass 4>><</link>>
	<br>
	<<link [[收起工具退回 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "蹲在船头帮他把锚绳盘好 (0:08)">><<pass 8>><<replace "#act-mp-relday-vesper-5">>
<<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 240>>
	<<set $daily.mpRelDay_vesper_5 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>粗麻缆绳被你盘得紧实利落，维斯把一枚刻着北极星的铜哨系在你腕上。<span class="green">他在海风里握紧了你微凉的手掌。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[留到傍晚继续相处 (0:04)|MP NPC Vesper Hub]]>><<pass 4>><</link>>
<<else>>
	湿滑的麻绳磨红了虎口，绳圈散了一半。<span class="red">维斯掏出鹿皮护掌替你戴好才继续盘绳。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<link [[顺着齿轮咬合再试 (0:04)|MP RelDay Vesper 5]]>><<pass 4>><</link>>
	<br>
	<<link [[转身离开此地 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Vesper 6 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.vesper to ($mpNpcs.vesper or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.vesper>>
<<if Time.dayState is "night" or Time.dayState is "dusk">>夜航归港后，<<else>>船队归港休整时，<</if>>船长室小铁炉上炖着奶油蛤蜊浓汤。维斯解下佩刀挂在壁钩上，拉着你坐上铺着厚羊毛毯的船长榻：「外海起了大雾，就在船上安心歇着。」
<br><br>
<<getouticon>><<link [[告别返回 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpRelDay_vesper_6 is 1>>
今天已陪过对方，先回去吧。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Vesper 7]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-vesper-6">
<<tendingicon>><<link "掀开铁锅盖盛满浓汤 (0:08)">><<pass 8>><<replace "#act-mp-relday-vesper-6">>
<<if ($housekeeping or 0) gte 250 or ($tending or 0) gte 250>>
	<<set $daily.mpRelDay_vesper_6 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_vesper_6")>><<money 650>><span class="gold">你将这份沉甸甸的心意贴身收好。</span><</if>>奶香与海鲜的鲜甜驱散了寒气，维斯将你整个人圈进宽大的臂弯。<span class="green">疲惫一扫而空。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[改日清晨再聚 (0:04)|MP RelDay Vesper 7]]>><<pass 4>><</link>>
<<else>>
	船身随暗涌晃了一下，汤勺碰响了锅沿。<span class="red">只好先停手缓神。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[避开迎面冷风再试 (0:04)|MP RelDay Vesper 6]]>><<pass 4>><</link>>
	<br>
	<<link [[暂退一步歇脚 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "借着马灯微光与他看海图 (0:09)">><<pass 9>><<replace "#act-mp-relday-vesper-6">>
<<if ($history or 0) gte 250 or ($science or 0) gte 250>>
	<<set $daily.mpRelDay_vesper_6 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_vesper_6")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="gold">你把这份温热的信物妥善收进怀里。</span><</if>>你用分规标出两处避风暗湾，维斯低笑着把下巴搁在你肩窝。<span class="green">眉眼间满是笑意。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[约好下次相伴 (0:04)|MP NPC Vesper Hub]]>><<pass 4>><</link>>
<<else>>
	昏黄马灯晃得海图线条重影，你打了个哈欠。<span class="red">动作不由得乱了节拍。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<link [[找准落脚石棱再试 (0:04)|MP RelDay Vesper 6]]>><<pass 4>><</link>>
	<br>
	<<link [[顺原路退回 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Noel 5 [nobr]
<<set $outside to 0>><<set $location to "school">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.noel to ($mpNpcs.noel or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.noel>>
<<if Time.weekDay is 1 or Time.weekDay is 7>>周末午后的旧理科室静悄悄的，<<else>>课后闲暇的旧理科室静悄悄的，<</if>>诺艾尔正踮脚往高柜顶层摆放密封干花瓶。阳光穿过百叶窗落在她发梢，她回头冲你抿嘴一笑：「最上面那格够不着，帮我扶一下木梯好吗？」
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>><<link [[回到诺艾尔身旁 (0:03)|MP NPC Noel Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">回到诺艾尔身旁 (0:03)（尚未结识）</span><</if>>
<br>
<<if $daily.mpRelDay_noel_5 is 1>>
今日活计已清，改日再来。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Noel 6]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-noel-5">
<<tendingicon>><<link "双手稳住木梯两侧 (0:07)">><<pass 7>><<replace "#act-mp-relday-noel-5">>
<<if ($physique or 10000) gte 11400 or ($athletics or 0) gte 240>>
	<<set $daily.mpRelDay_noel_5 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>诺艾尔稳稳放好标本瓶，下来时顺势扑进你怀里松了口气。<span class="green">淡淡的干花幽香萦绕在你们鼻尖。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[傍晚再与对方相伴 (0:04)|MP RelDay Noel 6]]>><<pass 4>><</link>>
<<else>>
	木梯脚垫在瓷砖上滑了半寸，吓得她抓紧梯档。<span class="red">你连忙用肩膀顶住梯身护着她下来。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[屏住呼吸重新试探 (0:04)|MP RelDay Noel 5]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回原处 (0:03)|MP NPC Noel Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "按采集月份替琉璃瓶贴签 (0:08)">><<pass 8>><<replace "#act-mp-relday-noel-5">>
<<if ($english or 0) gte 240 or ($science or 0) gte 240>>
	<<set $daily.mpRelDay_noel_5 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>娟秀的标签整整齐齐排成一列，诺艾尔把一朵压干的蓝冠花别在你衣领内侧。<span class="green">她耳根微红地与你并肩坐在窗台边。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[留到傍晚继续相处 (0:04)|MP NPC Noel Hub]]>><<pass 4>><</link>>
<<else>>
	浆糊刷得稍厚，两张标签粘在了指尖上。<span class="red">诺艾尔用湿帕子仔细替你擦净手指。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<link [[调整手腕角度再试 (0:04)|MP RelDay Noel 5]]>><<pass 4>><</link>>
	<br>
	<<link [[暂且收手离开 (0:03)|MP NPC Noel Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Noel 6 [nobr]
<<set $outside to 0>><<set $location to "school">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.noel to ($mpNpcs.noel or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.noel>>
<<if Weather.precipitation is "rain">>傍晚公园花房外下起蒙蒙细雨，<<else>>傍晚公园花房外晚风轻拂，<</if>>诺艾尔在育苗桌旁点起洋甘菊香薰灯。她把写满批注的草木图鉴推到你俩中间，膝盖轻贴着你的腿侧：「这几页安神茶方，我只写给你一个人看。」
<br><br>
<<getouticon>><<link [[告别返回 (0:03)|MP NPC Noel Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpRelDay_noel_6 is 1>>
今天已聊得尽兴，先回吧。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Noel 7]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-noel-6">
<<tendingicon>><<link "用钢笔补湿度记录 (0:08)">><<pass 8>><<replace "#act-mp-relday-noel-6">>
<<if ($science or 0) gte 250 or ($maths or 0) gte 250>>
	<<set $daily.mpRelDay_noel_6 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_noel_6")>><<money 650>><</if>>严谨的数据让茶方更加完备，诺艾尔欢喜地靠着你的肩头翻向下一页。<span class="green">心头暖意融融。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[改日清晨再聚 (0:04)|MP RelDay Noel 7]]>><<pass 4>><</link>>
<<else>>
	钢笔尖洇出一小团墨迹，弄脏了指腹。<span class="red">你连忙收势稳住心神。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[擦净指尖汗水再试 (0:04)|MP RelDay Noel 6]]>><<pass 4>><</link>>
	<br>
	<<link [[退回安全处 (0:03)|MP NPC Noel Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "将烘好的甘菊与薄荷装袋 (0:09)">><<pass 9>><<replace "#act-mp-relday-noel-6">>
<<if ($tending or 0) gte 250 or ($housekeeping or 0) gte 250>>
	<<set $daily.mpRelDay_noel_6 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_noel_6")>><<set $mpHerbsCollected to ($mpHerbsCollected or 0) + 1>><</if>>清甜的草木香气扑面而来，诺艾尔将系着浅绿丝带的香囊塞进你贴身口袋。<span class="green">彼此默契更深。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[约好下次相伴 (0:04)|MP NPC Noel Hub]]>><<pass 4>><</link>>
<<else>>
	薄荷干叶捏得太碎，粉末呛得你打了个喷嚏。<span class="red">只好先缓一缓再动手。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<link [[看准器物缝隙再试 (0:04)|MP RelDay Noel 6]]>><<pass 4>><</link>>
	<br>
	<<link [[先回入口歇息 (0:03)|MP NPC Noel Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Lin 5 [nobr]
<<set $outside to 0>><<set $location to "home">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.lin to ($mpNpcs.lin or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.lin>>
<<if Weather.precipitation is "rain">>雨夜巡街归来，林恩把湿透的皮夹克挂在修车库火炉边。<<else>>夜巡交班归来，林恩把沾着夜露的皮夹克挂在修车库火炉边。<</if>>他从铁皮柜里翻出两盒热牛肉馅饼，把馅料最足的那盒推到你面前：「刚从丰收街带回来的，趁热吃。」
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[回到林恩身旁 (0:03)|MP NPC Lin Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">回到林恩身旁 (0:03)（尚未结识）</span><</if>>
<br>
<<if $daily.mpRelDay_lin_5 is 1>>
此处今日已打点妥当。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Lin 6]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-lin-5">
<<tendingicon>><<link "拿干毛巾擦他发梢 (0:07)">><<pass 7>><<replace "#act-mp-relday-lin-5">>
<<if ($tending or 0) gte 240 or ($housekeeping or 0) gte 240>>
	<<set $daily.mpRelDay_lin_5 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>林恩微阖着眼任由你动作，平日冷峻的眉峰彻底柔和下来。<span class="green">炉火噼啪声中他握住了你的手腕。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[傍晚再与对方相伴 (0:04)|MP RelDay Lin 6]]>><<pass 4>><</link>>
<<else>>
	毛巾勾到了他耳后的旧擦伤，林恩轻嘶一声。<span class="red">你连忙放轻力道替他吹了吹伤处。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[稳住下盘重心再试 (0:04)|MP RelDay Lin 5]]>><<pass 4>><</link>>
	<br>
	<<link [[收起工具退回 (0:03)|MP NPC Lin Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "坐在木箱上陪他拆检手电 (0:08)">><<pass 8>><<replace "#act-mp-relday-lin-5">>
<<if ($skulduggery or 0) gte 240 or ($science or 0) gte 240>>
	<<set $daily.mpRelDay_lin_5 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>你擦亮手电接触片让光束重归雪亮，林恩把备用防身短哨交到你手里。<span class="green">并肩而坐的温度驱散了整夜寒气。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[留到傍晚继续相处 (0:04)|MP NPC Lin Hub]]>><<pass 4>><</link>>
<<else>>
	弹簧片从指间弹落，滚进了工作台底下。<span class="red">林恩俯身拾起弹簧，揉了揉你的发顶。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<link [[顺着纹理走向再试 (0:04)|MP RelDay Lin 5]]>><<pass 4>><</link>>
	<br>
	<<link [[转身离开此地 (0:03)|MP NPC Lin Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Lin 6 [nobr]
<<set $outside to 0>><<set $location to "home">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.lin to ($mpNpcs.lin or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.lin>>
<<if Time.dayState is "dawn" or Time.dayState is "morning">>清晨天色微明，<<else>>白昼街巷安宁，<</if>>林恩在阁楼窗边缠好深灰护腕。见你醒来，他半蹲在软垫边替你披上厚外套，声音低沉温和：「今天街区太平，我陪你去河湾走走。」
<br><br>
<<getouticon>><<link [[告别返回 (0:03)|MP NPC Lin Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpRelDay_lin_6 is 1>>
今天的心意已传达到位。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Lin 7]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-lin-6">
<<tendingicon>><<link "替他把左腕绷带系紧 (0:08)">><<pass 8>><<replace "#act-mp-relday-lin-6">>
<<if ($tending or 0) gte 250 or ($athletics or 0) gte 250>>
	<<set $daily.mpRelDay_lin_6 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_lin_6")>><<money 650>><span class="gold">你珍重地将这份馈赠收入贴身衣袋。</span><</if>>平结服帖稳固，林恩反手与你十指紧扣，掌心的薄茧磨过你的指腹。<span class="green">气氛温馨宁静。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[改日清晨再聚 (0:04)|MP RelDay Lin 7]]>><<pass 4>><</link>>
<<else>>
	绷带缠得稍紧了一扣，勒住了他的腕骨。<span class="red">只好先停手缓神。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[放缓指尖力道再试 (0:04)|MP RelDay Lin 6]]>><<pass 4>><</link>>
	<br>
	<<link [[暂退一步歇脚 (0:03)|MP NPC Lin Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "将热好的麦片粥端上小桌 (0:09)">><<pass 9>><<replace "#act-mp-relday-lin-6">>
<<if ($housekeeping or 0) gte 250 or ($willpower or 0) gte 420>>
	<<set $daily.mpRelDay_lin_6 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_lin_6")>><<set $mpHerbsCollected to ($mpHerbsCollected or 0) + 1>><span class="gold">你微笑着收下了这份独属于你们的留念。</span><</if>>热气腾腾的早餐让阁楼暖意融融，林恩替你擦去唇角沾着的一点奶沫。<span class="green">两人相视一笑。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[约好下次相伴 (0:04)|MP NPC Lin Hub]]>><<pass 4>><</link>>
<<else>>
	端铁盘时指尖碰到了烫边，差点晃洒麦粥。<span class="red">指尖微微有些忙乱。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<link [[借着微光看清再试 (0:04)|MP RelDay Lin 6]]>><<pass 4>><</link>>
	<br>
	<<link [[顺原路退回 (0:03)|MP NPC Lin Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Monet 5 [nobr]
<<set $outside to 0>><<set $location to "cafe">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.monet to ($mpNpcs.monet or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.monet>>
<<if Time.dayState is "day">>午后阳光斜照进天鹅绒画室，<<else>>柔和的暖光映照着天鹅绒画室，<</if>>莫奈正对着半幅未干的油画沉思。听见你的脚步声，她展颜一笑，朝你伸出沾着群青颜料的手：「我的缪斯来得正好，帮我看看这道高光。」
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.monet and $mpNpcs.monet.hasMet>><<link [[回到莫奈身旁 (0:03)|MP NPC Monet Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">回到莫奈身旁 (0:03)（尚未结识）</span><</if>>
<br>
<<if $daily.mpRelDay_monet_5 is 1>>
今日已相伴多时，改天再来。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Monet 6]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-monet-5">
<<tendingicon>><<link "执细画笔添抹银白 (0:07)">><<pass 7>><<replace "#act-mp-relday-monet-5">>
<<if ($danceskill or 0) gte 250 or ($tending or 0) gte 240>>
	<<set $daily.mpRelDay_monet_5 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>一笔银白让整幅丝绸衣褶活了过来，莫奈从身后环住你的腰赞叹不已。<span class="green">两人相视一笑。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[傍晚再与对方相伴 (0:04)|MP RelDay Monet 6]]>><<pass 4>><</link>>
<<else>>
	手腕微晃让银白颜料多晕开了半寸。<span class="red">手头一时失了准星。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[揉热发僵手指再试 (0:04)|MP RelDay Monet 5]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回原处 (0:03)|MP NPC Monet Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "替她把散落的丝绸色卡排齐 (0:08)">><<pass 8>><<replace "#act-mp-relday-monet-5">>
<<if ($housekeeping or 0) gte 250 or ($english or 0) gte 240>>
	<<set $daily.mpRelDay_monet_5 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>数十张色卡如彩虹般铺陈开来，莫奈挑出最衬你瞳色的一缕丝带系在你腕间。<span class="green">疲惫一扫而空。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[留到傍晚继续相处 (0:04)|MP NPC Monet Hub]]>><<pass 4>><</link>>
<<else>>
	几张丝绒色卡滑落在地毯下，你弯腰去捡时碰翻了水盂。<span class="red">你忙撤手退到一旁缓气。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<link [[听准机括节拍再试 (0:04)|MP RelDay Monet 5]]>><<pass 4>><</link>>
	<br>
	<<link [[暂且收手离开 (0:03)|MP NPC Monet Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Monet 6 [nobr]
