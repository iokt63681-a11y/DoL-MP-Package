/* DoL-MP v1.2.0-dev8: mp-npc-intimate-days-2.twee (24 passages: 12 RelDay 5..6 + 12 Vanilla Daily 4..5) */
:: MP RelDay Sera 5 [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<set _npc to $mpNpcs.sera>>
霜降后的清晨，塞拉在钟表铺二楼小厨房煎了培根吐司。她把刚烘热的羊毛护腕套在你手上，指着窗台上一只走慢半拍的旅行闹钟轻笑：「今天不接外客，我们把自家的钟调准。」
<br><br>
<<getouticon>><<link [[回到塞拉身旁 (0:03)|MP NPC Sera Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpRelDay_sera_5 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-relday-sera-5">
<<tendingicon>><<link "用铜镊拨正快慢针 (0:07)">><<pass 7>><<replace "#act-mp-relday-sera-5">>
<<set $daily.mpRelDay_sera_5 to 1>>
<<if ($science or 0) gte 250 or ($skulduggery or 0) gte 240>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>闹钟恢复清脆匀称的滴答声，塞拉顺势把头靠在你肩侧。<span class="green">晨光里的钟声与呼吸声交织在一起。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[傍晚再与对方相伴 (0:04)|MP RelDay Sera 6]]>><<pass 4>><</link>>
<<else>>
	镊子尖碰滑了微调拨片，发条轻响一声。<span class="red">塞拉握住你的手背带你慢慢找准刻度。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP RelDay Sera 5]]>><<set $daily.mpRelDay_sera_5 to 0>><<pass 3>><</link>>
	<br>
	<<link [[傍晚再与对方相伴 (0:04)|MP RelDay Sera 6]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "端起搪瓷壶替她添满热茶 (0:08)">><<pass 8>><<replace "#act-mp-relday-sera-5">>
<<set $daily.mpRelDay_sera_5 to 1>>
<<if ($housekeeping or 0) gte 240 or ($tending or 0) gte 240>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>锡兰红茶的暖香漫过桌面，塞拉捧着茶杯与你分食焦香吐司。<span class="green">她微凉的指尖在你掌心安心舒展开。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[留到傍晚继续相处 (0:04)|MP RelDay Sera 6]]>><<pass 4>><</link>>
<<else>>
	壶嘴热气熏红了你的指节，茶汤洒在托盘边。<span class="red">塞拉忙拿餐巾替你擦干手指的水珠。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<walkicon>><<link [[先去帮忙打理日常 (0:04)|MP NPC Sera Help]]>><<pass 4>><</link>>
	<br>
	<<link [[调整状态再试 (0:03)|MP RelDay Sera 5]]>><<set $daily.mpRelDay_sera_5 to 0>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Sera 6 [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<set _npc to $mpNpcs.sera>>
傍晚细雨敲打着天窗，塞拉搬出装着早年设计手稿的樟木匣，把最底下那张画着双摆怀表的图纸摊在你膝头：「这是按我们两人的步调画的，帮我选块表壳木料好不好？」
<br><br>
<<getouticon>><<link [[告别返回 (0:03)|MP NPC Sera Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpRelDay_sera_6 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-relday-sera-6">
<<tendingicon>><<link "挑出紫檀木片打磨 (0:08)">><<pass 8>><<replace "#act-mp-relday-sera-6">>
<<set $daily.mpRelDay_sera_6 to 1>>
<<if ($tending or 0) gte 250 or ($housekeeping or 0) gte 250>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_sera_6")>><<money 650>><</if>>紫檀木片在砂纸下透出温润暗光，塞拉将刻有你名字缩写的铜牌嵌进内盖。<span class="green">双摆怀表成了你们独有的默契信物。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[温存后返回 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<<else>>
	砂纸磨偏了木棱，细木屑沾满了袖口。<span class="red">塞拉笑着拿软刷替你扫净袖口木屑。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP RelDay Sera 6]]>><<set $daily.mpRelDay_sera_6 to 0>><<pass 3>><</link>>
	<br>
	<<link [[温存后返回 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "凑近灯下与她核算双摆齿 (0:09)">><<pass 9>><<replace "#act-mp-relday-sera-6">>
<<set $daily.mpRelDay_sera_6 to 1>>
<<if ($maths or 0) gte 250 or ($science or 0) gte 250>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_sera_6")>><<money 650>><</if>>你在草稿纸上算出精准的共鸣齿比，塞拉惊喜地吻了吻你的脸颊。<span class="green">炉火映照下她的眼眸比星光更亮。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好信物返回 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<<else>>
	连算两遍都差了半齿，你看得眼眶有些发酸。<span class="red">塞拉合上图纸让你先靠在她肩上歇眼。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<link [[去闲聊几句缓神 (0:04)|MP NPC Sera Chat]]>><<pass 4>><</link>>
	<br>
	<<link [[调整状态再试 (0:03)|MP RelDay Sera 6]]>><<set $daily.mpRelDay_sera_6 to 0>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Vesper 5 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<set _npc to $mpNpcs.vesper>>
退潮后的清晨，维斯坐在防波堤尽头的木栈上给猎风号补刷桐油。见你踏着湿石板走来，他顺手把一件干爽的帆布海员衫披在你肩上：「风大，帮我递一下热松香桶。」
<br><br>
<<getouticon>><<link [[回到维斯身旁 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpRelDay_vesper_5 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-relday-vesper-5">
<<tendingicon>><<link "拎起铜杓替船封蜡 (0:07)">><<pass 7>><<replace "#act-mp-relday-vesper-5">>
<<set $daily.mpRelDay_vesper_5 to 1>>
<<if ($athletics or 0) gte 250 or ($housekeeping or 0) gte 240>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>滚烫的松香严丝合缝地封住橡木板隙，维斯伸手替你拂去发梢海雾。<span class="green">晨潮拍岸声里你们配合得默契无间。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[傍晚再与对方相伴 (0:04)|MP RelDay Vesper 6]]>><<pass 4>><</link>>
<<else>>
	海风吹歪了铜杓，一滴温蜡落在鞋面上。<span class="red">维斯一把将你拉向背风侧挡住浪花。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP RelDay Vesper 5]]>><<set $daily.mpRelDay_vesper_5 to 0>><<pass 3>><</link>>
	<br>
	<<link [[傍晚再与对方相伴 (0:04)|MP RelDay Vesper 6]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "蹲在船头帮他把锚绳盘好 (0:08)">><<pass 8>><<replace "#act-mp-relday-vesper-5">>
<<set $daily.mpRelDay_vesper_5 to 1>>
<<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 240>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>粗麻缆绳被你盘得紧实利落，维斯把一枚刻着北极星的铜哨系在你腕上。<span class="green">他在海风里握紧了你微凉的手掌。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[留到傍晚继续相处 (0:04)|MP RelDay Vesper 6]]>><<pass 4>><</link>>
<<else>>
	湿滑的麻绳磨红了虎口，绳圈散了一半。<span class="red">维斯掏出鹿皮护掌替你戴好才继续盘绳。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<walkicon>><<link [[先去帮忙打理日常 (0:04)|MP NPC Vesper Help]]>><<pass 4>><</link>>
	<br>
	<<link [[调整状态再试 (0:03)|MP RelDay Vesper 5]]>><<set $daily.mpRelDay_vesper_5 to 0>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Vesper 6 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<set _npc to $mpNpcs.vesper>>
夜航归港后，船长室的小铁炉上炖着奶油蛤蜊浓汤。维斯解下佩刀挂在壁钩上，拉着你坐上铺着厚羊毛毯的船长榻：「外海起了大雾，今晚哪里也不去，就在船上歇着。」
<br><br>
<<getouticon>><<link [[告别返回 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpRelDay_vesper_6 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-relday-vesper-6">
<<tendingicon>><<link "揭开铁锅盛满浓汤 (0:08)">><<pass 8>><<replace "#act-mp-relday-vesper-6">>
<<set $daily.mpRelDay_vesper_6 to 1>>
<<if ($housekeeping or 0) gte 250 or ($tending or 0) gte 250>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_vesper_6")>><<money 650>><span class="gold">你收到了 £6.50 心意补贴。</span><</if>>奶香与海鲜的鲜甜驱散了寒气，维斯将你整个人圈进宽大的臂弯。<span class="green">摇晃的船舱成了最安稳的避风港。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[温存后返回 (0:04)|MP NPC Vesper Hub]]>><<pass 4>><</link>>
<<else>>
	船身随暗涌晃了一下，汤勺碰响了锅沿。<span class="red">维斯稳稳托住你的手腕把汤碗接过去。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP RelDay Vesper 6]]>><<set $daily.mpRelDay_vesper_6 to 0>><<pass 3>><</link>>
	<br>
	<<link [[温存后返回 (0:04)|MP NPC Vesper Hub]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "借着马灯微光与他看海图 (0:09)">><<pass 9>><<replace "#act-mp-relday-vesper-6">>
<<set $daily.mpRelDay_vesper_6 to 1>>
<<if ($history or 0) gte 250 or ($science or 0) gte 250>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_vesper_6")>><<money 650>><span class="gold">你收到了 £6.50 心意补贴。</span><</if>>你用分规标出两处避风暗湾，维斯低笑着把下巴搁在你肩窝。<span class="green">海浪轻拍船壳伴着你们安然入眠。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好信物返回 (0:04)|MP NPC Vesper Hub]]>><<pass 4>><</link>>
<<else>>
	昏黄马灯晃得海图线条重影，你打了个哈欠。<span class="red">维斯吹熄马灯替你掖好羊毛厚毯。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<walkicon>><<link [[去闲聊几句缓神 (0:04)|MP NPC Vesper Chat]]>><<pass 4>><</link>>
	<br>
	<<link [[调整状态再试 (0:03)|MP RelDay Vesper 6]]>><<set $daily.mpRelDay_vesper_6 to 0>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Noel 5 [nobr]
<<set $outside to 0>><<set $location to "school">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<set _npc to $mpNpcs.noel>>
周末午后的旧理科室静悄悄的，诺艾尔正踮着脚往高柜顶层摆放密封好的干花瓶。阳光穿过百叶窗落在她发梢，她回头冲你抿嘴一笑：「最上面那格够不着，你帮我扶一下木梯。」
<br><br>
<<getouticon>><<link [[回到诺艾尔身旁 (0:03)|MP NPC Noel Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpRelDay_noel_5 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-relday-noel-5">
<<tendingicon>><<link "双手稳住木梯两侧 (0:07)">><<pass 7>><<replace "#act-mp-relday-noel-5">>
<<set $daily.mpRelDay_noel_5 to 1>>
<<if ($physique or 10000) gte 11400 or ($athletics or 0) gte 240>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>诺艾尔稳稳放好标本瓶，下来时顺势扑进你怀里松了口气。<span class="green">淡淡的干花幽香萦绕在你们鼻尖。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[傍晚再与对方相伴 (0:04)|MP RelDay Noel 6]]>><<pass 4>><</link>>
<<else>>
	木梯脚垫在瓷砖上滑了半寸，吓得她抓紧梯档。<span class="red">你连忙用肩膀顶住梯身护着她下来。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP RelDay Noel 5]]>><<set $daily.mpRelDay_noel_5 to 0>><<pass 3>><</link>>
	<br>
	<<link [[傍晚再与对方相伴 (0:04)|MP RelDay Noel 6]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "按采集月份替琉璃瓶贴签 (0:08)">><<pass 8>><<replace "#act-mp-relday-noel-5">>
<<set $daily.mpRelDay_noel_5 to 1>>
<<if ($english or 0) gte 240 or ($science or 0) gte 240>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>娟秀的标签整整齐齐排成一列，诺艾尔把一朵压干的蓝冠花别在你衣领内侧。<span class="green">她耳根微红地与你并肩坐在窗台边。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[留到傍晚继续相处 (0:04)|MP RelDay Noel 6]]>><<pass 4>><</link>>
<<else>>
	浆糊刷得稍厚，两张标签粘在了指尖上。<span class="red">诺艾尔用湿帕子仔细替你擦净手指。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<walkicon>><<link [[先去帮忙打理日常 (0:04)|MP NPC Noel Help]]>><<pass 4>><</link>>
	<br>
	<<link [[调整状态再试 (0:03)|MP RelDay Noel 5]]>><<set $daily.mpRelDay_noel_5 to 0>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Noel 6 [nobr]
<<set $outside to 0>><<set $location to "school">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<set _npc to $mpNpcs.noel>>
傍晚公园花房下起蒙蒙细雨，诺艾尔在育苗桌旁点起一盏洋甘菊香薰灯。她把一本写满批注的草木图鉴推到你俩中间，膝盖轻轻贴着你的腿侧：「这几页安神茶方，我只写给你一个人看。」
<br><br>
<<getouticon>><<link [[告别返回 (0:03)|MP NPC Noel Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpRelDay_noel_6 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-relday-noel-6">
<<tendingicon>><<link "用钢笔补湿度记录 (0:08)">><<pass 8>><<replace "#act-mp-relday-noel-6">>
<<set $daily.mpRelDay_noel_6 to 1>>
<<if ($science or 0) gte 250 or ($maths or 0) gte 250>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_noel_6")>><<money 650>><</if>>严谨的数据让茶方更加完备，诺艾尔欢喜地靠着你的肩头翻向下一页。<span class="green">雨声淅沥的花房里满是静谧温存。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[温存后返回 (0:04)|MP NPC Noel Hub]]>><<pass 4>><</link>>
<<else>>
	钢笔尖洇出一小团墨迹，弄脏了指腹。<span class="red">诺艾尔拿吸墨纸替你轻轻按干页角。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP RelDay Noel 6]]>><<set $daily.mpRelDay_noel_6 to 0>><<pass 3>><</link>>
	<br>
	<<link [[温存后返回 (0:04)|MP NPC Noel Hub]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
