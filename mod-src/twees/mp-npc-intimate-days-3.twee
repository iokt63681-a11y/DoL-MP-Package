<<getouticon>><<if $mpNpcs and $mpNpcs.ash and $mpNpcs.ash.hasMet>><<link [[回到阿什身旁 (0:03)|MP NPC Ash Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">回到阿什身旁 (0:03)（尚未结识）</span><</if>>
