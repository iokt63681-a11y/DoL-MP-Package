/* DoL-MP v1.2.0-dev9: mp-npc-intimate-days-3.twee (24 passages: 12 RelDay 7..8 + 12 Vanilla Daily 6..7) */

:: MP RelDay Sera 7 [nobr]
<<set $outside to 0>><<set $location to "town">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.sera to ($mpNpcs.sera or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.sera>>
<<if Time.dayState is "morning" or Time.dayState is "dawn">>晨雾还未散尽，<<else>>高街街面安静时，<</if>>塞拉把二楼阳台的铸铁花架擦拭干净，摆上两盆刚换盆的迷迭香。她递给你一把弯嘴铜剪：「陪我修剪一下枯枝，顺便晒晒太阳好不好？」
脚边搁着一只盛满清水的铜壶。<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.sera and $mpNpcs.sera.hasMet>><<link [[回到塞拉铺中 (0:03)|MP NPC Sera Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">回到塞拉铺中 (0:03)（尚未结识）</span><</if>>
<br>
<<if $daily.mpRelDay_sera_7 is 1>>
今日已叙过话，改天再来吧。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Sera 8]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-sera-7">
<<tendingicon>><<link "用弯嘴铜剪修齐侧枝 (0:07)">><<pass 7>><<replace "#act-mp-relday-sera-7">>
<<if ($tending or 0) gte 250 or ($housekeeping or 0) gte 240>>
	<<set $daily.mpRelDay_sera_7 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>草木清香扑面而来，塞拉满意地拢了拢耳畔碎发，将一片香叶别在你衣领上。<span class="green">阳光落在你们相贴的肩头格外温暖。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[留到晚间陪她校表 (0:04)|MP RelDay Sera 8]]>><<pass 4>><</link>>
<<else>>
	铜剪刃口滑了一下，剪落了一朵刚抽芽的嫩叶。<span class="red">塞拉笑着接过铜剪教你认准分枝节位。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[看准枝节重新下剪 (0:04)|MP RelDay Sera 7]]>><<pass 4>><</link>>
	<br>
	<<link [[先回楼下铺面 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "端温水壶沿盆沿慢慢浇透 (0:08)">><<pass 8>><<replace "#act-mp-relday-sera-7">>
<<if ($science or 0) gte 240 or ($willpower or 0) gte 420>>
	<<set $daily.mpRelDay_sera_7 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>湿润泥土沁出清冽芬芳，塞拉从身后轻轻环住你的腰，陪你俯瞰高街屋顶。<span class="green">静谧晨光让两人的心境无比澄澈。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[约定傍晚再聚 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<<else>>
	水流稍急溅出盆沿，打湿了阳台木栏。<span class="red">你连忙拿干布替她擦净栏杆水渍。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[放缓壶嘴水流再浇 (0:04)|MP RelDay Sera 7]]>><<pass 4>><</link>>
	<br>
	<<link [[退回工作台旁 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Sera 8 [nobr]
<<set $outside to 0>><<set $location to "town">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.sera to ($mpNpcs.sera or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.sera>>
<<if Time.dayState is "night" or Time.dayState is "dusk">>夜色漫上高街屋檐，<<else>>打烊落锁后的阁楼里，<</if>>塞拉点亮台面上的黄铜酒精灯，取出一只为你特制的银链怀表壳：「就差最后一道抛光与刻字了，把你的名字缩写刻在背面吧。」
<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.sera and $mpNpcs.sera.hasMet>><<link [[告别塞拉返回 (0:03)|MP NPC Sera Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">告别塞拉返回 (0:03)（尚未结识）</span><</if>>
<br>
<<if $daily.mpRelDay_sera_8 is 1>>
今天的事已办妥，先歇息吧。
<<else>>
<div id="act-mp-relday-sera-8">
<<investigateicon>><<link "执雕刻针描出缩写字 (0:07)">><<pass 7>><<replace "#act-mp-relday-sera-8">>
<<if ($skulduggery or 0) gte 260 or ($science or 0) gte 250>>
	<<set $daily.mpRelDay_sera_8 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_sera_8")>><<money 650>>银屑簌簌落下，娟秀有力的花体缩写跃然表背，塞拉亲手将表链系在你衣扣上。<<else>>银屑簌簌落下，花体缩写跃然表背，塞拉微笑着替你理好表链。<</if>><span class="green">贴身怀表承载着她毫无保留的心意。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好怀表返回 (0:04)|MP NPC Sera Hub]]>><<pass 4>><</link>>
<<else>>
	刻针在弧形银面上滑偏半毫，留下一道浅痕。<span class="red">塞拉用玛瑙压刀替你抚平银面刮痕。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[托稳表壳重新落针 (0:04)|MP RelDay Sera 8]]>><<pass 4>><</link>>
	<br>
	<<link [[先回柜台歇手 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "用鹿皮蘸膏把表壳擦镜亮 (0:08)">><<pass 8>><<replace "#act-mp-relday-sera-8">>
<<if ($housekeeping or 0) gte 250 or ($tending or 0) gte 250>>
	<<set $daily.mpRelDay_sera_8 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_sera_8_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>银壳在灯下映出你们并肩的倒影，塞拉仰头在你唇角印下一吻，塞给你一枚手绘木书签。<<else>>银壳在台灯下映出你们并肩的倒影，塞拉仰头在你唇角印下一吻。<</if>><<willpower 1>><<gwillpower>><span class="green">温润银光见证着你们长久的陪伴。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[相拥片刻后返回 (0:04)|High Street]]>><<pass 4>><</link>>
<<else>>
	抛光膏抹得略厚，蹭花了袖口边缘。<span class="red">你拿温湿帕子擦净袖口白膏。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[换块干净鹿皮再擦 (0:04)|MP RelDay Sera 8]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回前厅歇息 (0:03)|MP NPC Sera Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>
<br>
<<link [[改日再访 (0:04)|MP RelDay Sera 9]]>><<pass 4>><</link>>

:: MP RelDay Vesper 7 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.vesper to ($mpNpcs.vesper or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.vesper>>
<<if Weather.precipitation is "rain">>海雨敲打着旧港防波堤，<<else>>海风吹拂着旧港防波堤，<</if>>维斯正站在猎风号甲板上校准备用罗盘。看见你走上跳板，他伸手揽住你的肩：「下午要试航新改的副帆，陪我出港转一圈？」

<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.vesper and $mpNpcs.vesper.hasMet>><<link [[返回维斯栈桥 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">返回维斯栈桥 (0:03)（尚未结识）</span><</if>>
<br>
<<if $daily.mpRelDay_vesper_7 is 1>>
此处今日已来过，明日再聚。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Vesper 8]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-vesper-7">
<<swimicon>><<link "拽紧主缭绳迎风调帆 (0:07)">><<pass 7>><<replace "#act-mp-relday-vesper-7">>
<<if ($athletics or 0) gte 250 or ($physique or 10000) gte 11400>>
	<<set $daily.mpRelDay_vesper_7 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>三角副帆吃满海风，船身轻盈地破开碧波，维斯站在舵轮旁冲你畅快大笑。<span class="green">你们在海风中配合得天衣无缝。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[随船归港共进晚餐 (0:04)|MP RelDay Vesper 8]]>><<pass 4>><</link>>
<<else>>
	横风猛地一扯缭绳，粗糙麻绳磨红了你的掌心。<span class="red">维斯一把按住绞盘替你卸去风力。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[缠稳绞盘重新拉帆 (0:04)|MP RelDay Vesper 7]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回船舱口 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "守在舵轮旁对照海图报水深 (0:08)">><<pass 8>><<replace "#act-mp-relday-vesper-7">>
<<if ($science or 0) gte 240 or ($history or 0) gte 240>>
	<<set $daily.mpRelDay_vesper_7 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>猎风号沿着你报出的水道灵巧绕开暗流，维斯腾出一只手揉了揉你的发顶。<span class="green">他眼底满是对你航海眼力的信赖。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[返航回船长室小聚 (0:04)|MP NPC Vesper Hub]]>><<pass 4>><</link>>
<<else>>
	船身颠簸晃花了海图刻度，你差点报错水深。<span class="red">你扶住海图桌稳住身形。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[按住海图重新核对 (0:04)|MP RelDay Vesper 7]]>><<pass 4>><</link>>
	<br>
	<<link [[退回防波堤旁 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP RelDay Vesper 8 [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.vesper to ($mpNpcs.vesper or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.vesper>>
<<if Time.dayState is "night" or Time.dayState is "dusk">>夜色笼罩暗港水面，<<else>>归港抛锚后的船长室里，<</if>>维斯打开一只黑檀木海图匣，取出一枚嵌着北极星银徽的航海怀表放在你手心：「这艘船和我的归途，以后都有你一半。」
炉边温着一壶肉桂茶，电炉的铜丝还泛着暗红。<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.vesper and $mpNpcs.vesper.hasMet>><<link [[告别维斯上岸 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">告别维斯上岸 (0:03)（尚未结识）</span><</if>>
<br>
<<if $daily.mpRelDay_vesper_8 is 1>>
今天已陪过对方，先回去吧。
<<else>>
<div id="act-mp-relday-vesper-8">
<<keepsakeicon>><<link "替他将备用海图封蜡 (0:07)">><<pass 7>><<replace "#act-mp-relday-vesper-8">>
<<if ($skulduggery or 0) gte 250 or ($housekeeping or 0) gte 250>>
	<<set $daily.mpRelDay_vesper_8 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 2)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_vesper_8")>><<money 650>>船锚火漆印章稳稳落在羊皮封口上，维斯从背后拥住你，将一份航线红利塞进你手里。<<else>>船锚火漆印章稳稳落在羊皮封口上，维斯从背后温和地拥住你。<</if>><span class="green">船长室的暖光将海雾彻底隔绝在外。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好信物返回岸上 (0:04)|MP NPC Vesper Hub]]>><<pass 4>><</link>>
<<else>>
	滚烫火漆滴在指背上，烫出一点红印。<span class="red">维斯连忙拿冰朗姆酒瓶替你冰敷手指。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[握稳铜印重新封缄 (0:04)|MP RelDay Vesper 8]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回甲板吹风 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "用电炉替他温一壶肉桂茶 (0:08)">><<pass 8>><<replace "#act-mp-relday-vesper-8">>
<<if ($tending or 0) gte 250 or ($willpower or 0) gte 420>>
	<<set $daily.mpRelDay_vesper_8 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 2)>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_vesper_8_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>醇厚甜香在舱内弥漫开来，维斯与你碰了碰锡杯，把私港纪念信物推到你手边。<<else>>醇厚甜香在船舱内弥漫开来，维斯与你碰了碰锡杯相视一笑。<</if>><<control 1>><span class="green">听着船底潮声，你们度过了安宁的一夜。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[饮尽热茶返回栈桥 (0:04)|Docks]]>><<pass 4>><</link>>
<<else>>
	肉桂粉撒得多了些，茶汤略微发苦。<span class="red">你添了半勺蜂蜜准备重新调匀。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[添入蜂蜜重新搅拌 (0:04)|MP RelDay Vesper 8]]>><<pass 4>><</link>>
	<br>
	<<link [[先回防波堤上 (0:03)|MP NPC Vesper Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>
<br>
<<link [[改日再访 (0:04)|MP RelDay Vesper 9]]>><<pass 4>><</link>>

:: MP RelDay Noel 7 [nobr]
<<set $outside to 0>><<set $location to "school">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpNpcs to ($mpNpcs or {})>><<set $mpNpcs.noel to ($mpNpcs.noel or { love: 0, trust: 0, lust: 0, dom: 0, corruption: 0, stage: 0 })>><<set _npc to $mpNpcs.noel>>
<<if Time.dayState is "day" or Time.dayState is "morning">>白昼阳光穿过标本室玻璃窗，<<else>>旧理科室亮起柔和的台灯，<</if>>诺艾尔正在蒸馏一瓶新鲜的苦橙花露。她见你进来，忙递过一只水晶滴管：「帮我盯着冷凝管流速，别让花露溢出来好不好？」

<br><br>
<<getouticon>><<if $mpNpcs and $mpNpcs.noel and $mpNpcs.noel.hasMet>><<link [[回到诺艾尔身边 (0:03)|MP NPC Noel Hub]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">回到诺艾尔身边 (0:03)（尚未结识）</span><</if>>
<br>
<<if $daily.mpRelDay_noel_7 is 1>>
今日活计已清，改日再来。
<br>
<<link [[顺路继续查探 (0:04)|MP RelDay Noel 8]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-relday-noel-7">
<<tendingicon>><<link "控稳酒精灯焰芯高度 (0:07)">><<pass 7>><<replace "#act-mp-relday-noel-7">>
<<if ($science or 0) gte 250 or ($tending or 0) gte 240>>
	<<set $daily.mpRelDay_noel_7 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>清亮的花露一滴滴落入收集瓶，诺艾尔蘸了一滴抹在你手腕内侧，脸颊微红。<span class="green">清甜的苦橙花香在你们呼吸间流转。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[傍晚陪她去花房护苗 (0:04)|MP RelDay Noel 8]]>><<pass 4>><</link>>
<<else>>
	火苗窜高了一下，烧瓶里冒出一串急泡。<span class="red">手背被热气烘得发烫，你忙拨低灯芯。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[拨低灯芯重新控温 (0:04)|MP RelDay Noel 7]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回窗边长椅 (0:03)|MP NPC Noel Hub]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "用绒布包住接收瓶分装贴签 (0:08)">><<pass 8>><<replace "#act-mp-relday-noel-7">>
<<if ($housekeeping or 0) gte 240 or ($english or 0) gte 240>>
	<<set $daily.mpRelDay_noel_7 to 1>>
	<<set _npc.love to Math.min(100, (_npc.love or 0) + 1)>><<set _npc.trust to Math.min(100, (_npc.trust or 0) + 1)>>每一只小瓶都贴上了工整的手写标签，诺艾尔开心地把最满的一瓶塞进你口袋。<span class="green">她望向你的眼神里盛满温柔笑意。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
