<<set _first to true>>
<br><br>
<<socialiseicon>><<if $NPCNameList and $NPCNameList.includes("Wren")>><<link [[和雷恩分头离开 (0:04)|Docks]]>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Wren")>><<npcincr Wren love 1>><</if>><<pass 4>><<set $eventskip to 1>><<endevent>><</link>><<else>><span class="disabled">和雷恩分头离开 (0:04)（尚未结识）</span><</if>>
<br>
