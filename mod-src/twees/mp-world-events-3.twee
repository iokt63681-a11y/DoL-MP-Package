:: MP World Mer AnchorBollardBag [nobr]
<<set $outside to 1>><<set $location to "mer">>
<<effects>>
<<set _exitPas to ($mpReturnPassage or "Mer Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Mer Street">>
<</if>>
梅尔街海员俱乐部外侧的锚链桩下塞着一只防水帆布袋。<<mpAmbient>>你放缓脚步环顾四周，见帆布袋铜扣上系着前人留下的水手暗结。
<<if ($mpAlertArea or "") isnot "docks">><<mpalertinit "docks">><</if>><<mpalerttext>><<mpalertcheck>>
<br><br>
<<getouticon>><<link [[缓步走回梅尔街边 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<br>
<<if ($mpAlert or 0) lt 100>>
<div id="wev-mp-world-mer-anchorbollardbag">
<<investigateicon>><<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>><<link "取出帆布袋 (0:05)">><<mpalert 8>><<pass 5>><<replace "#wev-mp-world-mer-anchorbollardbag">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_mer_anchorbollardbag")>><<money 220>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你借着海员俱乐部锚链桩的掩护解开防水帆布袋，将里面的旧银币与未鉴定古物揣进衣袋。<span class="green">你在锚链桩下顺利起出了防水帆布袋。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[离开 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<<else>>
	防水帆布袋被粗重的铁锚链压得极紧，你用力拉扯时指节磕在铸铁桩底座上，擦出一道红印。<span class="red">指节被锚链桩底座刮痛，只得先缩回手。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[握稳工具重调位置 (0:04)|MP World Mer AnchorBollardBag]]>><<pass 4>><</link>>
	<br>
	<<link [[返回梅尔街 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<</if>>
<</replace>><</link>><<mpalertgain "锚链桩后的窸窣声">><<else>><<link [[取出帆布袋 (0:05)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "取出帆布袋">><<set $mpInsuffReq to "诡术等级：<span class='purple'>D</span> 或 照料等级：<span class='purple'>D</span>">><<pass 5>><</link>><</if>>
<br>
<<if ($science or 0) gte 260 or ($athletics or 0) gte 250>><<link "沿石缝抽出 (0:06)">><<mpalert 6>><<pass 6>><<replace "#wev-mp-world-mer-anchorbollardbag">>
<<if ($science or 0) gte 240 or ($athletics or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_mer_anchorbollardbag_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你顺着石缝探到封蜡袋口，将防水帆布袋连同夹层里的零钞一并抽了出来。<span class="green">你用巧劲取下了完好无损的防水帆布袋。</span><<tiredness -1>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[走回梅尔街 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<<else>>
	俱乐部木门内忽然传来水手喧哗声，你动作一滞，袖口蹭上了一点船焦油。<span class="red">为免引人注意，你先停手退到栈桥暗影里。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[压住台面重新着力 (0:04)|MP World Mer AnchorBollardBag]]>><<pass 4>><</link>>
	<br>
	<<link [[返回外围通道 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<</if>>
<</replace>><</link>><<mpalertgain "罐体在石缝里刮擦">><<else>><<link [[沿石缝抽出 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "沿石缝抽出">><<set $mpInsuffReq to "科学等级：<span class='purple'>D</span> 或 运动等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
</div>
<</if>>
<<if ($mpAlert or 0) gte 80>>
<br>
<div id="mp-alert-mer-anchorbollardbag-exit">
<<if ($mpAlert or 0) gte 100>>
<<fisticon>><<link [[拼死一搏 (0:12)|MP Elite Encounter Abyssal Tentacles]]>><<set $mpReturnPassage to "Mer Street">><<set $mpAlert to 0>><<set $mpAlertCaught to 0>><<pass 12>><</link>>
<br>
<<if Math.max(($seductionskill or 0), ($english or 0), ($willpower or 0)) gte 260>><<link [[虚张声势 (0:08)|MP Alert Docks Bluff]]>><<set $mpReturnPassage to "Mer Street">><<set $mpAlertReturn to "MP World Mer AnchorBollardBag">><<pass 8>><</link>><<else>><<link [[虚张声势 (0:08)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "虚张声势">><<set $mpInsuffReq to "魅力等级：<span class='purple'>D</span> 或 英语等级：<span class='purple'>D</span> 或 意志等级：<span class='purple'>D</span>">><<pass 8>><</link>><</if>>
<br>
<<link [[转身就跑 (0:06)|MP Alert Docks Flee]]>><<set $mpReturnPassage to "Mer Street">><<pass 6>><</link>>
<<else>>
<<link [[硬闯出去 (0:10)|MP Elite Encounter Abyssal Tentacles]]>><<set $mpReturnPassage to "Mer Street">><<set $mpAlert to 0>><<set $mpAlertCaught to 0>><<pass 10>><</link>>
<</if>>
</div>
<</if>>

:: MP World Elk PulleyRailPadlock [nobr]
<<set $outside to 1>><<set $location to "elk">>
<<effects>>
<<set _exitPas to ($mpReturnPassage or "Elk Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Elk Street">>
<</if>>
麋鹿街三号仓库的滑轮导轨槽里卡着一只黄铜挂锁与钥匙串。<<mpAmbient>>你驻足留心仓库四周，看见锁梁侧面刻着货栈编号。
<<if ($mpAlertArea or "") isnot "docks">><<mpalertinit "docks">><</if>><<mpalerttext>><<mpalertcheck>>
<br><br>
<<getouticon>><<link [[返回麋鹿街 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<br>
<<if ($mpAlert or 0) lt 100>>
<div id="wev-mp-world-elk-pulleyrailpadlock">
<<investigateicon>><<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>><<link "取出挂锁钥匙 (0:05)">><<mpalert 8>><<pass 5>><<replace "#wev-mp-world-elk-pulleyrailpadlock">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_elk_pulleyrailpadlock")>><<money 220>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你借着三号仓库铁门的掩护解下黄铜挂锁与钥匙串，把连带的旧银币与古物妥善收入囊中。<span class="green">你在滑轮导轨槽里顺利起出了挂锁与钥匙串。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好器物返回 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<<else>>
	黄铜挂锁与钥匙串卡在导轨滑槽深处，你探手拨弄时指腹蹭在钢轨毛刺上，火辣生疼。<span class="red">指腹被导轨钢刺刮痛，只得先缩回手。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[垫上干布重起卡扣 (0:04)|MP World Elk PulleyRailPadlock]]>><<pass 4>><</link>>
	<br>
	<<link [[走回麋鹿街 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<</if>>
<</replace>><</link>><<mpalertgain "锁簧在导轨里轻响">><<else>><<link [[取出挂锁钥匙 (0:05)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "取出挂锁钥匙">><<set $mpInsuffReq to "诡术等级：<span class='purple'>D</span> 或 照料等级：<span class='purple'>D</span>">><<pass 5>><</link>><</if>>
<br>
<<if ($science or 0) gte 260 or ($athletics or 0) gte 250>><<link "顺墙根暗槽移出 (0:06)">><<mpalert 6>><<pass 6>><<replace "#wev-mp-world-elk-pulleyrailpadlock">>
<<if ($science or 0) gte 240 or ($athletics or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_elk_pulleyrailpadlock_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你拨开导轨止动簧片卸下锁扣，将黄铜挂锁与钥匙串连同小皮袋里的零钞一并取下。<span class="green">你完好取下了黄铜挂锁与钥匙串。</span><<tiredness -1>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[转回麋鹿街 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<<else>>
	仓库后街响起运货马车碾过石板的声响，你手腕微偏没能借上力。<span class="red">你收回手指，决定等巡道声过去再试。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[顺着卯眼重新发力 (0:04)|MP World Elk PulleyRailPadlock]]>><<pass 4>><</link>>
	<br>
	<<link [[转回麋鹿街 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><<mpalertclear>><</link>>
<</if>>
<</replace>><</link>><<mpalertgain "铁件在水泥地上拖出的摩擦">><<else>><<link [[顺墙根暗槽移出 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "顺墙根暗槽移出">><<set $mpInsuffReq to "科学等级：<span class='purple'>D</span> 或 运动等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
</div>
<</if>>
<<if ($mpAlert or 0) gte 80>>
<br>
<div id="mp-alert-elk-pulleyrailpadlock-exit">
<<if ($mpAlert or 0) gte 100>>
<<fisticon>><<link [[拼死一搏 (0:12)|MP Elite Encounter Abyssal Tentacles]]>><<set $mpReturnPassage to "Elk Street">><<set $mpAlert to 0>><<set $mpAlertCaught to 0>><<pass 12>><</link>>
<br>
<<if Math.max(($seductionskill or 0), ($english or 0), ($willpower or 0)) gte 260>><<link [[虚张声势 (0:08)|MP Alert Docks Bluff]]>><<set $mpReturnPassage to "Elk Street">><<set $mpAlertReturn to "MP World Elk PulleyRailPadlock">><<pass 8>><</link>><<else>><<link [[虚张声势 (0:08)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "虚张声势">><<set $mpInsuffReq to "魅力等级：<span class='purple'>D</span> 或 英语等级：<span class='purple'>D</span> 或 意志等级：<span class='purple'>D</span>">><<pass 8>><</link>><</if>>
<br>
<<link [[转身就跑 (0:06)|MP Alert Docks Flee]]>><<set $mpReturnPassage to "Elk Street">><<pass 6>><</link>>
<<else>>
<<link [[硬闯出去 (0:10)|MP Elite Encounter Abyssal Tentacles]]>><<set $mpReturnPassage to "Elk Street">><<set $mpAlert to 0>><<set $mpAlertCaught to 0>><<pass 10>><</link>>
<</if>>
</div>
<</if>>

:: MP World Harvest FlourSackCashbox [nobr]
<<set $outside to 1>><<set $location to "pub">>
<<effects>>
<<set _exitPas to ($mpReturnPassage or "Harvest Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Harvest Street">>
<</if>>
丰收街面包房后院的面粉麻袋堆夹缝里藏着一只小巧的木钱匣。<<mpAmbient>>你借着院墙掩护扫视左右，发现木钱匣铜角上刻着旧徽记。
<br><br>
<<getouticon>><<link [[返回丰收街 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="wev-mp-world-harvest-floursackcashbox">
<<investigateicon>><<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>><<link "挑开木钱匣扣 (0:05)">><<pass 5>><<replace "#wev-mp-world-harvest-floursackcashbox">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_harvest_floursackcashbox")>><<money 220>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你借着面粉麻袋堆的遮挡挑开木钱匣搭扣，将暗格里的零散银币与古物一并收好。<span class="green">你在面包房后院顺利起出了木钱匣。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[拍净衣角回街 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	木钱匣被两袋沉甸甸的面粉麻袋挤在墙角，你硬抽时手背磨在粗麻布上，泛起一片红痕。<span class="red">手背被粗麻袋磨得生疼，只得先缩回手。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[擦净指腹重按簧片 (0:04)|MP World Harvest FlourSackCashbox]]>><<pass 4>><</link>>
	<br>
	<<link [[走回丰收街 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><<link [[挑开木钱匣扣 (0:05)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "挑开木钱匣扣">><<set $mpInsuffReq to "诡术等级：<span class='purple'>D</span> 或 照料等级：<span class='purple'>D</span>">><<pass 5>><</link>><</if>>
<br>
<<if ($science or 0) gte 260 or ($athletics or 0) gte 250>><<link "垫帕子取出 (0:06)">><<pass 6>><<replace "#wev-mp-world-harvest-floursackcashbox">>
<<if ($science or 0) gte 240 or ($athletics or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_harvest_floursackcashbox_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你垫着帕子挪松上层麻袋，将木钱匣连同底格里的零钞稳稳抱了出来。<span class="green">你用巧劲取下了完好无损的木钱匣。</span><<tiredness -1>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[转回丰收街 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	后院风口吹来一阵细白面粉迷了眼，你探手的角度偏了半寸。<span class="red">指尖擦过木钱匣铜包角，只能暂且作罢。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[找准支点重新撬动 (0:04)|MP World Harvest FlourSackCashbox]]>><<pass 4>><</link>>
	<br>
	<<link [[转身步回丰收街边 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><<link [[垫帕子取出 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "垫帕子取出">><<set $mpInsuffReq to "科学等级：<span class='purple'>D</span> 或 运动等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
</div>

:: MP World ResAlley GeraniumPotWrap [nobr]
<<set $outside to 1>><<set $location to "residential_alley">>
<<effects>>
<<set _exitPas to ($mpReturnPassage or "Residential Alleyways")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Residential Alleyways">>
<</if>>
住宅区小巷的青砖矮墙顶上摆着三盆天竺葵，中间花盆下压着油纸包。<<mpAmbient>>你收敛气息打量巷口，见油纸包折角处抹着防潮蜂蜡。
<br><br>
<<getouticon>><<link [[返回住宅区 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="wev-mp-world-resalley-geraniumpotwrap">
<<investigateicon>><<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>><<link "摸出油纸包 (0:05)">><<pass 5>><<replace "#wev-mp-world-resalley-geraniumpotwrap">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_resalley_geraniumpotwrap")>><<money 220>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你借着天竺葵枝叶的掩护拆开油纸包，把封存的旧银币与古物稳稳收进贴身口袋。<span class="green">你在矮墙花盆下顺利起出了油纸包。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[返回原处 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	陶土花盆底盘粗糙沉重，你伸手去抽油纸包时指尖被碎瓦片刮了一下。<span class="red">指尖被盆底碎瓦刮痛，只得先把手指抽回。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[扶稳器座重调角度 (0:04)|MP World ResAlley GeraniumPotWrap]]>><<pass 4>><</link>>
	<br>
	<<link [[走回住宅区 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><<link [[摸出油纸包 (0:05)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "摸出油纸包">><<set $mpInsuffReq to "诡术等级：<span class='purple'>D</span> 或 照料等级：<span class='purple'>D</span>">><<pass 5>><</link>><</if>>
<br>
<<if ($science or 0) gte 260 or ($athletics or 0) gte 250>><<link "借盲区解封绳 (0:06)">><<pass 6>><<replace "#wev-mp-world-resalley-geraniumpotwrap">>
<<if ($science or 0) gte 240 or ($athletics or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_resalley_geraniumpotwrap_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你一手稳稳托起天竺葵花盆，另一手将油纸包连同里面的零钞完整抽出。<span class="green">你完好取出了花盆底下的油纸包。</span><<tiredness -1>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[退到通风处 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
