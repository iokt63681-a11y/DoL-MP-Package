	<<investigateicon>><<link [[继续探索 (0:25)|MP Quest Farmland Mill Resolve]]>><<set $mpQuestMill to 7>><<if !$daily>><<set $daily to {}>><</if>><<set $daily.mpQuestMill to 1>><<pass 25>><<stress -4>><<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("mpQuestMill_stg_7")>><<if "mpQuestMill" is "mpQuestUnderground" or "mpQuestMill" is "mpQuestVelvet">><<set $mpContrabandSealed to ($mpContrabandSealed or 0) + 1>><<else>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><</if>><</if>><</link>><<lstress>>
	<br>
<</if>>
