<</if>>
<</replace>><</link>>
<br>
<<link "屏息探手从风孔摸出异物 (0:06)">><<pass 6>><<replace "#reg-mom-foghorn-4">>
<<if ($skulduggery or 0) gte 250 or ($willpower or 0) gte 430>>
	<<set $mpClues to ($mpClues or {})>><<set $mpClues["mp_region_moment_foghorn_4_alt"] to 1>>
	你顺着器物纹理巧施寸劲，原本卡滞的关窍应声松开。<span class="green">你将内里藏着的收获稳稳纳入怀中。</span>
