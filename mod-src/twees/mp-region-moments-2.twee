	<br><br>
	<<walkicon>><<link [[顺通道继续往里探看 (0:04)|MP Region Moment Foghorn 5]]>><<pass 4>><</link>>
<<else>>
	<<set $mpClues to ($mpClues or {})>><<set $mpClues["mp_region_moment_foghorn_4_alt"] to 1>>
