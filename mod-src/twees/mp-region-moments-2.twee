	<<set $mpClues to ($mpClues or {})>><<set $mpClues["mp_region_moment_clockwork_1_alt"] to 1>>
	你屏息听准周遭动静，趁着空档将手头之事妥善办完。<span class="green">整套手法行云流水，令人暗暗称奇。</span>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("reg_moment_clockwork_1")>><<money 280>><</if>>
