	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("reg_moment_clockwork_3_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
