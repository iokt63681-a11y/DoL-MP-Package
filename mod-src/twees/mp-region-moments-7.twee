	<<link [[再试一次 (0:04)|MP Region Encounter Foghorn 10]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|MP Region Foghorn Island]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "比对系船锚链 (0:08)">><<pass 8>><<replace "#act-mp_region_encounter_foghorn_10">>
<<if (($science or 0) + ($mpClues['clue_reg7_foghorn_3'] ? 60 : 0)) gte 250 or (($history or 0)) gte 250>>
	<<set $daily.mpReg7_foghorn_5 to 1>><<set $mpClues["clue_reg7_foghorn_4"] to 1>><<swimmingskill 2>><<gswimming>>
