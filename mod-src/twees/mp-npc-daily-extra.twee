	<<else>>
		<<pain 1>><<stress 3>><<tiredness 2>>
	<</if>>
<</link>>
<br>
<<socialiseicon>><<if $NPCNameList and $NPCNameList.includes("Wren")>><<link [[替他应付盘问 (0:08)|MP Daily Wren 3]]>>
	<<set $mpDailyWren to Math.max(($mpDailyWren or 0), 2)>><<pass 8>>
