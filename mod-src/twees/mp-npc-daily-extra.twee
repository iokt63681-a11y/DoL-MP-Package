	<<if ($willpower or 0) gte 260>>
		<<stress -2>>
		<<if $NPCName and $NPCNameList and $NPCNameList.includes("Black Wolf")>><<npcincr "Black Wolf" love 1>><</if>>
	<<else>>
		<<stress 3>>
	<</if>>
<</link>>
<br>
<<parkicon>><<link [[用清凉草叶替它敷爪 (0:05)|MP Daily BlackWolf 2]]>>
