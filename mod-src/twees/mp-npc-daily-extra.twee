	<<set $mpDailyAvery to Math.max(($mpDailyAvery or 0), 1)>><<pass 5>>
	<<if ($willpower or 0) gte 260>>
		<<stress -2>>
		<<if $NPCName and $NPCNameList and $NPCNameList.includes("Avery")>><<npcincr Avery trust 1>><</if>>
	<<else>>
