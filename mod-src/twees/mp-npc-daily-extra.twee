		<<if $NPCName and $NPCNameList and $NPCNameList.includes("Eden")>><<npcincr Eden trust 1>><</if>>
	<<else>>
		<<pain 1>><<stress 3>>
	<</if>>
<</link>>
<br>
<<runicon>><<link [[合力把界石撬回原位 (0:06)|MP Daily Eden 3]]>>
	<<set $mpDailyEden to Math.max(($mpDailyEden or 0), 2)>><<pass 6>>
	<<if ($athletics or 0) gte 260>>
		<<stress -2>>
		<<if $NPCName and $NPCNameList and $NPCNameList.includes("Eden")>><<npcincr Eden love 1>><</if>>
	<<else>>
		<<stress 3>><<tiredness 2>>
	<</if>>
<</link>>
<br>
<<parkicon>><<link [[顺路采摘溪边止血草 (0:05)|MP Daily Eden 3]]>>
	<<set $mpDailyEden to Math.max(($mpDailyEden or 0), 2)>><<pass 5>><<stress -2>>
	<<if $NPCName and $NPCNameList and $NPCNameList.includes("Eden")>><<npcincr Eden love 1>><</if>>
<</link>>

:: MP Daily Eden 3 [nobr]
<<set $outside to 0>><<set $location to "cabin">><<effects>>
暮色笼罩森林时，你们回到了温暖干燥的木屋。壁炉里的松木烧得通红，铁锅里的蘑菇鹿肉汤咕嘟咕嘟冒着热气。伊甸坐在木桌旁用融化的蜂蜡擦拭猎弓弓弦，顺手盛了满满一粗陶碗热汤推到你面前，又把一张裁好的软鹿皮和几枚卖毛皮剩下的硬币放在桌角。
「靴子湿了就搁炉边烤烤，」伊甸低头擦着弓身，声音比平时柔和了几分，「那块鹿皮拿去垫鞋底，林子里路滑。」
<br><br>
<<tendingicon>><<link [[用蜂蜡擦亮皮靴猎刀 (0:05)|MP Daily Extra Hub]]>>
	<<set $mpDailyEden to 3>><<pass 5>>
	<<if ($housekeeping or 0) gte 250 or ($willpower or 0) gte 260>>
		<<stress -3>>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("daily_extra_eden_3")>><<money 250>><</if>>
		<<if $NPCName and $NPCNameList and $NPCNameList.includes("Eden")>><<npcincr Eden love 1>><<npcincr Eden trust 1>><</if>>
	<<else>>
		<<stress 2>><<tiredness 1>>
	<</if>>
<</link>>
<br>
<<socialiseicon>><<link [[坐炉火旁喝蘑菇肉汤 (0:05)|MP Daily Extra Hub]]>>
	<<set $mpDailyEden to 3>><<pass 5>><<stress -3>><<tiredness -1>>
	<<if $NPCName and $NPCNameList and $NPCNameList.includes("Eden")>><<npcincr Eden love 1>><</if>>
<</link>>
<br>
<<getouticon>><<link [[趁天未黑回森林石径 (0:03)|Forest]]>><<set $mpDailyEden to 3>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>

/* ==================== 3. Wren (雷恩) ==================== */

:: MP Daily Wren 1 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
旧港三号栈桥背风的缆桩旁，雷恩正半倚着木箱拆洗一只受潮的黄铜防风打火机，脚边的帆布袋里装着一沓刚从货船上卸下来的木制货牌。海雾把打火机的火石轮浸得直打滑，他试着擦了两下没打着火，抬头看见你走近，嘴角勾起一抹懒散的笑。
「来得巧，帮我搭把手，」雷恩把那摞沾着海盐的木货牌往你手边一推，「有些货牌上的炭笔编号被浪打花了，得赶在货主来提货前认清楚。」
<br><br>
<<sneakicon>><<link [[替他修好黄铜打火机 (0:05)|MP Daily Wren 2]]>>
	<<set $mpDailyWren to Math.max(($mpDailyWren or 0), 1)>><<pass 5>>
	<<if ($skulduggery or 0) gte 260>>
		<<stress -2>>
		<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("daily_extra_wren_1")>><<money 200>><</if>>
		<<if $NPCName and $NPCNameList and $NPCNameList.includes("Wren")>><<npcincr Wren trust 1>><</if>>
	<<else>>
		<<stress 3>>
	<</if>>
<</link>>
<br>
<<investigateicon>><<link [[借斜光辨认货牌刻痕 (0:06)|MP Daily Wren 2]]>>
	<<set $mpDailyWren to Math.max(($mpDailyWren or 0), 1)>><<pass 6>>
	<<if ($science or 0) gte 250 or ($english or 0) gte 250>>
		<<stress -2>>
		<<if $NPCName and $NPCNameList and $NPCNameList.includes("Wren")>><<npcincr Wren love 1>><</if>>
	<<else>>
		<<stress 3>><<tiredness 1>>
	<</if>>
<</link>>
<br>
<<socialiseicon>><<link [[靠缆桩听他聊港里风声 (0:04)|MP Daily Wren 2]]>>
