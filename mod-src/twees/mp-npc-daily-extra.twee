	<<set $mpDailyBriar to Math.max(($mpDailyBriar or 0), 2)>><<pass 5>>
	<<if ($maths or 0) gte 260>>
		<<stress -2>>
		<<if $NPCName and $NPCNameList and $NPCNameList.includes("Briar")>><<npcincr Briar love 1>><</if>>
	<<else>>
