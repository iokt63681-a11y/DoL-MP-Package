:: MP Native Combat [nobr]
<<if $mpCombatStart is 1 or !$NPCList[0] or !$NPCList[0].pronoun>>
	<<set $mpCombatStart to 0>>
	<<run window.dolmp && window.dolmp.prepareNativeCombatVars && window.dolmp.prepareNativeCombatVars()>>
	<<if $mpCombatMode is "coop_pve" and _mpHasCoopSnapshot is 1>>
		<<run window.dolmp && window.dolmp.restoreCoopNpcSnapshot && window.dolmp.restoreCoopNpcSnapshot()>>
		<<person1>>
		<<if $combat isnot 1>>
			<<controlloss>>
			<<violence 1>>
			<<neutral 1>>
			<<molested>>
			<<maninit>>
		<</if>>
	<<else>>
		<<if $combat is 1>>
			<<endcombat>>
		<<else>>
			<<endevent>>
		<</if>>
		<<generateNPC 1 "a" _mpOppPronoun _mpOppGender>>
		<<person1>>
		<<if $mpCombatConsensual is 1>>
			<<consensual>>
			<<set $consensual to 1>>
			<<neutral 1>>
			<<maninit>>
			<<set $enemytrust += 100>>
		<<else>>
			<<controlloss>>
			<<violence 1>>
			<<neutral 1>>
			<<molested>>
			<<maninit>>
		<</if>>
	<</if>>
	<<run window.dolmp && window.dolmp.setupNativeCombatNpc && window.dolmp.setupNativeCombatNpc()>>
<</if>>
<<if $index is undefined or !$pronoun>><<person1>><</if>>
<<run window.dolmp && window.dolmp.beforeNativeCombatEffects && window.dolmp.beforeNativeCombatEffects()>>
<<if $pain gte 100 and $mpCombatConsensual isnot 1 and $mpCombatMode isnot "coop_pve">>
	<<set $mpCombatOutcome to "me_pain_full">>
	<<set $mpForceCombatEnd to 1>>
<</if>>
<<effects>>
<<effectsman>>
<<man>>
<<run window.dolmp && window.dolmp.afterNativeCombatMan && window.dolmp.afterNativeCombatMan()>>
<<stateman>>
<br><br>
<<actionsman>>
<<if _combatend or $mpForceCombatEnd is 1 or ($pain gte 100 and $mpCombatConsensual isnot 1 and $mpCombatMode isnot "coop_pve")>>
	<<unset $mpForceCombatEnd>>
	<span id="next"><<link [[Next|MP Native Combat Finish]]>><<set $eventskip to 1>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|MP Native Combat]]>><</link>></span><<nexttext>>
<</if>>

:: MP Native Combat Finish [nobr]
<<effects>><<set $eventskip to 1>>
<<if !$pronoun and $NPCList[0] and $NPCList[0].pronoun>><<person1>><</if>>
<<if !$pronoun>>
	<<run window.dolmp && window.dolmp.prepareNativeCombatVars && window.dolmp.prepareNativeCombatVars()>>
	<<generateNPC 1 "a" _mpOppPronoun _mpOppGender>>
	<<person1>>
<</if>>
<<run window.dolmp && window.dolmp.prepareInteractVars && window.dolmp.prepareInteractVars()>>
<<set _exitPas to ($mpReturnPassage or "Domus Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas is "Orphanage Intro" or _exitPas is "MP Native Combat" or _exitPas is "MP Native Combat Finish" or _exitPas is "Tutorial">>
	<<set _exitPas to "Domus Street">>
<</if>>
<<if $mpCombatConsensual is 1>>
	<<if $enemyarousal gte $enemyarousalmax or $mpCombatOutcome is "peer_arousal" or $mpCombatOutcome is "me_arousal">>
		<<ejaculation>>
		潮水般的快感渐渐退去，你们浑身汗湿地交叠在一起，滚烫的皮肤贴合着彼此剧烈起伏的胸口。空气里弥漫着温热的气息，体液顺着大腿内侧缓缓滑落。
		<br><br>
		<<if _mpRelStage is "soulmate" or _mpRelStage is "lover">>
			<<He>>用温热的指腹轻轻拭去你眼角溢出的泪水，低头吻了吻你微肿的唇瓣与锁骨上的红痕。"刚才的你真美，"<<he>>在你耳边沙哑地低喃，手臂依然紧紧揽着你的腰，久久不愿松开。
		<<elseif _mpRelCorruption gte 25>>
			<<He>>舔了舔嘴唇，眼底闪烁着意犹未尽的暗火，指尖又在你尚且敏感颤栗的皮肤上轻轻刮了一下，引得你发出一声闷哼。
		<<else>>
			<<He>>红着脸贴在你的肩头平复着呼吸，手指温柔地替你理顺鬓边汗湿的发丝，眼里满是化不开的柔情。
		<</if>>
		<<if $wolfgirl gte 6 or $cat gte 6 or $fox gte 6>>
			<br>你头顶敏感的兽耳随着余韵轻轻抖动，毛茸茸的尾巴不自觉地缠在<<his>>的小腿上，喉咙里漏出满足的轻哼。
		<<elseif $demon gte 6>>
			<br>你身后的恶魔尾巴勾住<<his>>的手腕，尾尖轻轻摩挲着<<his>>的脉搏。
		<<elseif $angel gte 6 or $fallenangel gte 2>>
			<br>头顶的光环在情欲的浸染下泛起微弱的涟漪，令你一时有些失神。
		<</if>>
	<<else>>
		虽然比预想中结束得早了一些，<<he>>还是体贴地收拢了动作，替你拢好微敞的衣领，与你相视一笑。
	<</if>>
	<<stress -12>><<trauma -6>><<lstress>><<ltrauma>>
	<<run window.dolmp && window.dolmp.notifyRomanceDelta && window.dolmp.notifyRomanceDelta(1, 1, -4, -1, 1, "在温存过后与你相拥平复呼吸")>>
	<br><br>
	<<tearful>>你们各自整理好身上的衣物。
<<elseif $mpCombatOutcome is "escaped">>
	<span class="green">你趁着对方重心不稳的瞬间猛地发力，一举挣脱了对方的钳制，头也不回地转身逃离了现场。</span>
	<<stress -4>><<lstress>>
	<br><br>
	<<tearful>>你在安全的地方停下脚步，平复着剧烈的喘息并整理好凌乱的衣物。
<<elseif $mpCombatOutcome is "peer_escaped">>
	<span class="purple"><<print ($mpOpponentName or "对方")>>抓住空隙猛地发力挣开了你的钳制，迅速退后几步，转身消失在了拐角处。</span>
	<br><br>
	<<tearful>>你稳住身形，整理好身上的衣物。
<<elseif $mpCombatOutcome is "me_pain_full" or ($pain gte 100 and $mpCombatOutcome isnot "peer_down")>>
	<span class="red">剧烈的痛苦彻底超过了你的承受极限，你眼前阵阵发黑，酸软的四肢再也使不出半分力气，重重地跌倒在地上。</span>
	<<stress 12>><<trauma 6>><<gstress>><<gtrauma>>
	<br><br>
	<<print ($mpOpponentName or "对方")>>见你已经完全失去了反抗能力，停下手里的动作，转身离开了现场。<<tearful>>你缓了很久，才咬着牙撑起身体整理好衣物。
<<elseif $mpCombatOutcome is "peer_down" or ($mpCombatOutcome is undefined and $enemyhealth lte 0)>>
	<<if $mpCombatMode is "coop_pve">>
		在你们两人的联手反击下，<<person>>痛得闷哼一声蜷缩起身子，再也招架不住。"疯子……你们给我等着！"<<he>>捂着伤处一瘸一拐地逃进了街角阴影里。
		<<stress -8>><<trauma -4>><<lstress>><<ltrauma>>
		<<run window.dolmp && window.dolmp.notifyRomanceDelta && window.dolmp.notifyRomanceDelta(1, 1, 0, -1, 0, "与你并肩击退了袭击者")>>
		<br><br>
		<<tearful>>你和同伴互相搀扶着站起身来，替对方拍去身上的灰尘并整理好衣物。
		<<if $mpCombatConsensual isnot 1 and $mpCombatIsHost is 1 and $spraymax gte 1 and $spray lt $spraymax and $mpWasTutorial isnot 1>>
			<<spray 1>><<gspray>>
			<br><br><<peppersprayicon>><span class="gold">你从袭击者仓皇遗落的东西里找到了一罐防狼喷雾。</span>
		<</if>>
	<<else>>
		<<print ($mpOpponentName or "对方")>>在你的攻势下支撑不住跌倒在地，彻底失去了继续压制你的力气。
		<<stress -6>><<lstress>>
		<br><br>
		<<tearful>>你长舒了一口气，站起身来整理好身上的衣物。
	<</if>>
<<elseif $mpCombatOutcome is "me_down">>
	你在激烈的交锋中体力不支被<<print ($mpOpponentName or "对方")>>按倒在地。<<print ($mpOpponentName or "对方")>>居高临下地看了你片刻，最终停下动作转身离开了。
	<<pain 15>><<stress 12>><<trauma 6>><<gpain>><<gstress>><<gtrauma>>
	<br><br>
	<<tearful>>你缓了一会儿，才勉强撑起酸痛的身体整理好凌乱的衣物。
<<elseif $mpCombatOutcome is "peer_arousal" or ($mpCombatOutcome is undefined and $enemyarousal gte $enemyarousalmax)>>
	<<ejaculation>>
	<<if $mpCombatMode is "coop_pve">>
		<<person>>在强烈的快感冲击下浑身剧烈痉挛，随着一阵近乎虚脱的喘息，<<he>>双腿发软地扶着墙，摇摇晃晃地离开了现场。
		<<stress -6>><<lstress>>
		<<run window.dolmp && window.dolmp.notifyRomanceDelta && window.dolmp.notifyRomanceDelta(1, 1, 2, -1, 1, "与你配合脱身")>>
		<br><br>
		<<tearful>>你与同伴对视了一眼，各自松了一口气，整理好身上的衣物。
		<<if $mpCombatConsensual isnot 1 and $mpCombatIsHost is 1 and $spraymax gte 1 and $spray lt $spraymax and $mpWasTutorial isnot 1>>
			<<spray 1>><<gspray>>
			<br><br><<peppersprayicon>><span class="gold">你捡起了对方匆忙间掉落的一罐防狼喷雾。</span>
		<</if>>
	<<else>>
		<<print ($mpOpponentName or "对方")>>在剧烈的喘息中泄出了全部精力，松开对你的钳制，脚步虚浮地转身离开了。
		<br><br>
		<<tearful>>你抓紧时间站起身来，整理好身上的衣物。
	<</if>>
<<elseif $mpCombatOutcome is "me_arousal">>
	<<ejaculation>>
	强烈的高潮如电流般席卷全身，让你双腿发软、眼前白光闪烁，一时失去了继续对抗的力气。待余韵稍稍平息，<<print ($mpOpponentName or "对方")>>已经松开你离开了。
	<<stress 6>><<trauma 4>><<gstress>><<gtrauma>>
	<br><br>
	<<tearful>>你定下神来，慢慢站起身整理好衣物。
<<else>>
	双方在缠斗中各自退开，结束了这次冲突。
	<br><br>
	<<tearful>>你抓紧时间站起身来，整理好衣物。
<</if>>
<br><br>
<<clotheson>>
<<endcombat>>
<<run window.dolmp && window.dolmp.onNativeCombatFinished && window.dolmp.onNativeCombatFinished()>>
<<if $mpCombatConsensual isnot 1 and ($mpWasTutorial is 1 or ($spraymax or 0) lte 0 or $tutorialExit isnot undefined)>>
	<<unset $mpWasTutorial>>
	<<if $tutorialExit is undefined>><<set $tutorialExit to (_exitPas or "Domus Street")>><</if>>
	<<unset $mpReturnPassage>><<unset $mpCombatOutcome>><<unset $mpCombatMode>><<unset $mpCombatConsensual>><<unset $mpCombatIsHost>>
	<<generate1>><<person1>>一名<<person>>急匆匆地朝你跑了过来。"我看到刚才那个恶棍干的好事了，你没事吧？"<<He>>伸出一只手想要扶你起来。
	<br><br>
	<i>遭到袭击会削弱你的控制感。随着控制感下降，你会更容易受到创伤的影响。标记有"淫乱"、"露出"或"异种"的行动可以降低压力与创伤，并恢复你的控制感。频繁进行这些行动会解锁更进一步的同类行动，但也会让低阶行动失去效果。如果你掉以轻心，最终只能靠更加放荡惊人的举动才能维持控制感。</i>
	<br><br>
	<<brothelicon>><<link [[调情|Tutorial Flirt]]>><<set $spraymax++>><<spray 5>><</link>><<promiscuous1>>
	<br>
	<<socialiseicon>><<link [[谢谢<<him>>|Tutorial Thank]]>><<set $spraymax++>><<spray 5>><</link>>
<<else>>
	<<getouticon>><<link [[继续|_exitPas]]>><<set $eventskip to 1>><<endevent>><<unset $mpReturnPassage>><<unset $mpCombatOutcome>><<unset $mpCombatMode>><<unset $mpCombatConsensual>><<unset $mpCombatIsHost>><</link>>
<</if>>

:: MP Player Interact [nobr]
<<effects>>
<<set _exitPas to ($mpReturnPassage or "Orphanage")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas is "Orphanage Intro" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Orphanage">>
<</if>>
<<endevent>>
<<run window.dolmp && window.dolmp.prepareInteractVars && window.dolmp.prepareInteractVars()>>
<<generateNPC 1 "a" _mpOppPronoun _mpOppGender>>
<<person1>>
<<run window.dolmp && window.dolmp.prepareInteractVars && window.dolmp.prepareInteractVars()>>
<div id="mp-rel-header" class="mp-rel-banner"><<print window.dolmp && window.dolmp.renderRelationshipBannerHtml ? window.dolmp.renderRelationshipBannerHtml() : "">></div>
<<if _mpRelStage is "soulmate">>
	<<if $location is "home" or _exitPas is "Orphanage" or _exitPas is "Bedroom">>
		你走到<<print ($mpInteractTargetName or "同伴")>>身边。刚听到你的脚步声，<<he>>便放下了手头的事迎上前来，胸前的银质挂坠在灯光下微微闪烁。"欢迎回来，亲爱的，"<<he>>自然而然地伸出双臂将你拢入怀中，温热的唇印上你的嘴角。
	<<elseif $location is "park" or _exitPas is "Park">>
		你靠近长椅与树桩。<<print ($mpInteractTargetName or "同伴")>>一抬头看见你，眼底瞬间亮了起来，合上膝头的画册迎上来抱住你的腰。"我刚刚还在想你什么时候来，结果一抬头你就出现在我眼前了。"
	<<elseif $location is "school" or _exitPas is "Hallways" or _exitPas is "School Library">>
		你穿过人群走到角落。<<print ($mpInteractTargetName or "同伴")>>一看见你便露出温柔的笑意，趁周围没人注意，悄悄伸手将你拉近身侧，在你脸颊上落下一吻。"日安，亲爱的。我总是能为你腾出时间。"
	<<else>>
		你走近<<print ($mpInteractTargetName or "同伴")>>身旁。<<He>>第一时间向你张开怀抱，十指紧扣地握住你的手。"你来啦，我一直在等你。"
	<</if>>
<<elseif _mpRelStage is "lover">>
	<<if $location is "park" or _exitPas is "Park">>
		你靠近<<print ($mpInteractTargetName or "同伴")>>坐着的树桩。当<<he>>看到你时，<<he>>笑了，把怀里的速写本收起来向你伸出手。"你来了，亲爱的，"<<he>>轻轻吻了一下你的脸颊，示意你挨着<<he>>坐下。
	<<elseif $location is "school" or $location is "temple" or _exitPas is "Temple" or _exitPas is "Hallways" or _exitPas is "School Library">>
		你靠近柜台旁。当看见你时，<<print ($mpInteractTargetName or "同伴")>>的眼睛顿时亮了起来。"日安，亲爱的，"<<he>>一边说着一边吻上了你的脸颊，示意你绕过来和<<he>>坐在一起。"我总是能为你腾出时间。"
	<<else>>
		你走近<<print ($mpInteractTargetName or "同伴")>>所在的位置。当看见你时，<<his>>的眼睛顿时亮了起来，主动挽住你的手臂，亲昵地用脸颊蹭了蹭你的肩头。"日安，亲爱的。"
	<</if>>
<<elseif _mpRelStage is "crush">>
	你靠近<<print ($mpInteractTargetName or "同伴")>>所在的位置。当<<he>>看到你时，耳根微微泛红，对上了你的视线又慌忙移开，随后向你露出了羞涩的微笑。<<He>>往旁边挪了挪，示意你坐到<<he>>身旁。
<<else>>
	你靠近<<print ($mpInteractTargetName or "同伴")>>所在的位置。当<<he>>看到你时，<<he>>对你笑了笑。
<</if>>
<<if $exposed gte 1>>
	<br><span class="lewd">注意到你此刻衣不蔽体的模样，<<his>>的呼吸明显一滞，眼神变得幽深滚烫，随即立刻侧过身替你挡住了四周的视线。</span>
<</if>>
<<if _mpRelJealousy gte 25>>
	<br><span class="purple"><<He>>的视线紧紧黏在你身上，鼻尖凑近你的颈侧轻轻嗅了嗅，似乎在确认你身上有没有沾染别人的气息。</span>
<</if>>
<<if _mpRelCorruption gte 25>>
	<br><span class="lewd">趁着四下无人注意，<<his>>的指尖若有若无地滑过你的腰侧与臀线，眼底藏着一抹暗火。</span>
<</if>>
<br><br>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("chat")>>
	<<socialiseicon>><<link [[聊天 (0:15)|MP Player Interact Chat]]>><<pass 15>><<stress -6>><<trauma -3>><</link>><<lstress>><<ltrauma>><<glove>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("flirt")>>
	<<brothelicon>><<link [[调情 (0:15)|MP Player Interact Flirt]]>><<pass 15>><<stress -4>><<arousal 600>><</link>><<promiscuous1>><<lstress>><<glove>><<garousal>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("rest")>>
	<<bedicon "zzz">><<link [[依偎休息 (0:15)|MP Player Interact Rest]]>><<pass 15>><<tiredness -4>><<stress -6>><</link>><<ltiredness>><<lstress>><<glove>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("snack")>>
	<<foodicon "milkshake">><<link [[分享饮品 (0:15)|MP Player Interact Snack]]>><<pass 15>><<stress -8>><<tiredness -3>><</link>><<lstress>><<ltiredness>><<glove>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("care")>>
	<<bathroomicon "robe">><<link [[替<<him>>整理衣装 (0:15)|MP Player Interact Care]]>><<pass 15>><<pain -8>><<stress -5>><</link>><<lpain>><<lstress>><<glove>>
	<br>
<</if>>
<<if (_mpRelLove gte 10 or hasSexStat("promiscuity", 2) or $promiscuity gte 15) and (!window.dolmp || window.dolmp.canDoDailyInteract("kiss"))>>
	<<loveicon "kiss">><<link [[亲吻 (0:10)|MP Player Interact Kiss]]>><<pass 10>><<stress -6>><<trauma -3>><<arousal 900>><</link>><<promiscuous2>><<lstress>><<ltrauma>><<glove>><<garousal>>
	<br>
<</if>>
<<if !window.dolmp || window.dolmp.canDoDailyInteract("jealous_ask")>>
	<<socialiseicon "ask">><<link [[追问<<his>>的行踪 (0:10)|MP Player Interact JealousAsk]]>><<pass 10>><<arousal 400>><</link>><<garousal>>
	<br>
<</if>>
<<if _mpRelJealousy gte 10 and (!window.dolmp || window.dolmp.canDoDailyInteract("jealous_calm"))>>
	<<loveicon "hug">><<link [[安抚<<his>>的不安 (0:15)|MP Player Interact JealousCalm]]>><<pass 15>><<stress -6>><<trauma -2>><</link>><<lstress>><<ltrauma>><<glove>>
	<br>
<</if>>
<<if $harpy gte 6 and (!window.dolmp || window.dolmp.canDoDailyInteract("sing"))>>
	<<tficon "harpy">><<link [[唱歌 (0:10)|MP Player Interact Sing]]>><<pass 10>><<tiredness 2>><<stress -8>><<trauma -4>><</link>><<harpy>><<gtiredness>><<lstress>><<ltrauma>><<glove>>
	<br>
<</if>>
<<if ($wolfgirl gte 6 or $cat gte 6 or $fox gte 6 or $cow gte 6) and (!window.dolmp || window.dolmp.canDoDailyInteract("nuzzle"))>>
	<<tficon "wolf">><<link [[用耳朵蹭<<him>> (0:10)|MP Player Interact Nuzzle]]>><<pass 10>><<stress -6>><<trauma -4>><</link>><<lstress>><<ltrauma>><<glove>>
	<br>
<</if>>
<<if ($demon gte 6 or $angel gte 6 or $fallenangel gte 2) and (!window.dolmp || window.dolmp.canDoDailyInteract("wing_tease"))>>
	<<tficon "demon">><<link [[用羽翼与尾尖轻拢<<him>> (0:10)|MP Player Interact WingTease]]>><<pass 10>><<stress -6>><<arousal 1000>><</link>><<lstress>><<glove>><<garousal>>
	<br>
<</if>>
<<if (hasSexStat("promiscuity", 2) or $promiscuity gte 15 or _mpRelLove gte 18) and (!window.dolmp || window.dolmp.canDoDailyInteract("bath"))>>
