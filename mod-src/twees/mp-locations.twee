:: Widgets MP Ambient [widget nobr]
<<widget "mpAmbient">>
<<switch $location>>
<<case "forest">><<print either("潮湿的腐叶在靴底陷下浅坑。", "冷杉针叶擦过你的肩头。", "远处林冠传来啄木鸟笃笃的敲击声。", "一缕带着松脂味的凉雾漫过石径。", "树根缝隙里钻出几簇苍白的菌伞。", "不远处的灌木丛晃了晃，很快又归于沉寂。", "溪水漫过鹅卵石的哗啦声在林间回荡。", "腐木上的青苔蹭湿了你的裤脚。", "风吹过树梢，落下一阵细碎的松果壳。", "夜枭低沉的啼叫从密林深处掠过。")>>
<<case "docks" "docks_building">><<print either("粗麻缆绳拍打着生锈的系船柱。", "海鸥立在集装箱顶上发出嘶哑的鸣叫。", "咸腥的海风里混着一股浓郁的柴油味。", "远处的龙门吊滑轮发出沉闷的金属摩擦声。", "退潮的海水在防波堤石阶下留下一层白沫。", "几只木桶顺着浑浊的港湾水面轻轻碰撞。", "货轮低沉的汽笛声穿透了海面薄雾。", "潮湿的木栈道在脚下发出轻微的咯吱声。", "铁锚链条垂入幽暗的水面，泛起一圈涟漪。", "守夜哨亭的探照灯束偶尔扫过远处的货堆。")>>
<<case "sea" "beach" "searocks" "starfish">><<print either("碎浪卷着细沙漫过你的脚踝。", "咸湿的海风吹得衣角猎猎作响。", "礁石背阴处的潮水洼里游动着几只小虾。", "被浪冲上岸的海带缠在褪色的浮木上。", "远处海平线上的雾气正随着潮汐缓缓起伏。", "细碎的贝壳在沙滩上反射着微弱的光泽。", "海风裹挟着微凉的水汽扑在你的脸颊上。", "退潮后的沙面留下了一道道浅浅的波纹。", "两只海鸟贴着浪尖低飞，很快没入薄雾。", "暗礁深处传来海浪拍击石洞的闷响。")>>
<<case "temple" "wolf">><<print either("石柱间的长明铜灯散发出淡淡的檀香。", "高耸的彩绘玻璃窗将光线滤成斑斓的色块。", "回廊尽头传来若有若无的诵经余音。", "冰凉的青石地面映出摇曳的烛火倒影。", "风穿过钟楼拱券，带起一阵细微的铜铃声。", "石壁的浮雕凹槽里积着一层陈年的香灰。", "庭院里的古柏枝叶在风中轻轻摩挲。", "祭坛侧面的铜盆里漂浮着几片干枯的花瓣。", "厚重的橡木侧门在穿堂风里微微晃动。", "寂静的偏殿里只能听见烛芯爆裂的轻响。")>>
<<case "school" "oxford">><<print either("走廊尽头的储物柜门发出清脆的合拢声。", "擦得发亮的地板上映出窗外摇晃的树影。", "不远处的教室里隐约传出粉笔敲击黑板的声响。", "宣传栏上的旧海报被穿堂风掀起一角。", "楼梯拐角的窗户半开着，吹进一阵微凉的风。", "铅笔木屑与旧书页的气息在空气里弥漫。", "饮水机旁的水滴落入水槽，发出规律的轻响。", "操场方向隐约传来零星的哨声与脚步声。", "图书馆侧门边的铜牌在光线下泛着微光。", "空旷的连廊里回荡着你自己的脚步声。")>>
<<case "sewers" "underground">><<print either("拱顶石缝渗出的水珠规律地滴入暗渠。", "潮湿的砖墙上覆着一层滑腻的暗绿水苔。", "生锈的排气铁管深处传来低沉的风鸣。", "浑浊的水流顺着脚边的石槽缓缓淌过。", "铁梯横档上凝结着冰凉的细密水珠。", "远处岔道口闪过一道细碎的啮齿动物黑影。", "空气里浮动着铁锈与潮湿泥土的腥气。", "松动的铸铁井盖在头顶上方漏下一缕微光。", "石砌水闸边缘卡着几截枯枝与旧布条。", "幽深的隧道将每一次呼吸声都拉出长长的回音。")>>
<<case "avery_mansion">><<print either("水晶吊灯把大理石地面照得发亮。", "厚地毯吞掉了脚步声。", "银器碰撞的轻响从走廊尽头传来。", "壁炉里的松木偶尔爆出一声轻响。", "窗帘缝隙漏进一线灰白的天光。", "空气里浮着蜂蜡与旧木头的味道。")>>
<<case "pool">><<print either("瓷砖墙面凝着一层细密的水汽。", "消毒水的气味混着潮湿的氯味。", "水面反射的光在天花板上晃动。", "更衣柜门偶尔被风碰响。", "排水沟里传来均匀的滴水声。")>>
<<case "spa">><<print either("热水的雾气贴着瓷砖慢慢往上爬。", "空气里浮着桉叶和旧木头的味道。", "铜制水龙头偶尔滴下一声。", "隔着门传来毛巾落进藤篮的轻响。", "池边的石沿被水汽熏得发暖。")>>
<<case "hospital" "nightingale">><<print either("走廊尽头的日光灯发出轻微的嗡鸣。", "消毒水的气味压在喉咙口。", "推车轮子碾过地砖，声音由远及近。", "病房门缝里漏出一线冷白的光。", "候诊椅上的人压低了咳嗽声。")>>
<<case "brothel" "strip_club">><<print either("丝绒窗帘把街上的光滤成暗红色。", "楼道里飘着香水与烟草混在一起的气味。", "隔壁房间传来压低的说话声。", "黄铜门牌在灯下泛着暗光。", "地毯边缘磨得发亮。")>>
<<case "cabin">><<print either("炉膛里的柴火偶尔噼啪一声。", "木墙缝里渗进松脂和兽皮的味道。", "窗外的风把屋檐吹得轻轻作响。", "桌上的旧陶杯还留着一点余温。", "地板在脚下发出一声干涩的吱呀。")>>
<<case "bedroom">><<print either("窗帘缝里漏进一线天光。", "旧木床在身下轻轻吱呀。", "床头柜上的水杯还留着余温。", "走廊里传来远处关门的轻响。", "被褥上有淡淡的肥皂味。")>>
<<case "orphanage">><<print either("走廊里飘着消毒水和旧床单的味道。", "楼下传来孩子们压低的嬉闹声。", "楼梯扶手被摸得发亮。", "某个房间里有人轻轻咳嗽。", "暖气片偶尔发出轻响。")>>
<<case "cafe">><<print either("咖啡机的蒸汽声压过了低语。", "空气里浮着黄油和烤面包的味道。", "杯碟碰撞的轻响从吧台后传来。", "窗边的座位被透进来的光照得发暖。")>>
<<case "arcade" "shopping_centre" "commercial">><<print either("街机的电子音效在昏暗的厅里此起彼伏。", "霓虹灯把地板染成一片紫红。", "兑换处的玻璃柜里堆着廉价奖品。", "通风口吹出一股温热的塑料味。")>>
<<case "park">><<print either("树叶在头顶轻轻摩擦。", "长椅上的漆皮被晒得发烫。", "远处传来孩子追逐的笑声。", "喷泉的水声盖过了脚步。")>>
<<case "farm">><<print either("谷仓里有干草和牲口的气味。", "远处的鸡舍传来零星的扑翅声。", "木栅栏被风吹得轻轻作响。", "泥地被踩出深浅不一的脚印。")>>
<<case "pirate_ship">><<print either("船体在涌浪里发出低沉的吱呀。", "舱底弥漫着咸水、焦油和朗姆酒的味道。", "头顶甲板传来脚步声。", "悬灯随着船身轻轻摇晃。")>>
<<case "lake_ruin">><<print either("废弃石室里回荡着水滴声。", "藤蔓从坍塌的穹顶垂下来。", "湖水的腥气混着旧石头的潮味。", "远处的湖面反射着灰白的天光。")>>
<<case "industrial">><<print either("厂房里回荡着金属撞击声。", "空气里浮着机油和铁锈的味道。", "传送带在远处单调地转动。", "高窗漏下的光柱里浮着灰尘。")>>
<<case "garden">><<print either("修剪过的灌木散发着青草味。", "碎石小径在脚下沙沙作响。", "远处传来洒水器的轻响。", "花圃边缘的泥还带着湿气。")>>
<<case "barb">><<print either("警局走廊里飘着消毒水和旧纸张的味道。", "值班室的灯管发出轻微的嗡鸣。", "远处传来打字机般的敲击声。", "铁门在风里轻轻碰撞。")>>
<<case "cliff">><<print either("海风从崖壁下卷上来。", "远处的浪声被风撕成碎片。", "碎石在脚下松动。", "海鸟贴着崖壁盘旋。")>>
<<case "home" "flats" "residential_alley">><<print either("屋里很安静，只有钟摆的轻响。", "窗外的风把玻璃吹得微微震动。", "旧地板在脚下发出一声吱呀。", "空气里浮着灰尘和旧木头的味道。")>>
<<case "town">><<print either("街角的旧路灯在石板路上投下摇晃的昏黄光晕。", "微凉的穿堂风卷起几片枯叶擦过墙根。", "路边排水铁栅下传来细碎的流水声。", "二楼紧闭的木百叶窗后偶尔闪过一道微光。", "青石路面的凹坑里积着薄薄一层雨水。", "远处钟塔沉闷的报时声顺着屋檐漫开。", "巷口生锈的铁皮路牌在风里轻轻晃动。", "台阶边缘的砖缝里钻出几丛湿润的野草。")>>
<<case "elk">><<print either("工坊里飘着木屑和皮革的味道。", "刨刀在木料上刮出细碎的声响。", "角落的炉子把铁皮烘得发烫。", "窗外的麋鹿街传来马车经过的辘轳声。")>>
<<case "harvest" "pub">><<print either("地窖里弥漫着谷物和潮土的气味。", "木桶在石地上排成一列。", "头顶的楼板传来脚步声。", "墙缝里渗出的水珠滴在麻袋上。")>>
<<case "mer">><<print either("干船坞的龙骨在头顶投下巨大的阴影。", "海风从船台缺口灌进来。", "远处传来铆钉枪的敲击声。", "地面的油污混着海水，泛着暗光。")>>
<<default>><<print either("街角的旧路灯在石板路上投下摇晃的昏黄光晕。", "微凉的穿堂风卷起几片枯叶擦过墙根。", "路边排水铁栅下传来细碎的流水声。", "二楼紧闭的木百叶窗后偶尔闪过一道微光。", "青石路面的凹坑里积着薄薄一层雨水。", "远处钟塔沉闷的报时声顺着屋檐漫开。", "巷口生锈的铁皮路牌在风里轻轻晃动。", "台阶边缘的砖缝里钻出几丛湿润的野草。", "空气里飘过一缕淡淡的煤烟与潮气。", "拐角处的阴影随着云层移动缓缓拉长。")>>
<</switch>>
<</widget>>

:: MP Native Combat [nobr]
<<if $mpCombatStart is 1 or !$NPCList[0] or !$NPCList[0].pronoun or $NPCList[0].lefthand is undefined or $targetlist is undefined>>
	<<set $mpCombatStart to 0>>
	<<run window.dolmp && window.dolmp.prepareNativeCombatVars && window.dolmp.prepareNativeCombatVars()>>
	<<if $combat is 1>>
		<<endcombat>>
	<<else>>
		<<endevent>>
	<</if>>
	<<generateNPC 1 "a" _mpOppPronoun _mpOppGender>>
	<<person1>>
	<<if $mpCombatConsensual is 1>>
		<<consensual>>
		<<set $consensual to 1>>
		<<neutral 1>>
		<<maninit>>
		<<set $enemytrust += 100>>
	<<else>>
		<<controlloss>>
		<<violence 1>>
		<<neutral 1>>
		<<molested>>
		<<maninit>>
	<</if>>
	<<run window.dolmp && window.dolmp.setupNativeCombatNpc && window.dolmp.setupNativeCombatNpc()>>
<</if>>
<<if $index is undefined or !$pronoun>><<person1>><</if>>
<<run window.dolmp && window.dolmp.beforeNativeCombatEffects && window.dolmp.beforeNativeCombatEffects()>>
<<if $pain gte 100 and $mpCombatConsensual isnot 1 and $mpCombatMode isnot "coop_pve">>
	<<set $mpCombatOutcome to "me_pain_full">>
	<<set $mpForceCombatEnd to 1>>
<</if>>
<<effects>>
<<effectsman>>
<<man>>
<<run window.dolmp && window.dolmp.afterNativeCombatMan && window.dolmp.afterNativeCombatMan()>>
<<stateman>>
<br><br>
<<actionsman>>
<<if _combatend or $mpForceCombatEnd is 1 or ($pain gte 100 and $mpCombatConsensual isnot 1 and $mpCombatMode isnot "coop_pve")>>
	<<unset $mpForceCombatEnd>>
	<span id="next"><<link [[继续|MP Native Combat Finish]]>><<set $eventskip to 1>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[继续|MP Native Combat]]>><</link>></span><<nexttext>>
<</if>>

:: MP Native Combat Finish [nobr]
<<effects>><<set $eventskip to 1>>
<<if !$pronoun and $NPCList[0] and $NPCList[0].pronoun>><<person1>><</if>>
<<if !$pronoun>>
	<<run window.dolmp && window.dolmp.prepareNativeCombatVars && window.dolmp.prepareNativeCombatVars()>>
	<<generateNPC 1 "a" _mpOppPronoun _mpOppGender>>
	<<person1>>
<</if>>
<<run window.dolmp && window.dolmp.prepareInteractVars && window.dolmp.prepareInteractVars()>>
<<set _exitPas to ($mpReturnPassage or "Domus Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas is "Orphanage Intro" or _exitPas is "MP Native Combat" or _exitPas is "MP Native Combat Finish" or _exitPas is "Tutorial">>
	<<set _exitPas to "Domus Street">>
<</if>>
<<if $mpCombatConsensual is 1>>
	<<if $enemyarousal gte $enemyarousalmax or $mpCombatOutcome is "peer_arousal" or $mpCombatOutcome is "me_arousal">>
		<<ejaculation>>
		快感如潮退去，你们汗湿地交叠相拥，温热鼻息交错。
	<<else>>
		<<He>>体贴地收拢动作，替你拢好衣领相视一笑。
	<</if>>
	<<stress -12>><<trauma -6>><<lstress>><<ltrauma>>
	<<run window.dolmp && window.dolmp.notifyRomanceDelta && window.dolmp.notifyRomanceDelta(1, 1, -4, -1, 1, "在温存过后与你相拥平复呼吸")>>
<<elseif $mpCombatOutcome is "escaped">>
	<span class="green">你趁对方重心不稳猛然发力，挣开钳制退到安全距离外。</span>
	<<stress -4>><<lstress>>
<<elseif $mpCombatOutcome is "peer_escaped">>
	<span class="purple"><<print ($mpOpponentName or "对方")>>抓住空隙挣开束缚，连退几步隐入街角阴影。</span>
<<elseif $mpCombatOutcome is "me_pain_full" or ($pain gte 100 and $mpCombatOutcome isnot "peer_down")>>
	<span class="red">剧痛越过极限，你四肢酸软无力地跌坐在地。</span>
	<<stress 12>><<trauma 6>><<gstress>><<gtrauma>>
<<elseif $mpCombatOutcome is "peer_down" or ($mpCombatOutcome is undefined and $enemyhealth lte 0)>>
	<<if $mpCombatMode is "coop_pve">>
		在你们两人夹击下，<<person>>闷哼一声捂伤逃进暗处。
		<<stress -8>><<trauma -4>><<lstress>><<ltrauma>>
		<<run window.dolmp && window.dolmp.notifyRomanceDelta && window.dolmp.notifyRomanceDelta(1, 1, 0, -1, 0, "与你并肩击退了袭击者")>>
	<<else>>
		<<print ($mpOpponentName or "对方")>>在你的攻势下跌倒在地，再无力气纠缠。
		<<stress -6>><<lstress>>
	<</if>>
<<elseif $mpCombatOutcome is "me_down">>
	你体力不支被<<print ($mpOpponentName or "对方")>>按倒在地，对方片刻后松手离去。
	<<pain 15>><<stress 12>><<trauma 6>><<gpain>><<gstress>><<gtrauma>>
<<elseif $mpCombatOutcome is "peer_arousal" or ($mpCombatOutcome is undefined and $enemyarousal gte $enemyarousalmax)>>
	<<ejaculation>>
	<<if $mpCombatMode is "coop_pve">>
		<<person>>在快感冲击下双腿发软，扶墙摇晃离去。
		<<stress -6>><<lstress>>
		<<run window.dolmp && window.dolmp.notifyRomanceDelta && window.dolmp.notifyRomanceDelta(1, 1, 2, -1, 1, "与你配合脱身")>>
	<<else>>
		<<print ($mpOpponentName or "对方")>>在急促喘息中松开钳制转身离开。
	<</if>>
<<elseif $mpCombatOutcome is "me_arousal">>
	<<ejaculation>>
	强烈高潮令你双腿发软，待余韵平息时对方已松手离开。
	<<stress 6>><<trauma 4>><<gstress>><<gtrauma>>
<<else>>
	双方在缠斗中各自退开，结束了这场冲突。
<</if>>
<br><br>
<<clotheson>>
<<endcombat>>
<<run window.dolmp && window.dolmp.onNativeCombatFinished && window.dolmp.onNativeCombatFinished()>>
<<unset $mpWasTutorial>>
<<getouticon>><<link [[离开|_exitPas]]>><<set $eventskip to 1>><<endevent>><<unset $mpReturnPassage>><<unset $mpCombatOutcome>><<unset $mpCombatMode>><<unset $mpCombatConsensual>><<unset $mpCombatIsHost>><</link>>
<br>
<<walkicon>><<link [[平复喘息 (0:02)|MP Native Combat Aftermath]]>><<pass 2>><</link>>

:: MP Native Combat Aftermath [nobr]
<<effects>><<set $eventskip to 1>>
<<set _exitPas to ($mpReturnPassage or "Domus Street")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas is "Orphanage Intro" or _exitPas is "MP Native Combat" or _exitPas is "MP Native Combat Finish" or _exitPas is "Tutorial">>
	<<set _exitPas to "Domus Street">>
<</if>>
<<run window.dolmp && window.dolmp.prepareInteractVars && window.dolmp.prepareInteractVars()>>
<<if $mpCombatConsensual is 1>>
	<<if _mpRelStage is "soulmate" or _mpRelStage is "lover">>
		同伴用指腹拭去你眼角的湿意，低头吻了吻你的唇角，替你系好微敞的衣领。
	<<elseif _mpRelCorruption gte 25>>
		对方指尖在你腰窝上轻刮了一下，笑着替你拍去衣角褶皱。
	<<else>>
		对方红着耳根靠在你肩头平复呼吸，替你理顺鬓边汗湿的碎发。
	<</if>>
<<elseif $mpCombatMode is "coop_pve">>
	<<tearful>>你与同伴互相搀扶着站起身，拍去衣上的灰尘，确认彼此都没有大碍。
<<else>>
