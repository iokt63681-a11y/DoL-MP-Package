:: MP World Library TopBeamBookmarkTin [nobr]
<<set $outside to 0>><<set $location to "school">>
<<effects>>
<<set _exitPas to ($mpReturnPassage or "School Library")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "School Library">>
<</if>>
学校图书馆古籍区最顶层的木架横梁上放着一只落灰的锡制书签盒。<<mpAmbient>>你放缓脚步环顾书架四周，见盒盖角落印着旧藏书章。
<br><br>
<<getouticon>><<link [[返回图书馆 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="wev-mp-world-library-topbeambookmarktin">
<<mpreadicon>><<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>><<link "取出书签盒 (0:05)">><<pass 5>><<replace "#wev-mp-world-library-topbeambookmarktin">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_library_topbeambookmarktin")>><<money 220>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你借着高耸古籍书架的掩护打开锡制书签盒，将里面的旧银币与未鉴定古物揣进衣袋。<span class="green">你在古籍区横梁上顺利起出了锡制书签盒。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[离开 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	锡制书签盒卡在顶层横梁与挡板之间，你踮脚去摸时指尖被木刺扎了一下。<span class="red">指尖被书架横梁木刺刮痛，只得先缩回手。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[握稳工具重调位置 (0:04)|MP World Library TopBeamBookmarkTin]]>><<pass 4>><</link>>
	<br>
	<<link [[走回图书馆 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">取出书签盒 (0:05)（能力不足）</span><</if>>
<br>
<<if ($science or 0) gte 260 or ($athletics or 0) gte 250>><<link "沿石缝抽出 (0:06)">><<pass 6>><<replace "#wev-mp-world-library-topbeambookmarktin">>
<<if ($science or 0) gte 240 or ($athletics or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_library_topbeambookmarktin_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你屏住呼吸拨开横梁挡片，将锡制书签盒连同夹层里的零钞稳稳取下。<span class="green">你用巧劲取下了完好无损的锡制书签盒。</span><<tiredness -1>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[转回图书馆 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	借阅区走廊忽然传来管理员推书车的声响，你动作一滞，袖口蹭上了一点旧书灰。<span class="red">为免引人注意，你先收回手退到书架后。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[压住台面重新着力 (0:04)|MP World Library TopBeamBookmarkTin]]>><<pass 4>><</link>>
	<br>
	<<link [[返回外围通道 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">沿石缝抽出 (0:06)（能力不足）</span><</if>>
</div>

:: MP World Canteen MilkCrateCoinPurse [nobr]
<<set $outside to 0>><<set $location to "school">>
<<effects>>
<<set _exitPas to ($mpReturnPassage or "Canteen")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Canteen">>
<</if>>
学校食堂后厨储物间外的空牛奶箱下压着一只遗落的拉链零钱包。<<mpAmbient>>你驻足留心后厨动静，看见零钱包拉链头上挂着小铜牌。
<br><br>
<<getouticon>><<link [[收妥行囊回街口 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="wev-mp-world-canteen-milkcratecoinpurse">
<<investigateicon>><<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>><<link "取出卡住零钱包 (0:05)">><<pass 5>><<replace "#wev-mp-world-canteen-milkcratecoinpurse">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_canteen_milkcratecoinpurse")>><<money 220>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你借着成摞空牛奶箱的掩护拉开拉链零钱包，把内藏的旧银币与古物妥善收入囊中。<span class="green">你在食堂后厨外顺利起出了拉链零钱包。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好器物返回 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	拉链零钱包被木制牛奶箱底钉勾住了布边，你硬拽时指节磕在木箱铁包角上，留下一道红印。<span class="red">指节被牛奶箱铁包角刮痛，只得先缩回手。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[垫上干布重起卡扣 (0:04)|MP World Canteen MilkCrateCoinPurse]]>><<pass 4>><</link>>
	<br>
	<<link [[拍净衣袖回街口 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">取出卡住零钱包 (0:05)（能力不足）</span><</if>>
<br>
<<if ($science or 0) gte 260 or ($athletics or 0) gte 250>><<link "顺墙根暗槽移出 (0:06)">><<pass 6>><<replace "#wev-mp-world-canteen-milkcratecoinpurse">>
<<if ($science or 0) gte 240 or ($athletics or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_canteen_milkcratecoinpurse_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你稍稍抬起牛奶箱一角解开布边，将拉链零钱包连同暗格里的零钞一并取走。<span class="green">你完好无损地取出了拉链零钱包。</span><<tiredness -1>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[顺着街巷回街口 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	后厨门帘内响起餐盘碰撞的声响，你手腕微偏没能把木箱抬起。<span class="red">你轻手轻脚放下木箱，决定等后厨安静些再试。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[顺着卯眼重新发力 (0:04)|MP World Canteen MilkCrateCoinPurse]]>><<pass 4>><</link>>
	<br>
	<<link [[整好衣领回街口 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">顺墙根暗槽移出 (0:06)（能力不足）</span><</if>>
</div>

:: MP World TempleGarden RosebushCeladonVial [nobr]
<<set $outside to 1>><<set $location to "temple">>
<<effects>>
<<set _exitPas to ($mpReturnPassage or "Temple Garden")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Temple Garden">>
<</if>>
神殿花园修剪整齐的月季花丛根部露出半截青瓷药瓶。<<mpAmbient>>你借着石栏掩护扫视左右，发现瓶口木塞上封着白蜡暗记。
<br><br>
<<getouticon>><<link [[拍净衣袖回街口 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="wev-mp-world-templegarden-rosebushceladonvial">
<<investigateicon>><<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>><<link "挑开药瓶搭扣 (0:05)">><<pass 5>><<replace "#wev-mp-world-templegarden-rosebushceladonvial">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_templegarden_rosebushceladonvial")>><<money 220>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你借着月季花丛的掩护拔开青瓷药瓶木塞，将暗格里的零散银币与古物一并收好。<span class="green">你在神殿花园顺利起出了青瓷药瓶。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[拍净衣角回街 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	青瓷药瓶周围缠满带刺的月季枝条，你伸手拨弄时手背被花刺刮出一道红印。<span class="red">手背被月季花刺扎痛，只得先缩回手。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[擦净指腹重按簧片 (0:04)|MP World TempleGarden RosebushCeladonVial]]>><<pass 4>><</link>>
	<br>
	<<link [[顺着街巷回街口 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">挑开药瓶搭扣 (0:05)（能力不足）</span><</if>>
<br>
<<if ($science or 0) gte 260 or ($athletics or 0) gte 250>><<link "垫帕子取出 (0:06)">><<pass 6>><<replace "#wev-mp-world-templegarden-rosebushceladonvial">>
<<if ($science or 0) gte 240 or ($athletics or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_templegarden_rosebushceladonvial_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你垫着帕子拨开带刺花枝，将青瓷药瓶连同底座下的零钞一并收入掌心。<span class="green">你完好取出了花丛根部的青瓷药瓶。</span><<tiredness -1>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[整好衣领回街口 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	花园回廊吹来一阵穿堂冷风，花枝晃动间你探手的角度差了半寸。<span class="red">指尖擦过冰凉的青瓷釉面，只能暂且作罢。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[找准支点重新撬动 (0:04)|MP World TempleGarden RosebushCeladonVial]]>><<pass 4>><</link>>
	<br>
	<<link [[转身步回街口 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">垫帕子取出 (0:06)（能力不足）</span><</if>>
</div>

:: MP World OceanBreeze ParasolTieClip [nobr]
<<set $outside to 1>><<set $location to "town">>
<<effects>>
<<set _exitPas to ($mpReturnPassage or "Ocean Breeze")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Ocean Breeze">>
<</if>>
海风咖啡馆露台遮阳伞的铸铁底座槽里卡着一枚金质领带夹。<<mpAmbient>>你收敛气息打量露台四周，见领带夹背面刻着精致徽纹。
<br><br>
<<getouticon>><<link [[返回咖啡馆 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="wev-mp-world-oceanbreeze-parasoltieclip">
<<investigateicon>><<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>><<link "摸出领带夹 (0:05)">><<pass 5>><<replace "#wev-mp-world-oceanbreeze-parasoltieclip">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_oceanbreeze_parasoltieclip")>><<money 220>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你借着露台遮阳伞的掩护解开金质领带夹暗扣，把封存的旧银币与古物稳稳收进贴身口袋。<span class="green">你在海风咖啡馆露台顺利起出了金质领带夹。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[返回原处 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	金质领带夹卡在铸铁伞座的窄缝里，你硬往外抠时指尖蹭在粗糙铁铸面上，擦出一道红印。<span class="red">指尖被铸铁伞座刮痛，只得先缩回手。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[扶稳器座重调角度 (0:04)|MP World OceanBreeze ParasolTieClip]]>><<pass 4>><</link>>
	<br>
	<<link [[走回咖啡馆 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">摸出领带夹 (0:05)（能力不足）</span><</if>>
<br>
<<if ($science or 0) gte 260 or ($athletics or 0) gte 250>><<link "借盲区解封绳 (0:06)">><<pass 6>><<replace "#wev-mp-world-oceanbreeze-parasoltieclip">>
<<if ($science or 0) gte 240 or ($athletics or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_oceanbreeze_parasoltieclip_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你用指尖挑开伞座卡簧，将金质领带夹连同底座油纸包里的零钞一并取下。<span class="green">你用巧劲取下了完好无损的金质领带夹。</span><<tiredness -1>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[退到通风处 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	露台台阶下晃过侍者端盘的身影，你连忙压低身形收住手势。<span class="red">时机稍纵即逝，你只得先退回遮阳伞阴影处。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[屏住气息重新摸索 (0:04)|MP World OceanBreeze ParasolTieClip]]>><<pass 4>><</link>>
	<br>
	<<link [[转回咖啡馆 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">借盲区解封绳 (0:06)（能力不足）</span><</if>>
</div>

:: MP World Pub KegStackWineskin [nobr]
<<set $outside to 1>><<set $location to "pub">>
<<effects>>
<<set _exitPas to ($mpReturnPassage or "Pub")>>
<<if _exitPas is "Start" or _exitPas is "Start2" or _exitPas.startsWith("MP ")>>
	<<set _exitPas to "Pub">>
<</if>>
丰收街酒吧后巷的空啤酒桶堆里藏着一只密封的鹿皮酒囊。<<mpAmbient>>你趁四下无人走近细看，见酒囊铜嘴上缠着防伪细铅丝。
<br><br>
<<getouticon>><<link [[返回酒馆 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<div id="wev-mp-world-pub-kegstackwineskin">
<<mpdrinkicon>><<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 250>><<link "撬开鹿皮酒囊 (0:05)">><<pass 5>><<replace "#wev-mp-world-pub-kegstackwineskin">>
<<if ($skulduggery or 0) gte 240 or ($tending or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_pub_kegstackwineskin")>><<money 220>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你借着空啤酒桶堆的遮挡旋开鹿皮酒囊暗袋，将夹层里的古旧银币与器物悉数收起。<span class="green">你在酒吧后巷顺利起出了鹿皮酒囊。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[沿来路返回 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	鹿皮酒囊被两只橡木酒桶死死夹住，你伸手拉扯时手腕蹭在酒桶铁箍上，留下一道红痕。<span class="red">手腕被橡木桶铁箍刮痛，只得先缩回手。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[借着侧光重对刻痕 (0:04)|MP World Pub KegStackWineskin]]>><<pass 4>><</link>>
	<br>
	<<link [[退到通风处 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>
<</replace>><</link>><<else>><span class="disabled">撬开鹿皮酒囊 (0:05)（能力不足）</span><</if>>
<br>
<<if ($science or 0) gte 260 or ($athletics or 0) gte 250>><<link "趁脚步空档取走 (0:06)">><<pass 6>><<replace "#wev-mp-world-pub-kegstackwineskin">>
<<if ($science or 0) gte 240 or ($athletics or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("world_ev_mp_world_pub_kegstackwineskin_keepsake")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span><</if>>
	你用指腹触到皮带活扣，轻轻一抽便将鹿皮酒囊连同底袋里的零钞完整取下。<span class="green">你毫不费力地取出了完好无损的鹿皮酒囊。</span><<tiredness -1>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[转身步回酒馆吧台 (0:08)|_exitPas]]>><<pass 8>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	酒桶外侧沾着滑腻的麦芽酒沫，你捏住鹿皮酒囊边缘时滑脱了一下。<span class="red">掌心蹭上一层湿酒渍，没能当场将酒囊抽出。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
