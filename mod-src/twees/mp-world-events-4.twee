<<investigateicon>><<link [[上前仔细查探 (0:05)|_exitPas]]>><<pass 5>><<stress -4>><<money 220>><<set $eventskip to 1>><<endevent>><</link>><<lstress>>
<br>
<<if ($skulduggery or 0) gte 250>>
	<<sneakicon>><<link [[巧妙开启暗格 (0:04)|_exitPas]]>><<pass 4>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><<skulduggery 2>><<set $eventskip to 1>><<endevent>><</link>>
	<br>
<</if>>
<<walkicon>><<link [[不动声色地离开 (0:02)|_exitPas]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>

