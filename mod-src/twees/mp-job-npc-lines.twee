<<else>><<link [[缝好收据 (0:06)|MP Insufficient]]>><<set $mpInsuffRet to (State.passage)>><<set $mpInsuffLabel to "缝好收据">><<set $mpInsuffReq to "家政等级：<span class='purple'>D</span>">><<pass 6>><</link>><</if>>
