/* DoL-MP v1.2.0-dev8: mp-night-and-wilds-events.twee (12 passages: Alley, Docks, Forest, Park, SeaRocks, Orphanage 1..2) */
:: MP Night Event Alley 1 [nobr]
<<set $outside to 1>><<set $location to "commercial">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
午夜的商业区小巷只有尽头一盏煤气灯闪着微光，两只野猫在翻倒的木箱间追逐，撞落了一只挂在消防梯下的防水布包。
<br><br>
<<getouticon>><<link [[趁夜色返回 (0:02)|Commercial Alleyways]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv_alley_1 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-night-event-alley-1">
<<sneakicon>><<link "踩木箱勾下防水包 (0:06)">><<pass 6>><<replace "#act-mp-night-event-alley-1">>
<<set $daily.mpNightEv_alley_1 to 1>>
<<if ($athletics or 0) gte 240 or ($skulduggery or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev_alley_1")>><<money 280>><</if>>你轻巧勾下布包，里面装着夜班跑腿留下的零钱与一张后巷近道草图。<span class="green">你在夜巷消防梯下有所斩获。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[顺着夜色继续往前走 (0:04)|MP Night Event Alley 2]]>><<pass 4>><</link>>
<<else>>
	木箱板条松动晃了一下，你的手肘擦在砖墙上。<span class="red">砖墙擦红了你的小臂。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP Night Event Alley 1]]>><<set $daily.mpNightEv_alley_1 to 0>><<pass 3>><</link>>
	<br>
	<<link [[顺着夜色继续往前走 (0:04)|MP Night Event Alley 2]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "用长竹竿从地面将布包挑落 (0:07)">><<pass 7>><<replace "#act-mp-night-event-alley-1">>
<<set $daily.mpNightEv_alley_1 to 1>>
<<if ($tending or 0) gte 240 or ($science or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev_alley_1")>><<money 280>><</if>>布包稳稳落进怀里，没有发出半点声响，你顺手收起了里面的零钞。<span class="green">你悄无声息地取下了夜巷布包。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[往深处灯影下查探 (0:04)|MP Night Event Alley 2]]>><<pass 4>><</link>>
<<else>>
	竹竿头滑了一下，布包掉进浅水洼溅起几点泥星。<span class="red">你擦净布包退回干处。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<walkicon>><<link [[先退回主街口 (0:04)|Commercial Alleyways]]>><<pass 4>><</link>>
	<br>
	<<link [[调整状态再试 (0:03)|MP Night Event Alley 1]]>><<set $daily.mpNightEv_alley_1 to 0>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Alley 2 [nobr]
<<set $outside to 1>><<set $location to "commercial">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
顺着后巷往里走，裁缝铺后门的换气百叶窗下透出微弱暖光，门廊石阶边遗落着一只镶银顶针盒。
<br><br>
<<getouticon>><<link [[顺原路返回 (0:03)|Commercial Alleyways]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv_alley_2 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-night-event-alley-2">
<<tendingicon>><<link "拾顶针盒塞入窗缝 (0:06)">><<pass 6>><<replace "#act-mp-night-event-alley-2">>
<<set $daily.mpNightEv_alley_2 to 1>>
<<if ($skulduggery or 0) gte 250 or ($housekeeping or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev_alley_2")>><<money 320>><</if>>窗内守夜学徒感激地推开小窗，递给你几枚银币作为拾遗谢礼。<span class="green">你的善举换来了夜班学徒的酬谢。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[趁夜色返回歇息 (0:04)|Commercial Alleyways]]>><<pass 4>><</link>>
<<else>>
	百叶窗合页生锈，塞入顶针盒时刮痛了指节。<span class="red">你缩回手退入暗影。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP Night Event Alley 2]]>><<set $daily.mpNightEv_alley_2 to 0>><<pass 3>><</link>>
	<br>
	<<link [[趁夜色返回歇息 (0:04)|Commercial Alleyways]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "把顶针盒放在窗台轻叩两声 (0:07)">><<pass 7>><<replace "#act-mp-night-event-alley-2">>
<<set $daily.mpNightEv_alley_2 to 1>>
<<if ($skulduggery or 0) gte 250 or ($science or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev_alley_2")>><<money 320>><</if>>守夜学徒闻声开窗取走顶针盒，笑着塞给你一包夜班点心钱。<span class="green">你礼貌提醒学徒归还了顶针盒。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好补贴返回 (0:04)|Commercial Alleyways]]>><<pass 4>><</link>>
<<else>>
	巷口风声盖过了叩窗声，里面一时无人应答。<span class="red">你等风声小些再试。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<walkicon>><<link [[先退回主干道 (0:04)|Commercial Alleyways]]>><<pass 4>><</link>>
	<br>
	<<link [[调整状态再试 (0:03)|MP Night Event Alley 2]]>><<set $daily.mpNightEv_alley_2 to 0>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Docks 1 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
深夜两点的旧港栈桥海雾弥漫，守夜巡逻艇的探照灯每隔半分钟扫过三号泊位，系船桩下卡着一只随潮漂来的密封朗姆酒匣。
<br><br>
<<getouticon>><<link [[趁夜色返回 (0:02)|Docks]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv_docks_1 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-night-event-docks-1">
<<sneakicon>><<link "趁灯光移开捞酒匣 (0:06)">><<pass 6>><<replace "#act-mp-night-event-docks-1">>
<<set $daily.mpNightEv_docks_1 to 1>>
<<if ($skulduggery or 0) gte 250 or ($athletics or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev_docks_1")>><<money 280>><</if>>你在光束扫回前将酒匣提上干燥栈桥，匣内除了好酒还夹着几枚防水银币。<span class="green">你避开夜巡灯光捞起了漂流酒匣。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[顺着夜色继续往前走 (0:04)|MP Night Event Docks 2]]>><<pass 4>><</link>>
<<else>>
	浪花突然拍上石阶，冰凉海水打湿了你的鞋袜。<span class="red">海风吹得湿脚踝阵阵发凉。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP Night Event Docks 1]]>><<set $daily.mpNightEv_docks_1 to 0>><<pass 3>><</link>>
	<br>
	<<link [[顺着夜色继续往前走 (0:04)|MP Night Event Docks 2]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "用带钩的系船副缆拖回酒匣 (0:07)">><<pass 7>><<replace "#act-mp-night-event-docks-1">>
<<set $daily.mpNightEv_docks_1 to 1>>
<<if ($science or 0) gte 240 or ($tending or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev_docks_1")>><<money 280>><</if>>铁钩稳稳勾住木匣提手，你站在背光处不湿寸缕便将酒匣收入囊中。<span class="green">你巧用副缆在暗处收妥了酒匣。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[往深处灯影下查探 (0:04)|MP Night Event Docks 2]]>><<pass 4>><</link>>
<<else>>
	副缆上沾满湿滑海藻，拉拽时磨红了掌心。<span class="red">你拍去手上湿藻退后半步。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<walkicon>><<link [[先退回主街口 (0:04)|Docks]]>><<pass 4>><</link>>
	<br>
	<<link [[调整状态再试 (0:03)|MP Night Event Docks 1]]>><<set $daily.mpNightEv_docks_1 to 0>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Docks 2 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
栈桥尽头的夜航信号灯油壶快要见底，灯芯火苗在夜风里忽明忽暗，值班老水手正四处找备用油罐。
<br><br>
<<getouticon>><<link [[顺原路返回 (0:03)|Docks]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv_docks_2 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-night-event-docks-2">
<<tendingicon>><<link "拎备用鲸油罐添满 (0:06)">><<pass 6>><<replace "#act-mp-night-event-docks-2">>
<<set $daily.mpNightEv_docks_2 to 1>>
<<if ($housekeeping or 0) gte 250 or ($physique or 10000) gte 11400>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev_docks_2")>><<money 320>><</if>>信号灯重新亮起穿透夜雾的黄光，老水手塞给你一份守夜补贴道谢。<span class="green">你帮老水手保住了夜航信号灯。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[趁夜色返回歇息 (0:04)|Docks]]>><<pass 4>><</link>>
<<else>>
	备用鲸油罐沉重冰凉，拎起时磕到了脚踝。<span class="red">你扶住锚链箱稳住身形。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP Night Event Docks 2]]>><<set $daily.mpNightEv_docks_2 to 0>><<pass 3>><</link>>
	<br>
	<<link [[趁夜色返回歇息 (0:04)|Docks]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "用铜漏斗将两半瓶余油并入 (0:07)">><<pass 7>><<replace "#act-mp-night-event-docks-2">>
<<set $daily.mpNightEv_docks_2 to 1>>
<<if ($skulduggery or 0) gte 250 or ($science or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev_docks_2")>><<money 320>><</if>>油位升起后灯火顿时明亮如昼，老水手欣慰地付了你帮工钱。<span class="green">你巧用余油保住了夜航信号灯。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好补贴返回 (0:04)|Docks]]>><<pass 4>><</link>>
<<else>>
	船栈摇晃让漏斗歪斜，两滴鲸油洒在石板上。<span class="red">你扶正漏斗继续注油。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<walkicon>><<link [[先退回主干道 (0:04)|Docks]]>><<pass 4>><</link>>
	<br>
	<<link [[调整状态再试 (0:03)|MP Night Event Docks 2]]>><<set $daily.mpNightEv_docks_2 to 0>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Forest 1 [nobr]
<<set $outside to 1>><<set $location to "forest">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
子夜的密林深处月影斑驳，一丛发光的夜光蕈下压着半截猎人遗落的黄铜望远镜筒，周围树冠传来夜枭的低鸣。
<br><br>
<<getouticon>><<link [[趁夜色返回 (0:02)|Forest]]>><<pass 2>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv_forest_1 is 1>>
今日已来过此处。
<<else>>
<div id="act-mp-night-event-forest-1">
<<sneakicon>><<link "拨蕨叶取出望远镜 (0:06)">><<pass 6>><<replace "#act-mp-night-event-forest-1">>
<<set $daily.mpNightEv_forest_1 to 1>>
<<if ($tending or 0) gte 240 or ($skulduggery or 0) gte 240>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev_forest_1")>><<money 280>><</if>>镜筒内胆干燥完好，旋开后盖还藏着几枚猎人留下的应急银币。<span class="green">你在夜光蕈丛下寻获了完好镜筒。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[顺着夜色继续往前走 (0:04)|MP Night Event Forest 2]]>><<pass 4>><</link>>
<<else>>
	夜露打湿了衣袖，蕨丛下的荆棘刺了一下手背。<span class="red">你缩回手甩去露水。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[定神再试 (0:03)|MP Night Event Forest 1]]>><<set $daily.mpNightEv_forest_1 to 0>><<pass 3>><</link>>
	<br>
	<<link [[顺着夜色继续往前走 (0:04)|MP Night Event Forest 2]]>><<pass 4>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "先用树枝探清蕈丛下捕兽夹 (0:07)">><<pass 7>><<replace "#act-mp-night-event-forest-1">>
<<set $daily.mpNightEv_forest_1 to 1>>
<<if ($science or 0) gte 240 or ($willpower or 0) gte 420>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev_forest_1")>><<money 280>><</if>>你挑开一处松脱的细铜丝猎套，安全取出了黄铜镜筒与里面的存银。<span class="green">你的谨慎让你避开暗套拿到镜筒。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[往深处灯影下查探 (0:04)|MP Night Event Forest 2]]>><<pass 4>><</link>>
<<else>>
	夜枭突然振翅掠过头顶，吓得你脚下一滑踩进软泥。<span class="red">靴底沾上了一层湿黑林泥。</span><<stress 3>><<tiredness 1>><<gtiredness>><<gstress>>
	<br><br>
	<<walkicon>><<link [[先退回主街口 (0:04)|Forest]]>><<pass 4>><</link>>
	<br>
	<<link [[调整状态再试 (0:03)|MP Night Event Forest 1]]>><<set $daily.mpNightEv_forest_1 to 0>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Forest 2 [nobr]
<<set $outside to 1>><<set $location to "forest">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
林间溪谷的独木桥在夜雾中泛着湿光，桥头石桩的防风灯罩里卡着一封守林人留给路人的路标信。
<br><br>
<<getouticon>><<link [[顺原路返回 (0:03)|Forest]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
