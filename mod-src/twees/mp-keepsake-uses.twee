<</replace>><</link>>
<br>
<<link "模仿沙龙常客优雅步态走过 (0:07)">><<pass 7>><<replace "#act-mp-keepsake-use-mask">>
<<if ($skulduggery or 0) gte 250 or ($willpower or 0) gte 430>>
