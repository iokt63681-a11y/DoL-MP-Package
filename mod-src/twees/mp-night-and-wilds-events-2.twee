/* DoL-MP v1.2.0-dev9: mp-night-and-wilds-events-2.twee (12 passages: Alley, Docks, Forest, Park, SeaRocks, Orphanage 3..4) */

:: MP Night Event Alley 3 [nobr]
<<set $outside to 1>><<set $location to "commercial">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "night">>子夜的商业区后巷雾气弥漫，<<else>>昏暗幽深的商业区后巷拐角处，<</if>>当铺后窗的铸铁滑轮下挂着一只忘记收回的绒布首饰袋，袋口铜扣在煤气灯下闪着微光。
墙根立着一只垫脚的旧木箱。<br><br>
<<getouticon>><<link [[返回商业巷 (0:03)|Commercial Alleyways]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_alley_3 is 1>>
商业区后巷当铺窗下的首饰袋今夜已处置妥当，巷道安静无声。
<br>
<<link [[深入查探 (0:04)|MP Night Event Alley 4]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-night-event-alley-3">
<<sneakicon>><<link "踩箱取下布袋 (0:07)">><<pass 7>><<replace "#act-mp-night-event-alley-3">>
<<if ($athletics or 0) gte 250 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_alley_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_alley_3")>><<money 320>>你轻巧取下绒布袋从窗缝递入，守夜老掌柜感激地塞给你几枚银币谢礼。<<else>>你轻巧取下绒布袋从窗缝递入，守夜老掌柜隔窗朝你感激点头。<</if>><span class="green">你在夜巷替当铺保住了遗落的首饰袋。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[往前探路 (0:04)|MP Night Event Alley 4]]>><<pass 4>><</link>>
<<else>>
	木箱踏板沾着夜露，脚底一滑擦痛了脚踝。<span class="red">你扶住砖墙先站稳身形。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Night Event Alley 3]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|Commercial Alleyways]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "拉绳降下布袋 (0:08)">><<pass 8>><<replace "#act-mp-night-event-alley-3">>
<<if ($science or 0) gte 240 or ($housekeeping or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_alley_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_alley_3_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>滑轮无声转动，首饰袋平稳落在窗台内侧，老掌柜推窗递出一包老字号信物铜牌。<<else>>铸铁滑轮无声转动，绒布首饰袋平稳落在了窗台内侧。<</if>><<skulduggery 1>><span class="green">你巧用滑轮副绳归还了绒布首饰袋。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[返回商业巷深处 (0:04)|Commercial Alleyways]]>><<pass 4>><</link>>
<<else>>
	滑轮副绳打了个小結，拉动时磨红了手指。<span class="red">你解开绳结准备重新拉绳。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Night Event Alley 3]]>><<pass 4>><</link>>
	<br>
	<<link [[返回巷口 (0:03)|Commercial Alleyways]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Alley 4 [nobr]
<<set $outside to 1>><<set $location to "commercial">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "night">>深夜巷尾的报社印刷房还在低声运转，<<else>>夜色笼罩的印刷房后巷排风口旁，<</if>>一捆刚印好的晚报增刊从运货推车上滑落，里面夹着报社给夜班线人的信封。
<br><br>
<<getouticon>><<link [[返回商业巷 (0:03)|Commercial Alleyways]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_alley_4 is 1>>
印刷房后巷滑落的晚报增刊今夜已整理归位，油墨香气淡淡飘散。
<<else>>
<div id="act-mp-night-event-alley-4">
<<investigateicon>><<link "抱起晚报增刊 (0:07)">><<pass 7>><<replace "#act-mp-night-event-alley-4">>
<<if ($housekeeping or 0) gte 250 or ($physique or 10000) gte 11300>>
	<<set $daily.mpNightEv3_mp_night_event_alley_4 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_alley_4")>><<money 320>>印刷工连声道谢，把那封属于夜班帮工的线报津贴直接分给了你。<<else>>你扶稳倾斜的铅字架并抽回信封，夜班印刷工松了一大口气。<</if>><span class="green">你在夜巷帮印刷房收回了散落增刊。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[返回歇息 (0:04)|Commercial Alleyways]]>><<pass 4>><</link>>
<<else>>
	麻绳捆扎过紧，抱起时勒红了手腕。<span class="red">你垫上衣袖准备重新抱起。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Night Event Alley 4]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|Commercial Alleyways]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "借灯抽出信封 (0:08)">><<pass 8>><<replace "#act-mp-night-event-alley-4">>
<<if ($skulduggery or 0) gte 250 or ($english or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_alley_4 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_alley_4_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>你眼疾手快抽出防水信封并替印刷工码齐报纸，顺利收下里面的夜班通行铜牌。<<else>>你眼疾手快抽出防水信封并码齐报纸，桌面重新收拾得整整齐齐。<</if>><<skulduggery 1>><span class="green">你利落收妥了晚报夹层里的夜班信封。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[收工返回 (0:04)|Commercial Alleyways]]>><<pass 4>><</link>>
<<else>>
	新鲜油墨未干，蹭黑了你的两根手指。<span class="red">你拿手帕擦净油墨准备再试。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Night Event Alley 4]]>><<pass 4>><</link>>
	<br>
	<<link [[返回巷口 (0:03)|Commercial Alleyways]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Docks 3 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "night">>午夜涨潮的海浪拍打着四号泊位，<<else>>夜色深沉的旧港四号泊位栈桥边，<</if>>一艘刚靠岸的远洋货轮抛下撇缆，缆头的铜配重球不慎卡进了栈桥木缝。
<br><br>
<<getouticon>><<link [[返回码头 (0:03)|Docks]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_docks_3 is 1>>
四号泊位栈桥木缝里的撇缆铜球今夜已解开，货轮平稳停泊。
<br>
<<link [[深入查探 (0:04)|MP Night Event Docks 4]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-night-event-docks-3">
<<swimicon>><<link "握绳拔出铜球 (0:07)">><<pass 7>><<replace "#act-mp-night-event-docks-3">>
<<if ($physique or 10000) gte 11400 or ($athletics or 0) gte 250>>
	<<set $daily.mpNightEv3_mp_night_event_docks_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_docks_3")>><<money 320>>铜配重球应声拔出，你顺手将缆绳套上系船柱，大副从甲板抛下一袋夜班劳务银币。<<else>>铜配重球应声拔出，你将备用缆绳稳稳套上了系船石柱。<</if>><span class="green">你帮夜航货轮顺利系妥了头缆。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[往前探路 (0:04)|MP Night Event Docks 4]]>><<pass 4>><</link>>
<<else>>
	咸湿缆绳弹了一下，震得你手掌发麻。<span class="red">你缠稳手腕准备再次发力。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Night Event Docks 3]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|Docks]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "撬开木缝取球 (0:08)">><<pass 8>><<replace "#act-mp-night-event-docks-3">>
<<if ($science or 0) gte 240 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_docks_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_docks_3_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>铁撬杆轻轻一别便松开了木缝，大副冲你竖起大拇指并掷下航海纪念铜扣。<<else>>铁撬杆轻轻一别便松开了木缝，卡住的配重球顺利归位。<</if>><<skulduggery 1>><span class="green">你巧借撬杆毫不费力地解救了撇缆。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[返回码头深处 (0:04)|Docks]]>><<pass 4>><</link>>
<<else>>
	浪花拍上栈桥，打滑了铁撬杆的支点。<span class="red">你踩稳木板抵住支点准备再撬。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Night Event Docks 3]]>><<pass 4>><</link>>
	<br>
	<<link [[返回码头口 (0:03)|Docks]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Docks 4 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "night">>深夜的港务灯塔信标灯在雾中闪烁，<<else>>夜雾笼罩的码头备用信标台旁，<</if>>蓄电池箱的铜接线柱被海盐结晶包裹，接触不良的灯光忽明忽暗。
<br><br>
<<getouticon>><<link [[返回码头 (0:03)|Docks]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_docks_4 is 1>>
码头备用信标台的蓄电池接线柱今夜已刮净，航标灯稳定长亮。
<<else>>
<div id="act-mp-night-event-docks-4">
<<tendingicon>><<link "刮去柱上盐壳 (0:07)">><<pass 7>><<replace "#act-mp-night-event-docks-4">>
<<if ($science or 0) gte 250 or ($housekeeping or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_docks_4 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_docks_4")>><<money 320>>海盐结晶刮净后信标灯瞬间恢复雪亮，值夜港务员塞给你一笔夜巡检修费。<<else>>海盐结晶刮净后，引水信标灯瞬间恢复了雪亮通透的光束。<</if>><span class="green">你及时排除了夜航信标灯的接触故障。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[返回歇息 (0:04)|Docks]]>><<pass 4>><</link>>
<<else>>
	铜接线柱跳出一粒细小电火花，惊得你缩回手。<span class="red">你先拉开闸刀开关再动手。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Night Event Docks 4]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|Docks]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "涂油拧下螺母 (0:08)">><<pass 8>><<replace "#act-mp-night-event-docks-4">>
<<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_docks_4 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_docks_4_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>>螺母拧紧且裹满凡士林，灯光稳稳照亮水道，港务员欣喜地赠你一枚港务铜章。<<else>>接线螺母拧紧并涂好凡士林，防风信标灯稳稳照亮了夜航水道。<</if>><<skulduggery 1>><span class="green">防潮处理让信标灯在海雾中稳如磐石。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[返回梅尔街 (0:04)|Mer Street]]>><<pass 4>><</link>>
<<else>>
	铜螺母被盐霜咬住，手指拧得有些生疼。<span class="red">你摸出小扳手准备重新拧紧。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Night Event Docks 4]]>><<pass 4>><</link>>
	<br>
	<<link [[返回码头口 (0:03)|Docks]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Forest 3 [nobr]
<<set $outside to 1>><<set $location to "forest">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "night">>子夜的林间空地飘荡着点点萤火，<<else>>夜色幽暗的森林溪流石滩旁，<</if>>一株罕见的夜光月见草正在溪石缝间绽放，旁边树枝上还挂着采药人遗落的铜药铲。
<br><br>
<<getouticon>><<link [[返回森林 (0:03)|Forest]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_forest_3 is 1>>
溪石缝间的夜光月见草与铜药铲今夜已采集完毕，溪水潺潺流淌。
<br>
<<link [[深入查探 (0:04)|MP Night Event Forest 4]]>><<pass 4>><</link>>
<<else>>
<div id="act-mp-night-event-forest-3">
<<tendingicon>><<link "掘出月见草 (0:07)">><<pass 7>><<replace "#act-mp-night-event-forest-3">>
<<if ($tending or 0) gte 250 or ($science or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_forest_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_forest_3")>><<money 320>>月见草根系完整无损，连同铜药铲袋里的采药订金一并归入你囊中。<<else>>月见草根系完整无损地移入药篓，散发着清冽的草木香气。<</if>><span class="green">你在夜林溪畔采到了品相完好的月见草。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[往前探路 (0:04)|MP Night Event Forest 4]]>><<pass 4>><</link>>
<<else>>
	溪石湿滑，脚下一溜差点踩进浅溪里。<span class="red">你扶住岸边树干退回干处。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Night Event Forest 3]]>><<pass 4>><</link>>
	<br>
	<<link [[离开 (0:03)|Forest]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "解袋采花冠 (0:08)">><<pass 8>><<replace "#act-mp-night-event-forest-3">>
<<if ($athletics or 0) gte 240 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_forest_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_forest_3_alt")>><<set $mpHerbsCollected to ($mpHerbsCollected or 0) + 1>>你轻巧摘下药铲袋与月见草花冠，留住根系让它明年还能复生，收获颇丰。<<else>>你轻巧摘下饱满的月见草花冠，留住根系让它来年还能复生。<</if>><<skulduggery 1>><span class="green">你兼顾采收与留根拿到了夜林收获。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<link [[返回森林深处 (0:04)|Forest]]>><<pass 4>><</link>>
<<else>>
	夜露打湿了树枝，伸手时被松针扎了一下手背。<span class="red">你拨开松针准备重新解袋。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<link [[再试一次 (0:04)|MP Night Event Forest 3]]>><<pass 4>><</link>>
	<br>
	<<link [[返回林边 (0:03)|Forest]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Forest 4 [nobr]
<<set $outside to 1>><<set $location to "forest">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<if Time.dayState is "night">>深夜古橡树林间传来低沉的风声，<<else>>星光斑驳的深林猎人补给木桩旁，<</if>>树干高处的防熊吊篮绳扣松脱了一半，里面装着猎人行会预留的夜巡补给盒。
<br><br>
<<getouticon>><<link [[返回森林 (0:03)|Forest]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_forest_4 is 1>>
深林古橡树上的防熊吊篮今夜已重新系牢，林间夜色静谧。
<<else>>
<div id="act-mp-night-event-forest-4">
<<sneakicon>><<link "解下吊篮 (0:07)">><<pass 7>><<replace "#act-mp-night-event-forest-4">>
<<if ($athletics or 0) gte 250 or ($physique or 10000) gte 11400>>
	<<set $daily.mpNightEv3_mp_night_event_forest_4 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_forest_4")>><<money 320>>你敏捷跃上树枝取出补给盒里的银币与干粮，又替猎人把吊篮重新绑牢。<<else>>你敏捷跃上横枝整理好补给盒，又替猎人把树杈吊篮重新绑牢。<</if>><span class="green">你攀上古橡树取出了夜巡补给盒。</span><<stress -3>><<lstress>>
	<br><br>
