/* DoL-MP v1.2.0-dev9: mp-night-and-wilds-events-2.twee (12 passages: Alley, Docks, Forest, Park, SeaRocks, Orphanage 3..4) */

:: MP Night Event Alley 3 [nobr]
<<set $outside to 1>><<set $location to "commercial">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Time.dayState is "night">>子夜的商业区后巷雾气弥漫，<<else>>昏暗幽深的商业区后巷拐角处，<</if>>当铺后窗的铸铁滑轮下挂着一只忘记收回的绒布首饰袋，袋口铜扣在煤气灯下闪着微光。
墙根立着一只垫脚的旧木箱。<br><br>
<<getouticon>><<link [[趁夜色返回 (0:03)|Commercial Alleyways]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_alley_3 is 1>>
商业区后巷当铺窗下的首饰袋今夜已处置妥当，巷道安静无声。
<<else>>
<div id="act-mp-night-event-alley-3">
<<sneakicon>><<link "踩上木箱替当铺取下绒布袋 (0:07)">><<pass 7>><<replace "#act-mp-night-event-alley-3">>
<<if ($athletics or 0) gte 250 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_alley_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_alley_3")>><<money 320>>你轻巧取下绒布袋从窗缝递入，守夜老掌柜感激地塞给你几枚银币谢礼。<<else>>你熟练地复现了先前的步骤，里头的钱物虽已取走，仔细核验一遍仍让你心里踏实不少。<</if>><span class="green">你在夜巷替当铺保住了遗落的首饰袋。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[顺着夜色继续探看 (0:04)|MP Night Event Alley 4]]>><<pass 4>><</link>>
<<else>>
	木箱踏板沾着夜露，脚底一滑擦痛了脚踝。<span class="red">你扶住砖墙先站稳身形。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[屏住呼吸重新尝试 (0:04)|MP Night Event Alley 3]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回主街口 (0:03)|Commercial Alleyways]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "拉动副绳将绒布袋降窗台 (0:08)">><<pass 8>><<replace "#act-mp-night-event-alley-3">>
<<if ($science or 0) gte 240 or ($housekeeping or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_alley_3 to 1>><<set $mpClues["mpNightEv3_mp_night_event_alley_3_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_alley_3_alt")>><<money 380>>滑轮无声转动，首饰袋平稳落在窗台内侧，老掌柜推窗递出一包点心钱。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">你巧用滑轮副绳归还了绒布首饰袋。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[往深处灯影下走去 (0:04)|MP Night Event Alley 4]]>><<pass 4>><</link>>
<<else>>
	滑轮副绳打了个小結，拉动时磨红了手指。<span class="red">你解开绳结准备重新拉绳。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<walkicon>><<link [[看准位置再次动手 (0:04)|MP Night Event Alley 3]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回安全处 (0:03)|Commercial Alleyways]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Alley 4 [nobr]
<<set $outside to 1>><<set $location to "commercial">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Time.dayState is "night">>深夜巷尾的报社印刷房还在低声运转，<<else>>夜色笼罩的印刷房后巷排风口旁，<</if>>一捆刚印好的晚报增刊从运货推车上滑落，里面夹着报社给夜班线人的信封。
<<if $mpClues["mpNightEv3_mp_night_event_alley_3_alt"]>><span class="teal">凭借先前在上一处留下的巧手布置，你眼下的动作愈发得心应手。</span><</if>>
<br><br>
<<getouticon>><<link [[趁夜色返回 (0:03)|Commercial Alleyways]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_alley_4 is 1>>
印刷房后巷滑落的晚报增刊今夜已整理归位，油墨香气淡淡飘散。
<<else>>
<div id="act-mp-night-event-alley-4">
<<investigateicon>><<link "帮工友抱起晚报增刊 (0:07)">><<pass 7>><<replace "#act-mp-night-event-alley-4">>
<<if ($housekeeping or 0) gte 250 or ($physique or 10000) gte 11300>>
	<<set $daily.mpNightEv3_mp_night_event_alley_4 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_alley_4")>><<money 320>>印刷工连声道谢，把那封属于夜班帮工的线报津贴直接分给了你。<<else>>你熟练地复现了先前的步骤，里头的钱物虽已取走，仔细核验一遍仍让你心里踏实不少。<</if>><span class="green">你在夜巷帮印刷房收回了散落增刊。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[趁夜色返回歇息 (0:04)|Commercial Alleyways]]>><<pass 4>><</link>>
<<else>>
	麻绳捆扎过紧，抱起时勒红了手腕。<span class="red">你垫上衣袖准备重新抱起。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[屏住呼吸重新尝试 (0:04)|MP Night Event Alley 4]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回主街口 (0:03)|Commercial Alleyways]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "借路灯抽出夹层油纸信封 (0:08)">><<pass 8>><<replace "#act-mp-night-event-alley-4">>
<<if ($skulduggery or 0) gte 250 or ($english or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_alley_4 to 1>><<set $mpClues["mpNightEv3_mp_night_event_alley_4_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_alley_4_alt")>><<money 380>>你眼疾手快抽出防水信封并替印刷工码齐报纸，顺利收下里面的夜班赏金。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">你利落收妥了晚报夹层里的夜班信封。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好补贴返回 (0:04)|Commercial Alleyways]]>><<pass 4>><</link>>
<<else>>
	新鲜油墨未干，蹭黑了你的两根手指。<span class="red">你拿手帕擦净油墨准备再试。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<walkicon>><<link [[看准位置再次动手 (0:04)|MP Night Event Alley 4]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回安全处 (0:03)|Commercial Alleyways]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Docks 3 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Time.dayState is "night">>午夜涨潮的海浪拍打着四号泊位，<<else>>夜色深沉的旧港四号泊位栈桥边，<</if>>一艘刚靠岸的远洋货轮抛下撇缆，缆头的铜配重球不慎卡进了栈桥木缝。
<<if $mpClues["mpNightEv3_mp_night_event_alley_4_alt"]>><span class="teal">凭借先前在上一处留下的巧手布置，你眼下的动作愈发得心应手。</span><</if>>
<br><br>
<<getouticon>><<link [[趁夜色返回 (0:03)|Docks]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_docks_3 is 1>>
四号泊位栈桥木缝里的撇缆铜球今夜已解开，货轮平稳停泊。
<<else>>
<div id="act-mp-night-event-docks-3">
<<swimicon>><<link "握住缆绳巧劲拔出铜配重球 (0:07)">><<pass 7>><<replace "#act-mp-night-event-docks-3">>
<<if ($physique or 10000) gte 11400 or ($athletics or 0) gte 250>>
	<<set $daily.mpNightEv3_mp_night_event_docks_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_docks_3")>><<money 320>>铜配重球应声拔出，你顺手将缆绳套上系船柱，大副从甲板抛下一袋夜班劳务银币。<<else>>你熟练地复现了先前的步骤，里头的钱物虽已取走，仔细核验一遍仍让你心里踏实不少。<</if>><span class="green">你帮夜航货轮顺利系妥了头缆。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[顺着夜色继续探看 (0:04)|MP Night Event Docks 4]]>><<pass 4>><</link>>
<<else>>
	咸湿缆绳弹了一下，震得你手掌发麻。<span class="red">你缠稳手腕准备再次发力。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[屏住呼吸重新尝试 (0:04)|MP Night Event Docks 3]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回主街口 (0:03)|Docks]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "用铁撬杆撑开木缝取铜球 (0:08)">><<pass 8>><<replace "#act-mp-night-event-docks-3">>
<<if ($science or 0) gte 240 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_docks_3 to 1>><<set $mpClues["mpNightEv3_mp_night_event_docks_3_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_docks_3_alt")>><<money 380>>铁撬杆轻轻一别便松开了木缝，大副冲你竖起大拇指并掷下酬金袋。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">你巧借撬杆毫不费力地解救了撇缆。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[往深处灯影下走去 (0:04)|MP Night Event Docks 4]]>><<pass 4>><</link>>
<<else>>
	浪花拍上栈桥，打滑了铁撬杆的支点。<span class="red">你踩稳木板抵住支点准备再撬。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<walkicon>><<link [[看准位置再次动手 (0:04)|MP Night Event Docks 3]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回安全处 (0:03)|Docks]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Docks 4 [nobr]
<<set $outside to 1>><<set $location to "docks">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Time.dayState is "night">>深夜的港务灯塔信标灯在雾中闪烁，<<else>>夜雾笼罩的码头备用信标台旁，<</if>>蓄电池箱的铜接线柱被海盐结晶包裹，接触不良的灯光忽明忽暗。
<<if $mpClues["mpNightEv3_mp_night_event_docks_3_alt"]>><span class="teal">凭借先前在上一处留下的巧手布置，你眼下的动作愈发得心应手。</span><</if>>
<br><br>
<<getouticon>><<link [[趁夜色返回 (0:03)|Docks]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_docks_4 is 1>>
码头备用信标台的蓄电池接线柱今夜已刮净，航标灯稳定长亮。
<<else>>
<div id="act-mp-night-event-docks-4">
<<tendingicon>><<link "用小刀刮去柱上盐壳 (0:07)">><<pass 7>><<replace "#act-mp-night-event-docks-4">>
<<if ($science or 0) gte 250 or ($housekeeping or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_docks_4 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_docks_4")>><<money 320>>海盐结晶刮净后信标灯瞬间恢复雪亮，值夜港务员塞给你一笔夜巡检修费。<<else>>你熟练地复现了先前的步骤，里头的钱物虽已取走，仔细核验一遍仍让你心里踏实不少。<</if>><span class="green">你及时排除了夜航信标灯的接触故障。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[趁夜色返回歇息 (0:04)|Docks]]>><<pass 4>><</link>>
<<else>>
	铜接线柱跳出一粒细小电火花，惊得你缩回手。<span class="red">你先拉开闸刀开关再动手。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[屏住呼吸重新尝试 (0:04)|MP Night Event Docks 4]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回主街口 (0:03)|Docks]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "涂凡士林隔雾再拧铜螺母 (0:08)">><<pass 8>><<replace "#act-mp-night-event-docks-4">>
<<if ($skulduggery or 0) gte 250 or ($tending or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_docks_4 to 1>><<set $mpClues["mpNightEv3_mp_night_event_docks_4_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_docks_4_alt")>><<money 380>>螺母拧紧且裹满凡士林，灯光稳稳照亮水道，港务员欣喜地付给你奖金。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">防潮处理让信标灯在海雾中稳如磐石。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[收好补贴返回 (0:04)|Docks]]>><<pass 4>><</link>>
<<else>>
	铜螺母被盐霜咬住，手指拧得有些生疼。<span class="red">你摸出小扳手准备重新拧紧。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<walkicon>><<link [[看准位置再次动手 (0:04)|MP Night Event Docks 4]]>><<pass 4>><</link>>
	<br>
	<<link [[暂回安全处 (0:03)|Docks]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
</div>
<</if>>

:: MP Night Event Forest 3 [nobr]
<<set $outside to 1>><<set $location to "forest">><<effects>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Time.dayState is "night">>子夜的林间空地飘荡着点点萤火，<<else>>夜色幽暗的森林溪流石滩旁，<</if>>一株罕见的夜光月见草正在溪石缝间绽放，旁边树枝上还挂着采药人遗落的铜药铲。
<<if $mpClues["mpNightEv3_mp_night_event_docks_4_alt"]>><span class="teal">凭借先前在上一处留下的巧手布置，你眼下的动作愈发得心应手。</span><</if>>
<br><br>
<<getouticon>><<link [[趁夜色返回 (0:03)|Forest]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
<<if $daily.mpNightEv3_mp_night_event_forest_3 is 1>>
溪石缝间的夜光月见草与铜药铲今夜已采集完毕，溪水潺潺流淌。
<<else>>
<div id="act-mp-night-event-forest-3">
<<tendingicon>><<link "用铜药铲掘出月见草 (0:07)">><<pass 7>><<replace "#act-mp-night-event-forest-3">>
<<if ($tending or 0) gte 250 or ($science or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_forest_3 to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_forest_3")>><<money 320>>月见草根系完整无损，连同铜药铲袋里的采药订金一并归入你囊中。<<else>>你熟练地复现了先前的步骤，里头的钱物虽已取走，仔细核验一遍仍让你心里踏实不少。<</if>><span class="green">你在夜林溪畔采到了品相完好的月见草。</span><<stress -3>><<lstress>>
	<br><br>
	<<walkicon>><<link [[顺着夜色继续探看 (0:04)|MP Night Event Forest 4]]>><<pass 4>><</link>>
<<else>>
	溪石湿滑，脚下一溜差点踩进浅溪里。<span class="red">你扶住岸边树干退回干处。</span><<pain 1>><<stress 3>><<gpain>><<gstress>>
	<br><br>
	<<walkicon>><<link [[屏住呼吸重新尝试 (0:04)|MP Night Event Forest 3]]>><<pass 4>><</link>>
	<br>
	<<link [[先退回主街口 (0:03)|Forest]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "解下铜药铲袋并采下花冠 (0:08)">><<pass 8>><<replace "#act-mp-night-event-forest-3">>
<<if ($athletics or 0) gte 240 or ($skulduggery or 0) gte 240>>
	<<set $daily.mpNightEv3_mp_night_event_forest_3 to 1>><<set $mpClues["mpNightEv3_mp_night_event_forest_3_alt"] to 1>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("night_ev3_rew_mp_night_event_forest_3_alt")>><<money 380>>你轻巧摘下药铲袋与月见草花冠，留住根系让它明年还能复生，收获颇丰。<<else>>你轻车熟路地完成了整套手法，虽未再翻出额外的钱袋，却把现场理得井井有条。<</if>><<control 1>><span class="green">你兼顾采收与留根拿到了夜林收获。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<walkicon>><<link [[往深处灯影下走去 (0:04)|MP Night Event Forest 4]]>><<pass 4>><</link>>
<<else>>
	夜露打湿了树枝，伸手时被松针扎了一下手背。<span class="red">你拨开松针准备重新解袋。</span><<stress 3>><<tiredness 1>><<gstress>><<gtiredness>>
	<br><br>
	<<walkicon>><<link [[看准位置再次动手 (0:04)|MP Night Event Forest 3]]>><<pass 4>><</link>>
	<br>
