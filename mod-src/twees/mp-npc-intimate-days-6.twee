	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_lin_14_rew_alt")>><<set $mpHerbsCollected to ($mpHerbsCollected or 0) + 1>><span class="blue">获得草药 ×1</span>比重刻度分毫不差，林恩将第一小瓶高纯度薄荷精粹塞进你随身药包，叮嘱你困倦时嗅闻提神。<<else>>比重计稳稳浮在标准线上，林恩与你并肩坐在值班长椅上共享夜宵。<</if>><span class="green">林恩把亲手提纯的头道药草精粹留给了你。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
	<<if $mpNpcs and $mpNpcs.lin and $mpNpcs.lin.hasMet>><<link [[回药房前厅 (0:08)|MP NPC Lin Hub]]>><<pass 8>><</link>><<else>><span class="disabled">回药房前厅 (0:08)（尚未结识）</span><</if>>
<<else>>
