	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("relday_vesper_14_rew_alt")>><<set $mpAntiquesUnappraised to ($mpAntiquesUnappraised or 0) + 1>><span class="blue">获得未鉴定古董 ×1</span>常平双环无论风浪如何颠簸皆水平如镜，维斯将一枚老船长传下的纯铜袖珍指北针挂在你掌心赠予你。<<else>>防冻鲸油润透轴承，维斯握着你的手一起眺望远海灯塔。<</if>><span class="green">维斯将陪伴自己多年的航海护身信物赠予了你。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
