	<<set $daily.mpDaily_sydney_13 to 1>><<if !$mpClues or !$mpClues["clue_sydney_13_incense"]>><<set $mpClues["clue_sydney_13_incense"] to 1>><span class="blue">线索已记录</span><</if>><<if $NPCName and $NPCNameList and $NPCNameList.includes("Sydney")>><<npcincr Sydney love 2>><</if>>
	<<if window.dolmp && window.dolmp.claimUniqueReward && window.dolmp.claimUniqueReward("daily_sydney_13_rew_alt")>><<set $mpHerbsCollected to ($mpHerbsCollected or 0) + 1>><span class="blue">获得草药 ×1</span>白檀香饼分装妥帖，悉尼将一袋神殿药圃晒制的安神甘菊与檀香碎塞进你衣袋留作护身草药。<<else>>瓷瓮封口严密，清雅的白檀香气萦绕在你们两人之间。<</if>><span class="green">你与悉尼在静谧储香室里的默契让彼此心意愈发相通。</span><<tiredness -2>><<stress -2>><<ltiredness>><<lstress>>
	<br><br>
