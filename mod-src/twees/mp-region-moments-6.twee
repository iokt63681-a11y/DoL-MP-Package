	<br><br>
	<<link [[再试一次 (0:04)|MP Region Moment Druid 16]]>><<pass 4>><</link>>
	<br>
	<<link [[返回石环 (0:03)|MP Region Druid Circle]]>><<pass 3>><</link>>
<</if>>
<</replace>><</link>>
<br>
<<link "润滑经筒 (0:08)">><<pass 8>><<replace "#act-mp-reg6-druid-moment-16">>
<<if ($willpower or 0) gte 430 or ($tending or 0) gte 240>>
