:: MP Region Moment Druid 15 [nobr]
<<set $outside to 1>><<set $location to "forest">><<effects>><<mpAmbient>>
<<set $daily to ($daily or {})>><<set $mpClues to ($mpClues or {})>>
<<if Time.dayState is "night">>月光清冷的月泉祭坛东侧引水石渠旁，<<else>>林间静谧的月泉祭坛东侧引水石渠旁，<</if>>一只雕成松果形状的青铜滤水球卡在渠口，岸边放着一根韧竹签与一块蜂蜡布。
<<if $mpClues["clue_reg6_druid_0"]>><span class="teal">借着在西侧石台润藤时看清的石渠走向拨开石渠落叶，月泉祭坛的松果铜球顿时露了出来。</span><</if>>
<br><br>
<<getouticon>><<link [[离开 (0:03)|MP Region Druid Circle]]>><<pass 3>><<set $eventskip to 1>><<endevent>><</link>>
<br>
